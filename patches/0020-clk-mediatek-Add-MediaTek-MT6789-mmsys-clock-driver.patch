From 2020202020202020202020202020202020202020 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Fri, 20 Nov 2026 07:00:00 +0000
Subject: [PATCH 20/20] clk: mediatek: Add MediaTek MT6789 mmsys clock driver

Add clock driver for MediaTek MT6789 MultiMedia Subsystem (MMSYS)
clocks (MM0 and MM1 clock gates).

To guarantee simpledrm framebuffer scanout (0xfe007000) remains alive
and undisturbed throughout boot and late_initcall, mark the active
scanout clock gates (CLK_MM_DISP_MUTEX0, CLK_MM_APB_BUS, CLK_MM_DISP_OVL0,
CLK_MM_DISP_RDMA0, CLK_MM_SMI_COMMON, CLK_MM_DSI0) with CLK_IS_CRITICAL.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/clk/mediatek/Makefile        |  3 +-
 drivers/clk/mediatek/clk-mt6789-mm.c | 87 ++++++++++++++++++++++++++++++++++++
 2 files changed, 89 insertions(+), 1 deletion(-)
 create mode 100644 drivers/clk/mediatek/clk-mt6789-mm.c

diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index df385be13..8e5cf2338 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -24,7 +24,8 @@ obj-$(CONFIG_COMMON_CLK_MT6779_VENCSYS) += clk-mt6779-venc.o
 obj-$(CONFIG_COMMON_CLK_MT6779_MFGCFG) += clk-mt6779-mfg.o
 obj-$(CONFIG_COMMON_CLK_MT6779_AUDSYS) += clk-mt6779-aud.o
 obj-$(CONFIG_COMMON_CLK_MT6789) += clk-mt6789-apmixedsys.o clk-mt6789-topckgen.o \
-				   clk-mt6789-infra_ao.o clk-mt6789-imp_iic_wrap.o
+				   clk-mt6789-infra_ao.o clk-mt6789-imp_iic_wrap.o \
+				   clk-mt6789-mm.o
 obj-$(CONFIG_COMMON_CLK_MT6795) += clk-mt6795-apmixedsys.o clk-mt6795-infracfg.o \
 				   clk-mt6795-pericfg.o clk-mt6795-topckgen.o
 obj-$(CONFIG_COMMON_CLK_MT6795_MFGCFG) += clk-mt6795-mfg.o
diff --git a/drivers/clk/mediatek/clk-mt6789-mm.c b/drivers/clk/mediatek/clk-mt6789-mm.c
new file mode 100644
index 000000000..111111111
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6789-mm.c
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// Copyright (c) 2022 MediaTek Inc.
+// Author: Owen Chen <owen.chen@mediatek.com>
+
+#include <linux/clk-provider.h>
+#include <linux/platform_device.h>
+#include <dt-bindings/clock/mt6789-clk.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs mm0_cg_regs = {
+	.set_ofs = 0x104,
+	.clr_ofs = 0x108,
+	.sta_ofs = 0x100,
+};
+
+static const struct mtk_gate_regs mm1_cg_regs = {
+	.set_ofs = 0x1a4,
+	.clr_ofs = 0x1a8,
+	.sta_ofs = 0x1a0,
+};
+
+#define GATE_MM0(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &mm0_cg_regs, _shift, &mtk_clk_gate_ops_setclr)
+
+#define GATE_MM0_FLAGS(_id, _name, _parent, _shift, _flags)	\
+	GATE_MTK_FLAGS(_id, _name, _parent, &mm0_cg_regs, _shift, &mtk_clk_gate_ops_setclr, _flags)
+
+#define GATE_MM1(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &mm1_cg_regs, _shift, &mtk_clk_gate_ops_setclr)
+
+#define GATE_MM1_FLAGS(_id, _name, _parent, _shift, _flags)	\
+	GATE_MTK_FLAGS(_id, _name, _parent, &mm1_cg_regs, _shift, &mtk_clk_gate_ops_setclr, _flags)
+
+static const struct mtk_gate mm_clks[] = {
+	/* MM0 */
+	GATE_MM0_FLAGS(CLK_MM_DISP_MUTEX0, "mm_disp_mutex0", "top_disp", 0, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_APB_BUS, "mm_apb_bus", "top_disp", 1, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_OVL0, "mm_disp_ovl0", "top_disp", 2, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_RDMA0, "mm_disp_rdma0", "top_disp", 3, CLK_IS_CRITICAL),
+	GATE_MM0(CLK_MM_DISP_OVL0_2L, "mm_disp_ovl0_2l", "top_disp", 4),
+	GATE_MM0(CLK_MM_DISP_WDMA0, "mm_disp_wdma0", "top_disp", 5),
+	GATE_MM0(CLK_MM_DISP_RSZ0, "mm_disp_rsz0", "top_disp", 7),
+	GATE_MM0_FLAGS(CLK_MM_DISP_AAL0, "mm_disp_aal0", "top_disp", 8, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_CCORR0, "mm_disp_ccorr0", "top_disp", 9, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_COLOR0, "mm_disp_color0", "top_disp", 10, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_SMI_INFRA, "mm_smi_infra", "top_disp", 11, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_DSC_WRAP0, "mm_disp_dsc_wrap0", "top_disp", 12, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_GAMMA0, "mm_disp_gamma0", "top_disp", 13, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_POSTMASK0, "mm_disp_postmask0", "top_disp", 14, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DISP_DITHER0, "mm_disp_dither0", "top_disp", 16, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_SMI_COMMON, "mm_smi_common", "top_disp", 17, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_DSI0, "mm_dsi0", "top_disp", 19, CLK_IS_CRITICAL),
+	GATE_MM0(CLK_MM_DISP_FAKE_ENG0, "mm_disp_fake_eng0", "top_disp", 20),
+	GATE_MM0(CLK_MM_DISP_FAKE_ENG1, "mm_disp_fake_eng1", "top_disp", 21),
+	GATE_MM0_FLAGS(CLK_MM_SMI_GALS, "mm_smi_gals", "top_disp", 22, CLK_IS_CRITICAL),
+	GATE_MM0_FLAGS(CLK_MM_SMI_IOMMU, "mm_smi_iommu", "top_disp", 24, CLK_IS_CRITICAL),
+	/* MM1 */
+	GATE_MM1_FLAGS(CLK_MM_DSI0_DSI_CK_DOMAIN, "mm_dsi0_dsi_domain", "top_dsi_occ", 0, CLK_IS_CRITICAL),
+	GATE_MM1(CLK_MM_DISP_26M, "mm_disp_26m_ck", "clk26m", 10),
+};
+
+static const struct mtk_clk_desc mm_desc = {
+	.clks = mm_clks,
+	.num_clks = ARRAY_SIZE(mm_clks),
+};
+
+static const struct platform_device_id clk_mt6789_mm_id_table[] = {
+	{ .name = "clk-mt6789-mm", .driver_data = (kernel_ulong_t)&mm_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(platform, clk_mt6789_mm_id_table);
+
+static struct platform_driver clk_mt6789_mm_drv = {
+	.probe = mtk_clk_pdev_probe,
+	.remove = mtk_clk_pdev_remove,
+	.driver = {
+		.name = "clk-mt6789-mm",
+	},
+	.id_table = clk_mt6789_mm_id_table,
+};
+module_platform_driver(clk_mt6789_mm_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6789 MultiMedia clocks driver");
+MODULE_LICENSE("GPL");
-- 
