From 1010101010101010101010101010101010101010 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:10:00 +0000
Subject: [PATCH 10/10] spi: mediatek: Add MediaTek MT6789 SPI support

Add compatible string for the MediaTek MT6789 SoC SPI controller.
The hardware features match the MT6765 IP configuration (need_pad_sel,
must_tx, enhance_timing, dma_ext).

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 Documentation/devicetree/bindings/spi/mediatek,spi-mt65xx.yaml | 1 +
 drivers/spi/spi-mt65xx.c                                      | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/Documentation/devicetree/bindings/spi/mediatek,spi-mt65xx.yaml b/Documentation/devicetree/bindings/spi/mediatek,spi-mt65xx.yaml
index e4c24388e..289ad6626 100644
--- a/Documentation/devicetree/bindings/spi/mediatek,spi-mt65xx.yaml
+++ b/Documentation/devicetree/bindings/spi/mediatek,spi-mt65xx.yaml
@@ -34,6 +34,7 @@ properties:
       - items:
           - enum:
               - mediatek,mt6779-spi
+              - mediatek,mt6789-spi
               - mediatek,mt8186-spi
               - mediatek,mt8192-spi
               - mediatek,mt8195-spi
diff --git a/drivers/spi/spi-mt65xx.c b/drivers/spi/spi-mt65xx.c
index a352ecb31..82e1cbb3d 100644
--- a/drivers/spi/spi-mt65xx.c
+++ b/drivers/spi/spi-mt65xx.c
@@ -253,6 +253,9 @@ static const struct of_device_id mtk_spi_of_match[] = {
 	{ .compatible = "mediatek,mt6765-spi",
 		.data = (void *)&mt6765_compat,
 	},
+	{ .compatible = "mediatek,mt6789-spi",
+		.data = (void *)&mt6765_compat,
+	},
 	{ .compatible = "mediatek,mt6991-spi",
 		.data = (void *)&mt6991_compat,
 	},
-- 
