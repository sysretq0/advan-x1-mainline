From 1919191919191919191919191919191919191919 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Fri, 20 Nov 2026 06:00:00 +0000
Subject: [PATCH 19/19] soc: mediatek: mmsys: Add MediaTek MT6789 MMSYS support

Add support for the MediaTek MT6789 (Helio G99) MultiMedia Subsystem
(MMSYS) syscon and routing controller.

On MT6789, the display pipeline routing registers (OVL_MOUT_EN,
RDMA0_SEL_IN, MMSYS_OVL_CON, RDMA0_SOUT_SEL, DITHER0_MOUT_EN,
DSI0_SEL_IN, RDMA1_MOUT_EN, RDMA1_SEL_IN, DPI0_SEL_IN) and software
resets match the MT8186 topology. Point MT6789 to mmsys_mt8186_routing_table,
instantiate the clk-mt6789-mm clock provider, and add devicetree bindings.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 Documentation/devicetree/bindings/arm/mediatek/mediatek,mmsys.yaml | 1 +
 drivers/soc/mediatek/mtk-mmsys.c                                   | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/mediatek/mediatek,mmsys.yaml b/Documentation/devicetree/bindings/arm/mediatek/mediatek,mmsys.yaml
index 3f4262e93..c8d268b92 100644
--- a/Documentation/devicetree/bindings/arm/mediatek/mediatek,mmsys.yaml
+++ b/Documentation/devicetree/bindings/arm/mediatek/mediatek,mmsys.yaml
@@ -25,6 +25,7 @@ properties:
               - mediatek,mt2712-mmsys
               - mediatek,mt6765-mmsys
               - mediatek,mt6779-mmsys
+              - mediatek,mt6789-mmsys
               - mediatek,mt6795-mmsys
               - mediatek,mt6797-mmsys
               - mediatek,mt8167-mmsys
diff --git a/drivers/soc/mediatek/mtk-mmsys.c b/drivers/soc/mediatek/mtk-mmsys.c
index bfcd93830..80c4b7e18 100644
--- a/drivers/soc/mediatek/mtk-mmsys.c
+++ b/drivers/soc/mediatek/mtk-mmsys.c
@@ -67,6 +67,14 @@ static const struct mtk_mmsys_driver_data mt8173_mmsys_driver_data = {
 	.num_resets = 64,
 };
 
+static const struct mtk_mmsys_driver_data mt6789_mmsys_driver_data = {
+	.clk_driver = "clk-mt6789-mm",
+	.routes = mmsys_mt8186_routing_table,
+	.num_routes = ARRAY_SIZE(mmsys_mt8186_routing_table),
+	.sw0_rst_offset = MT8186_MMSYS_SW0_RST_B,
+	.num_resets = 32,
+};
+
 static const struct mtk_mmsys_driver_data mt8183_mmsys_driver_data = {
 	.clk_driver = "clk-mt8183-mm",
 	.routes = mmsys_mt8183_routing_table,
@@ -461,6 +469,7 @@ static const struct of_device_id of_match_mtk_mmsys[] = {
 	{ .compatible = "mediatek,mt2701-mmsys", .data = &mt2701_mmsys_driver_data },
 	{ .compatible = "mediatek,mt2712-mmsys", .data = &mt2712_mmsys_driver_data },
 	{ .compatible = "mediatek,mt6779-mmsys", .data = &mt6779_mmsys_driver_data },
+	{ .compatible = "mediatek,mt6789-mmsys", .data = &mt6789_mmsys_driver_data },
 	{ .compatible = "mediatek,mt6795-mmsys", .data = &mt6795_mmsys_driver_data },
 	{ .compatible = "mediatek,mt6797-mmsys", .data = &mt6797_mmsys_driver_data },
 	{ .compatible = "mediatek,mt8167-mmsys", .data = &mt8167_mmsys_driver_data },
