From c03740d99b5d539526337804e607cef60a398a73 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sun, 22 Nov 2026 04:29:51 +0000
Subject: [PATCH] dt-bindings: gpu: mali-bifrost: Add MT6789 compatible

Document the mediatek,mt6789-mali Valhall compatible string (2 power
domains: core0, core1) in arm,mali-bifrost.yaml.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
index ece2b63..9c41f20 100644
--- a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
@@ -44,6 +44,7 @@ properties:
       - items:
           - enum:
               - allwinner,sun55i-a523-mali
+              - mediatek,mt6789-mali
               - mediatek,mt8188-mali
               - mediatek,mt8192-mali
               - mediatek,mt8370-mali
@@ -232,6 +233,7 @@ allOf:
         compatible:
           contains:
             enum:
+              - mediatek,mt6789-mali
               - mediatek,mt8186-mali
               - mediatek,mt8370-mali
     then:
-- 
2.55.0
