From 6726b634ee2163ca8a403ba9f1c6e8f462549703 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:36 +0000
Subject: [PATCH] dt-bindings: memory: mediatek: Add MT6789 SMI compatibles

Document mediatek,mt6789-smi-common, mediatek,mt6789-smi-larb, and
mediatek,mt6789-iommu-mm compatibles and add the MT6789 display LARB
memory port header.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 .../bindings/iommu/mediatek,iommu.yaml        |  3 +++
 .../mediatek,smi-common.yaml                  |  2 ++
 .../memory-controllers/mediatek,smi-larb.yaml |  2 ++
 .../memory/mediatek,mt6789-memory-port.h      | 24 +++++++++++++++++++
 4 files changed, 31 insertions(+)
 create mode 100644 include/dt-bindings/memory/mediatek,mt6789-memory-port.h

diff --git a/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml b/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml
index cbda221..d6c2eef 100644
--- a/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/mediatek,iommu.yaml
@@ -73,6 +73,7 @@ properties:
           - mediatek,mt2701-m4u  # generation one
           - mediatek,mt2712-m4u  # generation two
           - mediatek,mt6779-m4u  # generation two
+          - mediatek,mt6789-iommu-mm         # generation two
           - mediatek,mt6795-m4u  # generation two
           - mediatek,mt6893-iommu-mm         # generation two
           - mediatek,mt8167-m4u  # generation two
@@ -178,6 +179,7 @@ allOf:
             enum:
               - mediatek,mt2701-m4u
               - mediatek,mt2712-m4u
+              - mediatek,mt6789-iommu-mm
               - mediatek,mt6795-m4u
               - mediatek,mt6893-iommu-mm
               - mediatek,mt8173-m4u
@@ -197,6 +199,7 @@ allOf:
       properties:
         compatible:
           enum:
+            - mediatek,mt6789-iommu-mm
             - mediatek,mt6893-iommu-mm
             - mediatek,mt8186-iommu-mm
             - mediatek,mt8188-iommu-vdo
diff --git a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml
index 33c989f..83c4322 100644
--- a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml
+++ b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-common.yaml
@@ -47,6 +47,7 @@ properties:
           - mediatek,mt2701-smi-common
           - mediatek,mt2712-smi-common
           - mediatek,mt6779-smi-common
+          - mediatek,mt6789-smi-common
           - mediatek,mt6795-smi-common
           - mediatek,mt6893-smi-common
           - mediatek,mt8167-smi-common
@@ -148,6 +149,7 @@ allOf:
         compatible:
           enum:
             - mediatek,mt6779-smi-common
+            - mediatek,mt6789-smi-common
             - mediatek,mt8183-smi-common
             - mediatek,mt8186-smi-common
             - mediatek,mt8192-smi-common
diff --git a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml
index 9a5dafd..f20de26 100644
--- a/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml
+++ b/Documentation/devicetree/bindings/memory-controllers/mediatek,smi-larb.yaml
@@ -20,6 +20,7 @@ properties:
           - mediatek,mt2701-smi-larb
           - mediatek,mt2712-smi-larb
           - mediatek,mt6779-smi-larb
+          - mediatek,mt6789-smi-larb
           - mediatek,mt6795-smi-larb
           - mediatek,mt6893-smi-larb
           - mediatek,mt8167-smi-larb
@@ -119,6 +120,7 @@ allOf:
               - mediatek,mt2701-smi-larb
               - mediatek,mt2712-smi-larb
               - mediatek,mt6779-smi-larb
+              - mediatek,mt6789-smi-larb
               - mediatek,mt8186-smi-larb
               - mediatek,mt8188-smi-larb
               - mediatek,mt8189-smi-larb
diff --git a/include/dt-bindings/memory/mediatek,mt6789-memory-port.h b/include/dt-bindings/memory/mediatek,mt6789-memory-port.h
new file mode 100644
index 0000000..896a2de
--- /dev/null
+++ b/include/dt-bindings/memory/mediatek,mt6789-memory-port.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Copyright (c) 2022 MediaTek Inc.
+ * Author: Jianjiao Zeng <jianjiao.zeng@mediatek.com>
+ */
+#ifndef _DT_BINDINGS_MEMORY_MT6789_MEMORY_PORT_H_
+#define _DT_BINDINGS_MEMORY_MT6789_MEMORY_PORT_H_
+
+#include <dt-bindings/memory/mtk-memory-port.h>
+
+/* larb0 */
+#define M4U_PORT_L0_DISP_POSTMASK0		MTK_M4U_ID(0, 0)
+#define M4U_PORT_L0_OVL_RDMA0_HDR		MTK_M4U_ID(0, 1)
+#define M4U_PORT_L0_OVL_RDMA0			MTK_M4U_ID(0, 2)
+#define M4U_PORT_L0_DISP_FAKE0			MTK_M4U_ID(0, 3)
+
+/* larb1 */
+#define M4U_PORT_L1_OVL_2L_RDMA0_HDR		MTK_M4U_ID(1, 0)
+#define M4U_PORT_L1_OVL_2L_RDMA0		MTK_M4U_ID(1, 1)
+#define M4U_PORT_L1_DISP_RDMA0			MTK_M4U_ID(1, 2)
+#define M4U_PORT_L1_DISP_WDMA0			MTK_M4U_ID(1, 3)
+#define M4U_PORT_L1_DISP_FAKE1			MTK_M4U_ID(1, 4)
+
+#endif /* _DT_BINDINGS_MEMORY_MT6789_MEMORY_PORT_H_ */
-- 
2.55.0

