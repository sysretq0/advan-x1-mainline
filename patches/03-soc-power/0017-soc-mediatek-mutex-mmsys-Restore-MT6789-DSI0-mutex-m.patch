From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Wed, 25 Nov 2026 19:06:00 +0000
Subject: [PATCH] soc: mediatek: mutex,mmsys: Restore MT6789 DSI0 mutex mod and
 MMSYS SODI/EMI config

On MediaTek MT6789, cold power-on of MT6789_POWER_DOMAIN_DISP after
s2idle system suspend resets DISP_MUTEX0 and MMSYS registers to 0x0,
wiping bootloader-initialized state that stayed intact across runtime
DPMS cycles:

1. mtk-mutex: downstream mt6789_mutex_mod includes DISP_DSI0 (BIT(14) in
   DISP_MUTEX0_MOD0) alongside DISP_MUTEX0_SOF = SOF_DSI0 | EOF_DSI0.
   Mainline mtk_mutex_add_comp() only wrote DISP_MUTEX0_SOF for
   DDP_COMPONENT_DSI0 and left BIT(14) cleared after DISP power-off.
   Add MT6789_MUTEX_MOD_DISP_DSI0 (14) and set/clear it when
   need_dsi_mod is enabled on mt6789_mutex_driver_data.
2. mt6789-mmsys: restore MMSYS_MISC (0x0f0 OVL0/OVL0_2L RDMA ultra
   select), MMSYS_SODI_REQ_MASK (0x0f4 RDMA0 PD mode), and
   MMSYS_EMI_REQ_CTL (0x0f8 RDMA0 DVFS halt mask and WDMA0 urgent ctl)
   matching downstream mt6789_mtk_sodi_config() whenever OVL0 -> RDMA0
   is connected.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/soc/mediatek/mt6789-mmsys.h | 22 ++++++++++++++++++++++
 drivers/soc/mediatek/mtk-mutex.c    | 21 +++++++++++++++++++++
 2 files changed, 43 insertions(+)

diff --git a/drivers/soc/mediatek/mt6789-mmsys.h b/drivers/soc/mediatek/mt6789-mmsys.h
index f6dae1161..e064308ea 100644
--- a/drivers/soc/mediatek/mt6789-mmsys.h
+++ b/drivers/soc/mediatek/mt6789-mmsys.h
@@ -5,6 +5,19 @@
 
 #define MT6789_MMSYS_SW0_RST_B				0x160
 
+#define MT6789_MMSYS_MISC				0x0F0
+#define MT6789_OVL_RDMA_ULTRA_SEL_MASK			(GENMASK(7, 6) | GENMASK(3, 2))
+
+#define MT6789_MMSYS_SODI_REQ_MASK			0x0F4
+#define MT6789_SODI_REQ_RDMA0_MASK			(GENMASK(13, 12) | GENMASK(9, 8))
+#define MT6789_SODI_REQ_RDMA0_PD_EN			(BIT(12) | BIT(8))
+
+#define MT6789_MMSYS_EMI_REQ_CTL			0x0F8
+#define MT6789_EMI_REQ_CTL_MASK				(BIT(22) | BIT(18) | \
+							 BIT(10) | BIT(9) | \
+							 BIT(1) | BIT(0))
+#define MT6789_EMI_REQ_CTL_RDMA0_EN			(BIT(18) | BIT(1))
+
 #define MT6789_MMSYS_OVL_CON				0xF04
 #define MT6789_MMSYS_OVL0_CON_MASK			0xF
 #define MT6789_OVL0_GO_BLEND				BIT(0)
@@ -47,6 +60,15 @@ static const struct mtk_mmsys_routes mmsys_mt6789_routing_table[] = {
 	MMSYS_ROUTE(OVL, 0, RDMA, 0,
 		    MT6789_MMSYS_OVL_CON, MT6789_MMSYS_OVL0_CON_MASK,
 		    MT6789_OVL0_GO_BLEND),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6789_MMSYS_MISC, MT6789_OVL_RDMA_ULTRA_SEL_MASK,
+		    0),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6789_MMSYS_SODI_REQ_MASK, MT6789_SODI_REQ_RDMA0_MASK,
+		    MT6789_SODI_REQ_RDMA0_PD_EN),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6789_MMSYS_EMI_REQ_CTL, MT6789_EMI_REQ_CTL_MASK,
+		    MT6789_EMI_REQ_CTL_RDMA0_EN),
 	MMSYS_ROUTE(RDMA, 0, COLOR, 0,
 		    MT6789_DISP_RDMA0_SOUT_SEL, MT6789_RDMA0_SOUT_SEL_MASK,
 		    MT6789_RDMA0_SOUT_TO_COLOR0),
diff --git a/drivers/soc/mediatek/mtk-mutex.c b/drivers/soc/mediatek/mtk-mutex.c
index d1e269188..bf0403d61 100644
--- a/drivers/soc/mediatek/mtk-mutex.c
+++ b/drivers/soc/mediatek/mtk-mutex.c
@@ -60,6 +60,7 @@
 #define MT8186_MUTEX_MOD_DISP_DITHER0		10
 #define MT8186_MUTEX_MOD_DISP_RDMA1		17
 #define MT6789_MUTEX_MOD_DISP_DSC_WRAP0_CORE0	13
+#define MT6789_MUTEX_MOD_DISP_DSI0		14
 
 #define MT8186_MUTEX_SOF_SINGLE_MODE		0
 #define MT8186_MUTEX_SOF_DSI0			1
@@ -357,6 +358,7 @@ struct mtk_mutex_data {
 	const u16 mutex_mod1_reg;
 	const u16 mutex_sof_reg;
 	const bool no_clk;
+	const bool need_dsi_mod;
 };
 
 struct mtk_mutex_ctx {
@@ -462,6 +464,7 @@ static const u8 mt6789_mutex_mod[DDP_COMPONENT_ID_MAX] = {
 	[DDP_COMPONENT_COLOR0] = MT8186_MUTEX_MOD_DISP_COLOR0,
 	[DDP_COMPONENT_DITHER0] = MT8186_MUTEX_MOD_DISP_DITHER0,
 	[DDP_COMPONENT_DSC0] = MT6789_MUTEX_MOD_DISP_DSC_WRAP0_CORE0,
+	[DDP_COMPONENT_DSI0] = MT6789_MUTEX_MOD_DISP_DSI0,
 	[DDP_COMPONENT_GAMMA] = MT8186_MUTEX_MOD_DISP_GAMMA0,
 	[DDP_COMPONENT_OVL0] = MT8186_MUTEX_MOD_DISP_OVL0,
 	[DDP_COMPONENT_OVL_2L0] = MT8186_MUTEX_MOD_DISP_OVL0_2L,
@@ -808,6 +811,7 @@ static const struct mtk_mutex_data mt6789_mutex_driver_data = {
 	.mutex_mod_reg = MT8183_MUTEX0_MOD0,
 	.mutex_mod1_reg = MT8183_MUTEX0_MOD1,
 	.mutex_sof_reg = MT8183_MUTEX0_SOF0,
+	.need_dsi_mod = true,
 };
 
 static const struct mtk_mutex_data mt8186_mutex_driver_data = {
@@ -926,6 +930,14 @@ void mtk_mutex_add_comp(struct mtk_mutex *mutex,
 	switch (id) {
 	case DDP_COMPONENT_DSI0:
 		sof_id = MUTEX_SOF_DSI0;
+		if (mtx->data->need_dsi_mod) {
+			offset = DISP_REG_MUTEX_MOD(mtx, mtx->data->mutex_mod[id],
+						    mutex->id);
+			mod_id = mtx->data->mutex_mod[id] % 32;
+			reg = readl_relaxed(mtx->regs + offset);
+			reg |= BIT(mod_id);
+			writel_relaxed(reg, mtx->regs + offset);
+		}
 		break;
 	case DDP_COMPONENT_DSI1:
 		sof_id = MUTEX_SOF_DSI0;
@@ -976,6 +988,15 @@ void mtk_mutex_remove_comp(struct mtk_mutex *mutex,
 
 	switch (id) {
 	case DDP_COMPONENT_DSI0:
+		if (mtx->data->need_dsi_mod) {
+			offset = DISP_REG_MUTEX_MOD(mtx, mtx->data->mutex_mod[id],
+						    mutex->id);
+			mod_id = mtx->data->mutex_mod[id] % 32;
+			reg = readl_relaxed(mtx->regs + offset);
+			reg &= ~BIT(mod_id);
+			writel_relaxed(reg, mtx->regs + offset);
+		}
+		fallthrough;
 	case DDP_COMPONENT_DSI1:
 	case DDP_COMPONENT_DSI2:
 	case DDP_COMPONENT_DSI3:
-- 
2.47.2
