From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Wed, 25 Nov 2026 18:20:00 +0000
Subject: [PATCH] iommu/mediatek: Restore IOMMU registers even when
 wr_len_ctrl is zero

mtk_iommu_runtime_resume() currently uses `if (!reg->wr_len_ctrl)` to
detect the initial resume before mtk_iommu_hw_init() has run. On SoCs
with WR_THROT_EN where clearing F_MMU_WR_THROT_DIS_MASK leaves
REG_MMU_WR_LEN_CTRL at 0, every subsequent runtime resume returns early
without restoring REG_MMU_PT_BASE_ADDR, interrupt enables, or control
registers after the power domain cycles across s2idle.

Track whether a valid domain state has been saved during
mtk_iommu_runtime_suspend() via an explicit reg->saved flag instead of
testing reg->wr_len_ctrl.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/iommu/mtk_iommu.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/iommu/mtk_iommu.c b/drivers/iommu/mtk_iommu.c
index 038ed9e1f..8c66c4b42 100644
--- a/drivers/iommu/mtk_iommu.c
+++ b/drivers/iommu/mtk_iommu.c
@@ -196,6 +196,7 @@ struct mtk_iommu_suspend_reg {
 	u32			int_control[MTK_IOMMU_BANK_MAX];
 	u32			int_main_control[MTK_IOMMU_BANK_MAX];
 	u32			ivrp_paddr[MTK_IOMMU_BANK_MAX];
+	bool			saved;
 };
 
 struct mtk_iommu_plat_data {
@@ -1492,6 +1493,7 @@ static int __maybe_unused mtk_iommu_runtime_suspend(struct device *dev)
 	struct mtk_iommu_data *data = dev_get_drvdata(dev);
 	struct mtk_iommu_suspend_reg *reg = &data->reg;
 	void __iomem *base;
+	bool has_dom = false;
 	int i = 0;
 
 	base = data->bank[i].base;
@@ -1507,7 +1509,10 @@ static int __maybe_unused mtk_iommu_runtime_suspend(struct device *dev)
 		reg->int_control[i] = readl_relaxed(base + REG_MMU_INT_CONTROL0);
 		reg->int_main_control[i] = readl_relaxed(base + REG_MMU_INT_MAIN_CONTROL);
 		reg->ivrp_paddr[i] = readl_relaxed(base + REG_MMU_IVRP_PADDR);
+		if (data->bank[i].m4u_dom)
+			has_dom = true;
 	} while (++i < data->plat_data->banks_num);
+	reg->saved = has_dom;
 	clk_disable_unprepare(data->bclk);
 	return 0;
 }
@@ -1527,10 +1532,12 @@ static int __maybe_unused mtk_iommu_runtime_resume(struct device *dev)
 	}
 
 	/*
-	 * Uppon first resume, only enable the clk and return, since the values of the
-	 * registers are not yet set.
+	 * Upon first resume before any bank has been initialized and suspended,
+	 * only enable the clk and return, since the values of the registers are
+	 * not yet saved. Do not key on reg->wr_len_ctrl, which may be 0 after
+	 * WR_THROT_EN clears F_MMU_WR_THROT_DIS_MASK on MT6789.
 	 */
-	if (!reg->wr_len_ctrl)
+	if (!reg->saved)
 		return 0;
 
 	base = data->bank[i].base;
