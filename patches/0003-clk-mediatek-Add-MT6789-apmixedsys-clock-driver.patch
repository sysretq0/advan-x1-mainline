From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Tue, 17 Nov 2026 15:18:56 +0000
Subject: [PATCH 3/7] clk: mediatek: Add MT6789 apmixedsys clock driver

Change-Id: If37bc47a5af864a98d57a386b7b17524845b2962
Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/clk/mediatek/clk-mt6789-apmixedsys.c | 153 +++++++++++++++++++
 1 file changed, 153 insertions(+)
 create mode 100644 drivers/clk/mediatek/clk-mt6789-apmixedsys.c

diff --git a/drivers/clk/mediatek/clk-mt6789-apmixedsys.c b/drivers/clk/mediatek/clk-mt6789-apmixedsys.c
new file mode 100644
index 000000000..a223d1017
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6789-apmixedsys.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// Copyright (c) 2022 MediaTek Inc.
+// Author: Owen Chen <owen.chen@mediatek.com>
+
+#include <linux/clk-provider.h>
+#include <linux/platform_device.h>
+#include <dt-bindings/clock/mt6789-clk.h>
+
+#include "clk-mtk.h"
+#include "clk-pll.h"
+
+#define MT6789_PLL_FMAX		(3800UL * MHZ)
+#define MT6789_PLL_FMIN		(1500UL * MHZ)
+#define MT6789_INTEGER_BITS	(8)
+
+#define PLL(_id, _name, _reg, _pwr_reg, _en_mask, _flags,		\
+	    _rst_bar_mask, _pcwbits, _pd_reg, _pd_shift,		\
+	    _tuner_reg, _tuner_en_reg, _tuner_en_bit,			\
+	    _pcw_reg) {							\
+		.id = _id,						\
+		.name = _name,						\
+		.reg = _reg,						\
+		.pwr_reg = _pwr_reg,					\
+		.en_mask = _en_mask,					\
+		.flags = _flags,					\
+		.rst_bar_mask = _rst_bar_mask,				\
+		.fmax = MT6789_PLL_FMAX,				\
+		.fmin = MT6789_PLL_FMIN,				\
+		.pcwbits = _pcwbits,					\
+		.pcwibits = MT6789_INTEGER_BITS,			\
+		.pd_reg = _pd_reg,					\
+		.pd_shift = _pd_shift,					\
+		.tuner_reg = _tuner_reg,				\
+		.tuner_en_reg = _tuner_en_reg,				\
+		.tuner_en_bit = _tuner_en_bit,				\
+		.pcw_reg = _pcw_reg,					\
+		.pcw_shift = 0,						\
+		.pcw_chg_reg = 0,					\
+		.en_reg = 0,						\
+		.pll_en_bit = 0,					\
+	}
+
+static const struct mtk_pll_data plls[] = {
+	/*
+	 * armpll_ll/armpll_bl0/ccipll are main clock source of AP MCU,
+	 * should not be closed in Linux world.
+	 */
+	PLL(CLK_APMIXED_ARMPLL_LL, "armpll_ll", 0x0208, 0x0214, 0,
+	    PLL_AO, BIT(0), 22, 0x020c, 24, 0, 0, 0, 0x020c),
+	PLL(CLK_APMIXED_ARMPLL_BL0, "armpll_bl0", 0x0218, 0x0224, 0,
+	    PLL_AO, BIT(0), 22, 0x021c, 24, 0, 0, 0, 0x021c),
+	PLL(CLK_APMIXED_CCIPLL, "ccipll", 0x0258, 0x0264, 0,
+	    PLL_AO, BIT(0), 22, 0x025c, 24, 0, 0, 0, 0x025c),
+	PLL(CLK_APMIXED_MPLL, "mpll", 0x0390, 0x039c, 0,
+	    PLL_AO, BIT(0), 22, 0x0394, 24, 0, 0, 0, 0x0394),
+	PLL(CLK_APMIXED_MAINPLL, "mainpll", 0x0340, 0x034c, 0xff000000,
+	    HAVE_RST_BAR | PLL_AO, BIT(23), 22, 0x0344, 24, 0, 0, 0, 0x0344),
+	PLL(CLK_APMIXED_UNIVPLL, "univpll", 0x0308, 0x0314, 0xff000000,
+	    HAVE_RST_BAR | PLL_AO, BIT(23), 22, 0x030c, 24, 0, 0, 0, 0x030c),
+	PLL(CLK_APMIXED_MSDCPLL, "msdcpll", 0x0350, 0x035c, 0,
+	    PLL_AO, BIT(0), 22, 0x0354, 24, 0, 0, 0, 0x0354),
+	PLL(CLK_APMIXED_MMPLL, "mmpll", 0x0360, 0x036c, 0xff000000,
+	    HAVE_RST_BAR | PLL_AO, BIT(23), 22, 0x0364, 24, 0, 0, 0, 0x0364),
+	PLL(CLK_APMIXED_NPUPLL, "npupll", 0x03b4, 0x03c0, 0xff000000,
+	    0, BIT(0), 22, 0x03b8, 24, 0, 0, 0, 0x03b8),
+	PLL(CLK_APMIXED_MFGPLL, "mfgpll", 0x0268, 0x0274, 0,
+	    0, BIT(0), 22, 0x026c, 24, 0, 0, 0, 0x026c),
+	PLL(CLK_APMIXED_TVDPLL, "tvdpll", 0x0380, 0x038c, 0,
+	    0, BIT(0), 22, 0x0384, 24, 0, 0, 0, 0x0384),
+	PLL(CLK_APMIXED_APLL1, "apll1", 0x0318, 0x0328, 0,
+	    0, BIT(0), 32, 0x031c, 24, 0x0040, 0x000c, 0, 0x0320),
+	PLL(CLK_APMIXED_APLL2, "apll2", 0x032c, 0x033c, 0,
+	    0, BIT(0), 32, 0x0330, 24, 0x0044, 0x000c, 5, 0x0334),
+	/*
+	 * usbpll is enabled through CON2 bit 2 instead of CON0 bit 0.
+	 */
+	{
+		.id = CLK_APMIXED_USBPLL,
+		.name = "usbpll",
+		.reg = 0x03c4,
+		.pwr_reg = 0x03cc,
+		.en_reg = 0x03cc,
+		.pll_en_bit = 2,
+		.flags = HAVE_RST_BAR | PLL_AO,
+		.rst_bar_mask = BIT(23),
+		.fmax = MT6789_PLL_FMAX,
+		.fmin = MT6789_PLL_FMIN,
+		.pcwbits = 22,
+		.pcwibits = MT6789_INTEGER_BITS,
+		.pd_reg = 0x03c4,
+		.pd_shift = 24,
+		.pcw_reg = 0x03c4,
+	},
+};
+
+static const struct of_device_id of_match_clk_mt6789_apmixed[] = {
+	{ .compatible = "mediatek,mt6789-apmixedsys", },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6789_apmixed);
+
+static int clk_mt6789_apmixed_probe(struct platform_device *pdev)
+{
+	struct clk_hw_onecell_data *clk_data;
+	struct device_node *node = pdev->dev.of_node;
+	int r;
+
+	clk_data = mtk_alloc_clk_data(CLK_APMIXED_NR_CLK);
+	if (!clk_data)
+		return -ENOMEM;
+
+	r = mtk_clk_register_plls(&pdev->dev, plls, ARRAY_SIZE(plls), clk_data);
+	if (r)
+		goto free_apmixed_data;
+
+	r = of_clk_add_hw_provider(node, of_clk_hw_onecell_get, clk_data);
+	if (r)
+		goto unregister_plls;
+
+	platform_set_drvdata(pdev, clk_data);
+
+	return r;
+
+unregister_plls:
+	mtk_clk_unregister_plls(plls, ARRAY_SIZE(plls), clk_data);
+free_apmixed_data:
+	mtk_free_clk_data(clk_data);
+	return r;
+}
+
+static void clk_mt6789_apmixed_remove(struct platform_device *pdev)
+{
+	struct device_node *node = pdev->dev.of_node;
+	struct clk_hw_onecell_data *clk_data = platform_get_drvdata(pdev);
+
+	of_clk_del_provider(node);
+	mtk_clk_unregister_plls(plls, ARRAY_SIZE(plls), clk_data);
+	mtk_free_clk_data(clk_data);
+}
+
+static struct platform_driver clk_mt6789_apmixed_drv = {
+	.probe = clk_mt6789_apmixed_probe,
+	.remove = clk_mt6789_apmixed_remove,
+	.driver = {
+		.name = "clk-mt6789-apmixed",
+		.of_match_table = of_match_clk_mt6789_apmixed,
+	},
+};
+builtin_platform_driver(clk_mt6789_apmixed_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6789 apmixedsys clocks driver");
+MODULE_LICENSE("GPL");
-- 
2.55.0

