From 4fbedba613beacd28fd7c1f7533208cbbba68508 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:20:33 +0000
Subject: [PATCH 6/7] arm64: dts: mediatek: Add MT6789 SoC base device tree

Structure follows upstream mediatek dtsi conventions. CPU topology, GICv3,
arch timer, PSCI, watchdog, UART0 and the topckgen/apmixedsys/infracfg_ao
clock controllers. All addresses and IRQs from Advan X1 stock firmware DT
(v5 boot image), mainline-shaped using the mt6789 vendor CCF register tables.

Change-Id: I7e9b5891ed265560fec47792d54b06703826c882
Signed-off-by: sysretq0 <sysretq0@users.noreply.github.com>
---
 .../boot/dts/mediatek/mt6789-advan-x1.dts     | 121 ++++++++++++
 arch/arm64/boot/dts/mediatek/mt6789.dtsi      | 186 ++++++++++++++++++
 2 files changed, 307 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6789.dtsi

diff --git a/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts b/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts
new file mode 100644
index 000000000..df137386c
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Advan X1 (MT6789) board device tree — clean redo.
+ *
+ * Board values from Advan X1 stock artifacts (extracted/v5/dtb/main_dtb_0.dts
+ * and live /proc/iomem audits 2026-11-11). Structure: upstream board-dts
+ * conventions. Loader interaction notes are evidence, not decoration — the
+ * loki-loader LNXB chain rewrites the chosen/bootargs bytes in place and
+ * publishes initrd coordinates only when the stub properties exist.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+#include "mt6789.dtsi"
+
+/ {
+	model = "Advan X1";
+	compatible = "advan,x1", "mediatek,mt6789";
+
+	chosen {
+		/*
+		 * Bootargs stub: loader (loki-loader/src/boot.c) rewrites these
+		 * exact value bytes in place, so this string IS the published
+		 * cmdline. Do not shrink below current capacity.
+		 */
+		bootargs = "earlycon=uart8250,mmio32,0x11002000 console=tty0 console=ttyGS0,115200 nokaslr loglevel=7 initcall_debug=1 root=/dev/sdc72 rootwait rw";
+
+		/*
+		 * Loader publishes initrd coordinates ONLY when the DTB carries
+		 * these stubs (boot.c/fdt.c FDT_NO_PROP). Boot 18 lost the
+		 * initramfs entirely because these two properties went missing.
+		 */
+		linux,initrd-start = <0x00 0x00>;
+		linux,initrd-end = <0x00 0x00>;
+		stdout-path = "framebuffer0";
+
+		#address-cells = <2>;
+		#size-cells = <2>;
+
+		framebuffer0: framebuffer@fe007000 {
+			compatible = "simple-framebuffer";
+			/* memory-region overrides reg; both kept for loader
+			 * compat (older staging code reads reg; kernel uses
+			 * memory-region). */
+			reg = <0x00 0xfe007000 0x00 0x00a80000>;
+			memory-region = <&fb_reserved>;
+			width = <1080>;
+			height = <2460>;
+			stride = <4352>;
+			format = "a8r8g8b8";
+			status = "okay";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* 4352 B * 2460 rows = 10,705,920 B; padded to 0x00A80000.
+		 * no-map: page allocator would otherwise clobber the LK
+		 * scanout buffer (boot 1-3 finding: kernel never reserves
+		 * bare-reg simplefb DRAM). */
+		fb_reserved: framebuffer@fe007000 {
+			reg = <0x00 0xfe007000 0x00 0x00a80000>;
+			no-map;
+		};
+
+		/* Stock ramoops carveout (live /proc/iomem 2026-11-11): 1 MiB
+		 * window inside the stock hole keeps the page allocator off it
+		 * in both directions. PSTORE_CONSOLE records console output
+		 * continuously, so a silent hang still leaves the exact last
+		 * lines readable from Android /sys/fs/pstore after the WDT
+		 * reset. Declared as memory + reserved (no no-map) so it is
+		 * System RAM for memremap (boots 4-5: zero content written
+		 * otherwise). */
+		ramoops@48090000 {
+			compatible = "ramoops";
+			reg = <0x00 0x48090000 0x00 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x20000>;
+			pmsg-size = <0x20000>;
+			ecc-size = <0>;
+		};
+	};
+
+	/* Memory: ONE verifiably clean window from live stock /proc/iomem
+	 * (2026-11-11): 0x140000000-0x2296fffff has zero reserved children.
+	 * Above it sit TZ/pKVM-class reservations to 0x23fffefff; device is
+	 * 8 GB total, stock MemTotal 7.49 GiB. Do NOT widen without a fresh
+	 * iomem audit. The stock ramoops hole is declared as memory + reserved
+	 * above. */
+	memory@48090000 {
+		device_type = "memory";
+		reg = <0x00 0x48090000 0x00 0x100000>; /* 1 MiB stock ramoops hole */
+	};
+
+	/* Kernel staging region: loader drops the Image at 0x61000000 (2 MiB
+	 * aligned); the arm64 kernel needs its load address inside a declared
+	 * memory region or the linear map never covers its own image (first
+	 * boot silence, 2026-11-11: silent hang + 30 s WDT). image_size
+	 * 0x54a0000 (84.6 MiB) fits with margin; top 0x69000000 stays below
+	 * the stock hole at 0x70000000-0x76bfffff. Loader image/stack/DTB
+	 * staging (0x60000000-0x61000000) stay outside on purpose. */
+	memory@61000000 {
+		device_type = "memory";
+		reg = <0x00 0x61000000 0x00 0x08000000>; /* 128 MiB */
+	};
+
+	memory@140000000 {
+		device_type = "memory";
+		reg = <0x01 0x40000000 0x00 0xe9700000>; /* 3.64 GiB clean window */
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6789.dtsi b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
new file mode 100644
index 000000000..9b0fadc2f
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * MediaTek MT6789 (Helio G99) SoC base device tree — mainline shape.
+ *
+ * Board authority: Advan X1 stock artifacts (extracted/v5/dtb/main_dtb_0.dts,
+ * dtbo_unpacked.dts). Every address/IRQ here is copied from those files; the
+ * structure follows upstream mediatek dtsi conventions (mt8186 generation).
+ *
+ * P1 scope: CPU topology, GICv3, arch timer, PSCI, watchdog, UART0, and the
+ * three clock controllers (topckgen, apmixedsys, infracfg_ao). UFS/USB/mphy/
+ * scpsys nodes land in P2-P4 with their drivers.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/clock/mt6789-clk.h>
+
+/ {
+	compatible = "mediatek,mt6789";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* Stock DT: 6x Cortex-A55 (MPIDR 0x0-0x5, cluster 0),
+		 * 2x Cortex-A76 (MPIDR 0x6-0x7, cluster 1). capacity-dmips-mhz
+		 * values are the stock 0x17f / 0x400. */
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x000>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <383>;
+		};
+
+		cpu1: cpu@100 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x100>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <383>;
+		};
+
+		cpu2: cpu@200 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x200>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <383>;
+		};
+
+		cpu3: cpu@300 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x300>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <383>;
+		};
+
+		cpu4: cpu@400 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x400>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <383>;
+		};
+
+		cpu5: cpu@500 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x500>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <383>;
+		};
+
+		cpu6: cpu@600 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x600>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+		};
+
+		cpu7: cpu@700 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x700>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+		};
+
+		cpu-map {
+			cluster0 {
+				core0 { cpu = <&cpu0>; };
+				core1 { cpu = <&cpu1>; };
+				core2 { cpu = <&cpu2>; };
+				core3 { cpu = <&cpu3>; };
+				core4 { cpu = <&cpu4>; };
+				core5 { cpu = <&cpu5>; };
+			};
+
+			cluster1 {
+				core0 { cpu = <&cpu6>; };
+				core1 { cpu = <&cpu7>; };
+			};
+		};
+	};
+
+	psci {
+		compatible = "arm,psci-1.0", "arm,psci-0.2";
+		method = "smc";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
+		/* LK leaves the counter at 13 MHz (verified 2026-11-11). */
+		clock-frequency = <13000000>;
+	};
+
+	soc: soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		gic: interrupt-controller@c000000 {
+			compatible = "arm,gic-v3";
+			#interrupt-cells = <3>;
+			#address-cells = <2>;
+			#size-cells = <2>;
+			interrupt-controller;
+			reg = <0x00 0x0c000000 0x00 0x00040000>, /* GICD */
+			      <0x00 0x0c040000 0x00 0x00200000>; /* GICR */
+			interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;
+		};
+
+		topckgen: clock-controller@10000000 {
+			compatible = "mediatek,mt6789-topckgen", "syscon";
+			reg = <0x00 0x10000000 0x00 0x1000>;
+			#clock-cells = <1>;
+		};
+
+		infracfg_ao: clock-controller@10001000 {
+			compatible = "mediatek,mt6789-infracfg_ao", "syscon";
+			reg = <0x00 0x10001000 0x00 0x1000>;
+			#clock-cells = <1>;
+		};
+
+		apmixedsys: clock-controller@1000c000 {
+			compatible = "mediatek,mt6789-apmixedsys", "syscon";
+			reg = <0x00 0x1000c000 0x00 0x1000>;
+			#clock-cells = <1>;
+		};
+
+		watchdog: watchdog@10007000 {
+			compatible = "mediatek,mt6789-wdt", "mediatek,mt6589-wdt";
+			reg = <0x00 0x10007000 0x00 0x100>;
+			#reset-cells = <1>;
+		};
+
+		/* UART0: 0x11002000 / SPI 141 (stock 0x8d), MT6577-compatible.
+		 * Baud clock = topckgen uart mux output; bus clock = infra_ao
+		 * gate bit 22 (IFRAO0). The 921600 bring-up console used
+		 * through boots 1-24. */
+		uart0: serial@11002000 {
+			compatible = "mediatek,mt6577-uart";
+			reg = <0x00 0x11002000 0x00 0x1000>;
+			interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&topckgen CLK_TOP_UART>, <&infracfg_ao CLK_IFRAO_UART0>;
+			clock-names = "baud", "bus";
+			status = "disabled";
+		};
+	};
+};
-- 
