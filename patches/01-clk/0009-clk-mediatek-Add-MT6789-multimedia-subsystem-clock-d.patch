+
+static const struct mtk_clk_desc cam_ra_desc = {
+	.clks = cam_ra_clks,
+	.num_clks = ARRAY_SIZE(cam_ra_clks),
+};
+
+static const struct mtk_clk_desc cam_rb_desc = {
