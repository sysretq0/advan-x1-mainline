From 1cb6ae243e07a37c4d54096dcfc7067613214c0a Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Tue, 24 Nov 2026 09:52:00 +0000
Subject: [PATCH] clk: mediatek: Add MT6789 MFGCFG clock driver

Add the MediaTek MT6789 MFGCFG (0x13fbf000) clock gate driver providing
CLK_MFGCFG_BG3D for the Mali-G57 MC2 GPU.

When the MFG1 power domain cycles off during GPU runtime suspend, the
MFG_TOP_CONFIG registers hardware-reset to gated state (MFG_CG_CON[0]=1)
and default external CG/AXI bridge configuration. Ungating BG3D and
re-applying the MT6789 external CG / AXI bridge settings on every clock
enable (driven by Panfrost GPU_PM_RT runtime PM while MFG1 is powered on)
restores the GPU clock path before Panfrost issues GPU_CMD_SOFT_RESET.

Guard MFG_CG_CON hardware readback in is_enabled() with a spinlock and
active-state flag so clk_disable_unused and clk_summary verify real
hardware gate state while MFG1 is active without touching MFG_TOP_CONFIG
MMIO while MFG1 is powered off.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/clk/mediatek/Makefile            |   2 +-
 drivers/clk/mediatek/clk-mt6789-mfgcfg.c | 188 +++++++++++++++++++++++
 2 files changed, 189 insertions(+), 1 deletion(-)
 create mode 100644 drivers/clk/mediatek/clk-mt6789-mfgcfg.c

diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 0290929dd..ade9dcb6b 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -25,7 +25,7 @@ obj-$(CONFIG_COMMON_CLK_MT6779_MFGCFG) += clk-mt6779-mfg.o
 obj-$(CONFIG_COMMON_CLK_MT6779_AUDSYS) += clk-mt6779-aud.o
 obj-$(CONFIG_COMMON_CLK_MT6789) += clk-mt6789-apmixedsys.o clk-mt6789-topckgen.o \
 				   clk-mt6789-infra_ao.o clk-mt6789-imp_iic_wrap.o \
-				   clk-mt6789-mm.o
+				   clk-mt6789-mm.o clk-mt6789-mfgcfg.o
 obj-$(CONFIG_COMMON_CLK_MT6795) += clk-mt6795-apmixedsys.o clk-mt6795-infracfg.o \
 				   clk-mt6795-pericfg.o clk-mt6795-topckgen.o
 obj-$(CONFIG_COMMON_CLK_MT6795_MFGCFG) += clk-mt6795-mfg.o
diff --git a/drivers/clk/mediatek/clk-mt6789-mfgcfg.c b/drivers/clk/mediatek/clk-mt6789-mfgcfg.c
new file mode 100644
index 000000000..ce0326303
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6789-mfgcfg.c
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2022 MediaTek Inc.
+ * Copyright (c) 2026 sysretq0
+ *
+ * MediaTek MT6789 MFGCFG (GPU top config) clock gate driver.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#include <dt-bindings/clock/mt6789-clk.h>
+
+#define MFG_CG_CON			0x00
+#define MFG_CG_SET			0x04
+#define MFG_CG_CLR			0x08
+#define MFG_CG_BG3D_BIT			BIT(0)
+
+#define MFG_ASYNC_CON			0x20
+#define MFG_ASYNC_CON_CG_MASK		(BIT(22) | BIT(23) | BIT(24) | BIT(25))
+#define MFG_ASYNC_CON_1			0x24
+#define MFG_ASYNC_CON_1_FAXI_EN		BIT(0)
+#define MFG_GLOBAL_CON			0xb0
+#define MFG_GLOBAL_CON_FREE_RUN_CLR	(BIT(8) | BIT(9) | BIT(10))
+#define MFG_GLOBAL_CON_PWR_CG_FREE_RUN	BIT(19)
+#define MFG_QCHANNEL_CON		0xb4
+#define MFG_QCHANNEL_ENABLE		BIT(4)
+#define MFG_I2M_PROTECTOR_CFG_00	0xf60
+#define MFG_I2M_GPM_ENABLE		BIT(0)
+
+/*
+ * Note: this driver intentionally does not use mtk_clk_simple_probe() or
+ * clk-core runtime PM (power-domains on mfgcfg):
+ *  1) MFG1 power-off resets MFG_TOP_CONFIG, so enable() must re-apply the
+ *     five external CG / AXI bridge registers in addition to clearing CG_CON.
+ *  2) Panfrost calls clk_prepare() once at probe and keeps the clock prepared
+ *     across runtime suspend; enabling clk-core RPM would pin MFG1 ON forever.
+ *  3) is_enabled() reads hardware MFG_CG_CON only while enabled (MFG1 active),
+ *     avoiding unclocked AXI hangs during clk_summary / clk_disable_unused.
+ */
+struct mt6789_mfgcfg_clk {
+	struct clk_hw hw;
+	void __iomem *base;
+	spinlock_t lock;
+	bool enabled;
+};
+
+static inline struct mt6789_mfgcfg_clk *to_mt6789_mfgcfg(struct clk_hw *hw)
+{
+	return container_of(hw, struct mt6789_mfgcfg_clk, hw);
+}
+
+static void mt6789_mfgcfg_external_cg_init(void __iomem *base)
+{
+	u32 val;
+
+	val = readl(base + MFG_ASYNC_CON);
+	val |= MFG_ASYNC_CON_CG_MASK;
+	writel(val, base + MFG_ASYNC_CON);
+
+	val = readl(base + MFG_GLOBAL_CON);
+	val &= ~MFG_GLOBAL_CON_FREE_RUN_CLR;
+	val |= MFG_GLOBAL_CON_PWR_CG_FREE_RUN;
+	writel(val, base + MFG_GLOBAL_CON);
+
+	val = readl(base + MFG_QCHANNEL_CON);
+	val |= MFG_QCHANNEL_ENABLE;
+	writel(val, base + MFG_QCHANNEL_CON);
+
+	val = readl(base + MFG_ASYNC_CON_1);
+	val |= MFG_ASYNC_CON_1_FAXI_EN;
+	writel(val, base + MFG_ASYNC_CON_1);
+
+	val = readl(base + MFG_I2M_PROTECTOR_CFG_00);
+	val |= MFG_I2M_GPM_ENABLE;
+	writel(val, base + MFG_I2M_PROTECTOR_CFG_00);
+}
+
+static int mt6789_mfgcfg_enable(struct clk_hw *hw)
+{
+	struct mt6789_mfgcfg_clk *mfg = to_mt6789_mfgcfg(hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&mfg->lock, flags);
+	writel(MFG_CG_BG3D_BIT, mfg->base + MFG_CG_CLR);
+	mt6789_mfgcfg_external_cg_init(mfg->base);
+	mfg->enabled = true;
+	spin_unlock_irqrestore(&mfg->lock, flags);
+
+	return 0;
+}
+
+static void mt6789_mfgcfg_disable(struct clk_hw *hw)
+{
+	struct mt6789_mfgcfg_clk *mfg = to_mt6789_mfgcfg(hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&mfg->lock, flags);
+	mfg->enabled = false;
+	writel(MFG_CG_BG3D_BIT, mfg->base + MFG_CG_SET);
+	spin_unlock_irqrestore(&mfg->lock, flags);
+}
+
+static int mt6789_mfgcfg_is_enabled(struct clk_hw *hw)
+{
+	struct mt6789_mfgcfg_clk *mfg = to_mt6789_mfgcfg(hw);
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&mfg->lock, flags);
+	if (mfg->enabled)
+		ret = !(readl(mfg->base + MFG_CG_CON) & MFG_CG_BG3D_BIT);
+	spin_unlock_irqrestore(&mfg->lock, flags);
+
+	return ret;
+}
+
+static const struct clk_ops mt6789_mfgcfg_ops = {
+	.enable = mt6789_mfgcfg_enable,
+	.disable = mt6789_mfgcfg_disable,
+	.is_enabled = mt6789_mfgcfg_is_enabled,
+};
+
+static const struct clk_parent_data mt6789_mfgcfg_parent = {
+	.name = "mfg_pll_sel",
+};
+
+static int clk_mt6789_mfgcfg_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *clk_data;
+	struct mt6789_mfgcfg_clk *mfg;
+	struct clk_init_data init = {
+		.name = "mfgcfg_bg3d",
+		.ops = &mt6789_mfgcfg_ops,
+		.parent_data = &mt6789_mfgcfg_parent,
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	};
+	int ret;
+
+	mfg = devm_kzalloc(dev, sizeof(*mfg), GFP_KERNEL);
+	if (!mfg)
+		return -ENOMEM;
+
+	spin_lock_init(&mfg->lock);
+
+	mfg->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(mfg->base))
+		return PTR_ERR(mfg->base);
+
+	mfg->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &mfg->hw);
+	if (ret)
+		return ret;
+
+	clk_data = devm_kzalloc(dev,
+				struct_size(clk_data, hws, CLK_MFGCFG_NR_CLK),
+				GFP_KERNEL);
+	if (!clk_data)
+		return -ENOMEM;
+
+	clk_data->num = CLK_MFGCFG_NR_CLK;
+	clk_data->hws[CLK_MFGCFG_BG3D] = &mfg->hw;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clk_data);
+}
+
+static const struct of_device_id of_match_clk_mt6789_mfgcfg[] = {
+	{ .compatible = "mediatek,mt6789-mfgcfg" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6789_mfgcfg);
+
+static struct platform_driver clk_mt6789_mfgcfg_drv = {
+	.probe = clk_mt6789_mfgcfg_probe,
+	.driver = {
+		.name = "clk-mt6789-mfgcfg",
+		.of_match_table = of_match_clk_mt6789_mfgcfg,
+	},
+};
+module_platform_driver(clk_mt6789_mfgcfg_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6789 GPU MFGCFG clock driver");
+MODULE_LICENSE("GPL");
-- 
2.55.0

