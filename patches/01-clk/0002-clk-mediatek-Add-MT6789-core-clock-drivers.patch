From 499bfe6b0aaab6827b28943aeb46851fc0210d64 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:28 +0000
Subject: [PATCH 2/4] clk: mediatek: Add MT6789 core clock drivers

Add clock drivers for the MediaTek MT6789 apmixedsys PLLs, topckgen
muxes and dividers, and infracfg_ao peripheral clock gates and resets.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/clk/mediatek/Kconfig                 |  11 +
 drivers/clk/mediatek/Makefile                |   2 +
 drivers/clk/mediatek/clk-mt6789-apmixedsys.c | 153 ++++
 drivers/clk/mediatek/clk-mt6789-infra_ao.c   | 251 ++++++
 drivers/clk/mediatek/clk-mt6789-topckgen.c   | 768 +++++++++++++++++++
 5 files changed, 1185 insertions(+)
 create mode 100644 drivers/clk/mediatek/clk-mt6789-apmixedsys.c
 create mode 100644 drivers/clk/mediatek/clk-mt6789-infra_ao.c
 create mode 100644 drivers/clk/mediatek/clk-mt6789-topckgen.c

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index ba1ca9c90..eec64ac59 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -303,6 +303,17 @@ config COMMON_CLK_MT6779_AUDSYS
 	help
 	  This driver supports Mediatek MT6779 audsys clocks.
 
+config COMMON_CLK_MT6789
+	tristate "Clock driver for MediaTek MT6789"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	select COMMON_CLK_MEDIATEK
+	default ARCH_MEDIATEK
+	help
+	  This driver supports MediaTek MT6789 basic clocks, including
+	  apmixedsys PLLs, topckgen muxes and dividers, infracfg_ao
+	  clock gates and resets, IMP I2C wrappers, and MMSYS display
+	  subsystem gates.
+
 config COMMON_CLK_MT6795
 	tristate "Clock driver for MediaTek MT6795"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
