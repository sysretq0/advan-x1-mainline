From 2323232323232323232323232323232323232323 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sat, 21 Nov 2026 04:00:00 +0000
Subject: [PATCH 23/23] drm/panel: Add Chipone ICNL9922C MIPI-DSI panel driver

Add support for the Chipone ICNL9922C based 1080x2460 MIPI-DSI LCD panel
(BOE 6.78\" panel found on the Advan X1).

The panel operates in 4-lane video mode with 60Hz (preferred), 90Hz,
and 120Hz modes. It requires 1.8V logic LDO control, dual ±5.5V bias
regulators (VSP/VSN), and active-low reset sequencing followed by a
manufacturer initialization command sequence.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---

diff --git a/Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml b/Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml
new file mode 100644
index 000000000..6b7efc2bc
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/chipone,icnl9922c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Chipone ICNL9922C 1080x2460 MIPI-DSI LCD Panel
+
+maintainers:
+  - sysretq0 <324514544+sysretq0@users.noreply.github.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: chipone,icnl9922c
+
+  reg:
+    maxItems: 1
+    description: DSI virtual channel
+
+  vsp-supply:
+    description: Positive 5.5V bias supply
+
+  vsn-supply:
+    description: Negative 5.5V bias supply
+
+  ldo18-gpios:
+    maxItems: 1
+    description: GPIO to enable 1.8V LDO logic supply
+
+  reset-gpios:
+    maxItems: 1
+
+  backlight: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "chipone,icnl9922c";
+            reg = <0>;
+
+            reset-gpios = <&pio 85 GPIO_ACTIVE_LOW>;
+            ldo18-gpios = <&pio 150 GPIO_ACTIVE_HIGH>;
+            vsp-supply = <&outp>;
+            vsn-supply = <&outn>;
+            backlight = <&backlight_lcd>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+...
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 7a520b4d6..0ba94c1a4 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -56,6 +56,16 @@ config DRM_PANEL_AUO_A030JTN01
 	  Say Y here to enable support for the AUO A030JTN01 320x480 3.0" panel
 	  as found in the YLM RS-97 handheld gaming console.
 
+config DRM_PANEL_CHIPONE_ICNL9922C
+	tristate "Chipone ICNL9922C DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for Chipone ICNL9922C
+	  based MIPI-DSI panels, such as the BOE 6.78" 1080x2460 panel
+	  found on the Advan X1.
+
 config DRM_PANEL_BOE_BF060Y8M_AJ0
 	tristate "Boe BF060Y8M-AJ0 panel"
 	depends on OF
