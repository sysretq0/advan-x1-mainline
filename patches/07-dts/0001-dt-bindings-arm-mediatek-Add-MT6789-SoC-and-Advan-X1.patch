From 62e715edb153b45ebf928a8f1c8916f81f3a30d9 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:58 +0000
Subject: [PATCH 1/3] dt-bindings: arm: mediatek: Add MT6789 SoC and Advan X1

Add the advan vendor prefix and document the advan,x1 board compatible
for MediaTek MT6789.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 Documentation/devicetree/bindings/arm/mediatek.yaml    | 4 ++++
 Documentation/devicetree/bindings/vendor-prefixes.yaml | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/mediatek.yaml b/Documentation/devicetree/bindings/arm/mediatek.yaml
index 180e6e494..f471c6a06 100644
--- a/Documentation/devicetree/bindings/arm/mediatek.yaml
+++ b/Documentation/devicetree/bindings/arm/mediatek.yaml
@@ -62,6 +62,10 @@ properties:
           - enum:
               - mediatek,mt6779-evb
           - const: mediatek,mt6779
+      - items:
+          - enum:
+              - advan,x1
+          - const: mediatek,mt6789
       - items:
           - enum:
               - mediatek,mt6795-evb
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index 5471a06f9..8bea0e9dc 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -70,6 +70,8 @@ patternProperties:
     description: ADI Engineering, Inc.
   "^admatec,.*":
     description: admatec GmbH
+  "^advan,.*":
+    description: PT. Bangga Teknologi Indonesia (Advan)
   "^advantech,.*":
     description: Advantech Corporation
   "^aeroflexgaisler,.*":
