From 2424242424242424242424242424242424242424 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sat, 21 Nov 2026 11:10:00 +0000
Subject: [PATCH 24/24] drm/mediatek: Add hardware DSC 1.1 support for MT6789

The Advan X1 BOE 6.78" 1080x2460 ICNL9922C panel requires VESA DSC 1.1
3:1 compression (8 bpp, 2 slices/line, 540x20 slices) on both LK and
stock Android; without DSC, all modes (~336.9 MHz pixel clock) exceed
the 1.5 Gbps/lane D-PHY limit at 24 bpp and are pruned by mode_valid.

Wire struct drm_dsc_config from the attached mipi_dsi_device through
mtk_crtc into mtk_ddp_comp's DISP_DSC block, programming MT6789's
disp_dsc_wrap0 encoder registers (including OBUF workaround 0x800002d9
for widths < 1440 and PPS0..PPS19) instead of bypass mode when DSC is
requested. Update mtk_dsi to support COMPRESSED_PIXEL_STREAM (DSI_PS_SEL
= 5), compressed DSI_SIZE_CON/VDO timing, panel hs_rate override, and
MT6789 CMDQ_SIZE_SEL for long DCS packets.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/mediatek/mtk_crtc.c b/drivers/gpu/drm/mediatek/mtk_crtc.c
index 1941222a9..5349a8bbc 100644
--- a/drivers/gpu/drm/mediatek/mtk_crtc.c
+++ b/drivers/gpu/drm/mediatek/mtk_crtc.c
@@ -343,6 +343,7 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 	struct drm_encoder *encoder;
 	struct drm_connector_list_iter conn_iter;
 	struct drm_device *dev = mtk_crtc->base.dev;
+	const struct drm_dsc_config *dsc = NULL;
 	unsigned int width, height, vrefresh, bpc = MTK_MAX_BPC;
 	int ret;
 	int i;
@@ -401,9 +402,18 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 		mtk_mutex_add_comp(mtk_crtc->mutex, mtk_crtc->ddp_comp[i]->id);
 	mtk_mutex_enable(mtk_crtc->mutex);
 
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+		dsc = mtk_ddp_comp_get_dsc(mtk_crtc->ddp_comp[i]);
+		if (dsc)
+			break;
+	}
+
 	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
 		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
 
+		if (dsc)
+			mtk_ddp_comp_set_dsc(comp, dsc);
+
 		if (i == 1)
 			mtk_ddp_comp_bgclr_in_on(comp);
 
diff --git a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
index 282614507..83eeaf8a5 100644
--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
@@ -12,6 +12,7 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/soc/mediatek/mtk-cmdq.h>
+#include <drm/display/drm_dsc.h>
 #include <drm/drm_print.h>
 
 #include "mtk_crtc.h"
@@ -45,6 +46,36 @@
 #define DSC_DUAL_INOUT				BIT(2)
 #define DSC_BYPASS				BIT(4)
 #define DSC_UFOE_SEL				BIT(16)
+#define DISP_REG_DSC_SPR			0x0014
+#define DISP_REG_DSC_PIC_W			0x0018
+#define DISP_REG_DSC_PIC_H			0x001c
+#define DISP_REG_DSC_SLICE_W			0x0020
+#define DISP_REG_DSC_SLICE_H			0x0024
+#define DISP_REG_DSC_CHUNK_SIZE			0x0028
+#define DISP_REG_DSC_BUF_SIZE			0x002c
+#define DISP_REG_DSC_MODE			0x0030
+#define DISP_REG_DSC_CFG			0x0034
+#define DISP_REG_DSC_PAD			0x0038
+#define DISP_REG_DSC_ENC_WIDTH			0x003c
+#define DISP_REG_DSC_DBG_CON			0x0060
+#define DSC_CKSM_CAL_EN				BIT(9)
+#define DISP_REG_DSC_OBUF			0x0070
+#define DSC_OBUF_SW_VAL				0x800002d9
+#define DISP_REG_DSC_PPS0			0x0080
+#define DISP_REG_DSC_PPS1			0x0084
+#define DISP_REG_DSC_PPS2			0x0088
+#define DISP_REG_DSC_PPS3			0x008c
+#define DISP_REG_DSC_PPS4			0x0090
+#define DISP_REG_DSC_PPS5			0x0094
+#define DISP_REG_DSC_PPS6			0x0098
+#define DISP_REG_DSC_PPS7			0x009c
+#define DISP_REG_DSC_PPS8			0x00a0
+#define DISP_REG_DSC_PPS9			0x00a4
+#define DISP_REG_DSC_PPS10			0x00a8
+#define DISP_REG_DSC_PPS11			0x00ac
+#define DISP_REG_DSC_PPS12			0x00b0
+#define DISP_REG_DSC_SHADOW			0x0200
+#define DSC_FORCE_COMMIT			BIT(0)
 
 #define DISP_REG_OD_EN				0x0000
 #define DISP_REG_OD_CFG				0x0020
@@ -64,6 +95,8 @@ struct mtk_ddp_comp_dev {
 	struct clk *clk;
 	void __iomem *regs;
 	struct cmdq_client_reg cmdq_reg;
+	const struct drm_dsc_config *dsc;
+	bool need_obuf_sw;
 };
 
 void mtk_ddp_write(struct cmdq_pkt *cmdq_pkt, unsigned int value,
@@ -187,25 +220,179 @@ static void mtk_dither_set(struct device *dev, unsigned int bpc,
 			      DISP_DITHERING, cmdq_pkt);
 }
 
+static void mtk_dsc_set_dsc(struct device *dev, const struct drm_dsc_config *dsc)
+{
+	struct mtk_ddp_comp_dev *priv = dev_get_drvdata(dev);
+
+	priv->dsc = dsc;
+}
+
+static u32 mtk_dsc_pack_rc_range(const struct drm_dsc_rc_range_parameters *p)
+{
+	return ((u32)(p->range_bpg_offset & 0x3f) << 10) |
+	       ((u32)(p->range_max_qp & 0x1f) << 5) |
+	       (u32)(p->range_min_qp & 0x1f);
+}
+
 static void mtk_dsc_config(struct device *dev, unsigned int w,
 			   unsigned int h, unsigned int vrefresh,
 			   unsigned int bpc, struct cmdq_pkt *cmdq_pkt)
 {
 	struct mtk_ddp_comp_dev *priv = dev_get_drvdata(dev);
+	const struct drm_dsc_config *dsc = priv->dsc;
+	unsigned int slice_count, slice_width, slice_height;
+	unsigned int pic_width, pic_group_width, slice_group_width;
+	unsigned int pic_height_ext_num, chunk_size, pad_num;
+	u32 dsc_con, reg_val;
+	int i;
+
+	if (!dsc) {
+		/* dsc bypass mode */
+		mtk_ddp_write_mask(cmdq_pkt, DSC_BYPASS, &priv->cmdq_reg, priv->regs,
+				   DISP_REG_DSC_CON, DSC_BYPASS);
+		mtk_ddp_write_mask(cmdq_pkt, DSC_UFOE_SEL, &priv->cmdq_reg, priv->regs,
+				   DISP_REG_DSC_CON, DSC_UFOE_SEL);
+		mtk_ddp_write_mask(cmdq_pkt, DSC_DUAL_INOUT, &priv->cmdq_reg, priv->regs,
+				   DISP_REG_DSC_CON, DSC_DUAL_INOUT);
+		return;
+	}
 
-	/* dsc bypass mode */
-	mtk_ddp_write_mask(cmdq_pkt, DSC_BYPASS, &priv->cmdq_reg, priv->regs,
-			   DISP_REG_DSC_CON, DSC_BYPASS);
-	mtk_ddp_write_mask(cmdq_pkt, DSC_UFOE_SEL, &priv->cmdq_reg, priv->regs,
-			   DISP_REG_DSC_CON, DSC_UFOE_SEL);
-	mtk_ddp_write_mask(cmdq_pkt, DSC_DUAL_INOUT, &priv->cmdq_reg, priv->regs,
-			   DISP_REG_DSC_CON, DSC_DUAL_INOUT);
+	slice_count = dsc->slice_count ? dsc->slice_count : 1;
+	slice_width = dsc->slice_width;
+	slice_height = dsc->slice_height;
+	pic_width = slice_width * slice_count;
+	pic_group_width = (pic_width + 2) / 3;
+	slice_group_width = (slice_width + 2) / 3;
+	pic_height_ext_num = DIV_ROUND_UP(h, slice_height);
+	chunk_size = dsc->slice_chunk_size ? dsc->slice_chunk_size :
+		     DIV_ROUND_UP(slice_width * dsc->bits_per_pixel, 16 * 8);
+	pad_num = DIV_ROUND_UP(chunk_size * slice_count, 3) * 3 -
+		  chunk_size * slice_count;
+
+	mtk_ddp_write_relaxed(cmdq_pkt, 0x0, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_SPR);
+
+	if (priv->need_obuf_sw && pic_width < 1440)
+		mtk_ddp_write_relaxed(cmdq_pkt, DSC_OBUF_SW_VAL, &priv->cmdq_reg,
+				      priv->regs, DISP_REG_DSC_OBUF);
+
+	mtk_ddp_write_relaxed(cmdq_pkt, (pic_width << 16) | slice_width,
+			      &priv->cmdq_reg, priv->regs, DISP_REG_DSC_ENC_WIDTH);
+
+	dsc_con = (dsc->dsc_version_minor == 2) ? 0x4080 : 0x0080;
+	dsc_con |= DSC_UFOE_SEL;
+	mtk_ddp_write_relaxed(cmdq_pkt, dsc_con, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_CON);
+
+	mtk_ddp_write_relaxed(cmdq_pkt, ((pic_group_width - 1) << 16) | pic_width,
+			      &priv->cmdq_reg, priv->regs, DISP_REG_DSC_PIC_W);
+	mtk_ddp_write_relaxed(cmdq_pkt,
+			      ((pic_height_ext_num * slice_height - 1) << 16) | (h - 1),
+			      &priv->cmdq_reg, priv->regs, DISP_REG_DSC_PIC_H);
+	mtk_ddp_write_relaxed(cmdq_pkt, ((slice_group_width - 1) << 16) | slice_width,
+			      &priv->cmdq_reg, priv->regs, DISP_REG_DSC_SLICE_W);
+	mtk_ddp_write_relaxed(cmdq_pkt,
+			      ((slice_width % 3) << 30) |
+			      ((pic_height_ext_num - 1) << 16) |
+			      (slice_height - 1),
+			      &priv->cmdq_reg, priv->regs, DISP_REG_DSC_SLICE_H);
+	mtk_ddp_write_relaxed(cmdq_pkt, chunk_size, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_CHUNK_SIZE);
+	mtk_ddp_write_relaxed(cmdq_pkt, pad_num, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PAD);
+	mtk_ddp_write_relaxed(cmdq_pkt, chunk_size * slice_height, &priv->cmdq_reg,
+			      priv->regs, DISP_REG_DSC_BUF_SIZE);
+
+	/* Video mode: init_delay_height = 1, slice_mode = (slice_count > 1) */
+	reg_val = (slice_count > 1 ? 1 : 0) | (1 << 8);
+	mtk_ddp_write_mask(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			   DISP_REG_DSC_MODE, 0xffff);
+	mtk_ddp_write_relaxed(cmdq_pkt, 0x22, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_CFG);
+	mtk_ddp_write_mask(cmdq_pkt, DSC_CKSM_CAL_EN, &priv->cmdq_reg, priv->regs,
+			   DISP_REG_DSC_DBG_CON, DSC_CKSM_CAL_EN);
+	mtk_ddp_write_mask(cmdq_pkt, (dsc->dsc_version_minor == 2) ? 0x40 : 0x20,
+			   &priv->cmdq_reg, priv->regs, DISP_REG_DSC_SHADOW, 0x60);
+
+	reg_val = dsc->line_buf_depth |
+		  (dsc->bits_per_component << 4) |
+		  (dsc->bits_per_pixel << 8) |
+		  (dsc->convert_rgb ? BIT(18) : 0) |
+		  (dsc->block_pred_enable ? BIT(19) : 0);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS0);
+
+	reg_val = dsc->initial_xmit_delay | (dsc->initial_dec_delay << 16);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS1);
+
+	reg_val = dsc->initial_scale_value | (dsc->scale_increment_interval << 16);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS2);
+
+	reg_val = dsc->scale_decrement_interval | (dsc->first_line_bpg_offset << 16);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS3);
+
+	reg_val = dsc->nfl_bpg_offset | (dsc->slice_bpg_offset << 16);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS4);
+
+	reg_val = dsc->initial_offset | (dsc->final_offset << 16);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS5);
+
+	reg_val = dsc->flatness_min_qp | (dsc->flatness_max_qp << 8) |
+		  (dsc->rc_model_size << 16);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS6);
+
+	reg_val = dsc->rc_edge_factor | (dsc->rc_quant_incr_limit0 << 8) |
+		  (dsc->rc_quant_incr_limit1 << 16) |
+		  (dsc->rc_tgt_offset_high << 24) |
+		  (dsc->rc_tgt_offset_low << 28);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS7);
+
+	reg_val = (dsc->rc_buf_thresh[3] << 24) | (dsc->rc_buf_thresh[2] << 16) |
+		  (dsc->rc_buf_thresh[1] << 8) | dsc->rc_buf_thresh[0];
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS8);
+
+	reg_val = (dsc->rc_buf_thresh[7] << 24) | (dsc->rc_buf_thresh[6] << 16) |
+		  (dsc->rc_buf_thresh[5] << 8) | dsc->rc_buf_thresh[4];
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS9);
+
+	reg_val = (dsc->rc_buf_thresh[11] << 24) | (dsc->rc_buf_thresh[10] << 16) |
+		  (dsc->rc_buf_thresh[9] << 8) | dsc->rc_buf_thresh[8];
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS10);
+
+	reg_val = (dsc->rc_buf_thresh[13] << 8) | dsc->rc_buf_thresh[12];
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS11);
+
+	for (i = 0; i < 7; i++) {
+		reg_val = mtk_dsc_pack_rc_range(&dsc->rc_range_params[i * 2]) |
+			  (mtk_dsc_pack_rc_range(&dsc->rc_range_params[i * 2 + 1]) << 16);
+		mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+				      DISP_REG_DSC_PPS12 + i * 4);
+	}
+	reg_val = mtk_dsc_pack_rc_range(&dsc->rc_range_params[14]);
+	mtk_ddp_write_relaxed(cmdq_pkt, reg_val, &priv->cmdq_reg, priv->regs,
+			      DISP_REG_DSC_PPS12 + 7 * 4);
 }
 
 static void mtk_dsc_start(struct device *dev)
 {
 	struct mtk_ddp_comp_dev *priv = dev_get_drvdata(dev);
 
+	if (priv->dsc)
+		mtk_ddp_write_mask(NULL, DSC_FORCE_COMMIT, &priv->cmdq_reg,
+				   priv->regs, DISP_REG_DSC_SHADOW,
+				   DSC_FORCE_COMMIT);
+
 	/* write with mask to reserve the value set in mtk_dsc_config */
 	mtk_ddp_write_mask(NULL, DSC_EN, &priv->cmdq_reg, priv->regs, DISP_REG_DSC_CON, DSC_EN);
 }
@@ -314,12 +501,14 @@ static const struct mtk_ddp_comp_funcs ddp_dsc = {
 	.config = mtk_dsc_config,
 	.start = mtk_dsc_start,
 	.stop = mtk_dsc_stop,
+	.set_dsc = mtk_dsc_set_dsc,
 };
 
 static const struct mtk_ddp_comp_funcs ddp_dsi = {
 	.start = mtk_dsi_ddp_start,
 	.stop = mtk_dsi_ddp_stop,
 	.encoder_index = mtk_dsi_encoder_index,
+	.get_dsc = mtk_dsi_get_dsc,
 };
 
 static const struct mtk_ddp_comp_funcs ddp_gamma = {
@@ -704,6 +893,8 @@ int mtk_ddp_comp_init(struct device *dev, struct device_node *node, struct mtk_d
 		dev_dbg(comp->dev, "get mediatek,gce-client-reg fail!\n");
 #endif
 
+	priv->need_obuf_sw = of_device_is_compatible(node, "mediatek,mt6789-disp-dsc");
+
 	platform_set_drvdata(comp_pdev, priv);
 
 	return 0;
diff --git a/drivers/gpu/drm/mediatek/mtk_ddp_comp.h b/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
index 3f3d43f43..36b9284d5 100644
--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
@@ -18,6 +18,7 @@ struct device;
 struct device_node;
 struct drm_crtc;
 struct drm_device;
+struct drm_dsc_config;
 struct mtk_plane_state;
 struct drm_crtc_state;
 
@@ -90,6 +91,8 @@ struct mtk_ddp_comp_funcs {
 	void (*remove)(struct device *dev, struct mtk_mutex *mutex);
 	unsigned int (*encoder_index)(struct device *dev);
 	enum drm_mode_status (*mode_valid)(struct device *dev, const struct drm_display_mode *mode);
+	const struct drm_dsc_config *(*get_dsc)(struct device *dev);
+	void (*set_dsc)(struct device *dev, const struct drm_dsc_config *dsc);
 };
 
 struct mtk_ddp_comp {
@@ -347,6 +350,20 @@ static inline void mtk_ddp_comp_encoder_index_set(struct mtk_ddp_comp *comp)
 		comp->encoder_index = (int)comp->funcs->encoder_index(comp->dev);
 }
 
+static inline const struct drm_dsc_config *mtk_ddp_comp_get_dsc(struct mtk_ddp_comp *comp)
+{
+	if (comp->funcs && comp->funcs->get_dsc)
+		return comp->funcs->get_dsc(comp->dev);
+	return NULL;
+}
+
+static inline void mtk_ddp_comp_set_dsc(struct mtk_ddp_comp *comp,
+					const struct drm_dsc_config *dsc)
+{
+	if (comp->funcs && comp->funcs->set_dsc)
+		comp->funcs->set_dsc(comp->dev, dsc);
+}
+
 int mtk_ddp_comp_get_id(struct device_node *node,
 			enum mtk_ddp_comp_type comp_type);
 int mtk_find_possible_crtcs(struct drm_device *drm, struct device *dev);
diff --git a/drivers/gpu/drm/mediatek/mtk_disp_drv.h b/drivers/gpu/drm/mediatek/mtk_disp_drv.h
index 679d413bf..9270d823b 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_drv.h
+++ b/drivers/gpu/drm/mediatek/mtk_disp_drv.h
@@ -12,6 +12,8 @@
 #include "mtk_mdp_rdma.h"
 #include "mtk_plane.h"
 
+struct drm_dsc_config;
+
 int mtk_aal_clk_enable(struct device *dev);
 void mtk_aal_clk_disable(struct device *dev);
 void mtk_aal_config(struct device *dev, unsigned int w,
@@ -50,6 +52,7 @@ unsigned int mtk_dpi_encoder_index(struct device *dev);
 void mtk_dsi_ddp_start(struct device *dev);
 void mtk_dsi_ddp_stop(struct device *dev);
 unsigned int mtk_dsi_encoder_index(struct device *dev);
+const struct drm_dsc_config *mtk_dsi_get_dsc(struct device *dev);
 
 int mtk_gamma_clk_enable(struct device *dev);
 void mtk_gamma_clk_disable(struct device *dev);
diff --git a/drivers/gpu/drm/mediatek/mtk_dsi.c b/drivers/gpu/drm/mediatek/mtk_dsi.c
--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -18,6 +18,7 @@
 #include <video/mipi_display.h>
 #include <video/videomode.h>
 
+#include <drm/display/drm_dsc.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_bridge.h>
 #include <drm/drm_bridge_connector.h>
@@ -70,12 +71,13 @@
 #define HSTX_CKLP_EN			BIT(16)
 
 #define DSI_PSCTRL		0x1c
-#define DSI_PS_WC			GENMASK(13, 0)
-#define DSI_PS_SEL			GENMASK(17, 16)
+#define DSI_PS_WC			GENMASK(14, 0)
+#define DSI_PS_SEL			GENMASK(19, 16)
 #define PACKED_PS_16BIT_RGB565		0
 #define PACKED_PS_18BIT_RGB666		1
 #define LOOSELY_PS_24BIT_RGB666		2
 #define PACKED_PS_24BIT_RGB888		3
+#define COMPRESSED_PIXEL_STREAM		5
 
 #define DSI_VSA_NL		0x20
 #define DSI_VBP_NL		0x24
@@ -212,6 +214,8 @@
 	struct clk *hs_clk;
 
 	u32 data_rate;
+	unsigned long hs_rate;
+	const struct drm_dsc_config *dsc;
 
 	unsigned long mode_flags;
 	enum mipi_dsi_pixel_format format;
@@ -397,31 +401,39 @@
 {
 	u32 dsi_buf_bpp, ps_val, ps_wc, vact_nl;
 
-	if (dsi->format == MIPI_DSI_FMT_RGB565)
-		dsi_buf_bpp = 2;
-	else
-		dsi_buf_bpp = 3;
+	if (dsi->dsc) {
+		u32 slice_count = dsi->dsc->slice_count ? dsi->dsc->slice_count : 1;
+		u32 chunk_bytes = dsi->dsc->slice_chunk_size * slice_count;
 
-	/* Word count */
