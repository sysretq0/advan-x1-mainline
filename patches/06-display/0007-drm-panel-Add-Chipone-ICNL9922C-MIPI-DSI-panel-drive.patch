From 7f8b6873cfc7ce8b7001bb2fae0b917c7b909543 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:57 +0000
Subject: [PATCH 7/7] drm/panel: Add Chipone ICNL9922C MIPI-DSI panel driver

Add MIPI-DSI panel driver for the Chipone ICNL9922C 1080x2460 4-lane
VESA DSC 1.1 video-mode LCD panel (60/90/120 Hz) found on the
Advan X1.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/gpu/drm/panel/Kconfig                 |  10 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-chipone-icnl9922c.c   | 565 ++++++++++++++++++
 3 files changed, 576 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-chipone-icnl9922c.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 7a520b4d6..5db2e4041 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -127,6 +127,16 @@ config DRM_PANEL_CHIPONE_ICNA35XX
 	  around the Chipone ICNA3512 and ICNA3520 display controllers,
 	  such as some Tianma panels used in AYN Odin2 Portal and Thor.
 
+config DRM_PANEL_CHIPONE_ICNL9922C
+	tristate "Chipone ICNL9922C DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for Chipone ICNL9922C
+	  based MIPI-DSI panels, such as the BOE 6.78" 1080x2460 panel
+	  found on the Advan X1.
+
 config DRM_PANEL_CHIPWEALTH_CH13726A
 	tristate "CHIPWEALTH CH13726A-based DSI panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index da5175909..dc56bf2cd 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -11,6 +11,7 @@ obj-$(CONFIG_DRM_PANEL_BOE_TH101MB31UIG002_28A) += panel-boe-th101mb31ig002-28a.
 obj-$(CONFIG_DRM_PANEL_BOE_TV101WUM_LL2) += panel-boe-tv101wum-ll2.o
 obj-$(CONFIG_DRM_PANEL_BOE_TV101WUM_NL6) += panel-boe-tv101wum-nl6.o
 obj-$(CONFIG_DRM_PANEL_CHIPONE_ICNA35XX) += panel-chipone-icna35xx.o
+obj-$(CONFIG_DRM_PANEL_CHIPONE_ICNL9922C) += panel-chipone-icnl9922c.o
 obj-$(CONFIG_DRM_PANEL_CHIPWEALTH_CH13726A) += panel-chipwealth-ch13726a.o
