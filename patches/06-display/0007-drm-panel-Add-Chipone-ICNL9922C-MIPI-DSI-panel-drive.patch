+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xc9,
+					 0x62, 0x62, 0x5c, 0x5c, 0x00, 0x00,
+					 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+					 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+					 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+					 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+					 0x00, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xd0,
+					 0x0c, 0x23, 0x18, 0xff, 0xff, 0x00,
+					 0x80, 0x0c, 0xff, 0x0f, 0x40);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x9a,
+				     0x11, 0x7a, 0x00, 0x00, 0xff, 0x00, 0x0a,
+				     0x00, 0x17, 0x00, 0x22);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x99,
+				     0x91, 0xb5, 0x00, 0x3f, 0x00, 0x7a, 0x00,
+				     0x30, 0x22, 0x01);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xe0,
+					 0x0c, 0x00, 0xb0, 0x10, 0x00, 0x15,
+					 0x7c);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xf0, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_TEAR_ON, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x0f, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x2c, 0x00);
+}
+
+static int icnl9922c_prepare(struct drm_panel *panel)
+{
+	struct icnl9922c_panel *ctx = to_icnl9922c_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (ctx->ldo18_gpio) {
+		gpiod_set_value_cansleep(ctx->ldo18_gpio, 1);
+		usleep_range(5000, 10000);
+	}
+
+	if (ctx->vsp) {
+		ret = regulator_enable(ctx->vsp);
+		if (ret) {
+			dev_err(dev, "Failed to enable vsp regulator: %d\n", ret);
+			goto err_vsp;
+		}
+		usleep_range(5000, 10000);
+	}
+
+	if (ctx->vsn) {
+		ret = regulator_enable(ctx->vsn);
+		if (ret) {
+			dev_err(dev, "Failed to enable vsn regulator: %d\n", ret);
+			goto err_vsn;
+		}
+		usleep_range(15000, 20000);
+	}
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(150);
+
+	icnl9922c_init_sequence(&dsi_ctx);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xac, 0x05, 0x00);
+
+	if (dsi_ctx.accum_err) {
+		ret = dsi_ctx.accum_err;
+		goto err_cmds;
+	}
+
+	return 0;
+
+err_cmds:
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	if (ctx->vsn)
+		regulator_disable(ctx->vsn);
+err_vsn:
+	if (ctx->vsp)
+		regulator_disable(ctx->vsp);
+err_vsp:
+	if (ctx->ldo18_gpio)
+		gpiod_set_value_cansleep(ctx->ldo18_gpio, 0);
+	return ret;
+}
+
+static int icnl9922c_unprepare(struct drm_panel *panel)
+{
+	struct icnl9922c_panel *ctx = to_icnl9922c_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+
+	if (ctx->vsn) {
+		regulator_disable(ctx->vsn);
+		usleep_range(5000, 10000);
+	}
+
+	if (ctx->vsp) {
+		regulator_disable(ctx->vsp);
+		usleep_range(5000, 10000);
+	}
+
+	if (ctx->ldo18_gpio)
+		gpiod_set_value_cansleep(ctx->ldo18_gpio, 0);
+
+	return dsi_ctx.accum_err;
+}
+
+static int icnl9922c_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(icnl9922c_modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, &icnl9922c_modes[i]);
+		if (!mode)
+			return -ENOMEM;
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = 70;
+	connector->display_info.height_mm = 160;
+	connector->display_info.bpc = 8;
+
+	return ARRAY_SIZE(icnl9922c_modes);
+}
+
+static const struct drm_panel_funcs icnl9922c_panel_funcs = {
+	.prepare = icnl9922c_prepare,
+	.unprepare = icnl9922c_unprepare,
+	.get_modes = icnl9922c_get_modes,
+};
+
+static int icnl9922c_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct icnl9922c_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct icnl9922c_panel, panel,
+				   &icnl9922c_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->vsp = devm_regulator_get_optional(dev, "vsp");
+	if (IS_ERR(ctx->vsp)) {
+		if (PTR_ERR(ctx->vsp) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(ctx->vsp),
+					     "Failed to get vsp regulator\n");
+		ctx->vsp = NULL;
+	}
+
+	ctx->vsn = devm_regulator_get_optional(dev, "vsn");
+	if (IS_ERR(ctx->vsn)) {
+		if (PTR_ERR(ctx->vsn) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(ctx->vsn),
+					     "Failed to get vsn regulator\n");
+		ctx->vsn = NULL;
+	}
+
+	ctx->ldo18_gpio = devm_gpiod_get_optional(dev, "ldo18", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->ldo18_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->ldo18_gpio),
+				     "Failed to get ldo18-gpios\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	ctx->panel.prepare_prev_first = true;
+
+	drm_panel_add(&ctx->panel);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+	dsi->hs_rate = 852000000;
+	dsi->dsc = &icnl9922c_dsc;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach DSI device: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void icnl9922c_remove(struct mipi_dsi_device *dsi)
+{
+	struct icnl9922c_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(ctx->dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id icnl9922c_of_match[] = {
+	{ .compatible = "chipone,icnl9922c" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, icnl9922c_of_match);
+
+static struct mipi_dsi_driver icnl9922c_driver = {
+	.probe = icnl9922c_probe,
+	.remove = icnl9922c_remove,
+	.driver = {
+		.name = "panel-chipone-icnl9922c",
+		.of_match_table = icnl9922c_of_match,
+	},
+};
+module_mipi_dsi_driver(icnl9922c_driver);
