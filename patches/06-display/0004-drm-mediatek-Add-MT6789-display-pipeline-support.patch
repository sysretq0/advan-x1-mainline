 drivers/gpu/drm/mediatek/mtk_disp_rdma.c  | 33 ++++++++++++++++++++++-
 drivers/gpu/drm/mediatek/mtk_drm_drv.c    | 45 +++++++++++++++++++++++++++++++
 7 files changed, 108 insertions(+), 3 deletions(-)

