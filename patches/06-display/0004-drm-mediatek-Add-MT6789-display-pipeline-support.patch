@@ -50,6 +51,9 @@
 #define RDMA_FIFO_PSEUDO_SIZE(bytes)			(((bytes) / 16) << 16)
 #define RDMA_OUTPUT_VALID_FIFO_THRESHOLD(bytes)		((bytes) / 16)
 #define RDMA_FIFO_SIZE(rdma)			((rdma)->data->fifo_size)
+#define DISP_REG_RDMA_SHADOW_UPDATE		0x00bc
+#define RDMA_BYPASS_SHADOW				BIT(1)
+#define RDMA_READ_WORK_REG				BIT(2)
 #define DISP_RDMA_MEM_START_ADDR		0x0f00
 
 #define RDMA_MEM_GMC				0x40402020
@@ -72,6 +76,8 @@ struct mtk_disp_rdma_data {
 	unsigned int fifo_size;
 	const u32 *formats;
 	size_t num_formats;
+	bool bypass_shadow;
+	bool zero_fifo_threshold;
 };
 
 /*
@@ -190,6 +196,20 @@ void mtk_rdma_config(struct device *dev, unsigned int width,
 	struct mtk_disp_rdma *rdma = dev_get_drvdata(dev);
 	u32 rdma_fifo_size;
 
+	if (rdma->data->bypass_shadow) {
+		if (!cmdq_pkt &&
+		    (readl(rdma->regs + DISP_REG_RDMA_GLOBAL_CON) & RDMA_ENGINE_EN)) {
+			writel(0x0, rdma->regs + DISP_REG_RDMA_INT_ENABLE);
+			writel(RDMA_SOFT_RESET, rdma->regs + DISP_REG_RDMA_GLOBAL_CON);
+			writel(0x0, rdma->regs + DISP_REG_RDMA_GLOBAL_CON);
+			writel(0x0, rdma->regs + DISP_REG_RDMA_INT_STATUS);
+		}
+		mtk_ddp_write_mask(cmdq_pkt, RDMA_BYPASS_SHADOW | RDMA_READ_WORK_REG,
+				   &rdma->cmdq_reg, rdma->regs,
+				   DISP_REG_RDMA_SHADOW_UPDATE,
+				   RDMA_BYPASS_SHADOW | RDMA_READ_WORK_REG);
+	}
+
 	mtk_ddp_write_mask(cmdq_pkt, width, &rdma->cmdq_reg, rdma->regs,
 			   DISP_REG_RDMA_SIZE_CON_0, 0xfff);
 	mtk_ddp_write_mask(cmdq_pkt, height, &rdma->cmdq_reg, rdma->regs,
@@ -206,7 +226,7 @@ void mtk_rdma_config(struct device *dev, unsigned int width,
 	 * output threshold to 70% of max fifo size to make sure the
 	 * threhold will not overflow
 	 */
-	threshold = rdma_fifo_size * 7 / 10;
+	threshold = rdma->data->zero_fifo_threshold ? 0 : rdma_fifo_size * 7 / 10;
 	reg = RDMA_FIFO_UNDERFLOW_EN |
 	      RDMA_FIFO_PSEUDO_SIZE(rdma_fifo_size) |
 	      RDMA_OUTPUT_VALID_FIFO_THRESHOLD(threshold);
@@ -382,6 +402,15 @@ static const struct mtk_disp_rdma_data mt2701_rdma_driver_data = {
 	.num_formats = ARRAY_SIZE(mt8173_formats),
 };
 
+static const struct mtk_disp_rdma_data mt6789_rdma_driver_data = {
+	.fifo_size = SZ_32K + SZ_8K + SZ_4K + SZ_2K + SZ_1K +
