From 1aafa3f93b957e7ed9701f51bda82b0e33ef0f41 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:56 +0000
Subject: [PATCH] dt-bindings: display: panel: Add Chipone ICNL9922C binding

Add devicetree schema for the Chipone ICNL9922C 1080x2460 MIPI-DSI
LCD panel.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 .../display/panel/chipone,icnl9922c.yaml      | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml b/Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml
new file mode 100644
index 0000000..1499a5d
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/chipone,icnl9922c.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/chipone,icnl9922c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Chipone ICNL9922C 1080x2460 MIPI-DSI LCD Panel
+
+maintainers:
+  - Neil Armstrong <neil.armstrong@linaro.org>
+  - Jessica Zhang <jessica.zhang@oss.qualcomm.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: chipone,icnl9922c
+
+  reg:
+    maxItems: 1
+    description: DSI virtual channel
+
+  vsp-supply:
+    description: Positive 5.5V bias supply
+
+  vsn-supply:
+    description: Negative 5.5V bias supply
+
+  ldo18-gpios:
+    maxItems: 1
+    description: GPIO to enable 1.8V LDO logic supply
+
+  reset-gpios:
+    maxItems: 1
+
+  backlight: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "chipone,icnl9922c";
+            reg = <0>;
+
+            reset-gpios = <&pio 85 GPIO_ACTIVE_LOW>;
+            ldo18-gpios = <&pio 150 GPIO_ACTIVE_HIGH>;
+            vsp-supply = <&outp>;
+            vsn-supply = <&outn>;
+            backlight = <&backlight_lcd>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+...
-- 
2.55.0

