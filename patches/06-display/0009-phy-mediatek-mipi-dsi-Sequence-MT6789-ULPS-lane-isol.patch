From aac20b16fa232d73ae1eb1212274ea01b7e50e3f Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Wed, 25 Nov 2026 08:51:58 +0000
Subject: [PATCH] phy: mediatek: mipi-dsi: Sequence MT6789 ULPS lane isolation
 via set_mode

On MediaTek MT6789, cold-starting the MIPI-TX D-PHY after power-off
(such as resuming from system suspend) requires the lanes to remain
isolated under SW_CTL_EN while the DSI controller runs DPHY_RESET and
programs LDX_ULPM_AS_L0/SLEEP_MODE, with LPTX PRE_OE asserted first and
SW_CTL_EN released immediately before SLEEPOUT_START.

Releasing SW_CTL_EN inside phy_power_on() before mtk_dsi configures
DSI_TXRX_CTRL and ULPS exit left the DSI TX state machine wedged on
the first panel command after resume (intsta=0x80000080, dbg6=0x00010001).

Wire phy_ops.set_mode through struct mtk_mipitx_data and keep
mtk_mipi_tx_power_on_signal_mt6789() limited to CK_CKMODE_EN, exposing
MT6789 D-PHY submodes for PRE_OE enable, SW_CTL_EN release, and ULPS
enter isolation while preserving live bootloader handover when
SW_CTL_EN is already clear.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../phy/mediatek/phy-mtk-mipi-dsi-mt8183.c    | 79 +++++++++++++------
 drivers/phy/mediatek/phy-mtk-mipi-dsi.c       | 13 +++
 drivers/phy/mediatek/phy-mtk-mipi-dsi.h       |  2 +
 3 files changed, 72 insertions(+), 22 deletions(-)

diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8183.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8183.c
index 07799de86..9c0e8335a 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8183.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8183.c
@@ -290,35 +290,28 @@ static const struct clk_ops mtk_mipi_tx_pll_ops_mt6789 = {
 	.recalc_rate = mtk_mipi_tx_pll_recalc_rate,
 };
 
+/*
+ * MT6789 MIPI-TX D-PHY lane isolation submodes used via
+ * phy_set_mode_ext(phy, PHY_MODE_MIPI_DPHY, submode) during DSI ULPS
+ * transitions:
+ *   1: enable LPTX PRE_OE while lanes are isolated in SW control
+ *   2: release SW_CTL_EN so DSI ULPS sleepout takes ownership of lanes
+ *   3: disable LPTX PRE_OE and assert SW_CTL_EN after DSI enters ULPS
+ */
+#define MT6789_DPHY_SUBMODE_PRE_OE_EN		1
+#define MT6789_DPHY_SUBMODE_SW_CTL_RELEASE	2
+#define MT6789_DPHY_SUBMODE_ULPS_ISOLATE	3
+
 static void mtk_mipi_tx_power_on_signal_mt6789(struct phy *phy)
 {
 	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
 	void __iomem *base = mipi_tx->regs;
 
 	/*
-	 * Only toggle PRE_OE if lanes were isolated in SW control (cold start
-	 * or resume from power-off). Live bootloader handover keeps PRE_OE as
-	 * programmed by LK.
+	 * Configure clock-lane mode only. On cold-start or resume, lanes stay
+	 * isolated under SW_CTL_EN until mtk_dsi sequences PRE_OE and releases
+	 * SW_CTL_EN during ULPS sleepout.
 	 */
-	if (readl(base + MIPITX_D0_SW_CTL_EN) & DSI_SW_CTL_EN) {
-		mtk_phy_set_bits(base + MIPITX_D2_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D2C_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D0_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D0C_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_CK_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_CKC_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D1_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D1C_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D3_SW_LPTX_PRE_OE, BIT(0));
-		mtk_phy_set_bits(base + MIPITX_D3C_SW_LPTX_PRE_OE, BIT(0));
-
-		mtk_phy_clear_bits(base + MIPITX_D0_SW_CTL_EN, DSI_SW_CTL_EN);
-		mtk_phy_clear_bits(base + MIPITX_D1_SW_CTL_EN, DSI_SW_CTL_EN);
-		mtk_phy_clear_bits(base + MIPITX_D2_SW_CTL_EN, DSI_SW_CTL_EN);
-		mtk_phy_clear_bits(base + MIPITX_D3_SW_CTL_EN, DSI_SW_CTL_EN);
-		mtk_phy_clear_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
-	}
-
 	mtk_phy_set_bits(base + MIPITX_CK_CKMODE_EN, DSI_CK_CKMODE_EN);
 }
 
@@ -345,8 +338,50 @@ static void mtk_mipi_tx_power_off_signal_mt6789(struct phy *phy)
 	mtk_phy_set_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
 }
 
+static int mtk_mipi_tx_set_mode_mt6789(struct phy *phy, enum phy_mode mode,
+				       int submode)
+{
+	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
+	void __iomem *base = mipi_tx->regs;
+
+	if (mode != PHY_MODE_MIPI_DPHY)
+		return 0;
+
+	switch (submode) {
+	case MT6789_DPHY_SUBMODE_PRE_OE_EN:
+		if (readl(base + MIPITX_D0_SW_CTL_EN) & DSI_SW_CTL_EN) {
+			mtk_phy_set_bits(base + MIPITX_D2_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D2C_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D0_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D0C_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_CK_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_CKC_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D1_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D1C_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D3_SW_LPTX_PRE_OE, BIT(0));
+			mtk_phy_set_bits(base + MIPITX_D3C_SW_LPTX_PRE_OE, BIT(0));
+		}
+		break;
+	case MT6789_DPHY_SUBMODE_SW_CTL_RELEASE:
+		mtk_phy_clear_bits(base + MIPITX_D0_SW_CTL_EN, DSI_SW_CTL_EN);
+		mtk_phy_clear_bits(base + MIPITX_D1_SW_CTL_EN, DSI_SW_CTL_EN);
+		mtk_phy_clear_bits(base + MIPITX_D2_SW_CTL_EN, DSI_SW_CTL_EN);
+		mtk_phy_clear_bits(base + MIPITX_D3_SW_CTL_EN, DSI_SW_CTL_EN);
+		mtk_phy_clear_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
+		break;
+	case MT6789_DPHY_SUBMODE_ULPS_ISOLATE:
+		mtk_mipi_tx_power_off_signal_mt6789(phy);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
 const struct mtk_mipitx_data mt6789_mipitx_data = {
 	.mipi_tx_clk_ops = &mtk_mipi_tx_pll_ops_mt6789,
 	.mipi_tx_enable_signal = mtk_mipi_tx_power_on_signal_mt6789,
 	.mipi_tx_disable_signal = mtk_mipi_tx_power_off_signal_mt6789,
+	.mipi_tx_set_mode = mtk_mipi_tx_set_mode_mt6789,
 };
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
index 7cf67ead3..a894e6040 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
@@ -58,9 +58,22 @@ static int mtk_mipi_tx_power_off(struct phy *phy)
 	return 0;
 }
 
+static int mtk_mipi_tx_set_mode(struct phy *phy, enum phy_mode mode,
+				int submode)
+{
+	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
+
+	if (mipi_tx->driver_data->mipi_tx_set_mode)
+		return mipi_tx->driver_data->mipi_tx_set_mode(phy, mode,
+							      submode);
+
+	return 0;
+}
+
 static const struct phy_ops mtk_mipi_tx_ops = {
 	.power_on = mtk_mipi_tx_power_on,
 	.power_off = mtk_mipi_tx_power_off,
+	.set_mode = mtk_mipi_tx_set_mode,
 	.owner = THIS_MODULE,
 };
 
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.h b/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
index e03a08515..13d63e41a 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
@@ -21,6 +21,8 @@ struct mtk_mipitx_data {
 	const struct clk_ops *mipi_tx_clk_ops;
 	void (*mipi_tx_enable_signal)(struct phy *phy);
 	void (*mipi_tx_disable_signal)(struct phy *phy);
+	int (*mipi_tx_set_mode)(struct phy *phy, enum phy_mode mode,
+				int submode);
 };
 
 struct mtk_mipi_tx {
-- 
2.55.0

