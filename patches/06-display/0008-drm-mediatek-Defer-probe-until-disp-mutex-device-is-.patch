From e4828fb2358d9169e444f439032eec706b87bbc4 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Tue, 24 Nov 2026 09:30:01 +0000
Subject: [PATCH] drm/mediatek: Defer probe until disp-mutex device is bound

mtk_drm_bind() only checked whether of_find_device_by_node() returned a
platform_device for disp-mutex, not whether mtk-mutex had actually
probed and set drvdata. When the SPM power-domain controller defers
(e.g. waiting for a domain-supply regulator), all display components and
disp-mutex are deferred together; if the DSI/DRM components wake up and
bind before disp-mutex probes, mtk_crtc_create() -> mtk_mutex_get()
dereferences NULL drvdata inside deferred_probe_work_func().

Defer mtk_drm_probe() until disp-mutex has bound (drvdata is non-NULL)
so the component master only binds once disp-mutex is ready, and guard
mtk_drm_bind() the same way without dropping private->mutex_node on
-EPROBE_DEFER.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/gpu/drm/mediatek/mtk_drm_drv.c | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_drm_drv.c b/drivers/gpu/drm/mediatek/mtk_drm_drv.c
index 5b1a067..4d5b424 100644
--- a/drivers/gpu/drm/mediatek/mtk_drm_drv.c
+++ b/drivers/gpu/drm/mediatek/mtk_drm_drv.c
@@ -648,10 +648,11 @@ static int mtk_drm_bind(struct device *dev)
 	int ret, i;
 
 	pdev = of_find_device_by_node(private->mutex_node);
-	if (!pdev) {
-		dev_err(dev, "Waiting for disp-mutex device %pOF\n",
+	if (!pdev || !dev_get_drvdata(&pdev->dev)) {
+		if (pdev)
+			put_device(&pdev->dev);
+		dev_dbg(dev, "Waiting for disp-mutex device %pOF\n",
 			private->mutex_node);
-		of_node_put(private->mutex_node);
 		return -EPROBE_DEFER;
 	}
 
@@ -1188,6 +1189,18 @@ static int mtk_drm_probe(struct platform_device *pdev)
 
 			id = of_alias_get_id(node, "mutex");
 			if (id < 0 || id == private->data->mmsys_id) {
+				struct platform_device *mutex_pdev;
+
+				mutex_pdev = of_find_device_by_node(node);
+				if (!mutex_pdev ||
+				    !dev_get_drvdata(&mutex_pdev->dev)) {
+					if (mutex_pdev)
+						put_device(&mutex_pdev->dev);
+					of_node_put(node);
+					ret = -EPROBE_DEFER;
+					goto err_node;
+				}
+				put_device(&mutex_pdev->dev);
 				private->mutex_node = of_node_get(node);
 				dev_dbg(dev, "get mutex for mmsys %d", private->data->mmsys_id);
 			}
-- 
