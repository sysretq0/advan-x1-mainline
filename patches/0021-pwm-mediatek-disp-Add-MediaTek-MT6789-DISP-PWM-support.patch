From 2121212121212121212121212121212121212121 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sat, 21 Nov 2026 03:00:00 +0000
Subject: [PATCH 21/21] pwm: mediatek-disp: Add MediaTek MT6789 DISP PWM support

Add display PWM support for the MediaTek MT6789 (Helio G99) SoC.
On MT6789, register offsets are shifted by +8 bytes relative to MT8173
(con0 = 0x18, con1 = 0x1c, commit = 0x0c, matching mp01-kernel
mt6799_pwm_data), and register writes require manual commit to working
registers. Add devicetree binding and driver data.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 Documentation/devicetree/bindings/pwm/mediatek,pwm-disp.yaml |  1 +
 drivers/pwm/pwm-mtk-disp.c                                   | 11 +++++++++++
 2 files changed, 12 insertions(+)

diff --git a/Documentation/devicetree/bindings/pwm/mediatek,pwm-disp.yaml b/Documentation/devicetree/bindings/pwm/mediatek,pwm-disp.yaml
index 68ef30414..9222895db 100644
--- a/Documentation/devicetree/bindings/pwm/mediatek,pwm-disp.yaml
+++ b/Documentation/devicetree/bindings/pwm/mediatek,pwm-disp.yaml
@@ -18,6 +18,7 @@ properties:
       - enum:
           - mediatek,mt2701-disp-pwm
           - mediatek,mt6595-disp-pwm
+          - mediatek,mt6789-disp-pwm
           - mediatek,mt8173-disp-pwm
           - mediatek,mt8183-disp-pwm
       - items:
diff --git a/drivers/pwm/pwm-mtk-disp.c b/drivers/pwm/pwm-mtk-disp.c
index 56d10cde5..d44ce2fd8 100644
--- a/drivers/pwm/pwm-mtk-disp.c
+++ b/drivers/pwm/pwm-mtk-disp.c
@@ -284,6 +284,16 @@ static const struct mtk_pwm_data mt8173_pwm_data = {
 	.commit_mask = 0x1,
 };
 
+static const struct mtk_pwm_data mt6789_pwm_data = {
+	.enable_mask = BIT(0),
+	.con0 = 0x18,
+	.con0_sel = 0x0,
+	.con1 = 0x1c,
+	.has_commit = true,
+	.commit = 0x0c,
+	.commit_mask = 0x1,
+};
+
 static const struct mtk_pwm_data mt8183_pwm_data = {
 	.enable_mask = BIT(0),
 	.con0 = 0x18,
@@ -297,6 +307,7 @@ static const struct mtk_pwm_data mt8183_pwm_data = {
 static const struct of_device_id mtk_disp_pwm_of_match[] = {
 	{ .compatible = "mediatek,mt2701-disp-pwm", .data = &mt2701_pwm_data },
 	{ .compatible = "mediatek,mt6595-disp-pwm", .data = &mt8173_pwm_data },
+	{ .compatible = "mediatek,mt6789-disp-pwm", .data = &mt6789_pwm_data },
 	{ .compatible = "mediatek,mt8173-disp-pwm", .data = &mt8173_pwm_data },
 	{ .compatible = "mediatek,mt8183-disp-pwm", .data = &mt8183_pwm_data },
 	{ }
