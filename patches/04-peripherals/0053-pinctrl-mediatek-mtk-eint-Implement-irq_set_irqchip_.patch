From 8127525f06d6d39467e498e23eea07b5aa7a0a6f Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Thu, 26 Nov 2026 23:31:43 +0700
Subject: [PATCH] pinctrl: mediatek: mtk-eint: Implement irq_set_irqchip_state

Drivers with edge-triggered interrupts on MediaTek EINT pins (such as
touchscreens whose INT line toggles during panel reset and firmware
upload on resume) call irq_set_irqchip_state(..., IRQCHIP_STATE_PENDING,
false) to discard stale latched edges before re-enabling the IRQ.
Without .irq_set_irqchip_state on mtk_eint_irq_chip, that call fails
with -ENOSYS and the stale edge fires immediately on enable_irq().

Implement mtk_eint_irq_set_irqchip_state() for IRQCHIP_STATE_PENDING,
clearing pending status via mtk_eint_ack() and setting it via soft_set.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/pinctrl/mediatek/mtk-eint.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/pinctrl/mediatek/mtk-eint.c b/drivers/pinctrl/mediatek/mtk-eint.c
index 389ceaf..ae054d8 100644
--- a/drivers/pinctrl/mediatek/mtk-eint.c
+++ b/drivers/pinctrl/mediatek/mtk-eint.c
@@ -305,6 +305,25 @@ static void mtk_eint_irq_release_resources(struct irq_data *d)
 	gpiochip_unlock_as_irq(gpio_c, gpio_n);
 }
 
+static int mtk_eint_irq_set_irqchip_state(struct irq_data *d,
+					  enum irqchip_irq_state which,
+					  bool state)
+{
+	struct mtk_eint *eint = irq_data_get_irq_chip_data(d);
+	unsigned int mask = BIT(eint->pins[d->hwirq].index & 0x1f);
+
+	if (which != IRQCHIP_STATE_PENDING)
+		return -EINVAL;
+
+	if (state)
+		writel(mask, mtk_eint_get_offset(eint, d->hwirq,
+						 eint->regs->soft_set));
+	else
+		mtk_eint_ack(d);
+
+	return 0;
+}
+
 static struct irq_chip mtk_eint_irq_chip = {
 	.name = "mt-eint",
 	.irq_disable = mtk_eint_mask,
@@ -313,6 +332,7 @@ static struct irq_chip mtk_eint_irq_chip = {
 	.irq_ack = mtk_eint_ack,
 	.irq_set_type = mtk_eint_set_type,
 	.irq_set_wake = mtk_eint_irq_set_wake,
+	.irq_set_irqchip_state = mtk_eint_irq_set_irqchip_state,
 	.irq_request_resources = mtk_eint_irq_request_resources,
 	.irq_release_resources = mtk_eint_irq_release_resources,
 };
