From be28c11b4edd7df6de6720625a5d7d5af2246a69 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:45 +0000
Subject: [PATCH] thermal/drivers/mediatek/lvts: Enable sensing before zone
 registration

Return -EAGAIN on raw zero MSR readings in lvts_get_temp() so
uninitialized sensor registers during devm_thermal_of_zone_register()
do not compute bogus >250 C temperatures, and wait one sampling round
(2-3 ms) after enabling sensing points in lvts_ctrl_start() while
preserving upstream zone-driven sensor_map selection.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/thermal/mediatek/lvts_thermal.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/thermal/mediatek/lvts_thermal.c b/drivers/thermal/mediatek/lvts_thermal.c
index 350fffd..5f45bc8 100644
--- a/drivers/thermal/mediatek/lvts_thermal.c
+++ b/drivers/thermal/mediatek/lvts_thermal.c
@@ -376,6 +376,9 @@ static int lvts_get_temp(struct thermal_zone_device *tz, int *temp)
 	if (rc)
 		return -EAGAIN;
 
+	if (!(value & 0xFFFF))
+		return -EAGAIN;
+
 	*temp = lvts_raw_to_temp(value, lvts_data);
 
 	return 0;
@@ -1367,6 +1370,9 @@ static int lvts_ctrl_start(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 		writel(sensor_map | BIT(9), LVTS_MONCTL0(lvts_ctrl->base));
 	}
 
+	if (sensor_map)
+		usleep_range(2000, 3000);
+
 	return 0;
 }
 
