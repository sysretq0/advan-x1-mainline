diff --git a/sound/soc/codecs/mt6358-accdet.c b/sound/soc/codecs/mt6358-accdet.c
new file mode 100644
index 000000000..bf8f756f4
--- /dev/null
+++ b/sound/soc/codecs/mt6358-accdet.c
@@ -0,0 +1,702 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6358/MT6366 ALSA SoC accessory detection (ACCDET) driver
+ *
+ * Copyright (c) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/iio/consumer.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+#include <sound/jack.h>
+#include <sound/soc.h>
+
+#include "mt6358.h"
+#include "mt6358-accdet.h"
+
+/* MT6358/MT6366 ACCDET register addresses */
+#define MT6358_ACCDET_CON0		0x2508
+#define MT6358_ACCDET_CON1		0x250a
+#define MT6358_ACCDET_CON2		0x250c
+#define MT6358_ACCDET_CON3		0x250e
+#define MT6358_ACCDET_CON4		0x2510
+#define MT6358_ACCDET_CON5		0x2512
+#define MT6358_ACCDET_CON6		0x2514
+#define MT6358_ACCDET_CON7		0x2516
+#define MT6358_ACCDET_CON8		0x2518
+#define MT6358_ACCDET_CON9		0x251a
+#define MT6358_ACCDET_CON10		0x251c
+#define MT6358_ACCDET_CON11		0x251e
+#define MT6358_ACCDET_CON12		0x2520
+#define MT6358_ACCDET_CON14		0x2524
+#define MT6358_ACCDET_CON15		0x2526
+#define MT6358_ACCDET_CON18		0x252c
+#define MT6358_ACCDET_CON24		0x2538
+#define MT6358_ACCDET_CON25		0x253a
+
+/* MT6358_ACCDET_CON1 (0x250a) */
+#define ACCDET_EN_BIT			BIT(0)
+#define ACCDET_SEQ_INIT_BIT		BIT(1)
+#define ACCDET_EINT0_EN_BIT		BIT(2)
+#define ACCDET_EINT0_SEQ_INIT_BIT	BIT(3)
+#define ACCDET_EINT1_EN_BIT		BIT(4)
+#define ACCDET_EINT1_SEQ_INIT_BIT	BIT(5)
+
+/* MT6358_ACCDET_CON2 (0x250c) */
+#define ACCDET_PWM_EN_MASK		GENMASK(2, 0)
+#define ACCDET_EINT0_PWM_EN_BIT		BIT(3)
+#define ACCDET_EINT1_PWM_EN_BIT		BIT(4)
+#define ACCDET_PWM_IDLE_MASK		GENMASK(10, 8)
+#define ACCDET_EINT0_PWM_IDLE_BIT	BIT(11)
+#define ACCDET_EINT1_PWM_IDLE_BIT	BIT(12)
+
+/* MT6358_ACCDET_CON11 (0x251e) */
+#define ACCDET_EINT0_IVAL_SEL_BIT	BIT(14)
+#define ACCDET_EINT0_IVAL_B2_6_10	0x0444
+
+/* MT6358_ACCDET_CON12 (0x2520) */
+#define ACCDET_IRQ_STS_BIT		BIT(0)
+#define ACCDET_EINT0_IRQ_STS_BIT	BIT(2)
+#define ACCDET_EINT1_IRQ_STS_BIT	BIT(3)
+#define ACCDET_IRQ_CLR_BIT		BIT(8)
+#define ACCDET_EINT0_IRQ_CLR_BIT	BIT(10)
+#define ACCDET_EINT1_IRQ_CLR_BIT	BIT(11)
+#define ACCDET_EINT0_IRQ_POL_BIT	BIT(14)
+#define ACCDET_EINT1_IRQ_POL_BIT	BIT(15)
+
+/* MT6358_ACCDET_CON14 (0x2524) */
+#define ACCDET_MEM_IN_SHIFT		6
+#define ACCDET_MEM_IN_MASK		GENMASK(1, 0)
+#define ACCDET_AB_00			0x0
+#define ACCDET_AB_01			0x1
+#define ACCDET_AB_11			0x3
+
+/* MT6358_ACCDET_CON15 (0x2526) / CON25 (0x253a) */
+#define ACCDET_EINT_DEB_SHIFT		3
+#define ACCDET_EINT_DEB_MASK		GENMASK(6, 3)
+#define ACCDET_EINT_PWM_THRESH_SHIFT	8
+#define ACCDET_EINT_PWM_THRESH_MASK	GENMASK(10, 8)
+#define ACCDET_EINT_PWM_WIDTH_SHIFT	12
+#define ACCDET_EINT_PWM_WIDTH_MASK	GENMASK(13, 12)
+#define ACCDET_EINT_DEB_IN_256		0x0e
+
+/* MT6358_ACCDET_CON24 (0x2538) */
+#define ACCDET_HWMODE_SEL_BIT		BIT(2)
+#define ACCDET_FAST_DISCHARGE_BIT	BIT(4)
+
+/* MT6358_AUDENC_ANA_CON6 / CON10 / CON11 */
+#define AUDENC_FSTDSCHRG_ANALOG_DIR	BIT(5)
+#define AUDENC_FSTDSCHRG_IMPR_EN	BIT(6)
+#define AUDENC_MICBIAS1_LOWPEN		BIT(2)
+#define AUDENC_MICBIAS1_VREF_SHIFT	4
+#define AUDENC_MICBIAS1_VREF_MASK	GENMASK(6, 4)
+#define AUDENC_MICBIAS1_DCSW1PEN	BIT(8)
+#define AUDENC_ACCDET_MODE1		0x0807
+#define AUDENC_ACCDET_MODE2		0x0887
+#define AUDENC_ACCDET_MODE6		0x0887
+
+#define HEADSET_MODE_1			1
+#define HEADSET_MODE_2			2
+#define HEADSET_MODE_6			6
+
+#define ACCDET_BTN_DEBOUNCE		0x64
+#define ACCDET_IRQ_CLR_TIMEOUT_US	1000
+
+enum accdet_state {
+	ACCDET_PLUG_OUT = 0,
+	ACCDET_MIC_BIAS,
+	ACCDET_HOOK_SWITCH,
+};
+
+struct mt6358_accdet_pwm_deb {
+	u32 pwm_width;
+	u32 pwm_thresh;
+	u32 fall_delay;
+	u32 rise_delay;
+	u32 debounce0;
+	u32 debounce1;
+	u32 debounce3;
+	u32 debounce4;
+	u32 eint_pwm_width;
+	u32 eint_pwm_thresh;
+	u32 eint_debounce0;
+	u32 eint_debounce1;
+	u32 eint_debounce2;
+	u32 eint_debounce3;
+	u32 eint_inverter_debounce;
+};
+
+struct mt6358_accdet {
+	struct device *dev;
+	struct regmap *regmap;
+	struct iio_channel *adc_chan;
+	struct snd_soc_jack *jack;
+	struct mutex lock; /* protects jack state and register transitions */
+	struct workqueue_struct *wq;
+	struct work_struct accdet_work;
+	struct work_struct eint_work;
+
+	int accdet_irq;
+	int eint_irq;
+
+	u32 mic_vol;
+	u32 mic_mode;
+	u32 plugout_deb;
+	u32 eint_pol;
+	u32 eint_num;
+	struct mt6358_accdet_pwm_deb pwm_deb;
+	u32 four_key[5];
+	u32 three_key[4];
+	/* Tier A: headset-three-key-threshold-CDD = <0 121 192 600> */
+	u32 cdd_key[4];
+	bool has_four_key;
+
+	bool plugged_in;
+	enum accdet_state state;
+	int jack_type;
+	int btn_type;
+};
+
+static void mt6358_accdet_report(struct mt6358_accdet *priv)
+{
+	int report, mask;
+
+	if (!priv->jack)
+		return;
+
+	report = priv->jack_type | priv->btn_type;
+	mask = SND_JACK_HEADSET | SND_JACK_BTN_0 | SND_JACK_BTN_1 |
+	       SND_JACK_BTN_2 | SND_JACK_BTN_3;
+	snd_soc_jack_report(priv->jack, report, mask);
+}
+
+static void mt6358_accdet_clear_irq(struct mt6358_accdet *priv,
+				    u32 clr_bit, u32 sts_bit, u32 top_bit)
+{
+	unsigned int val;
+
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON12, clr_bit, clr_bit);
+	regmap_read_poll_timeout(priv->regmap, MT6358_ACCDET_CON12, val,
+				 !(val & sts_bit), 50,
+				 ACCDET_IRQ_CLR_TIMEOUT_US);
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON12, clr_bit, 0);
+	regmap_update_bits(priv->regmap, MT6358_AUD_TOP_INT_STATUS0,
+			   top_bit, top_bit);
+}
+
+static void mt6358_accdet_set_eint_deb(struct mt6358_accdet *priv, u32 deb)
+{
+	unsigned int reg = priv->eint_num ? MT6358_ACCDET_CON25 :
+					    MT6358_ACCDET_CON15;
+
+	regmap_update_bits(priv->regmap, reg, ACCDET_EINT_DEB_MASK,
+			   (deb << ACCDET_EINT_DEB_SHIFT) &
+			   ACCDET_EINT_DEB_MASK);
+}
+
+static void mt6358_accdet_seq_reset(struct mt6358_accdet *priv)
+{
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON1,
+			   ACCDET_SEQ_INIT_BIT, ACCDET_SEQ_INIT_BIT);
+	usleep_range(2000, 3000);
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON1,
+			   ACCDET_SEQ_INIT_BIT, 0);
+	usleep_range(1000, 1500);
+
+	regmap_write(priv->regmap, MT6358_ACCDET_CON6, priv->pwm_deb.debounce0);
+	regmap_write(priv->regmap, MT6358_ACCDET_CON7, priv->pwm_deb.debounce1);
+	regmap_write(priv->regmap, MT6358_ACCDET_CON9, priv->pwm_deb.debounce3);
+	regmap_write(priv->regmap, MT6358_ACCDET_CON10, priv->pwm_deb.debounce4);
+}
+
+static void mt6358_accdet_disable(struct mt6358_accdet *priv)
+{
+	mt6358_accdet_clear_irq(priv, ACCDET_IRQ_CLR_BIT, ACCDET_IRQ_STS_BIT,
+				RG_INT_STATUS_ACCDET_MASK_SFT);
+
+	regmap_write(priv->regmap, MT6358_ACCDET_CON6, priv->pwm_deb.debounce0);
+	regmap_write(priv->regmap, MT6358_ACCDET_CON9, priv->pwm_deb.debounce3);
+
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON1, ACCDET_EN_BIT, 0);
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON2,
+			   ACCDET_PWM_EN_MASK | ACCDET_PWM_IDLE_MASK, 0);
+}
+
+static int mt6358_accdet_check_button(struct mt6358_accdet *priv)
+{
+	int mv = 0;
+	int ret;
+
+	if (!priv->adc_chan)
+		return SND_JACK_BTN_0;
+
+	ret = iio_read_channel_processed(priv->adc_chan, &mv);
+	if (ret < 0) {
+		dev_dbg(priv->dev, "AUXADC read failed: %d\n", ret);
+		return SND_JACK_BTN_0;
+	}
+
+	if (priv->has_four_key) {
+		if (mv < priv->four_key[1])
+			return SND_JACK_BTN_0;
+		if (mv < priv->four_key[2])
+			return SND_JACK_BTN_3;
+		if (mv < priv->four_key[3])
+			return SND_JACK_BTN_2;
+		if (mv < priv->four_key[4])
+			return SND_JACK_BTN_1;
+		return 0;
+	}
+
+	if (mv < priv->three_key[1])
+		return SND_JACK_BTN_0;
+	if (mv < priv->three_key[2])
+		return SND_JACK_BTN_2;
+	if (mv < priv->three_key[3])
+		return SND_JACK_BTN_1;
+
+	return 0;
+}
+
+static void mt6358_accdet_work(struct work_struct *work)
+{
+	struct mt6358_accdet *priv =
+		container_of(work, struct mt6358_accdet, accdet_work);
+	unsigned int val = 0;
+	u32 cur_ab;
+
+	mutex_lock(&priv->lock);
+	if (!priv->plugged_in)
+		goto out_unlock;
+
+	regmap_read(priv->regmap, MT6358_ACCDET_CON14, &val);
+	cur_ab = (val >> ACCDET_MEM_IN_SHIFT) & ACCDET_MEM_IN_MASK;
+
+	switch (priv->state) {
+	case ACCDET_PLUG_OUT:
+		if (cur_ab == ACCDET_AB_00) {
+			priv->state = ACCDET_HOOK_SWITCH;
+			priv->jack_type = SND_JACK_HEADPHONE;
+			priv->btn_type = 0;
+		} else if (cur_ab == ACCDET_AB_01) {
+			priv->state = ACCDET_MIC_BIAS;
+			priv->jack_type = SND_JACK_HEADSET;
+			priv->btn_type = 0;
+			regmap_write(priv->regmap, MT6358_ACCDET_CON6,
+				     ACCDET_BTN_DEBOUNCE);
+		} else if (cur_ab == ACCDET_AB_11) {
+			priv->state = ACCDET_PLUG_OUT;
+			priv->jack_type = 0;
+			priv->btn_type = 0;
+		}
+		break;
+	case ACCDET_MIC_BIAS:
+		if (cur_ab == ACCDET_AB_00) {
+			priv->state = ACCDET_HOOK_SWITCH;
+			priv->btn_type = mt6358_accdet_check_button(priv);
+		} else if (cur_ab == ACCDET_AB_01) {
+			priv->jack_type = SND_JACK_HEADSET;
+			priv->btn_type = 0;
+		} else if (cur_ab == ACCDET_AB_11) {
+			priv->state = ACCDET_PLUG_OUT;
+			priv->btn_type = 0;
+		}
+		break;
+	case ACCDET_HOOK_SWITCH:
+		if (cur_ab == ACCDET_AB_01) {
+			priv->state = ACCDET_MIC_BIAS;
+			priv->jack_type = SND_JACK_HEADSET;
+			priv->btn_type = 0;
+		} else if (cur_ab == ACCDET_AB_11) {
+			priv->state = ACCDET_PLUG_OUT;
+			priv->btn_type = 0;
+		}
+		break;
+	}
+
+	mt6358_accdet_report(priv);
+
+out_unlock:
+	mutex_unlock(&priv->lock);
+}
+
+static void mt6358_accdet_eint_work(struct work_struct *work)
+{
+	struct mt6358_accdet *priv =
+		container_of(work, struct mt6358_accdet, eint_work);
+	u32 eint_pwm_idle = priv->eint_num ? ACCDET_EINT1_PWM_IDLE_BIT :
+					     ACCDET_EINT0_PWM_IDLE_BIT;
+
+	mutex_lock(&priv->lock);
+	if (priv->plugged_in) {
+		mt6358_accdet_seq_reset(priv);
+		regmap_update_bits(priv->regmap, MT6358_ACCDET_CON2,
+				   ACCDET_PWM_IDLE_MASK | eint_pwm_idle |
+				   ACCDET_PWM_EN_MASK,
+				   ACCDET_PWM_IDLE_MASK | eint_pwm_idle |
+				   ACCDET_PWM_EN_MASK);
+		regmap_update_bits(priv->regmap, MT6358_ACCDET_CON1,
+				   ACCDET_EN_BIT, ACCDET_EN_BIT);
+	} else {
+		mt6358_accdet_disable(priv);
+		priv->state = ACCDET_PLUG_OUT;
+		priv->jack_type = 0;
+		priv->btn_type = 0;
+		mt6358_accdet_report(priv);
+	}
+	mutex_unlock(&priv->lock);
+}
+
+static irqreturn_t mt6358_accdet_irq_handler(int irq, void *data)
+{
+	struct mt6358_accdet *priv = data;
+	unsigned int status = 0;
+	u32 eint_sts = priv->eint_num ? ACCDET_EINT1_IRQ_STS_BIT :
+					ACCDET_EINT0_IRQ_STS_BIT;
+	u32 eint_clr = priv->eint_num ? ACCDET_EINT1_IRQ_CLR_BIT :
+					ACCDET_EINT0_IRQ_CLR_BIT;
+	u32 eint_pol = priv->eint_num ? ACCDET_EINT1_IRQ_POL_BIT :
+					ACCDET_EINT0_IRQ_POL_BIT;
+	u32 eint_top = priv->eint_num ? RG_INT_STATUS_ACCDET_EINT1_MASK_SFT :
+					RG_INT_STATUS_ACCDET_EINT0_MASK_SFT;
+
+	regmap_read(priv->regmap, MT6358_ACCDET_CON12, &status);
+
+	if ((status & ACCDET_IRQ_STS_BIT) && !(status & eint_sts)) {
+		mt6358_accdet_clear_irq(priv, ACCDET_IRQ_CLR_BIT,
+					ACCDET_IRQ_STS_BIT,
+					RG_INT_STATUS_ACCDET_MASK_SFT);
+		queue_work(priv->wq, &priv->accdet_work);
+		return IRQ_HANDLED;
+	}
+
+	if (status & eint_sts) {
+		bool plug_in;
+
+		mutex_lock(&priv->lock);
+		plug_in = !priv->plugged_in;
+		priv->plugged_in = plug_in;
+
+		/* Flip EINT polarity to detect the opposite transition */
+		if ((plug_in && priv->eint_pol == IRQ_TYPE_LEVEL_HIGH) ||
+		    (!plug_in && priv->eint_pol != IRQ_TYPE_LEVEL_HIGH))
+			regmap_update_bits(priv->regmap, MT6358_ACCDET_CON12,
+					   eint_pol, 0);
+		else
+			regmap_update_bits(priv->regmap, MT6358_ACCDET_CON12,
+					   eint_pol, eint_pol);
+
+		mt6358_accdet_set_eint_deb(priv, plug_in ?
+					   priv->plugout_deb :
+					   priv->pwm_deb.eint_debounce0);
+		mutex_unlock(&priv->lock);
+
+		mt6358_accdet_clear_irq(priv, eint_clr, eint_sts, eint_top);
+		queue_work(priv->wq, &priv->eint_work);
+		return IRQ_HANDLED;
+	}
+
+	return IRQ_NONE;
+}
+
+static void mt6358_accdet_hw_init(struct mt6358_accdet *priv)
+{
+	u32 eint_pwm_en = priv->eint_num ? ACCDET_EINT1_PWM_EN_BIT :
+					   ACCDET_EINT0_PWM_EN_BIT;
+	u32 eint_pwm_idle = priv->eint_num ? ACCDET_EINT1_PWM_IDLE_BIT :
+					     ACCDET_EINT0_PWM_IDLE_BIT;
+	u32 eint_en = priv->eint_num ? ACCDET_EINT1_EN_BIT :
+				       ACCDET_EINT0_EN_BIT;
+	u32 mode_val;
+
+	mt6358_accdet_seq_reset(priv);
+	mt6358_accdet_set_eint_deb(priv, priv->pwm_deb.eint_debounce0);
+
+	/* Reset the ACCDET block */
+	regmap_update_bits(priv->regmap, MT6358_AUD_TOP_RST_CON0,
+			   RG_ACCDET_RST_MASK_SFT, RG_ACCDET_RST_MASK_SFT);
+	regmap_update_bits(priv->regmap, MT6358_AUD_TOP_RST_CON0,
+			   RG_ACCDET_RST_MASK_SFT, 0);
+
+	/* PWM frequency, duty cycle, and rise/fall delay */
+	regmap_write(priv->regmap, MT6358_ACCDET_CON3,
+		     priv->pwm_deb.pwm_width ? priv->pwm_deb.pwm_width - 1 : 0);
+	regmap_write(priv->regmap, MT6358_ACCDET_CON4,
+		     priv->pwm_deb.pwm_thresh ? priv->pwm_deb.pwm_thresh - 1 : 0);
+	regmap_write(priv->regmap, MT6358_ACCDET_CON5,
+		     (priv->pwm_deb.fall_delay << 15) |
+		     priv->pwm_deb.rise_delay);
+
+	/* Configure MICBIAS1 voltage */
+	regmap_update_bits(priv->regmap, MT6358_AUDENC_ANA_CON10,
+			   AUDENC_MICBIAS1_VREF_MASK | AUDENC_MICBIAS1_LOWPEN,
+			   ((priv->mic_vol << AUDENC_MICBIAS1_VREF_SHIFT) &
+			    AUDENC_MICBIAS1_VREF_MASK) |
+			   AUDENC_MICBIAS1_LOWPEN);
+
+	/* Configure microphone bias topology */
+	switch (priv->mic_mode) {
+	case HEADSET_MODE_2:
+		mode_val = AUDENC_ACCDET_MODE2;
+		break;
+	case HEADSET_MODE_6:
+		mode_val = AUDENC_ACCDET_MODE6;
+		regmap_update_bits(priv->regmap, MT6358_AUDENC_ANA_CON10,
+				   AUDENC_MICBIAS1_DCSW1PEN,
+				   AUDENC_MICBIAS1_DCSW1PEN);
+		break;
+	case HEADSET_MODE_1:
+	default:
+		mode_val = AUDENC_ACCDET_MODE1;
+		break;
+	}
+	regmap_update_bits(priv->regmap, MT6358_AUDENC_ANA_CON11,
+			   mode_val, mode_val);
+
+	/* Analog fast discharge */
+	if (priv->eint_pol == IRQ_TYPE_LEVEL_LOW)
+		regmap_update_bits(priv->regmap, MT6358_AUDENC_ANA_CON6,
+				   AUDENC_FSTDSCHRG_IMPR_EN |
+				   AUDENC_FSTDSCHRG_ANALOG_DIR,
+				   AUDENC_FSTDSCHRG_IMPR_EN |
+				   AUDENC_FSTDSCHRG_ANALOG_DIR);
+	else
+		regmap_update_bits(priv->regmap, MT6358_AUDENC_ANA_CON6,
+				   ~(u32)0xe0, 0);
+
+	/* Configure PMIC EINT PWM and SW fast-discharge mode */
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON15,
+			   ACCDET_EINT_PWM_THRESH_MASK |
+			   ACCDET_EINT_PWM_WIDTH_MASK,
+			   (0x6 << ACCDET_EINT_PWM_THRESH_SHIFT) |
+			   (0x2 << ACCDET_EINT_PWM_WIDTH_SHIFT));
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON2,
+			   eint_pwm_en | eint_pwm_idle,
+			   eint_pwm_en | eint_pwm_idle);
+	regmap_update_bits(priv->regmap, MT6358_ACCDET_CON24,
+			   ACCDET_HWMODE_SEL_BIT | ACCDET_FAST_DISCHARGE_BIT,
+			   ACCDET_FAST_DISCHARGE_BIT);
+
+	if (priv->eint_num == 0 && priv->eint_pol == IRQ_TYPE_LEVEL_HIGH) {
+		regmap_update_bits(priv->regmap, MT6358_ACCDET_CON12,
+				   ACCDET_EINT0_IRQ_POL_BIT,
+				   ACCDET_EINT0_IRQ_POL_BIT);
+		regmap_update_bits(priv->regmap, MT6358_ACCDET_CON1,
+				   ACCDET_EINT0_SEQ_INIT_BIT,
+				   ACCDET_EINT0_SEQ_INIT_BIT);
+		usleep_range(2000, 3000);
+		regmap_update_bits(priv->regmap, MT6358_ACCDET_CON11,
+				   ACCDET_EINT0_IVAL_SEL_BIT |
+				   ACCDET_EINT0_IVAL_B2_6_10,
+				   ACCDET_EINT0_IVAL_SEL_BIT);
+		usleep_range(2000, 3000);
+		regmap_update_bits(priv->regmap, MT6358_ACCDET_CON1,
+				   ACCDET_EINT0_SEQ_INIT_BIT, 0);
+		mt6358_accdet_set_eint_deb(priv, ACCDET_EINT_DEB_IN_256);
+	}
+
+	/* Enable PMIC EINT jack detection */
+	regmap_write(priv->regmap, MT6358_ACCDET_CON1, eint_en);
+}
+
+static int mt6358_accdet_parse_dt(struct mt6358_accdet *priv)
+{
+	struct device_node *np = priv->dev->of_node;
+	u32 pwm_deb[15] = {
+		0x500, 0x500, 0x01, 0x1f0, 0x800, 0x800, 0x20, 0x44,
+		0x00, 0x00, 0x0e, 0x00, 0x00, 0x00, 0x00,
+	};
+
+	priv->mic_vol = 6;
+	priv->mic_mode = HEADSET_MODE_1;
+	priv->plugout_deb = 1;
+	priv->eint_pol = IRQ_TYPE_LEVEL_LOW;
+	priv->eint_num = 0;
+
+	priv->three_key[0] = 0;
+	priv->three_key[1] = 80;
+	priv->three_key[2] = 220;
+	priv->three_key[3] = 400;
+
+	if (np) {
+		of_property_read_u32(np, "mediatek,mic-vol", &priv->mic_vol);
+		of_property_read_u32(np, "mediatek,mic-mode", &priv->mic_mode);
+		of_property_read_u32(np, "mediatek,plugout-debounce",
+				     &priv->plugout_deb);
+		of_property_read_u32(np, "mediatek,eint-level-pol",
+				     &priv->eint_pol);
+		of_property_read_u32(np, "mediatek,eint-num", &priv->eint_num);
+		of_property_read_u32_array(np, "mediatek,pwm-deb-setting",
+					   pwm_deb, ARRAY_SIZE(pwm_deb));
+		of_property_read_u32_array(np, "mediatek,three-key-threshold",
+					   priv->three_key,
+					   ARRAY_SIZE(priv->three_key));
+		/*
+		 * Stock accdet selects this alternate key map for CDD-type
+		 * accessories. Keep it available to the driver; accessory
+		 * identification / selection lands with the jack-type work.
+		 */
+		of_property_read_u32_array(np,
+					   "mediatek,three-key-threshold-CDD",
+					   priv->cdd_key,
+					   ARRAY_SIZE(priv->cdd_key));
+		if (!of_property_read_u32_array(np,
+						"mediatek,four-key-threshold",
+						priv->four_key,
+						ARRAY_SIZE(priv->four_key)))
+			priv->has_four_key = true;
+	}
+
+	priv->pwm_deb.pwm_width = pwm_deb[0];
+	priv->pwm_deb.pwm_thresh = pwm_deb[1];
+	priv->pwm_deb.fall_delay = pwm_deb[2];
+	priv->pwm_deb.rise_delay = pwm_deb[3];
+	priv->pwm_deb.debounce0 = pwm_deb[4];
+	priv->pwm_deb.debounce1 = pwm_deb[5];
+	priv->pwm_deb.debounce3 = pwm_deb[6];
+	priv->pwm_deb.debounce4 = pwm_deb[7];
+	priv->pwm_deb.eint_pwm_width = pwm_deb[8];
+	priv->pwm_deb.eint_pwm_thresh = pwm_deb[9];
+	priv->pwm_deb.eint_debounce0 = pwm_deb[10];
+	priv->pwm_deb.eint_debounce1 = pwm_deb[11];
+	priv->pwm_deb.eint_debounce2 = pwm_deb[12];
+	priv->pwm_deb.eint_debounce3 = pwm_deb[13];
+	priv->pwm_deb.eint_inverter_debounce = pwm_deb[14];
+
+	return 0;
+}
+
+int mt6358_accdet_enable_jack_detect(struct snd_soc_component *component,
+				     struct snd_soc_jack *jack)
+{
+	struct mt6358_accdet *priv = snd_soc_component_get_drvdata(component);
+
+	snd_jack_set_key(jack->jack, SND_JACK_BTN_0, KEY_PLAYPAUSE);
+	snd_jack_set_key(jack->jack, SND_JACK_BTN_1, KEY_VOLUMEDOWN);
+	snd_jack_set_key(jack->jack, SND_JACK_BTN_2, KEY_VOLUMEUP);
+	snd_jack_set_key(jack->jack, SND_JACK_BTN_3, KEY_VOICECOMMAND);
+
+	mutex_lock(&priv->lock);
+	priv->jack = jack;
+	mt6358_accdet_report(priv);
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6358_accdet_enable_jack_detect);
+
+static const struct snd_soc_component_driver mt6358_accdet_soc_driver = {
+	.name = "mt6358-accdet",
+};
+
+static void mt6358_accdet_destroy_wq(void *data)
+{
+	struct mt6358_accdet *priv = data;
+
+	destroy_workqueue(priv->wq);
+}
+
+static int mt6358_accdet_probe(struct platform_device *pdev)
+{
+	struct mt6397_chip *mt6397 = dev_get_drvdata(pdev->dev.parent);
+	struct device *dev = &pdev->dev;
+	struct mt6358_accdet *priv;
+	const char *eint_name;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	priv->regmap = mt6397->regmap;
+	mutex_init(&priv->lock);
+	platform_set_drvdata(pdev, priv);
+
+	mt6358_accdet_parse_dt(priv);
+
+	priv->adc_chan = devm_iio_channel_get(dev, "pmic_accdet");
+	if (IS_ERR(priv->adc_chan)) {
+		ret = PTR_ERR(priv->adc_chan);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		dev_warn(dev, "AUXADC channel unavailable (%d), using default key\n",
+			 ret);
+		priv->adc_chan = NULL;
+	}
+
+	priv->wq = create_singlethread_workqueue("mt6358_accdet");
+	if (!priv->wq)
+		return -ENOMEM;
+
+	INIT_WORK(&priv->accdet_work, mt6358_accdet_work);
+	INIT_WORK(&priv->eint_work, mt6358_accdet_eint_work);
+
+	ret = devm_add_action_or_reset(dev, mt6358_accdet_destroy_wq, priv);
+	if (ret)
+		return ret;
+
+	priv->accdet_irq = platform_get_irq_byname(pdev, "accdet_irq");
+	if (priv->accdet_irq < 0)
+		return priv->accdet_irq;
+
+	eint_name = priv->eint_num ? "accdet_eint1" : "accdet_eint0";
+	priv->eint_irq = platform_get_irq_byname(pdev, eint_name);
+	if (priv->eint_irq < 0)
+		return priv->eint_irq;
+
+	ret = devm_request_threaded_irq(dev, priv->accdet_irq, NULL,
+					mt6358_accdet_irq_handler,
+					IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+					"ACCDET_IRQ", priv);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request accdet IRQ\n");
+
+	ret = devm_request_threaded_irq(dev, priv->eint_irq, NULL,
+					mt6358_accdet_irq_handler,
+					IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+					priv->eint_num ? "ACCDET_EINT1" :
+							 "ACCDET_EINT0",
+					priv);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request eint IRQ\n");
+
+	ret = devm_snd_soc_register_component(dev, &mt6358_accdet_soc_driver,
+					      NULL, 0);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register component\n");
+
+	mt6358_accdet_hw_init(priv);
+
+	return 0;
+}
+
+static const struct of_device_id mt6358_accdet_of_match[] = {
+	{ .compatible = "mediatek,mt6358-accdet" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6358_accdet_of_match);
+
+static struct platform_driver mt6358_accdet_driver = {
+	.driver = {
+		.name = "mt6358-accdet",
+		.of_match_table = mt6358_accdet_of_match,
+	},
+	.probe = mt6358_accdet_probe,
+};
+module_platform_driver(mt6358_accdet_driver);
+
+MODULE_AUTHOR("sysretq0 <sysretq0@proton.me>");
+MODULE_DESCRIPTION("MediaTek MT6358/MT6366 ALSA SoC jack detection driver");
+MODULE_LICENSE("GPL");
