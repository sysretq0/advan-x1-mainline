From 2e060067a876f0b78bdfe10b3ad0aeef70c509d3 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Wed, 25 Nov 2026 05:27:28 +0000
Subject: [PATCH] ASoC: codecs: mt6358-accdet: Add MT6358/MT6366 headset jack
 detection

Register the mt6358-accdet MFD sub-device in mt6397-core with its
MT6358_IRQ_ACCDET/EINT0/EINT1 interrupts, and add the MT6358/MT6366
ACCDET ASoC jack and multi-button detection driver.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/mfd/mt6397-core.c        |  11 +
 sound/soc/codecs/Kconfig         |   7 +
 sound/soc/codecs/Makefile        |   2 +
 sound/soc/codecs/mt6358-accdet.c | 691 +++++++++++++++++++++++++++++++
 sound/soc/codecs/mt6358-accdet.h |  25 ++
 5 files changed, 736 insertions(+)
 create mode 100644 sound/soc/codecs/mt6358-accdet.c
 create mode 100644 sound/soc/codecs/mt6358-accdet.h

diff --git a/drivers/mfd/mt6397-core.c b/drivers/mfd/mt6397-core.c
index 16dbcc783..1338d25f0 100644
--- a/drivers/mfd/mt6397-core.c
+++ b/drivers/mfd/mt6397-core.c
@@ -84,6 +84,12 @@ static const struct resource mt6359_keys_resources[] = {
 	DEFINE_RES_IRQ_NAMED(MT6359_IRQ_HOMEKEY_R, "homekey_r"),
 };
 
+static const struct resource mt6358_accdet_resources[] = {
+	DEFINE_RES_IRQ_NAMED(MT6358_IRQ_ACCDET, "accdet_irq"),
+	DEFINE_RES_IRQ_NAMED(MT6358_IRQ_ACCDET_EINT0, "accdet_eint0"),
+	DEFINE_RES_IRQ_NAMED(MT6358_IRQ_ACCDET_EINT1, "accdet_eint1"),
+};
+
 static const struct resource mt6359_accdet_resources[] = {
 	DEFINE_RES_IRQ_NAMED(MT6359_IRQ_ACCDET, "accdet_irq"),
 	DEFINE_RES_IRQ_NAMED(MT6359_IRQ_ACCDET_EINT0, "accdet_eint0"),
@@ -229,6 +235,11 @@ static const struct mfd_cell mt6358_devs[] = {
 		.num_resources = ARRAY_SIZE(mt6358_keys_resources),
 		.resources = mt6358_keys_resources,
 		.of_compatible = "mediatek,mt6358-keys"
+	}, {
+		.name = "mt6358-accdet",
+		.num_resources = ARRAY_SIZE(mt6358_accdet_resources),
+		.resources = mt6358_accdet_resources,
+		.of_compatible = "mediatek,mt6358-accdet"
 	},
 };
 
