+	  Enable accessory detection (3.5mm headset jack and button press
+	  detection) support for MediaTek MT6358 and MT6366 PMICs.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-soc-mt6358-accdet.
+
 config SND_SOC_MT6359
 	tristate "MediaTek MT6359 Codec"
 	depends on MTK_PMIC_WRAP
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index 5f454785d..f18ecc7d7 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -195,6 +195,7 @@ snd-soc-msm8916-digital-y := msm8916-wcd-digital.o
 snd-soc-mt6351-y := mt6351.o
 snd-soc-mt6357-y := mt6357.o
 snd-soc-mt6358-y := mt6358.o
