From ff24b9938ef2f68767a20b4eaf07b2b7e1c82817 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Wed, 25 Nov 2026 13:04:16 +0000
Subject: [PATCH] dt-bindings: nvmem: thermal: Add MT6358 PMIC eFuse and MT6366
 thermal bindings

Add devicetree bindings for the MediaTek MT6358/MT6366 PMIC OTP eFuse
NVMEM provider and MT6366 4-channel PMIC thermal sensor driver, wire the
efuse child node in mediatek,mt6397.yaml, and allow optional eFuse
nvmem-cells in mediatek,mt6358-accdet.yaml.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../bindings/mfd/mediatek,mt6397.yaml         |  6 +-
 .../bindings/nvmem/mediatek,mt6358-efuse.yaml | 46 +++++++++++
 .../sound/mediatek,mt6358-accdet.yaml         | 17 +++++
 .../thermal/mediatek,mt6366-pmic-temp.yaml    | 70 +++++++++++++++++++
 4 files changed, 134 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/nvmem/mediatek,mt6358-efuse.yaml
 create mode 100644 Documentation/devicetree/bindings/thermal/mediatek,mt6366-pmic-temp.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
index 1790788b1..b2f3a189c 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
@@ -188,13 +188,17 @@ properties:
 
   efuse:
     type: object
+    $ref: /schemas/nvmem/nvmem.yaml#
     unevaluatedProperties: false
     description:
       The efuse is responsible for storing calibration data, such as thermal
       sensor calibration.
 
     properties:
       compatible:
-        const: mediatek,mt6323-efuse
+        enum:
+          - mediatek,mt6323-efuse
+          - mediatek,mt6358-efuse
+          - mediatek,mt6359p-efuse
 
       nvmem-layout:
         $ref: /schemas/nvmem/layouts/nvmem-layout.yaml#
diff --git a/Documentation/devicetree/bindings/nvmem/mediatek,mt6358-efuse.yaml b/Documentation/devicetree/bindings/nvmem/mediatek,mt6358-efuse.yaml
new file mode 100644
index 000000000..8ac0f926e
--- /dev/null
+++ b/Documentation/devicetree/bindings/nvmem/mediatek,mt6358-efuse.yaml
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/nvmem/mediatek,mt6358-efuse.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6358/MT6366 PMIC eFuse
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+description: |
+  Read-only OTP eFuse memory array integrated in the MediaTek MT6358 and
+  MT6366 PMICs (128 x 16-bit rows, 256 bytes total). Stores per-unit thermal
+  and ACCDET calibration parameters.
+
+allOf:
+  - $ref: nvmem.yaml#
+
+properties:
+  compatible:
+    enum:
+      - mediatek,mt6358-efuse
+      - mediatek,mt6359p-efuse
+
+required:
+  - compatible
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    efuse {
+        compatible = "mediatek,mt6358-efuse";
+
+        nvmem-layout {
+            compatible = "fixed-layout";
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            mt6366_thermal_efuse: thermal-cali@40 {
+                reg = <0x40 0x0c>;
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml
index 6142c4bb1..5fd7b16b6 100644
--- a/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml
@@ -93,6 +93,23 @@ properties:
     minItems: 5
     maxItems: 5
 
+  nvmem-cells:
+    minItems: 1
+    maxItems: 4
+    description:
+      Optional PMIC eFuse calibration cells for AUXADC offset, moisture
+      compensation, and 4-key fallback thresholds.
+
+  nvmem-cell-names:
+    minItems: 1
+    maxItems: 4
+    items:
+      enum:
+        - accdet-offset
+        - four-key
+        - moisture-vdd
+        - moisture-offset
+
 required:
   - compatible
 
diff --git a/Documentation/devicetree/bindings/thermal/mediatek,mt6366-pmic-temp.yaml b/Documentation/devicetree/bindings/thermal/mediatek,mt6366-pmic-temp.yaml
new file mode 100644
index 000000000..719382ecc
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/mediatek,mt6366-pmic-temp.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/mediatek,mt6366-pmic-temp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6366 PMIC Thermal Sensors
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+description: |
+  The MediaTek MT6366 PMIC exposes four on-die thermal sensing channels
+  (PMU die, VCORE buck, VPROC buck, VGPU buck) sampled via the MT6358/MT6366
+  PMIC AUXADC and calibrated using per-unit slope/intercept data stored in
+  the PMIC eFuse.
+
+properties:
+  compatible:
+    const: mediatek,mt6366-pmic-temp
+
+  io-channels:
+    items:
+      - description: PMIC chip die temperature channel (ts1)
+      - description: VCORE buck temperature channel (ts2)
+      - description: VPROC buck temperature channel (ts3)
+      - description: VGPU buck temperature channel (ts4)
+
+  io-channel-names:
+    items:
+      - const: pmic6366_ts1
+      - const: pmic6366_ts2
+      - const: pmic6366_ts3
+      - const: pmic6366_ts4
+
+  nvmem-cells:
+    maxItems: 1
+    description: Phandle to the 12-byte PMIC thermal eFuse calibration cell
+
+  nvmem-cell-names:
+    const: mt6366_e_data
+
+  "#thermal-sensor-cells":
+    const: 1
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+  - "#thermal-sensor-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/iio/adc/mediatek,mt6358-auxadc.h>
+
+    pmic-thermal {
+        compatible = "mediatek,mt6366-pmic-temp";
+        io-channels = <&pmic_adc MT6358_AUXADC_CHIP_TEMP>,
+                      <&pmic_adc MT6358_AUXADC_VCORE_TEMP>,
+                      <&pmic_adc MT6358_AUXADC_VPROC_TEMP>,
+                      <&pmic_adc MT6358_AUXADC_VGPU_TEMP>;
+        io-channel-names = "pmic6366_ts1", "pmic6366_ts2",
+                           "pmic6366_ts3", "pmic6366_ts4";
+        nvmem-cells = <&mt6366_thermal_efuse>;
+        nvmem-cell-names = "mt6366_e_data";
+        #thermal-sensor-cells = <1>;
+    };
-- 
2.55.0

