   - reg
diff --git a/Documentation/devicetree/bindings/sound/foursemi,fs1599.yaml b/Documentation/devicetree/bindings/sound/foursemi,fs1599.yaml
new file mode 100644
index 000000000..db35fd737
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/foursemi,fs1599.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/foursemi,fs1599.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FourSemi FS1599 analog-input speaker amplifier
+
+maintainers:
+  - Mark Brown <broonie@kernel.org>
+
+description: |
+  The FourSemi FS1599 is an I2C-controlled Class-K boost analog-input
+  speaker amplifier.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: foursemi,fs1599
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-amplifier@34 {
+            compatible = "foursemi,fs1599";
+            reg = <0x34>;
+            sound-name-prefix = "Ext Spk";
+        };
+    };
diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml
new file mode 100644
index 000000000..fb2a36609
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6358-accdet.yaml
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6358-accdet.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6358/MT6366 PMIC Accessory Detection (ACCDET)
+
+maintainers:
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+  - Trevor Wu <trevor.wu@mediatek.com>
+
+description: |
+  Accessory detection (3.5mm headset jack insertion and button press
+  detection) sub-device of the MediaTek MT6358/MT6366 PMIC MFD.
+
+properties:
+  compatible:
+    const: mediatek,mt6358-accdet
+
+  io-channels:
+    maxItems: 1
+
+  io-channel-names:
+    const: pmic_accdet
+
+  mediatek,mic-vol:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: MICBIAS1 voltage selection index (0..7 for <= 2.7V).
+    minimum: 0
+    maximum: 7
+    default: 6
+
+  mediatek,mic-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: |
+      Headset microphone bias topology:
+        1 - ACC mode
+        2 - DCC low-cost mode without internal bias
+        6 - DCC low-cost mode with internal bias
+    enum: [1, 2, 6]
+    default: 1
+
+  mediatek,plugout-debounce:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Plug-out debounce value.
+    default: 1
+
+  mediatek,eint-level-pol:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: |
+      PMIC EINT detection trigger level polarity (Linux IRQ_TYPE_LEVEL_*):
+        4 - IRQ_TYPE_LEVEL_HIGH
+        8 - IRQ_TYPE_LEVEL_LOW
+    enum: [4, 8]
+    default: 8
+
+  mediatek,eint-num:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: PMIC EINT channel index (0 for EINT0, 1 for EINT1).
+    enum: [0, 1]
+    default: 0
+
+  mediatek,pwm-deb-setting:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: |
+      ACCDET PWM width/threshold, rise/fall delay, and state debounce
+      register values (15 cells).
+    minItems: 15
+    maxItems: 15
+
+  mediatek,three-key-threshold:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: |
+      3-button headset ADC thresholds in millivolts:
+      <min, mid_max, up_max, down_max>.
+    minItems: 4
+    maxItems: 4
+
+  mediatek,three-key-threshold-cdd:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: |
+      Alternate Android CDD 3-button headset ADC thresholds in millivolts:
+      <min, mid_max, up_max, down_max>.
+    minItems: 4
+    maxItems: 4
+
+  mediatek,four-key-threshold:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: |
+      4-button headset ADC thresholds in millivolts:
+      <min, mid_max, voice_max, up_max, down_max>.
+    minItems: 5
+    maxItems: 5
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/iio/adc/mediatek,mt6358-auxadc.h>
+
+    accdet {
+        compatible = "mediatek,mt6358-accdet";
+        io-channels = <&pmic_adc MT6358_AUXADC_ACCDET>;
+        io-channel-names = "pmic_accdet";
+        mediatek,mic-vol = <6>;
+        mediatek,mic-mode = <1>;
+        mediatek,plugout-debounce = <1>;
+        mediatek,eint-level-pol = <8>;
+        mediatek,pwm-deb-setting = <0x500 0x500 0x01 0x1f0 0x800 0x800
+                                    0x20 0x44 0x00 0x00 0x0e 0x00
+                                    0x00 0x00 0x00>;
+        mediatek,three-key-threshold = <0 80 220 400>;
+        mediatek,four-key-threshold = <0 58 121 192 400>;
+    };
diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6789-mt6366-sound.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6789-mt6366-sound.yaml
