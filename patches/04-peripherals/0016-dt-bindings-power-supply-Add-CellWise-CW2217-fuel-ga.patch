From f2025cf9aa77a8f7f1075e62635dc4f0cc49d861 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Mon, 23 Nov 2026 12:19:32 +0000
Subject: [PATCH] dt-bindings: power: supply: Add CellWise CW2217 fuel gauge
 binding

Document Device Tree bindings for the CellWise CW2215/CW2217 I2C
single-cell battery fuel gauge.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 .../power/supply/cellwise,cw2217.yaml         | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml b/Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml
new file mode 100644
index 0000000..fb9efe3
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/cellwise,cw2217.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: CellWise CW2215/CW2217 Battery Fuel Gauge
+
+maintainers:
+  - sysretq0 <324514544+sysretq0@users.noreply.github.com>
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    enum:
+      - cellwise,cw2215
+      - cellwise,cw2217
+
+  reg:
+    maxItems: 1
+
+  shunt-resistor-micro-ohms:
+    description: External current sense resistor value in micro-ohms.
+    default: 10000
+
+  cellwise,battery-profile:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 80
+    maxItems: 80
+    description:
+      80-byte board/battery characterization profile table written to
+      CW2217 registers 0x10..0x5f during gauge initialization.
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      fuel-gauge@64 {
+        compatible = "cellwise,cw2217";
+        reg = <0x64>;
+        shunt-resistor-micro-ohms = <10000>;
+        monitored-battery = <&battery>;
+      };
+    };
-- 
2.55.0

