+
 static struct attribute *mtk_ccci_attrs[] = {
 	&dev_attr_state.attr,
 	&dev_attr_hs1_done.attr,
@@ -1042,6 +1142,7 @@ static struct attribute *mtk_ccci_attrs[] = {
 	&dev_attr_wdt_count.attr,
 	&dev_attr_rx_packets.attr,
 	&dev_attr_lk_verified.attr,
+	&dev_attr_rpc_count.attr,
 	NULL,
 };
 ATTRIBUTE_GROUPS(mtk_ccci);
@@ -1158,12 +1259,17 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 
 	ccci->dev = &pdev->dev;
 	spin_lock_init(&ccci->ccif_lock);
+	spin_lock_init(&ccci->tx_lock);
 	init_completion(&ccci->hs1_comp);
 	init_completion(&ccci->hs2_comp);
 	INIT_WORK(&ccci->boot_work, mtk_ccci_boot_work);
 	INIT_WORK(&ccci->rx_work, mtk_ccci_rx_work);
 	platform_set_drvdata(pdev, ccci);
 
+	ccci->rx_buf = devm_kmalloc(&pdev->dev, MTK_CCCI_RX_BUF_SIZE, GFP_KERNEL);
+	if (!ccci->rx_buf)
+		return -ENOMEM;
+
 	ccci->md_rgu_base = devm_platform_ioremap_resource_byname(pdev, "md-rgu");
 	if (IS_ERR(ccci->md_rgu_base))
 		return PTR_ERR(ccci->md_rgu_base);
@@ -1236,6 +1342,12 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "failed to enable CCIF clocks\n");
 
+	ccci->rx_wq = alloc_workqueue("mtk_ccci_rx", WQ_UNBOUND | WQ_HIGHPRI, 1);
+	if (!ccci->rx_wq) {
+		ret = -ENOMEM;
+		goto err_clks;
+	}
+
 	/* Clear pending CCIF0 flags before requesting IRQs */
 	writel(0xffffffff, ccci->ccif_ap_base + APCCIF_ACK);
 
@@ -1243,19 +1355,19 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 			       IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN,
 			       "mtk-ccif0-data0", ccci);
 	if (ret)
-		goto err_clks;
+		goto err_wq;
 
 	ret = devm_request_irq(&pdev->dev, ccci->ccif_irq1, mtk_ccci_ccif_irq1,
 			       IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN,
 			       "mtk-ccif0-data1", ccci);
 	if (ret)
-		goto err_clks;
+		goto err_wq;
 
 	ret = devm_request_irq(&pdev->dev, ccci->wdt_irq, mtk_ccci_wdt_irq,
 			       IRQF_TRIGGER_RISING | IRQF_NO_AUTOEN,
 			       "mtk-md-wdt", ccci);
 	if (ret)
-		goto err_clks;
