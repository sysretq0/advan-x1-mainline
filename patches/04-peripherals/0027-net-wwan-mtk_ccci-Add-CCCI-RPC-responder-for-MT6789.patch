+/*
+ * Advan X1 SIM hot-plug EINT attributes from runtime_merged.dts
+ * (MD1_SIM1_HOT_PLUG_EINT / MD1_SIM2_HOT_PLUG_EINT) and verified against
+ * stock ccci_dump.log:
+ *   SIM1: interrupts=<0 8> (num=0, LEVEL_LOW->pola=0,sens=0),
+ *         debounce=<0 0xc350> (50 ms), dedicated=0, src_pin=1, sockettype=0
+ *   SIM2: interrupts=<1 8> (num=1, LEVEL_LOW->pola=0,sens=0),
+ *         debounce=<1 0xc350> (50 ms), dedicated=0, src_pin=2, sockettype=0
+ */
+struct mtk_ccci_sim_eint_cfg {
+	const char *name;
+	s32 val[SIM_EINT_MAX];
+};
+
+static const struct mtk_ccci_sim_eint_cfg advan_x1_sim_eint[] = {
+	{
+		.name = "MD1_SIM1_HOT_PLUG_EINT",
+		.val = {
+			[SIM_EINT_NUM]		= 0,
+			[SIM_EINT_DEBOUNCE]	= 50,
+			[SIM_EINT_POLA]		= 0,
+			[SIM_EINT_SENS]		= 0,
+			[SIM_EINT_SOCKE]	= 0,
+			[SIM_EINT_DEDICATEDEN]	= 0,
+			[SIM_EINT_SRCPIN]	= 1,
+		},
+	},
+	{
+		.name = "MD1_SIM2_HOT_PLUG_EINT",
+		.val = {
+			[SIM_EINT_NUM]		= 1,
+			[SIM_EINT_DEBOUNCE]	= 50,
+			[SIM_EINT_POLA]		= 0,
+			[SIM_EINT_SENS]		= 0,
+			[SIM_EINT_SOCKE]	= 0,
+			[SIM_EINT_DEDICATEDEN]	= 0,
+			[SIM_EINT_SRCPIN]	= 2,
+		},
