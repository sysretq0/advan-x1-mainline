+/*
+ * Advan X1 md_attr_node properties from runtime_merged.dts and verified
+ * in stock ccci_dump.log (get_md_dtsi_val ... -- 0xf0f0f0f).
+ */
+struct mtk_ccci_attr_entry {
+	const char *name;
+	u32 value;
+};
+
+static const struct mtk_ccci_attr_entry advan_x1_md_attr[] = {
+	{ "mediatek,md_product_name_model_id",	0x0f0f0f0fU },
+	{ "mediatek,md_drdi_rf_set_idx",	0x0f0f0f0fU },
+};
