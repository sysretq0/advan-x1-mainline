+/*
+ * Advan X1 md_auxadc from runtime_merged.dts (io-channels = <&auxadc 2>)
+ * and stock ccci_dump.log ("ADC val:1, EVB" -> 1 mV, 12-bit code = 3).
+ */
+#define ADVAN_X1_MD_ADC_CH		2
+#define ADVAN_X1_MD_ADC_RAW		3
+
+static int mtk_ccci_lookup_eint(const char *name, u32 name_len,
+				u32 type, s32 *out_val)
+{
+	size_t eff_len = strnlen(name, name_len);
+	size_t i;
+
+	if (type >= SIM_EINT_MAX)
+		return MTK_CCCI_EINT_ERR_TYPE;
+
+	for (i = 0; i < ARRAY_SIZE(advan_x1_sim_eint); i++) {
+		if (eff_len == strlen(advan_x1_sim_eint[i].name) &&
+		    !memcmp(name, advan_x1_sim_eint[i].name, eff_len)) {
+			*out_val = advan_x1_sim_eint[i].val[type];
+			return MTK_CCCI_RPC_OK;
+		}
+	}
+
+	return MTK_CCCI_EINT_ERR_STRING;
+}
+
+static int mtk_ccci_lookup_gpio(const char *name, u32 name_len)
+{
+	size_t eff_len = strnlen(name, name_len);
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(advan_x1_gpio_map); i++) {
+		if (eff_len == strlen(advan_x1_gpio_map[i].name) &&
+		    !memcmp(name, advan_x1_gpio_map[i].name, eff_len))
+			return advan_x1_gpio_map[i].md_pin;
+	}
+
+	return -ENOENT;
+}
+
+static int mtk_ccci_lookup_md_attr(const char *name, size_t max_len,
+				   u32 *out_val)
+{
+	size_t eff_len = strnlen(name, max_len);
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(advan_x1_md_attr); i++) {
+		if (eff_len == strlen(advan_x1_md_attr[i].name) &&
+		    !memcmp(name, advan_x1_md_attr[i].name, eff_len)) {
+			*out_val = advan_x1_md_attr[i].value;
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+static void mtk_ccci_rpc_fill_gpio_adc(struct mtk_ccci_dev *ccci,
+				       const struct mtk_ccci_rpc_gpio_adc_in *in,
+				       struct mtk_ccci_rpc_gpio_adc_out *out)
+{
+	u32 i;
+
+	memset(out, 0x0f, sizeof(*out));
+
+	if (in->req_mask & MTK_RPC_REQ_GPIO_PIN) {
+		for (i = 0; i < MTK_RPC_GPIO_MAX_V1; i++) {
+			int pin;
+
+			if (!(in->gpio_valid_pin_mask & BIT(i)))
+				continue;
+			pin = mtk_ccci_lookup_gpio(in->gpio_pin_name[i],
+						   MTK_RPC_GPIO_NAME_LEN);
+			if (pin >= 0) {
+				out->gpio_pin_num[i] = pin;
+				if (in->req_mask & MTK_RPC_REQ_GPIO_VALUE)
+					out->gpio_pin_value[i] = 0;
+			}
+		}
+	} else if (in->req_mask & MTK_RPC_REQ_GPIO_VALUE) {
+		for (i = 0; i < MTK_RPC_GPIO_MAX_V1; i++) {
+			if (in->gpio_valid_pin_mask & BIT(i))
+				out->gpio_pin_value[i] = 0;
+		}
+	}
+
+	if (in->req_mask & MTK_RPC_REQ_ADC_PIN)
+		out->adc_ch_num = ADVAN_X1_MD_ADC_CH;
+	if (in->req_mask & MTK_RPC_REQ_ADC_VALUE)
+		out->adc_ch_meas_sum = ADVAN_X1_MD_ADC_RAW *
+				       in->adc_ch_meas_count;
+
+	dev_info(ccci->dev, "RPC GET_GPIO_ADC v1: mask=0x%x valid=0x%x adc_cnt=%u\n",
+		 in->req_mask, in->gpio_valid_pin_mask, in->adc_ch_meas_count);
+}
+
+static void mtk_ccci_rpc_fill_gpio_adc_v2(struct mtk_ccci_dev *ccci,
+					  const struct mtk_ccci_rpc_gpio_adc_in_v2 *in,
+					  struct mtk_ccci_rpc_gpio_adc_out_v2 *out)
