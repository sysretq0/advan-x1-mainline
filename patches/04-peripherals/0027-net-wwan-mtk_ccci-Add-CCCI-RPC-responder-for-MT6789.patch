 	if (ack & MTK_CCIF_EXP_QUEUE_MASK)
 		dev_warn_ratelimited(ccci->dev, "CCIF IRQ1 high ch mask=0x%08x\n",
@@ -976,13 +1066,15 @@ static void mtk_ccci_boot_work(struct work_struct *work)
 		return;
 	}
 
-	if (!wait_for_completion_timeout(&ccci->hs2_comp, msecs_to_jiffies(5000))) {
+	if (!wait_for_completion_timeout(&ccci->hs2_comp, msecs_to_jiffies(10000))) {
 		mtk_ccci_smc(MTK_CCCI_SMC_POWER_CONFIG, MTK_CCCI_PWR_BOOT_STATUS, 0, &res);
 		dev_err(ccci->dev,
-			"HS2 ACK timeout (5s)! boot_status=0x%lx/0x%lx ccif_rch=0x%x\n",
+			"HS2 ACK timeout (10s)! boot_status=0x%lx/0x%lx ccif_rch=0x%x rx=%d rpc=%d\n",
 			res.a1, res.a2,
-			readl(ccci->ccif_ap_base + APCCIF_RCHNUM));
-		ccci->state = MTK_CCCI_STATE_FAILED;
+			readl(ccci->ccif_ap_base + APCCIF_RCHNUM),
+			atomic_read(&ccci->rx_packets),
+			atomic_read(&ccci->rpc_count));
+		WRITE_ONCE(ccci->state, MTK_CCCI_STATE_FAILED);
 	}
 }
 
@@ -991,7 +1083,7 @@ static ssize_t state_show(struct device *dev, struct device_attribute *attr, cha
 {
 	struct mtk_ccci_dev *ccci = dev_get_drvdata(dev);
 
-	return sysfs_emit(buf, "%s\n", mtk_ccci_state_names[ccci->state]);
+	return sysfs_emit(buf, "%s\n", mtk_ccci_state_names[READ_ONCE(ccci->state)]);
 }
 static DEVICE_ATTR_RO(state);
 
@@ -1035,6 +1127,14 @@ static ssize_t lk_verified_show(struct device *dev, struct device_attribute *att
 }
 static DEVICE_ATTR_RO(lk_verified);
 
+static ssize_t rpc_count_show(struct device *dev, struct device_attribute *attr, char *buf)
