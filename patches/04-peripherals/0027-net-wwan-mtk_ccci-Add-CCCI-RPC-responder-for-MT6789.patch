+
+static int mtk_ccci_rpc_send_reply(struct mtk_ccci_dev *ccci,
+				   const struct mtk_ccci_rpc_hdr *req_hdr,
+				   const struct mtk_ccci_rpc_arg *resp,
+				   u32 resp_num)
+{
+	struct mtk_ccci_rpc_hdr *out_hdr;
+	u8 *buf;
+	u32 pos, i;
+	int ret;
+
+	if (resp_num > MTK_CCCI_RPC_MAX_ARG)
+		return -EINVAL;
+
+	buf = kzalloc(MTK_CCCI_RPC_MAX_BUF, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	pos = sizeof(*out_hdr);
+	for (i = 0; i < resp_num; i++) {
+		u32 aligned = ALIGN(resp[i].len, 4);
+
+		if (pos + sizeof(u32) + aligned > MTK_CCCI_RPC_MAX_BUF) {
+			kfree(buf);
+			return -ENOSPC;
+		}
+		memcpy(buf + pos, &resp[i].len, sizeof(u32));
+		pos += sizeof(u32);
+		if (resp[i].len && resp[i].buf)
+			memcpy(buf + pos, resp[i].buf, resp[i].len);
+		pos += aligned;
+	}
+
+	out_hdr = (struct mtk_ccci_rpc_hdr *)buf;
+	out_hdr->ccci.data[0] = 0;
+	out_hdr->ccci.data[1] = pos;
+	out_hdr->ccci.channel = CCCI_CH_RPC_TX;
+	out_hdr->ccci.seq_assert = 0;
+	out_hdr->ccci.reserved = req_hdr->ccci.reserved;
+	out_hdr->op_id = req_hdr->op_id | MTK_CCCI_RPC_RESP_MASK;
+	out_hdr->para_num = resp_num;
+
+	ret = mtk_ccci_tx_send(ccci, MTK_CCIF_RPC_QUEUE, buf, pos);
+	if (ret)
+		dev_err(ccci->dev, "RPC reply TX failed op=0x%08x len=%u ret=%d\n",
+			req_hdr->op_id, pos, ret);
+	kfree(buf);
+	return ret;
+}
+
+void mtk_ccci_rpc_handle(struct mtk_ccci_dev *ccci, const u8 *pkt, u32 len)
+{
+	struct mtk_ccci_rpc_arg args[MTK_CCCI_RPC_MAX_ARG];
+	struct mtk_ccci_rpc_arg resp[MTK_CCCI_RPC_MAX_ARG];
+	struct mtk_ccci_rpc_hdr hdr;
+	u32 resp_num = 0;
+	u32 pos, i;
+	s32 status = MTK_CCCI_RPC_OK;
+	s32 val = 0;
+	u32 u32_val = 0;
+
+	static_assert(sizeof(struct mtk_ccci_rpc_hdr) == 24);
+	static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_in) == 157);
+	static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_out) == 32);
+	static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_in_v2) == 425);
+	static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_out_v2) == 88);
+	static_assert(sizeof(struct mtk_ccci_rpc_dtsi_in) == 66);
+	static_assert(sizeof(struct mtk_ccci_rpc_dtsi_out) == 68);
+
+	if (len < sizeof(hdr) || len > MTK_CCCI_RPC_MAX_BUF) {
+		dev_warn(ccci->dev, "RPC bad packet length %u\n", len);
+		print_hex_dump(KERN_INFO, "mtk-ccci rpc: ", DUMP_PREFIX_OFFSET,
+			       16, 1, pkt, min_t(u32, len, 64), true);
+		return;
+	}
+
+	memcpy(&hdr, pkt, sizeof(hdr));
+	if (hdr.ccci.reserved > MTK_CCCI_RPC_MAX_REQ_IDX ||
+	    hdr.para_num > MTK_CCCI_RPC_MAX_ARG) {
+		dev_warn(ccci->dev, "RPC invalid rsv=%u para_num=%u op=0x%08x\n",
+			 hdr.ccci.reserved, hdr.para_num, hdr.op_id);
+		print_hex_dump(KERN_INFO, "mtk-ccci rpc: ", DUMP_PREFIX_OFFSET,
+			       16, 1, pkt, min_t(u32, len, 64), true);
+		return;
+	}
+
+	pos = sizeof(hdr);
+	for (i = 0; i < hdr.para_num; i++) {
+		u32 arg_len, aligned;
+
+		if (pos + sizeof(u32) > len)
+			goto err_malformed;
+		memcpy(&arg_len, pkt + pos, sizeof(u32));
+		pos += sizeof(u32);
+		aligned = ALIGN(arg_len, 4);
+		if (arg_len > len || aligned < arg_len || pos + aligned > len)
+			goto err_malformed;
+		args[i].len = arg_len;
+		args[i].buf = pkt + pos;
+		pos += aligned;
+	}
+
+	atomic_inc(&ccci->rpc_count);
+
+	switch (hdr.op_id) {
+	case IPC_RPC_GET_EINT_ATTR_OP: {
+		u32 type = 0;
+		int err;
+
+		if (hdr.para_num < 3 || args[0].len == 0 ||
+		    args[2].len < sizeof(u32)) {
+			status = MTK_CCCI_RPC_PARAM_ERR;
+			val = status;
+		} else {
+			memcpy(&type, args[2].buf, sizeof(type));
+			err = mtk_ccci_lookup_eint(args[0].buf, args[0].len,
+						   type, &val);
+			status = err;
+			if (err)
+				val = err;
+			dev_info(ccci->dev,
+				 "RPC GET_EINT_ATTR: name=%.*s type=%u -> err=%d val=%d\n",
+				 (int)strnlen(args[0].buf, args[0].len),
+				 (const char *)args[0].buf, type, err, val);
+		}
+		resp[0].len = sizeof(status);
+		resp[0].buf = &status;
+		resp[1].len = sizeof(val);
+		resp[1].buf = &val;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_GET_TDD_EINT_NUM_OP:
+	case IPC_RPC_GET_GPIO_NUM_OP:
+	case IPC_RPC_GET_ADC_NUM_OP: {
+		if (hdr.para_num < 2 || args[0].len == 0) {
+			val = MTK_CCCI_RPC_PARAM_ERR;
+		} else if (hdr.op_id == IPC_RPC_GET_TDD_EINT_NUM_OP) {
+			val = MTK_CCCI_RPC_FUNC_FAIL;
+		} else if (hdr.op_id == IPC_RPC_GET_GPIO_NUM_OP) {
+			int pin = mtk_ccci_lookup_gpio(args[0].buf, args[0].len);
+
+			val = (pin >= 0) ? pin : MTK_CCCI_RPC_FUNC_FAIL;
+		} else {
+			val = ADVAN_X1_MD_ADC_CH;
+		}
+		dev_info(ccci->dev, "RPC op=0x%04x name=%.*s -> %d\n",
+			 hdr.op_id,
+			 hdr.para_num >= 1 ? (int)strnlen(args[0].buf, args[0].len) : 0,
+			 hdr.para_num >= 1 ? (const char *)args[0].buf : "", val);
+		resp[0].len = sizeof(val);
+		resp[0].buf = &val;
+		resp[1].len = sizeof(val);
+		resp[1].buf = &val;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_GET_EMI_CLK_TYPE_OP: {
+		val = (hdr.para_num == 0) ? MTK_CCCI_RPC_FUNC_FAIL :
+					    MTK_CCCI_RPC_PARAM_ERR;
+		dev_info(ccci->dev, "RPC GET_EMI_CLK_TYPE -> %d\n", val);
+		resp[0].len = sizeof(val);
+		resp[0].buf = &val;
+		resp[1].len = sizeof(val);
+		resp[1].buf = &val;
+		resp[2].len = sizeof(val);
+		resp[2].buf = &val;
+		resp_num = 3;
+		break;
+	}
+
+	case IPC_RPC_GET_GPIO_VAL_OP:
+	case IPC_RPC_GET_ADC_VAL_OP: {
+		u32 num = 0;
+
+		if (hdr.para_num != 1 || args[0].len < sizeof(u32)) {
+			val = MTK_CCCI_RPC_PARAM_ERR;
+		} else {
+			memcpy(&num, args[0].buf, sizeof(num));
+			val = (hdr.op_id == IPC_RPC_GET_ADC_VAL_OP) ?
+			      ADVAN_X1_MD_ADC_RAW : 0;
+		}
+		dev_info(ccci->dev, "RPC op=0x%04x num=%u -> %d\n",
+			 hdr.op_id, num, val);
+		resp[0].len = sizeof(val);
+		resp[0].buf = &val;
+		resp[1].len = sizeof(val);
+		resp[1].buf = &val;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_GET_GPIO_ADC_OP: {
+		if (hdr.para_num == 1 &&
+		    args[0].len == sizeof(struct mtk_ccci_rpc_gpio_adc_in)) {
+			struct mtk_ccci_rpc_gpio_adc_in in;
+			struct mtk_ccci_rpc_gpio_adc_out out;
+
+			memcpy(&in, args[0].buf, sizeof(in));
+			mtk_ccci_rpc_fill_gpio_adc(ccci, &in, &out);
+			status = MTK_CCCI_RPC_OK;
+			resp[0].len = sizeof(status);
+			resp[0].buf = &status;
+			resp[1].len = sizeof(out);
+			resp[1].buf = &out;
+			resp_num = 2;
+			mtk_ccci_rpc_send_reply(ccci, &hdr, resp, resp_num);
+			return;
+		}
+		if (hdr.para_num == 1 &&
+		    args[0].len == sizeof(struct mtk_ccci_rpc_gpio_adc_in_v2)) {
+			struct mtk_ccci_rpc_gpio_adc_in_v2 *in_v2;
+			struct mtk_ccci_rpc_gpio_adc_out_v2 *out_v2;
+
+			in_v2 = kmalloc_obj(*in_v2);
+			out_v2 = kmalloc_obj(*out_v2);
+			if (in_v2 && out_v2) {
+				memcpy(in_v2, args[0].buf, sizeof(*in_v2));
+				mtk_ccci_rpc_fill_gpio_adc_v2(ccci, in_v2, out_v2);
+				status = MTK_CCCI_RPC_OK;
+				resp[0].len = sizeof(status);
+				resp[0].buf = &status;
+				resp[1].len = sizeof(*out_v2);
+				resp[1].buf = out_v2;
+				mtk_ccci_rpc_send_reply(ccci, &hdr, resp, 2);
+			}
+			kfree(out_v2);
+			kfree(in_v2);
+			return;
+		}
+		status = MTK_CCCI_RPC_PARAM_ERR;
+		resp[0].len = sizeof(status);
+		resp[0].buf = &status;
+		resp[1].len = sizeof(status);
+		resp[1].buf = &status;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_CCCI_LHIF_MAPPING: {
+		if (hdr.para_num == 1 &&
+		    args[0].len >= sizeof(struct mtk_ccci_rpc_lhif_map)) {
+			struct mtk_ccci_rpc_lhif_map map;
+
+			memcpy(&map, args[0].buf, sizeof(map));
+			dev_info(ccci->dev,
+				 "RPC LHIF_MAPPING: net_if=%u lhif_q=%u\n",
+				 map.net_if, map.lhif_q);
+			status = MTK_CCCI_RPC_OK;
+		} else {
+			status = MTK_CCCI_RPC_PARAM_ERR;
+		}
+		resp[0].len = sizeof(status);
+		resp[0].buf = &status;
+		resp[1].len = sizeof(status);
+		resp[1].buf = &status;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_DTSI_QUERY_OP: {
+		if (hdr.para_num == 1 &&
+		    args[0].len >= sizeof(struct mtk_ccci_rpc_dtsi_in)) {
+			struct mtk_ccci_rpc_dtsi_in in;
+			struct mtk_ccci_rpc_dtsi_out out;
+			u32 prop_val;
+
+			memcpy(&in, args[0].buf, sizeof(in));
+			memset(&out, 0x0f, sizeof(out));
+			if (in.req == MTK_RPC_REQ_PROP_VALUE &&
+			    !mtk_ccci_lookup_md_attr(in.str_name,
+						     sizeof(in.str_name),
+						     &prop_val))
+				out.ret_value = prop_val;
+			dev_info(ccci->dev,
+				 "RPC DTSI_QUERY: req=%u name=%.*s -> 0x%08x\n",
+				 in.req,
+				 (int)strnlen(in.str_name, sizeof(in.str_name)),
+				 in.str_name, out.ret_value);
+			status = MTK_CCCI_RPC_OK;
+			resp[0].len = sizeof(status);
+			resp[0].buf = &status;
+			resp[1].len = sizeof(out);
+			resp[1].buf = &out;
+			mtk_ccci_rpc_send_reply(ccci, &hdr, resp, 2);
+			return;
+		}
+		status = MTK_CCCI_RPC_PARAM_ERR;
+		resp[0].len = sizeof(status);
+		resp[0].buf = &status;
+		resp[1].len = sizeof(status);
+		resp[1].buf = &status;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_TRNG: {
+		if (hdr.para_num != 1) {
+			status = MTK_CCCI_RPC_PARAM_ERR;
+			u32_val = status;
+		} else {
+			status = MTK_CCCI_RPC_OK;
+			u32_val = get_random_u32();
+			dev_info(ccci->dev, "RPC TRNG -> 0x%08x\n", u32_val);
+		}
+		resp[0].len = sizeof(status);
+		resp[0].buf = &status;
+		resp[1].len = sizeof(u32_val);
+		resp[1].buf = &u32_val;
+		resp_num = 2;
+		break;
+	}
+
+	case IPC_RPC_QUERY_CARD_TYPE: {
+		dev_info(ccci->dev, "RPC QUERY_CARD_TYPE: para=%u\n",
+			 hdr.para_num);
+		for (i = 0; i < hdr.para_num; i++)
+			resp[i] = args[i];
+		resp_num = hdr.para_num;
+		break;
+	}
+
+	case IPC_RPC_IT_OP: {
+		status = 1;
+		u32_val = 0xa5a5U;
+		dev_info(ccci->dev, "RPC IT_OP -> (1, 0xa5a5)\n");
+		resp[0].len = sizeof(status);
+		resp[0].buf = &status;
+		resp[1].len = sizeof(u32_val);
+		resp[1].buf = &u32_val;
+		resp_num = 2;
+		break;
+	}
+
+	default:
+		dev_warn(ccci->dev,
+			 "RPC unhandled op=0x%08x para=%u len=%u rsv=0x%08x\n",
+			 hdr.op_id, hdr.para_num, len, hdr.ccci.reserved);
+		print_hex_dump(KERN_INFO, "mtk-ccci rpc: ", DUMP_PREFIX_OFFSET,
+			       16, 1, pkt, min_t(u32, len, 64), true);
+		return;
+	}
+
+	mtk_ccci_rpc_send_reply(ccci, &hdr, resp, resp_num);
+	return;
+
+err_malformed:
+	dev_warn(ccci->dev,
+		 "RPC malformed packet op=0x%08x para=%u len=%u\n",
+		 hdr.op_id, hdr.para_num, len);
+	print_hex_dump(KERN_INFO, "mtk-ccci rpc: ", DUMP_PREFIX_OFFSET,
+		       16, 1, pkt, min_t(u32, len, 64), true);
+}
