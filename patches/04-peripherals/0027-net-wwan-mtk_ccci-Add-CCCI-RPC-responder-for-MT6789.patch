+int mtk_ccci_tx_send(struct mtk_ccci_dev *ccci, u32 q, void *buf, u32 len)
+{
+	struct mtk_ccci_header *hdr = buf;
+	unsigned long flags;
+	bool assert_bit;
+	u16 seq;
+	int ret, db_ret;
+
+	if (q >= MTK_CCIF_QUEUE_NUM || !buf || len < sizeof(*hdr) ||
+	    hdr->channel >= MTK_CCCI_MAX_CH)
+		return -EINVAL;
+
+	spin_lock_irqsave(&ccci->tx_lock, flags);
+
+	seq = ccci->tx_seq[hdr->channel]++ & MTK_CCCI_SEQ_MASK;
+	assert_bit = true;
+	if ((hdr->channel == CCCI_CH_RPC_TX || hdr->channel == CCCI_CH_FS_TX) &&
+	    READ_ONCE(ccci->state) != MTK_CCCI_STATE_HS1_DONE)
+		assert_bit = false;
+	hdr->seq_assert = FIELD_PREP(MTK_CCCI_SEQ_MASK, seq) |
+			  (assert_bit ? MTK_CCCI_ASSERT_BIT : 0);
+
+	ret = mtk_ccci_rb_write(&ccci->rb_normal[q], buf, len);
+	if (ret != len) {
+		spin_unlock_irqrestore(&ccci->tx_lock, flags);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	db_ret = mtk_ccif_ring_doorbell(ccci, q);
+	spin_unlock_irqrestore(&ccci->tx_lock, flags);
+
+	/*
+	 * If APCCIF_BUSY is already set for queue q, MD already has a pending
+	 * doorbell interrupt and will drain all queued ringbuffer packets.
+	 */
+	if (db_ret && db_ret != -EBUSY)
+		return db_ret;
+
+	return 0;
+}
+
 /*
  * Parse LK's ccci_tag_mem (0xbf7f0000) without touching EMI-MPU-locked md1img
  * DRAM directly. Supports both v1 (16-byte tag name) and v2 (64-byte tag name).
@@ -710,48 +755,93 @@ static void mtk_ccci_handle_sram_rx(struct mtk_ccci_dev *ccci)
 	    dl_hdr.data[1] == CCCI_MD_INIT_START_BOOT &&
 	    dl_hdr.reserved == CCCI_MD_INIT_CHK_ID) {
 		atomic_set(&ccci->hs1_done, 1);
-		ccci->state = MTK_CCCI_STATE_HS1_DONE;
+		WRITE_ONCE(ccci->state, MTK_CCCI_STATE_HS1_DONE);
 		complete(&ccci->hs1_comp);
 		dev_info(ccci->dev, "HS1 complete — negotiating runtime features\n");
 
 		if (mtk_ccci_prepare_and_send_hs2(ccci, &md_q))
-			ccci->state = MTK_CCCI_STATE_FAILED;
+			WRITE_ONCE(ccci->state, MTK_CCCI_STATE_FAILED);
 	}
 }
 
 static void mtk_ccci_drain_queue(struct mtk_ccci_dev *ccci, u32 q)
 {
 	struct mtk_ccci_header hdr;
-	u8 tmp[64];
 	int ret;
 
-	while ((ret = mtk_ccci_rb_read(&ccci->rb_normal[q], tmp, sizeof(tmp))) >= 0) {
+	while ((ret = mtk_ccci_rb_read(&ccci->rb_normal[q], ccci->rx_buf,
+				       MTK_CCCI_RX_BUF_SIZE)) >= 0) {
 		int cnt = atomic_inc_return(&ccci->rx_packets);
+		u32 copy_len = min_t(u32, ret, MTK_CCCI_RX_BUF_SIZE);
+
+		if (ret > MTK_CCCI_RX_BUF_SIZE) {
+			dev_warn(ccci->dev,
+				 "CCIF Q%u RX #%d truncated: len=%d > %u\n",
+				 q, cnt, ret, MTK_CCCI_RX_BUF_SIZE);
+			print_hex_dump(KERN_INFO, "mtk-ccci rx: ",
+				       DUMP_PREFIX_OFFSET, 16, 1,
+				       ccci->rx_buf, min_t(u32, copy_len, 64),
+				       true);
+			continue;
+		}
 
 		if (ret < sizeof(hdr))
 			continue;
-		memcpy(&hdr, tmp, sizeof(hdr));
+		memcpy(&hdr, ccci->rx_buf, sizeof(hdr));
 
-		if (cnt <= 16 || hdr.channel == CCCI_CH_CONTROL_RX)
+		if (cnt <= 32 || hdr.channel == CCCI_CH_CONTROL_RX)
 			dev_info(ccci->dev,
-				 "CCIF Q%u RX #%d: ch=%u len=%d d0=0x%08x d1=0x%08x rsv=0x%08x\n",
+				 "CCIF Q%u RX #%d: ch=%u len=%d d0=0x%08x d1=0x%08x seq=0x%04x rsv=0x%08x\n",
 				 q, cnt, hdr.channel, ret, hdr.data[0],
-				 hdr.data[1], hdr.reserved);
+				 hdr.data[1], hdr.seq_assert, hdr.reserved);
 
-		if (hdr.channel == CCCI_CH_CONTROL_RX) {
+		switch (hdr.channel) {
+		case CCCI_CH_CONTROL_RX:
 			if (hdr.data[1] == CCCI_MD_INIT_START_BOOT &&
 			    hdr.reserved != CCCI_MD_INIT_CHK_ID) {
 				atomic_set(&ccci->hs2_done, 1);
-				ccci->state = MTK_CCCI_STATE_READY;
+				WRITE_ONCE(ccci->state, MTK_CCCI_STATE_READY);
 				complete(&ccci->hs2_comp);
 				dev_info(ccci->dev, "HS2 complete — MD READY!\n");
 			} else if (hdr.data[1] == CCCI_MD_EX ||
 				   hdr.data[1] == CCCI_MD_EX_REC_OK ||
 				   hdr.data[1] == CCCI_DRV_VER_ERROR) {
-				ccci->state = MTK_CCCI_STATE_EXCEPTION;
+				WRITE_ONCE(ccci->state, MTK_CCCI_STATE_EXCEPTION);
 				dev_err(ccci->dev, "MD control exception msg=0x%x rsv=0x%x\n",
 					hdr.data[1], hdr.reserved);
+			} else {
+				print_hex_dump(KERN_INFO, "mtk-ccci ctrl: ",
+					       DUMP_PREFIX_OFFSET, 16, 1,
+					       ccci->rx_buf,
+					       min_t(u32, ret, 64), true);
 			}
+			break;
+		case CCCI_CH_RPC_RX:
+			mtk_ccci_rpc_handle(ccci, ccci->rx_buf, ret);
+			break;
+		case CCCI_CH_FS_RX: {
+			u32 fs_op = 0;
+
+			if (ret >= sizeof(hdr) + sizeof(fs_op))
+				memcpy(&fs_op, ccci->rx_buf + sizeof(hdr),
+				       sizeof(fs_op));
+			dev_info(ccci->dev,
+				 "CCIF Q%u FS RX (log-only): len=%d op=0x%08x rsv=0x%08x\n",
+				 q, ret, fs_op, hdr.reserved);
+			if (cnt <= 32)
+				print_hex_dump(KERN_INFO, "mtk-ccci fs: ",
+					       DUMP_PREFIX_OFFSET, 16, 1,
+					       ccci->rx_buf,
+					       min_t(u32, ret, 64), true);
+			break;
+		}
+		default:
+			if (cnt <= 32)
+				print_hex_dump(KERN_INFO, "mtk-ccci pkt: ",
+					       DUMP_PREFIX_OFFSET, 16, 1,
+					       ccci->rx_buf,
+					       min_t(u32, ret, 64), true);
+			break;
 		}
 	}
 }
@@ -787,7 +877,7 @@ static irqreturn_t mtk_ccci_ccif_irq0(int irq, void *data)
 	wmb();
 
 	set_mask_bits(&ccci->pending_ch, 0, ack);
-	schedule_work(&ccci->rx_work);
