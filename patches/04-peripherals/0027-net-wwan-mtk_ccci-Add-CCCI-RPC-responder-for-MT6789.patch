diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_rpc.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_rpc.c
new file mode 100644
index 000000000..6403806bb
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_rpc.c
@@ -0,0 +1,705 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 CCCI kernel RPC responder (ch=32 -> ch=33 over CCIF0 Q1).
+ *
+ * Wire framing and opcode IDs match the Gen95 CCCI RPC ABI. All returned
+ * SIM EINT, GPIO, AUXADC, and md_attr values are sourced strictly from the
+ * Advan X1 runtime-merged DT, stock ccci_md_all.ko, and stock ccci_dump.log.
+ *
+ * Copyright (c) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/align.h>
+#include <linux/build_bug.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <linux/printk.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "mtk_ccci.h"
+
+#define MTK_CCCI_RPC_MAX_ARG		6
+#define MTK_CCCI_RPC_MAX_BUF		2048U
+#define MTK_CCCI_RPC_RESP_MASK		0xffff0000U
+#define MTK_CCCI_RPC_MAX_REQ_IDX	2U
+
+/* RPC status / error codes (Gen95 CCCI FS/RPC ABI) */
+#define MTK_CCCI_RPC_OK			0
+#define MTK_CCCI_RPC_NO_OP		(-1)
+#define MTK_CCCI_RPC_PARAM_ERR		(-2)
+#define MTK_CCCI_RPC_FUNC_FAIL		(-5)
+
+/* SIM hot-plug EINT query error codes */
+#define MTK_CCCI_EINT_ERR_TYPE		(-12)
+#define MTK_CCCI_EINT_ERR_STRING	(-11)
+
+/* Gen95 IPC RPC operation IDs */
+enum mtk_ccci_rpc_op {
+	IPC_RPC_GET_TDD_EINT_NUM_OP	= 0x4001,
+	IPC_RPC_GET_GPIO_NUM_OP		= 0x4002,
+	IPC_RPC_GET_ADC_NUM_OP		= 0x4003,
+	IPC_RPC_GET_EMI_CLK_TYPE_OP	= 0x4004,
+	IPC_RPC_GET_EINT_ATTR_OP	= 0x4005,
+	IPC_RPC_GET_GPIO_VAL_OP		= 0x4006,
+	IPC_RPC_GET_ADC_VAL_OP		= 0x4007,
+	IPC_RPC_GET_GPIO_ADC_OP		= 0x4009,
+	IPC_RPC_CCCI_LHIF_MAPPING	= 0x400d,
+	IPC_RPC_DTSI_QUERY_OP		= 0x400e,
+	IPC_RPC_TRNG			= 0x4012,
+	IPC_RPC_QUERY_CARD_TYPE		= 0x4013,
+	IPC_RPC_IT_OP			= 0x4321,
+};
+
+enum mtk_ccci_sim_eint_type {
