From 68276d1880da319f284dede6a5419636092cbdbf Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Wed, 25 Nov 2026 13:02:41 +0000
Subject: [PATCH] dt-bindings: soc: mediatek: Add MT6366 DCXO clock buffer
 binding

Add devicetree binding schema for the MediaTek MT6366 PMIC DCXO clock
buffer sub-device and reference it from mediatek,mt6397.yaml.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../bindings/mfd/mediatek,mt6397.yaml         |  7 +++
 .../soc/mediatek/mediatek,mt6366-clkbuf.yaml  | 49 +++++++++++++++++++
 2 files changed, 56 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6366-clkbuf.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
index 673df49c9..1790788b1 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
@@ -161,6 +161,13 @@ properties:
     description:
       Headset jack and button accessory detection (ACCDET).
 
+  clock-buffer:
+    type: object
+    $ref: /schemas/soc/mediatek/mediatek,mt6366-clkbuf.yaml#
+    unevaluatedProperties: false
+    description:
+      MT6366 PMIC DCXO external clock buffer control.
+
   clocks:
     type: object
     additionalProperties: false
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6366-clkbuf.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6366-clkbuf.yaml
new file mode 100644
index 000000000..817a13ae5
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6366-clkbuf.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6366-clkbuf.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6366 PMIC DCXO Clock Buffer
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+description: |
+  The MediaTek MT6366 PMIC integrates a 26 MHz DCXO clock buffer block with
+  independently switchable external clock outputs (XO_SOC, XO_WCN, XO_NFC,
+  XO_CEL). This sub-device of the MT6397/MT6358 PMIC MFD enables board-wide
+  DCXO outputs such as XO_NFC (index 2) for peripherals whose upstream
+  drivers do not model a PMIC clock buffer consumer.
+
+properties:
+  compatible:
+    const: mediatek,mt6366-clkbuf
+
+  mediatek,xo-buf-enable:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: |
+      List of DCXO external clock buffer indices to enable in software mode
+      at probe:
+        0 - XO_SOC (EXTBUF1)
+        1 - XO_WCN (EXTBUF2)
+        2 - XO_NFC (EXTBUF3)
+        3 - XO_CEL (EXTBUF4)
+    minItems: 1
+    maxItems: 4
+    items:
+      minimum: 0
+      maximum: 3
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-buffer {
+        compatible = "mediatek,mt6366-clkbuf";
+        mediatek,xo-buf-enable = <2>;
+    };
-- 
2.55.0

