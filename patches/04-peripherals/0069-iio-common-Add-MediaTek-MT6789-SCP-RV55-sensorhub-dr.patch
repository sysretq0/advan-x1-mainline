+static void scp_register_one_iio(struct mtk_scp_hub *hub,
+				 const struct scp_shm_info *info)
+{
+	const struct iio_chan_spec *chans;
+	const struct iio_info *iio_info = &scp_sensor_iio_info;
+	struct iio_dev *indio_dev;
+	struct mtk_scp_sensor *s;
+	const char *iio_name;
+	int num_chans, ret;
+
+	if (hub->num_sensors >= SCP_MAX_IIO_SENSORS ||
+	    info->sensor_type >= SCP_SENSOR_MAX_TYPE ||
+	    hub->by_type[info->sensor_type] || !info->gain)
+		return;
+
+	switch (info->sensor_type) {
+	case SCP_SENSOR_ACCEL:
+		chans = scp_accel_chans;
+		num_chans = ARRAY_SIZE(scp_accel_chans);
+		iio_name = "mtk-scp-accel";
+		break;
+	case SCP_SENSOR_GYRO:
+		chans = scp_gyro_chans;
+		num_chans = ARRAY_SIZE(scp_gyro_chans);
+		iio_name = "mtk-scp-gyro";
+		break;
+	case SCP_SENSOR_MAGN:
+		chans = scp_magn_chans;
+		num_chans = ARRAY_SIZE(scp_magn_chans);
+		iio_name = "mtk-scp-magn";
+		break;
+	case SCP_SENSOR_LIGHT:
+		chans = scp_light_chans;
+		num_chans = ARRAY_SIZE(scp_light_chans);
+		iio_name = "mtk-scp-light";
+		break;
+	case SCP_SENSOR_PROXIMITY:
+		chans = scp_prox_chans;
+		num_chans = ARRAY_SIZE(scp_prox_chans);
+		iio_name = "mtk-scp-proximity";
+		iio_info = &scp_prox_iio_info;
+		break;
+	default:
+		return;
+	}
+
+	indio_dev = iio_device_alloc(hub->dev, sizeof(*s));
+	if (!indio_dev)
+		return;
+
+	s = iio_priv(indio_dev);
+	s->hub = hub;
+	s->indio_dev = indio_dev;
+	s->sensor_type = info->sensor_type;
+	s->gain = info->gain;
+	strscpy(s->name, iio_name, sizeof(s->name));
+	mutex_init(&s->lock);
+	init_completion(&s->sample_done);
+	INIT_DELAYED_WORK(&s->idle_work, scp_sensor_idle_fn);
+
+	indio_dev->name = s->name;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->info = iio_info;
+	indio_dev->channels = chans;
+	indio_dev->num_channels = num_chans;
+
+	hub->by_type[info->sensor_type] = s;
+	ret = iio_device_register(indio_dev);
+	if (ret) {
+		hub->by_type[info->sensor_type] = NULL;
+		iio_device_free(indio_dev);
+		dev_warn(hub->dev, "failed to register %s: %d\n", s->name, ret);
+		return;
+	}
+
+	hub->sensors[hub->num_sensors++] = s;
+	dev_info(hub->dev, "registered %s (hw=%.16s vendor=%.16s gain=%u)\n",
+		 s->name, info->name, info->vendor, info->gain);
+}
