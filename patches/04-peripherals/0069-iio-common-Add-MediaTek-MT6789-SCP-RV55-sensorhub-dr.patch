+static int scp_configure_share_mem(struct mtk_scp_hub *hub)
+{
+	static const struct {
+		u8 type;
+		u32 off;
+		u32 size;
+		u32 item_size;
+	} regions[] = {
+		{ SHM_TYPE_DATA,       SCP_SHM_DATA_OFF,     SCP_SHM_DATA_SIZE,     sizeof(struct scp_shm_data) },
+		{ SHM_TYPE_SUPER_DATA, SCP_SHM_SUPER_OFF,    SCP_SHM_SUPER_SIZE,    76 },
+		{ SHM_TYPE_LIST,       SCP_SHM_LIST_OFF,     SCP_SHM_LIST_SIZE,     sizeof(struct scp_shm_info) },
+		{ SHM_TYPE_DEBUG,      SCP_SHM_DEBUG_OFF,    SCP_SHM_DEBUG_SIZE,    4040 },
+		{ SHM_TYPE_CUSTOM_W,   SCP_SHM_CUSTOM_W_OFF, SCP_SHM_CUSTOM_W_SIZE, 64 },
+		{ SHM_TYPE_CUSTOM_R,   SCP_SHM_CUSTOM_R_OFF, SCP_SHM_CUSTOM_R_SIZE, 64 },
+	};
+	struct scp_sens_share_mem msg = {};
+	int i, idx = 0, ret;
+
+	for (i = 0; i < ARRAY_SIZE(regions); i++) {
+		struct scp_shm_base __iomem *b = hub->shm_virt + regions[i].off;
+
+		scp_shm_ring_init(b, regions[i].size, regions[i].item_size);
+		if (regions[i].type == SHM_TYPE_DATA)
+			hub->data_shm = b;
+		else if (regions[i].type == SHM_TYPE_LIST)
+			hub->list_shm = b;
+
+		msg.base_info[idx].payload_type = regions[i].type;
+		msg.base_info[idx].payload_base = (u32)(hub->shm_phys + regions[i].off);
+		msg.available_num = ++idx;
+
+		if (idx == ARRAY_SIZE(msg.base_info) || i == ARRAY_SIZE(regions) - 1) {
+			ret = scp_send_ctrl(hub, SCP_SENSOR_INVALID,
+					    SENS_COMM_CTRL_SHARE_MEMORY_CMD,
+					    &msg, sizeof(msg));
+			if (ret)
+				return ret;
+			idx = 0;
+			memset(&msg, 0, sizeof(msg));
+		}
+	}
+
+	return 0;
+}
+
+static int scp_discover_sensors(struct mtk_scp_hub *hub)
+{
+	struct scp_sens_notify n = {};
+	struct scp_shm_info list[32];
+	unsigned long flags;
+	u32 wp;
+	int bytes, i, count, ret;
+
+	writel(0, &hub->list_shm->rp);
+	wmb();
+	reinit_completion(&hub->list_done);
+
+	n.sequence = (u8)atomic_inc_return(&hub->list_seq);
+	n.sensor_type = SCP_SENSOR_INVALID;
+	n.command = SENS_COMM_NOTIFY_LIST_CMD;
+	n.length = 0;
+
+	ret = scp_send_notify(hub, &n);
+	if (ret)
+		return ret;
+
+	if (!wait_for_completion_timeout(&hub->list_done, msecs_to_jiffies(1000)))
+		return -ETIMEDOUT;
+
+	spin_lock_irqsave(&hub->rx_lock, flags);
+	wp = hub->list_wp;
+	spin_unlock_irqrestore(&hub->rx_lock, flags);
+
+	bytes = scp_shm_ring_read(hub->list_shm, wp, list, sizeof(list),
+				  sizeof(list[0]));
+	if (bytes <= 0)
+		return bytes < 0 ? bytes : -ENODEV;
+
+	count = bytes / sizeof(list[0]);
+	for (i = 0; i < count; i++)
+		scp_register_one_iio(hub, &list[i]);
+
+	return 0;
+}
+
+static void scp_init_work_fn(struct work_struct *work)
+{
+	struct mtk_scp_hub *hub = container_of(work, struct mtk_scp_hub, init_work);
+	struct scp_sens_notify ready_msg = {};
+	struct arm_smccc_res res;
+	int ret;
+
+	/* Request 26M resource and release SCP Core 0 reset via EL3 BL31 */
+	scp_dvfs_req(SCP_REQ_26M);
+	arm_smccc_smc(MTK_SIP_TINYSYS_SCP_CONTROL, SCP_KERNEL_OP_RESET_RELEASE,
+		      0, 0, 0, 0, 0, 0, &res);
+
+	if (!wait_for_completion_timeout(&hub->scp_ready_done,
+					 msecs_to_jiffies(5000))) {
+		dev_warn(hub->dev, "SCP RV55 boot ready timeout (firmware preloaded by bootloader?)\n");
+		scp_dvfs_req(SCP_REQ_RELEASE);
+		return;
+	}
+
+	/* Clear pending SPM IPC bit after boot ready */
+	writel(0xff, hub->cfg_base + SCP_TO_SPM_REG);
+	scp_dvfs_req(SCP_REQ_RELEASE);
+
+	/* Handshake with SCP sensorhub 2.0 task */
+	reinit_completion(&hub->sens_ready_done);
+	ready_msg.sequence = 0;
+	ready_msg.sensor_type = SCP_SENSOR_INVALID;
+	ready_msg.command = SENS_COMM_NOTIFY_READY_CMD;
+	ready_msg.length = 0;
+
+	ret = scp_send_notify(hub, &ready_msg);
+	if (ret) {
+		dev_err(hub->dev, "failed to send sensorhub ready notify: %d\n", ret);
+		return;
+	}
+
+	if (!wait_for_completion_timeout(&hub->sens_ready_done,
+					 msecs_to_jiffies(10000))) {
+		dev_warn(hub->dev, "SCP sensorhub ready handshake timeout\n");
+		return;
+	}
+
+	ret = scp_configure_share_mem(hub);
+	if (ret) {
+		dev_err(hub->dev, "failed to configure SCP shared memory: %d\n", ret);
+		return;
+	}
+
+	hub->ready = true;
+	ret = scp_discover_sensors(hub);
+	if (ret) {
+		dev_warn(hub->dev, "failed to query SCP sensor list: %d\n", ret);
+		return;
+	}
+
+	dev_info(hub->dev, "MT6789 SCP RV55 sensorhub online (%u IIO sensors)\n",
+		 hub->num_sensors);
+}
+
+static int mtk_scp_sensorhub_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *rmem_np;
+	struct reserved_mem *rmem;
+	struct mtk_scp_hub *hub;
+	int irq1, irq2, irq3, ret;
+
+	hub = devm_kzalloc_obj(dev, *hub);
+	if (!hub)
+		return -ENOMEM;
+
+	hub->dev = dev;
+	platform_set_drvdata(pdev, hub);
+
+	ret = iio_read_mount_matrix(dev, &hub->mount_matrix);
+	if (ret)
+		return ret;
+
+	mutex_init(&hub->tx_lock);
+	mutex_init(&hub->ctrl_lock);
+	mutex_init(&hub->shm_read_lock);
+	spin_lock_init(&hub->rx_lock);
+	init_completion(&hub->scp_ready_done);
+	init_completion(&hub->sens_ready_done);
+	init_completion(&hub->ctrl_ack_done);
+	init_completion(&hub->list_done);
+	INIT_WORK(&hub->init_work, scp_init_work_fn);
+	INIT_WORK(&hub->data_work, scp_data_work_fn);
+
+	hub->cfg_base = devm_platform_ioremap_resource_byname(pdev, "cfg");
+	if (IS_ERR(hub->cfg_base))
+		return PTR_ERR(hub->cfg_base);
+
+	hub->mbox1_base = devm_platform_ioremap_resource_byname(pdev, "mbox1");
+	if (IS_ERR(hub->mbox1_base))
+		return PTR_ERR(hub->mbox1_base);
+
+	hub->mbox2_base = devm_platform_ioremap_resource_byname(pdev, "mbox2");
+	if (IS_ERR(hub->mbox2_base))
+		return PTR_ERR(hub->mbox2_base);
+
+	hub->mbox3_base = devm_platform_ioremap_resource_byname(pdev, "mbox3");
+	if (IS_ERR(hub->mbox3_base))
+		return PTR_ERR(hub->mbox3_base);
+
+	hub->infracfg = syscon_regmap_lookup_by_phandle(dev->of_node, "mediatek,infracfg");
+	if (IS_ERR(hub->infracfg))
+		return dev_err_probe(dev, PTR_ERR(hub->infracfg),
+				     "failed to lookup infracfg regmap\n");
+
+	hub->scp_clk = devm_clk_get_enabled(dev, "scp");
+	if (IS_ERR(hub->scp_clk))
+		return dev_err_probe(dev, PTR_ERR(hub->scp_clk),
+				     "failed to enable scp clock\n");
+
+	rmem_np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!rmem_np)
+		return dev_err_probe(dev, -ENODEV, "missing memory-region\n");
+
+	rmem = of_reserved_mem_lookup(rmem_np);
+	of_node_put(rmem_np);
+	if (!rmem || rmem->size < SCP_SHM_MIN_TOTAL_SIZE)
+		return dev_err_probe(dev, -EINVAL, "invalid scp_share_mem region\n");
+
+	hub->shm_phys = rmem->base;
+	hub->shm_size = rmem->size;
+	hub->shm_virt = devm_ioremap_wc(dev, hub->shm_phys, hub->shm_size);
+	if (!hub->shm_virt)
+		return -ENOMEM;
+
+	irq1 = platform_get_irq_byname(pdev, "mbox1");
+	if (irq1 < 0)
+		return irq1;
+	irq2 = platform_get_irq_byname(pdev, "mbox2");
+	if (irq2 < 0)
+		return irq2;
+	irq3 = platform_get_irq_byname(pdev, "mbox3");
+	if (irq3 < 0)
+		return irq3;
+
+	ret = devm_request_irq(dev, irq1, scp_mbox1_isr, 0, "scp-mbox1", hub);
+	if (ret)
+		return ret;
+	ret = devm_request_irq(dev, irq2, scp_mbox2_isr, 0, "scp-mbox2", hub);
+	if (ret)
+		return ret;
+	ret = devm_request_irq(dev, irq3, scp_mbox3_isr, 0, "scp-mbox3", hub);
+	if (ret)
+		return ret;
+
+	schedule_work(&hub->init_work);
+	return 0;
+}
+
+static void mtk_scp_sensorhub_remove(struct platform_device *pdev)
+{
+	struct mtk_scp_hub *hub = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	cancel_work_sync(&hub->init_work);
+	hub->ready = false;
+
+	for (i = 0; i < hub->num_sensors; i++) {
+		struct mtk_scp_sensor *s = hub->sensors[i];
+
+		cancel_delayed_work_sync(&s->idle_work);
+		iio_device_unregister(s->indio_dev);
+		if (s->enabled)
+			scp_sensor_set_enable(s, false);
+		iio_device_free(s->indio_dev);
+	}
+
+	cancel_work_sync(&hub->data_work);
+}
+
+static int mtk_scp_sensorhub_suspend(struct device *dev)
+{
+	struct mtk_scp_hub *hub = dev_get_drvdata(dev);
+
+	if (hub->ready)
+		scp_send_ctrl(hub, SCP_SENSOR_INVALID,
+			      SENS_COMM_CTRL_MASK_NOTIFY_CMD, NULL, 0);
+	return 0;
+}
+
+static int mtk_scp_sensorhub_resume(struct device *dev)
+{
+	struct mtk_scp_hub *hub = dev_get_drvdata(dev);
+
+	if (hub->ready)
+		scp_send_ctrl(hub, SCP_SENSOR_INVALID,
+			      SENS_COMM_CTRL_UNMASK_NOTIFY_CMD, NULL, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(mtk_scp_sensorhub_pm_ops,
+				mtk_scp_sensorhub_suspend,
+				mtk_scp_sensorhub_resume);
+
+static const struct of_device_id mtk_scp_sensorhub_of_match[] = {
+	{ .compatible = "mediatek,mt6789-scp-sensorhub" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mtk_scp_sensorhub_of_match);
+
+static struct platform_driver mtk_scp_sensorhub_driver = {
+	.probe = mtk_scp_sensorhub_probe,
+	.remove = mtk_scp_sensorhub_remove,
+	.driver = {
+		.name = "mtk-scp-sensorhub",
+		.of_match_table = mtk_scp_sensorhub_of_match,
+		.pm = pm_sleep_ptr(&mtk_scp_sensorhub_pm_ops),
+	},
+};
+module_platform_driver(mtk_scp_sensorhub_driver);
+
