From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sat, 28 Nov 2026 00:15:00 +0700
Subject: [PATCH] iio: common: Add MediaTek MT6789 SCP RV55 sensorhub driver

Add a Linux IIO driver interfacing with the preloaded MediaTek MT6789
SCP RV55 sensorhub 2.0 firmware over hardware mailboxes (mbox1..3),
SCPSYS awake-lock IPC, EL3 BL31 reset-release/DVFS SMCs, and reserved
DRAM shared-memory rings.

Discovers live physical sensors from SCP and registers standard Linux
IIO devices for accelerometer, gyroscope, magnetometer, ambient light,
and proximity with on-demand enable, automatic idle power-down, and
suspend/resume notification masking.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
diff --git a/drivers/iio/common/Kconfig b/drivers/iio/common/Kconfig
--- a/drivers/iio/common/Kconfig
+++ b/drivers/iio/common/Kconfig
@@ -7,6 +7,7 @@
 source "drivers/iio/common/hid-sensors/Kconfig"
 source "drivers/iio/common/inv_sensors/Kconfig"
 source "drivers/iio/common/ms_sensors/Kconfig"
+source "drivers/iio/common/mtk_scp_sensors/Kconfig"
 source "drivers/iio/common/scmi_sensors/Kconfig"
 source "drivers/iio/common/ssp_sensors/Kconfig"
 source "drivers/iio/common/st_sensors/Kconfig"
diff --git a/drivers/iio/common/Makefile b/drivers/iio/common/Makefile
--- a/drivers/iio/common/Makefile
+++ b/drivers/iio/common/Makefile
@@ -12,6 +12,7 @@
 obj-y += hid-sensors/
 obj-y += inv_sensors/
 obj-y += ms_sensors/
+obj-y += mtk_scp_sensors/
 obj-y += scmi_sensors/
 obj-y += ssp_sensors/
 obj-y += st_sensors/
diff --git a/drivers/iio/common/mtk_scp_sensors/Kconfig b/drivers/iio/common/mtk_scp_sensors/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/iio/common/mtk_scp_sensors/Kconfig
@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config IIO_MTK_SCP_SENSORHUB
+	tristate "MediaTek MT6789 SCP RV55 Sensor Hub IIO driver"
+	depends on IIO && (ARCH_MEDIATEK || COMPILE_TEST)
+	depends on HAVE_ARM_SMCCC
+	select MFD_SYSCON
+	help
+	  Say yes here to build support for the MediaTek MT6789 SCP RV55
+	  sensor hub over hardware mailboxes and reserved DRAM rings,
+	  exposing accelerometer, gyroscope, magnetometer, ambient light,
+	  and proximity sensors as standard Linux IIO devices.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mtk_scp_sensorhub.
diff --git a/drivers/iio/common/mtk_scp_sensors/Makefile b/drivers/iio/common/mtk_scp_sensors/Makefile
new file mode 100644
--- /dev/null
+++ b/drivers/iio/common/mtk_scp_sensors/Makefile
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_IIO_MTK_SCP_SENSORHUB) += mtk_scp_sensorhub.o
diff --git a/drivers/iio/common/mtk_scp_sensors/mtk_scp_sensorhub.c b/drivers/iio/common/mtk_scp_sensors/mtk_scp_sensorhub.c
new file mode 100644
--- /dev/null
+++ b/drivers/iio/common/mtk_scp_sensors/mtk_scp_sensorhub.c
@@ -0,0 +1,1197 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 SCP RV55 Sensor Hub IIO driver.
+ *
+ * Interfaces with the preloaded MT6789 SCP RV55 sensorhub 2.0 firmware over
+ * hardware mailboxes (mbox1..3) and the reserved DRAM shared-memory rings,
+ * exposing physical sensors (accelerometer, gyroscope, magnetometer, ambient
+ * light, and proximity) as standard Linux IIO devices.
+ *
+ * Copyright (C) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/build_bug.h>
+#include <linux/cleanup.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/sysfs.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
+
+/* EL3 BL31 SiP SMC ABIs verified against MT6789 TF-A */
+#define MTK_SIP_SCP_DVFS_CONTROL \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64, \
+			   ARM_SMCCC_OWNER_SIP, 0x232)
+#define SCP_DVFS_RESOURCE_REQ		1
+#define SCP_REQ_RELEASE			0
+#define SCP_REQ_26M			1
+
+#define MTK_SIP_TINYSYS_SCP_CONTROL \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64, \
+			   ARM_SMCCC_OWNER_SIP, 0x528)
+#define SCP_KERNEL_OP_RESET_RELEASE	3
+
+/* SCP configuration & infracfg_ao awake-lock IPC registers */
+#define SCP_TO_SPM_REG			0x0094
+#define INFRACFG_SCP_IRQ_SET		0x0b14
+#define INFRACFG_SCP_IRQ_CLEAR		0x0b18
+#define SCP_AWAKE_KEY			0xa0
+#define SCP_AWAKE_LOCK_BIT		BIT(0)
+#define SCP_AWAKE_UNLOCK_BIT		BIT(1)
+#define SCP_AWAKE_TIMEOUT_US		100000
+
+/* Hardware mailbox offsets (64-slot / 256-byte SRAM window + set/clr IRQ) */
+#define MBOX_SET_IRQ_OFF		0x0100
+#define MBOX_CLR_IRQ_OFF		0x010c
+
+/* MT6789 mbox1..3 pin bit indices and byte offsets (is64d=1 table) */
+#define MBOX1_RECV_READY0_BIT		BIT(15)
+#define MBOX1_RECV_READY0_OFF		0x0078
+
+#define MBOX2_SEND_CTRL_BIT		BIT(0)
+#define MBOX2_SEND_CTRL_OFF		0x0000
+#define MBOX2_SEND_CTRL_MAX_BYTES	64
+
+#define MBOX2_SEND_NOTIFY_BIT		BIT(8)
+#define MBOX2_SEND_NOTIFY_OFF		0x0040
+#define MBOX2_SEND_NOTIFY_BYTES		28
+
+#define MBOX2_RECV_CTRL_BIT		BIT(13)
+#define MBOX2_RECV_CTRL_OFF		0x0068
+
+#define MBOX2_RECV_NOTIFY_BIT		BIT(14)
+#define MBOX2_RECV_NOTIFY_OFF		0x0070
+
+#define MBOX3_RECV_READY1_BIT		BIT(15)
+
+/* MT6789 scp_share_mem (0x8f000000, 0x7a0000) sub-region offsets & sizes */
+#define SCP_SHM_MIN_TOTAL_SIZE		0x719000
+#define SCP_SHM_DATA_OFF		0x24e300
+#define SCP_SHM_DATA_SIZE		0x100000
+#define SCP_SHM_SUPER_OFF		0x6ece00
+#define SCP_SHM_SUPER_SIZE		0x010000
+#define SCP_SHM_LIST_OFF		0x6fce00
+#define SCP_SHM_LIST_SIZE		0x001000
+#define SCP_SHM_DEBUG_OFF		0x6fde00
+#define SCP_SHM_DEBUG_SIZE		0x002000
+#define SCP_SHM_CUSTOM_W_OFF		0x6ffe00
+#define SCP_SHM_CUSTOM_W_SIZE		0x000100
+#define SCP_SHM_CUSTOM_R_OFF		0x6fff00
+#define SCP_SHM_CUSTOM_R_SIZE		0x000100
+
+/* Sensorhub 2.0 protocol commands */
+enum scp_sens_ctrl_cmd {
+	SENS_COMM_CTRL_DISABLE_CMD	= 0,
+	SENS_COMM_CTRL_ENABLE_CMD	= 1,
+	SENS_COMM_CTRL_MASK_NOTIFY_CMD	= 8,
+	SENS_COMM_CTRL_UNMASK_NOTIFY_CMD = 9,
+	SENS_COMM_CTRL_SHARE_MEMORY_CMD	= 11,
+};
+
+enum scp_sens_notify_cmd {
+	SENS_COMM_NOTIFY_DATA_CMD	= 0,
+	SENS_COMM_NOTIFY_FULL_CMD	= 1,
+	SENS_COMM_NOTIFY_READY_CMD	= 4,
+	SENS_COMM_NOTIFY_LIST_CMD	= 5,
+};
+
+enum scp_shm_payload_type {
+	SHM_TYPE_DATA		= 0,
+	SHM_TYPE_SUPER_DATA	= 1,
+	SHM_TYPE_LIST		= 2,
+	SHM_TYPE_DEBUG		= 3,
+	SHM_TYPE_CUSTOM_W	= 4,
+	SHM_TYPE_CUSTOM_R	= 5,
+};
+
+/* Android/HF sensor types exposed by SCP RV55 */
+#define SCP_SENSOR_INVALID	0
+#define SCP_SENSOR_ACCEL	1
+#define SCP_SENSOR_MAGN		2
+#define SCP_SENSOR_GYRO		4
+#define SCP_SENSOR_LIGHT	5
+#define SCP_SENSOR_PROXIMITY	8
+#define SCP_SENSOR_MAX_TYPE	72
+
+#define SCP_ACTION_DATA		0
+
+#define SCP_MAX_IIO_SENSORS	5
+#define SCP_IDLE_DISABLE_MS	10000
+
+/* Wire-format structs matching MT6789 SCP sensorhub 2.0 ABI */
+struct scp_sens_batch {
+	s64 delay_ns;
+	s64 latency_ns;
+} __packed __aligned(4);
+
+struct scp_sens_shm_entry {
+	u8 payload_type;
+	u8 pad[3];
+	u32 payload_base;
+} __packed;
+
+struct scp_sens_share_mem {
+	u8 available_num;
+	struct scp_sens_shm_entry base_info[4];
+	u8 tail_pad[3];
+} __packed __aligned(4);
+
+struct scp_sens_ctrl {
+	u8 sequence;
+	u8 sensor_type;
+	u8 command;
+	u8 length;
+	u8 crc8;
+	u8 pad[3];
+	u8 data[] __aligned(4);
+} __packed __aligned(4);
+
+struct scp_sens_ack {
+	u8 sequence;
+	u8 sensor_type;
+	u8 command;
+	s8 ret_val;
+	u8 crc8;
+	u8 pad[3];
+} __packed __aligned(4);
+
+struct scp_sens_notify {
+	u8 sequence;
+	u8 sensor_type;
+	u8 command;
+	u8 length;
+	u8 crc8;
+	u8 pad[3];
+	s32 value[5];
+} __packed __aligned(4);
+
+struct scp_shm_base {
+	u32 rp;
+	u32 wp;
+	u32 buffer_size;
+	u32 item_size;
+	u8 data[];
+} __packed __aligned(4);
+
+struct scp_shm_data {
+	u8 sensor_type;
+	u8 action;
+	u8 accuracy;
+	u8 pad;
+	s64 timestamp;
+	s32 value[6] __aligned(4);
+} __packed __aligned(4);
+
+struct scp_shm_info {
+	u8 sensor_type;
+	u8 pad[3];
+	u32 gain;
+	u8 name[16];
+	u8 vendor[16];
+} __packed __aligned(4);
+
+static_assert(offsetof(struct scp_sens_ctrl, crc8) == 4);
+static_assert(offsetof(struct scp_sens_ctrl, data) == 8);
+static_assert(sizeof(struct scp_sens_ctrl) == 8);
+static_assert(sizeof(struct scp_sens_ack) == 8);
+static_assert(offsetof(struct scp_sens_ack, crc8) == 4);
+static_assert(sizeof(struct scp_sens_notify) == 28);
+static_assert(offsetof(struct scp_sens_notify, crc8) == 4);
+static_assert(offsetof(struct scp_sens_notify, value) == 8);
+static_assert(sizeof(struct scp_sens_share_mem) == 36);
+static_assert(offsetof(struct scp_sens_share_mem, base_info) == 1);
+static_assert(offsetof(struct scp_sens_share_mem, base_info[0].payload_base) == 5);
+static_assert(sizeof(struct scp_sens_batch) == 16);
+static_assert(sizeof(struct scp_shm_base) == 16);
+static_assert(sizeof(struct scp_shm_data) == 36);
+static_assert(sizeof(struct scp_shm_info) == 40);
+
+struct mtk_scp_hub;
+
+struct mtk_scp_sensor {
+	struct mtk_scp_hub *hub;
+	struct iio_dev *indio_dev;
+	struct delayed_work idle_work;
+	struct completion sample_done;
+	struct mutex lock;
+	u8 sensor_type;
+	u32 gain;
+	char name[24];
+	bool enabled;
+	bool have_sample;
+	s32 val[3];
+};
+
+struct mtk_scp_hub {
+	struct device *dev;
+	void __iomem *cfg_base;
+	void __iomem *mbox1_base;
+	void __iomem *mbox2_base;
+	void __iomem *mbox3_base;
+	struct regmap *infracfg;
+	struct clk *scp_clk;
+
+	phys_addr_t shm_phys;
+	size_t shm_size;
+	void __iomem *shm_virt;
+	struct scp_shm_base __iomem *data_shm;
+	struct scp_shm_base __iomem *list_shm;
+
+	struct mutex tx_lock;
+	struct mutex ctrl_lock;
+	struct mutex shm_read_lock;
+	spinlock_t rx_lock;
+
+	atomic_t ctrl_seq;
+	atomic_t list_seq;
+
+	struct completion scp_ready_done;
+	struct completion sens_ready_done;
+	struct completion ctrl_ack_done;
+	struct completion list_done;
+
+	struct scp_sens_ack last_ack;
+	u32 list_wp;
+	u8 list_rx_seq;
+	u32 data_wp;
+
+	struct work_struct init_work;
+	struct work_struct data_work;
+
+	bool ready;
+	struct iio_mount_matrix mount_matrix;
+	struct mtk_scp_sensor *sensors[SCP_MAX_IIO_SENSORS];
+	unsigned int num_sensors;
+	struct mtk_scp_sensor *by_type[SCP_SENSOR_MAX_TYPE];
+};
+
+/* MediaTek sensorhub 2.0 reflected CRC-8 (polynomial 0x8c, init 0) */
+static const u8 scp_crc8_table[32] = {
+	0x00, 0x5e, 0xbc, 0xe2, 0x61, 0x3f, 0xdd, 0x83,
+	0xc2, 0x9c, 0x7e, 0x20, 0xa3, 0xfd, 0x1f, 0x41,
+	0x00, 0x9d, 0x23, 0xbe, 0x46, 0xdb, 0x65, 0xf8,
+	0x8c, 0x11, 0xaf, 0x32, 0xca, 0x57, 0xe9, 0x74,
+};
+
+static u8 scp_tiny_crc8(const void *buf, size_t len)
+{
+	const u8 *p = buf;
+	u8 crc = 0;
+
+	while (len--) {
+		crc ^= *p++;
+		crc = scp_crc8_table[crc & 0x0f] ^
+		      scp_crc8_table[16 + ((crc >> 4) & 0x0f)];
+	}
+	return crc;
+}
+
+static void mbox_write_words(void __iomem *dst, const void *src, size_t bytes)
+{
+	const u32 *s = src;
+	size_t i, words = DIV_ROUND_UP(bytes, 4);
+
+	for (i = 0; i < words; i++)
+		writel(s[i], dst + i * 4);
+}
+
+static void mbox_read_words(void *dst, void __iomem *src, size_t bytes)
+{
+	u32 *d = dst;
+	size_t i, words = DIV_ROUND_UP(bytes, 4);
+
+	for (i = 0; i < words; i++)
+		d[i] = readl(src + i * 4);
+}
+
+static void scp_dvfs_req(u32 req_type)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_SIP_SCP_DVFS_CONTROL, SCP_DVFS_RESOURCE_REQ,
+		      req_type, 0, 0, 0, 0, 0, &res);
+}
+
+static int scp_awake_ipc(struct mtk_scp_hub *hub, u32 bit)
+{
+	u32 val = 0;
+	int tries;
+	int ret = -ETIMEDOUT;
+
+	regmap_write(hub->infracfg, INFRACFG_SCP_IRQ_SET, SCP_AWAKE_KEY | bit);
+	for (tries = 0; tries < SCP_AWAKE_TIMEOUT_US / 10; tries++) {
+		regmap_read(hub->infracfg, INFRACFG_SCP_IRQ_SET, &val);
+		if ((val & SCP_AWAKE_KEY) != SCP_AWAKE_KEY)
+			break;
+		if (!(val & bit)) {
+			ret = 0;
+			break;
+		}
+		udelay(10);
+	}
+	regmap_write(hub->infracfg, INFRACFG_SCP_IRQ_CLEAR, SCP_AWAKE_KEY | bit);
+	return ret;
+}
+
+static int scp_mbox2_send(struct mtk_scp_hub *hub, u32 offset, u32 irq_bit,
+			  const void *buf, size_t len)
+{
+	int tries, ret;
+
+	guard(mutex)(&hub->tx_lock);
+
+	ret = scp_awake_ipc(hub, SCP_AWAKE_LOCK_BIT);
+	if (ret)
+		return ret;
+
+	for (tries = 0; tries < 200; tries++) {
+		if (!(readl(hub->mbox2_base + MBOX_SET_IRQ_OFF) & irq_bit))
+			break;
+		usleep_range(500, 1000);
+	}
+	if (readl(hub->mbox2_base + MBOX_SET_IRQ_OFF) & irq_bit) {
+		scp_awake_ipc(hub, SCP_AWAKE_UNLOCK_BIT);
+		return -EBUSY;
+	}
+
+	mbox_write_words(hub->mbox2_base + offset, buf, len);
+	mb();
+	writel(irq_bit, hub->mbox2_base + MBOX_SET_IRQ_OFF);
+
+	scp_awake_ipc(hub, SCP_AWAKE_UNLOCK_BIT);
+	return 0;
+}
+
+static int scp_send_notify(struct mtk_scp_hub *hub, struct scp_sens_notify *n)
+{
+	n->crc8 = scp_tiny_crc8(n, offsetof(struct scp_sens_notify, crc8));
+	return scp_mbox2_send(hub, MBOX2_SEND_NOTIFY_OFF, MBOX2_SEND_NOTIFY_BIT,
+			      n, sizeof(*n));
+}
+
+static int scp_send_ctrl(struct mtk_scp_hub *hub, u8 sensor_type, u8 cmd,
+			 const void *payload, u8 len)
+{
+	u8 buf[MBOX2_SEND_CTRL_MAX_BYTES] = {};
+	struct scp_sens_ctrl *ctrl = (struct scp_sens_ctrl *)buf;
+	struct scp_sens_ack ack;
+	unsigned long flags;
+	size_t tx_len;
+	int attempt, ret;
+
+	tx_len = round_up(sizeof(*ctrl) + len, 4);
+	if (tx_len > sizeof(buf))
+		return -EINVAL;
+
+	guard(mutex)(&hub->ctrl_lock);
+
+	for (attempt = 0; attempt < 5; attempt++) {
+		ctrl->sequence = (u8)atomic_inc_return(&hub->ctrl_seq);
+		ctrl->sensor_type = sensor_type;
+		ctrl->command = cmd;
+		ctrl->length = len;
+		ctrl->crc8 = scp_tiny_crc8(ctrl, offsetof(struct scp_sens_ctrl, crc8));
+		if (len && payload)
+			memcpy(ctrl->data, payload, len);
+
+		reinit_completion(&hub->ctrl_ack_done);
+		ret = scp_mbox2_send(hub, MBOX2_SEND_CTRL_OFF, MBOX2_SEND_CTRL_BIT,
+				     buf, tx_len);
+		if (ret)
+			continue;
+
+		if (!wait_for_completion_timeout(&hub->ctrl_ack_done,
+						 msecs_to_jiffies(250))) {
+			ret = -ETIMEDOUT;
+			continue;
+		}
+
+		spin_lock_irqsave(&hub->rx_lock, flags);
+		ack = hub->last_ack;
+		spin_unlock_irqrestore(&hub->rx_lock, flags);
+
+		if (ack.crc8 != scp_tiny_crc8(&ack, offsetof(struct scp_sens_ack, crc8))) {
+			ret = -EBADMSG;
+			continue;
+		}
+		if (ack.sequence != ctrl->sequence ||
+		    ack.sensor_type != ctrl->sensor_type ||
+		    ack.command != ctrl->command) {
+			ret = -EPROTO;
+			continue;
+		}
+		if (ack.ret_val < 0)
+			return -EREMOTEIO;
+		return 0;
+	}
+
+	return ret;
+}
+
+static void scp_shm_ring_init(struct scp_shm_base __iomem *base,
+			      u32 total_bytes, u32 item_size)
+{
+	u32 usable = ((total_bytes - offsetof(struct scp_shm_base, data)) /
+		      item_size) * item_size;
+
+	writel(0, &base->rp);
+	writel(0, &base->wp);
+	writel(usable, &base->buffer_size);
+	writel(item_size, &base->item_size);
+	wmb();
+}
+
+static int scp_shm_ring_read(struct scp_shm_base __iomem *base, u32 wp,
+			     void *dst, u32 max_bytes, u32 expected_item)
+{
+	u32 rp = readl(&base->rp);
+	u32 buf_size = readl(&base->buffer_size);
+	u32 item_size = readl(&base->item_size);
+	u32 first, second, count;
+	u8 __iomem *src = base->data;
+
+	if (!buf_size || item_size != expected_item || wp >= buf_size || rp >= buf_size)
+		return -EIO;
+	if (wp == rp)
+		return 0;
+
+	if (wp > rp) {
+		first = wp - rp;
+		second = 0;
+	} else {
+		first = buf_size - rp;
+		second = wp;
+	}
+
+	first = min(first, max_bytes);
+	first -= first % item_size;
+	second = min(max_bytes - first, second);
+	second -= second % item_size;
+
+	if (first)
+		memcpy_fromio(dst, src + rp, first);
+	if (second)
+		memcpy_fromio((u8 *)dst + first, src, second);
+
+	count = first + second;
+	rp = (rp + count) % buf_size;
+	wmb();
+	writel(rp, &base->rp);
+
+	return count;
+}
+
+static void scp_data_work_fn(struct work_struct *work)
+{
+	struct mtk_scp_hub *hub = container_of(work, struct mtk_scp_hub, data_work);
+	struct scp_shm_data batch[16];
+	unsigned long flags;
+	u32 wp;
+	int bytes, i, n;
+
+	guard(mutex)(&hub->shm_read_lock);
+
+	for (;;) {
+		spin_lock_irqsave(&hub->rx_lock, flags);
+		wp = hub->data_wp;
+		spin_unlock_irqrestore(&hub->rx_lock, flags);
+
+		bytes = scp_shm_ring_read(hub->data_shm, wp, batch, sizeof(batch),
+					  sizeof(batch[0]));
+		if (bytes <= 0)
+			break;
+
+		n = bytes / sizeof(batch[0]);
+		for (i = 0; i < n; i++) {
+			struct scp_shm_data *d = &batch[i];
+			struct mtk_scp_sensor *s;
+
+			if (d->action != SCP_ACTION_DATA ||
+			    d->sensor_type >= SCP_SENSOR_MAX_TYPE)
+				continue;
+
+			s = hub->by_type[d->sensor_type];
+			if (!s)
+				continue;
+
+			spin_lock_irqsave(&hub->rx_lock, flags);
+			s->val[0] = d->value[0];
+			s->val[1] = d->value[1];
+			s->val[2] = d->value[2];
+			s->have_sample = true;
+			spin_unlock_irqrestore(&hub->rx_lock, flags);
+
+			complete_all(&s->sample_done);
+		}
+	}
+}
+
+static irqreturn_t scp_mbox1_isr(int irq, void *data)
+{
+	struct mtk_scp_hub *hub = data;
+	u32 status = readl(hub->mbox1_base + MBOX_CLR_IRQ_OFF);
+
+	if (status & MBOX1_RECV_READY0_BIT)
+		complete(&hub->scp_ready_done);
+
+	writel(1, hub->cfg_base + SCP_TO_SPM_REG);
+	if (status)
+		writel(status, hub->mbox1_base + MBOX_CLR_IRQ_OFF);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t scp_mbox2_isr(int irq, void *data)
+{
+	struct mtk_scp_hub *hub = data;
+	u32 status = readl(hub->mbox2_base + MBOX_CLR_IRQ_OFF);
+	unsigned long flags;
+
+	if (status & MBOX2_RECV_CTRL_BIT) {
+		struct scp_sens_ack ack;
+
+		mbox_read_words(&ack, hub->mbox2_base + MBOX2_RECV_CTRL_OFF,
+				sizeof(ack));
+		spin_lock_irqsave(&hub->rx_lock, flags);
+		hub->last_ack = ack;
+		spin_unlock_irqrestore(&hub->rx_lock, flags);
+		complete(&hub->ctrl_ack_done);
+	}
+
+	if (status & MBOX2_RECV_NOTIFY_BIT) {
+		struct scp_sens_notify n;
+
+		mbox_read_words(&n, hub->mbox2_base + MBOX2_RECV_NOTIFY_OFF,
+				sizeof(n));
+		if (n.crc8 == scp_tiny_crc8(&n, offsetof(struct scp_sens_notify, crc8))) {
+			switch (n.command) {
+			case SENS_COMM_NOTIFY_READY_CMD:
+				complete(&hub->sens_ready_done);
+				break;
+			case SENS_COMM_NOTIFY_LIST_CMD:
+				spin_lock_irqsave(&hub->rx_lock, flags);
+				hub->list_wp = (u32)n.value[0];
+				hub->list_rx_seq = n.sequence;
+				spin_unlock_irqrestore(&hub->rx_lock, flags);
+				complete(&hub->list_done);
+				break;
+			case SENS_COMM_NOTIFY_DATA_CMD:
+			case SENS_COMM_NOTIFY_FULL_CMD:
+				spin_lock_irqsave(&hub->rx_lock, flags);
+				hub->data_wp = (u32)n.value[0];
+				spin_unlock_irqrestore(&hub->rx_lock, flags);
+				schedule_work(&hub->data_work);
+				break;
+			default:
+				break;
+			}
+		}
+	}
+
+	writel(1, hub->cfg_base + SCP_TO_SPM_REG);
+	if (status)
+		writel(status, hub->mbox2_base + MBOX_CLR_IRQ_OFF);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t scp_mbox3_isr(int irq, void *data)
+{
+	struct mtk_scp_hub *hub = data;
+	u32 status = readl(hub->mbox3_base + MBOX_CLR_IRQ_OFF);
+
+	if (status & MBOX3_RECV_READY1_BIT)
+		complete(&hub->scp_ready_done);
+
+	writel(1, hub->cfg_base + SCP_TO_SPM_REG);
+	if (status)
+		writel(status, hub->mbox3_base + MBOX_CLR_IRQ_OFF);
+
+	return IRQ_HANDLED;
+}
+
+static int scp_sensor_set_enable(struct mtk_scp_sensor *s, bool enable)
+{
+	struct scp_sens_batch batch;
+	int ret;
+
+	if (enable == s->enabled)
+		return 0;
+
+	if (enable) {
+		batch.delay_ns = (s->sensor_type == SCP_SENSOR_LIGHT ||
+				  s->sensor_type == SCP_SENSOR_PROXIMITY) ?
+				  100000000LL : 50000000LL;
+		batch.latency_ns = 0;
+		reinit_completion(&s->sample_done);
+		ret = scp_send_ctrl(s->hub, s->sensor_type,
+				    SENS_COMM_CTRL_ENABLE_CMD,
+				    &batch, sizeof(batch));
+		if (!ret)
+			s->enabled = true;
+		return ret;
+	}
+
+	ret = scp_send_ctrl(s->hub, s->sensor_type,
+			    SENS_COMM_CTRL_DISABLE_CMD, NULL, 0);
+	s->enabled = false;
+	s->have_sample = false;
+	return ret;
+}
+
+static void scp_sensor_idle_fn(struct work_struct *work)
+{
+	struct mtk_scp_sensor *s =
+		container_of(to_delayed_work(work), struct mtk_scp_sensor, idle_work);
+
+	guard(mutex)(&s->lock);
+	if (s->enabled)
+		scp_sensor_set_enable(s, false);
+}
+
+static int scp_sensor_read_raw(struct iio_dev *indio_dev,
+			       struct iio_chan_spec const *chan,
+			       int *val, int *val2, long mask)
+{
+	struct mtk_scp_sensor *s = iio_priv(indio_dev);
+	unsigned long flags;
+	bool fresh;
+	s32 v;
+	int ret;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_SCALE:
+		*val = 1;
+		if (s->sensor_type == SCP_SENSOR_MAGN)
+			/* Android reports uT * gain; Linux IIO expects Gauss (1 G = 100 uT) */
+			*val2 = s->gain * 100;
+		else
+			*val2 = s->gain;
+		return IIO_VAL_FRACTIONAL;
+
+	case IIO_CHAN_INFO_RAW: {
+		guard(mutex)(&s->lock);
+		if (!s->hub->ready)
+			return -EAGAIN;
+
+		if (!s->enabled) {
+			ret = scp_sensor_set_enable(s, true);
+			if (ret)
+				return ret;
+		}
+		mod_delayed_work(system_dfl_wq, &s->idle_work,
+				 msecs_to_jiffies(SCP_IDLE_DISABLE_MS));
+
+		spin_lock_irqsave(&s->hub->rx_lock, flags);
+		fresh = s->have_sample;
+		spin_unlock_irqrestore(&s->hub->rx_lock, flags);
+
+		if (!fresh) {
+			if (!wait_for_completion_timeout(&s->sample_done,
+							 msecs_to_jiffies(500)))
+				return -ETIMEDOUT;
+		}
+
+		spin_lock_irqsave(&s->hub->rx_lock, flags);
+		v = s->val[chan->scan_index];
+		spin_unlock_irqrestore(&s->hub->rx_lock, flags);
+
+		if (s->sensor_type == SCP_SENSOR_PROXIMITY)
+			/* SCP reports distance in cm (0=near, >0=far); IIO near = higher */
+			*val = (v == 0) ? 1 : 0;
+		else
+			*val = v;
+		return IIO_VAL_INT;
+	}
+
+	default:
+		return -EINVAL;
+	}
+}
