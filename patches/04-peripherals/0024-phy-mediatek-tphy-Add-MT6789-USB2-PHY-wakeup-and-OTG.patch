From b4aeb5fb1426b101035a975608af5ac202b27090 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Mon, 23 Nov 2026 21:42:00 +0000
Subject: [PATCH] phy: mediatek: tphy: Add MT6789 USB2 PHY wakeup and OTG
 session forcing

On MediaTek MT6789 (Helio G99), the USB2 T-PHY OTG VBUS comparator is
not driven directly by external VBUS; instead, the PHY relies on the
U2PHYDTM1 force bits (FORCE_VBUSVALID, FORCE_SESSEND, FORCE_BVALID,
FORCE_AVALID, FORCE_IDDIG, FORCE_IDPULLUP) to report a valid session to
the MUSB controller. When booting with a USB cable already attached, the
bootloader configures U2PHYDTM1 and wakes the PHY, masking the omission.
When booting on battery (unplugged), the PHY remains in cold-boot
suspend with U2PHYDTM1 unforced, leaving MUSB unable to enter a
peripheral session or respond to host resets when a cable is attached.

Add a dedicated mediatek,mt6789-tphy match entry with a force_otg_vbus
flag that performs the cold-boot SUSPENDM wakeup pulse and settle delay
on power-on and asserts the U2PHYDTM1 OTG force/session bits in
u2_phy_instance_power_on() and u2_phy_instance_set_mode(), matching the
downstream MT6789 PHY initialization sequence.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/phy/mediatek/phy-mtk-tphy.c | 64 ++++++++++++++++++++++++++++-
 1 file changed, 63 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/mediatek/phy-mtk-tphy.c b/drivers/phy/mediatek/phy-mtk-tphy.c
index 22273a4..6108d42 100644
--- a/drivers/phy/mediatek/phy-mtk-tphy.c
+++ b/drivers/phy/mediatek/phy-mtk-tphy.c
@@ -111,11 +111,22 @@
 
 #define U3P_U2PHYDTM1		0x06C
 #define P2C_RG_UART_EN			BIT(16)
+#define P2C_FORCE_VBUSVALID		BIT(13)
+#define P2C_FORCE_SESSEND		BIT(12)
+#define P2C_FORCE_BVALID		BIT(11)
+#define P2C_FORCE_AVALID		BIT(10)
 #define P2C_FORCE_IDDIG		BIT(9)
+#define P2C_FORCE_IDPULLUP		BIT(8)
 #define P2C_RG_VBUSVALID		BIT(5)
 #define P2C_RG_SESSEND			BIT(4)
+#define P2C_RG_BVALID			BIT(3)
 #define P2C_RG_AVALID			BIT(2)
 #define P2C_RG_IDDIG			BIT(1)
+#define P2C_RG_IDPULLUP		BIT(0)
+#define P2C_FORCE_OTG_MSK \
+		(P2C_FORCE_VBUSVALID | P2C_FORCE_SESSEND | \
+		P2C_FORCE_BVALID | P2C_FORCE_AVALID | \
+		P2C_FORCE_IDDIG | P2C_FORCE_IDPULLUP)
 
 #define U3P_U2PHYBC12C		0x080
 #define P2C_RG_CHGDT_EN		BIT(0)
@@ -291,6 +302,7 @@ struct mtk_phy_pdata {
 	bool avoid_rx_sen_degradation;
 	bool sw_pll_48m_to_26m;
 	bool sw_efuse_supported;
+	bool force_otg_vbus;
 	u8 slew_ref_clock_mhz;
 	u8 slew_rate_coefficient;
 	enum mtk_phy_version version;
@@ -871,6 +883,24 @@ static void u2_phy_instance_power_on(struct mtk_tphy *tphy,
 	void __iomem *com = u2_banks->com;
 	u32 index = instance->index;
 
+	if (tphy->pdata->force_otg_vbus) {
+		/*
+		 * Wake USB2 PHY out of cold-boot suspend when the bootloader
+		 * did not initialize USB (e.g. battery boot without cable).
+		 */
+		mtk_phy_set_bits(com + U3P_U2PHYDTM0, P2C_FORCE_SUSPENDM);
+		mtk_phy_clear_bits(com + U3P_U2PHYDTM0, P2C_RG_SUSPENDM);
+		mtk_phy_set_bits(com + U3P_U2PHYDTM0, P2C_RG_SUSPENDM);
+		usleep_range(30, 50);
+		mtk_phy_clear_bits(com + U3P_U2PHYDTM0,
+				   P2C_FORCE_SUSPENDM | P2C_RG_SUSPENDM |
+				   P2C_FORCE_UART_EN | P2C_RG_XCVRSEL |
+				   P2C_RG_DATAIN | P2C_DTM0_PART_MASK);
+		mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_UART_EN);
+		mtk_phy_clear_bits(com + U3P_U2PHYACR4, P2C_U2_GPIO_CTR_MSK);
+		mtk_phy_clear_bits(com + U3P_USBPHYACR6, PA6_RG_U2_BC11_SW_EN);
+	}
+
 	/* OTG Enable */
 	mtk_phy_set_bits(com + U3P_USBPHYACR6, PA6_RG_U2_OTG_VBUSCMP_EN);
 
@@ -878,6 +908,15 @@ static void u2_phy_instance_power_on(struct mtk_tphy *tphy,
 
 	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_SESSEND);
 
+	if (tphy->pdata->force_otg_vbus) {
+		mtk_phy_set_bits(com + U3P_U2PHYDTM1,
+				 P2C_RG_BVALID | P2C_RG_IDPULLUP |
+				 P2C_FORCE_VBUSVALID | P2C_FORCE_SESSEND |
+				 P2C_FORCE_BVALID | P2C_FORCE_AVALID |
+				 P2C_FORCE_IDPULLUP);
+		usleep_range(800, 1000);
+	}
+
 	if (tphy->pdata->avoid_rx_sen_degradation && index) {
 		mtk_phy_set_bits(com + U3D_U2PHYDCR0, P2C_RG_SIF_U2PLL_FORCE_ON);
 
@@ -896,7 +935,8 @@ static void u2_phy_instance_power_off(struct mtk_tphy *tphy,
 	/* OTG Disable */
 	mtk_phy_clear_bits(com + U3P_USBPHYACR6, PA6_RG_U2_OTG_VBUSCMP_EN);
 
-	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_VBUSVALID | P2C_RG_AVALID);
+	mtk_phy_clear_bits(com + U3P_U2PHYDTM1,
+			   P2C_RG_VBUSVALID | P2C_RG_BVALID | P2C_RG_AVALID);
 
 	mtk_phy_set_bits(com + U3P_U2PHYDTM1, P2C_RG_SESSEND);
 
@@ -934,10 +974,22 @@ static void u2_phy_instance_set_mode(struct mtk_tphy *tphy,
 	switch (mode) {
 	case PHY_MODE_USB_DEVICE:
 		tmp |= P2C_FORCE_IDDIG | P2C_RG_IDDIG;
+		if (tphy->pdata->force_otg_vbus) {
+			tmp &= ~P2C_RG_SESSEND;
+			tmp |= P2C_RG_VBUSVALID | P2C_RG_BVALID |
+			       P2C_RG_AVALID | P2C_RG_IDPULLUP |
+			       P2C_FORCE_OTG_MSK;
+		}
 		break;
 	case PHY_MODE_USB_HOST:
 		tmp |= P2C_FORCE_IDDIG;
 		tmp &= ~P2C_RG_IDDIG;
+		if (tphy->pdata->force_otg_vbus) {
+			tmp &= ~P2C_RG_SESSEND;
+			tmp |= P2C_RG_VBUSVALID | P2C_RG_BVALID |
+			       P2C_RG_AVALID | P2C_RG_IDPULLUP |
+			       P2C_FORCE_OTG_MSK;
+		}
 		break;
 	case PHY_MODE_USB_OTG:
 		tmp &= ~(P2C_FORCE_IDDIG | P2C_RG_IDDIG);
@@ -1545,6 +1597,15 @@ static const struct mtk_phy_pdata mt8173_pdata = {
 	.version = MTK_PHY_V1,
 };
 
+static const struct mtk_phy_pdata mt6789_pdata = {
+	.avoid_rx_sen_degradation = false,
+	.sw_efuse_supported = true,
+	.force_otg_vbus = true,
+	.slew_ref_clock_mhz = 26,
+	.slew_rate_coefficient = 28,
+	.version = MTK_PHY_V2,
+};
+
 static const struct mtk_phy_pdata mt8195_pdata = {
 	.sw_pll_48m_to_26m = true,
 	.sw_efuse_supported = true,
@@ -1554,6 +1615,7 @@ static const struct mtk_phy_pdata mt8195_pdata = {
 static const struct of_device_id mtk_tphy_id_table[] = {
 	{ .compatible = "mediatek,mt2701-u3phy", .data = &tphy_v1_pdata },
 	{ .compatible = "mediatek,mt2712-u3phy", .data = &tphy_v2_pdata },
+	{ .compatible = "mediatek,mt6789-tphy", .data = &mt6789_pdata },
 	{ .compatible = "mediatek,mt8173-u3phy", .data = &mt8173_pdata },
 	{ .compatible = "mediatek,mt8195-tphy", .data = &mt8195_pdata },
 	{ .compatible = "mediatek,generic-tphy-v1", .data = &tphy_v1_pdata },
-- 
2.55.0

