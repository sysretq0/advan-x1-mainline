From d1127381a4046819525121d90428e8fbd298b786 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:52:39 +0000
Subject: [PATCH] Input: add Chipone ICNL9922C SPI TDDI touchscreen driver

Add a mainline SPI touchscreen driver for the Chipone ICNL9922C TDDI
controller supporting TCS normal-mode multitouch readout, DRW
program-mode hardware ID verification (0x99c220), SFCTRLv2 hardware
SRAM CRC verification, asynchronous SRAM firmware loading
(chipone/icnl9922c.bin), and drm_panel_follower synchronization so
SRAM firmware is loaded after the shared TDDI display panel reset.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/input/touchscreen/Kconfig             |  14 +
 drivers/input/touchscreen/Makefile            |   1 +
 drivers/input/touchscreen/chipone_icnl9922c.c | 809 ++++++++++++++++++
 3 files changed, 824 insertions(+)
 create mode 100644 drivers/input/touchscreen/chipone_icnl9922c.c

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8ac3..1fadc7630 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -210,6 +210,20 @@ config TOUCHSCREEN_CHIPONE_ICN8505
 	  To compile this driver as a module, choose M here: the
 	  module will be called chipone_icn8505.
 
+config TOUCHSCREEN_CHIPONE_ICNL9922C
+	tristate "Chipone ICNL9922C SPI TDDI touchscreen controller"
+	depends on SPI_MASTER
+	depends on OF
+	select CRC32
+	help
+	  Say Y here if you have a Chipone ICNL9922C based SPI TDDI
+	  touchscreen controller using the TCS protocol.
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called chipone_icnl9922c.
+
 config TOUCHSCREEN_CY8CTMA140
 	tristate "cy8ctma140 touchscreen"
 	depends on I2C
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index bfd9de833..6b34656e8 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -23,6 +23,7 @@ obj-$(CONFIG_TOUCHSCREEN_BU21013)	+= bu21013_ts.o
 obj-$(CONFIG_TOUCHSCREEN_BU21029)	+= bu21029_ts.o
 obj-$(CONFIG_TOUCHSCREEN_CHIPONE_ICN8318)	+= chipone_icn8318.o
 obj-$(CONFIG_TOUCHSCREEN_CHIPONE_ICN8505)	+= chipone_icn8505.o
+obj-$(CONFIG_TOUCHSCREEN_CHIPONE_ICNL9922C)	+= chipone_icnl9922c.o
 obj-$(CONFIG_TOUCHSCREEN_CY8CTMA140)	+= cy8ctma140.o
 obj-$(CONFIG_TOUCHSCREEN_CY8CTMG110)	+= cy8ctmg110_ts.o
 obj-$(CONFIG_TOUCHSCREEN_CYTTSP_CORE)	+= cyttsp_core.o
diff --git a/drivers/input/touchscreen/chipone_icnl9922c.c b/drivers/input/touchscreen/chipone_icnl9922c.c
new file mode 100644
index 000000000..f1f8fdd76
--- /dev/null
+++ b/drivers/input/touchscreen/chipone_icnl9922c.c
@@ -0,0 +1,809 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Chipone ICNL9922C SPI TDDI touchscreen driver (TCS + DRW SRAM boot)
+ *
+ * Copyright (C) 2026 sysretq0 <324514544+sysretq0@users.noreply.github.com>
+ */
+
+#include <drm/drm_panel.h>
+#include <linux/crc32.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#define ICNL9922C_TCS_WR_ADDR			0xf0
+#define ICNL9922C_TCS_RD_ADDR			0xf1
+#define ICNL9922C_TCS_WRITE_BIT			BIT(13)
+
+#define ICNL9922C_CMD_INFO_CHIP_FW_ID_RO	0x4003
+#define ICNL9922C_CMD_INFO_FW_VER_RO		0x4005
+#define ICNL9922C_CMD_INFO_TOUCH_XY_INFO_RO	0x4007
+#define ICNL9922C_CMD_TP_DATA_COORDINATES_RO	0x4103
+
+#define ICNL9922C_PROG_SPI_ADDR			0x60
+#define ICNL9922C_HW_REG_HWID			0x070000
+#define ICNL9922C_HW_REG_BOOT_MODE		0x070010
+#define ICNL9922C_BOOT_MODE_SRAM		0x03
+
+#define ICNL9922C_SFCTRL_BASE			0x074000
+#define ICNL9922C_SFCTRL_SRAM_ADDR		(ICNL9922C_SFCTRL_BASE + 0x08)
+#define ICNL9922C_SFCTRL_DATA_LEN		(ICNL9922C_SFCTRL_BASE + 0x0c)
+#define ICNL9922C_SFCTRL_CRC_RESULT		(ICNL9922C_SFCTRL_BASE + 0x1c)
+#define ICNL9922C_SFCTRL_SRAM_CRC_START		(ICNL9922C_SFCTRL_BASE + 0x20)
+#define ICNL9922C_SFCTRL_SF_BUSY		(ICNL9922C_SFCTRL_BASE + 0x24)
+
+#define ICNL9922C_SRAM_CRC_MAGIC_ADDR		0x02bff0
+#define ICNL9922C_SRAM_CRC_VAL_ADDR		0x02bff8
+#define ICNL9922C_SRAM_CRC_LEN_ADDR		0x02bffc
+#define ICNL9922C_SRAM_CRC_MAGIC		0xcc33555a
+
+#define ICNL9922C_HWID				0x99c220
+#define ICNL9922C_HWID_MASK			0xfffffff0
+#define ICNL9922C_FW_NAME			"chipone/icnl9922c.bin"
+
+#define ICNL9922C_MAX_TOUCH_POINTS		10
+#define ICNL9922C_DEBUG_MSG_SIZE		40
+/* Keep DRW write (chunk + 18B overhead) within 1024B single SPI DMA packet */
+#define ICNL9922C_DRW_CHUNK_SIZE		1000
+#define ICNL9922C_DRW_OVERHEAD			18
+#define ICNL9922C_XFER_BUF_SIZE			(ICNL9922C_DRW_CHUNK_SIZE + 32)
+
+#define ICNL9922C_EVENT_DOWN			1
+#define ICNL9922C_EVENT_MOVE			2
+#define ICNL9922C_EVENT_STAY			3
+#define ICNL9922C_EVENT_UP			4
+
+struct icnl9922c_tx_hdr {
+	u8 addr;
+	__le16 cmd;
+	__le16 datlen;
+	__le16 crc16;
+} __packed;
+
+struct icnl9922c_rx_tail {
+	u8 ecode;
+	__le16 cmd;
+	__le16 crc16;
+} __packed;
+
+struct icnl9922c_touch_msg {
+	u8 id;
+	__le16 x;
+	__le16 y;
+	u8 pressure;
+	u8 event;
+} __packed;
+
+struct icnl9922c_touch_info {
+	u8 vkey_state;
+	u8 num_msg;
+	struct icnl9922c_touch_msg msgs[ICNL9922C_MAX_TOUCH_POINTS];
+	u8 debug_msg[ICNL9922C_DEBUG_MSG_SIZE];
+} __packed;
+
+struct icnl9922c_ts {
+	struct spi_device *spi;
+	struct input_dev *input;
+	struct gpio_desc *reset_gpio;
+	struct touchscreen_properties prop;
+	struct drm_panel_follower panel_follower;
+	struct work_struct fw_work;
+	struct mutex lock; /* serializes SPI buffer and firmware state */
+	u8 *tx_buf;
+	u8 *rx_buf;
+	u8 *fw_data;
+	size_t fw_size;
+	bool irq_enabled;
+	bool running;
+};
+
+/* MSB-first CRC-16/BUYPASS (polynomial 0x8005, initial value 0x0000) */
+static u16 icnl9922c_crc16(const u8 *data, size_t len)
+{
+	u16 crc = 0;
+	size_t i;
+	int bit;
+
+	for (i = 0; i < len; i++) {
+		crc ^= (u16)data[i] << 8;
+		for (bit = 0; bit < 8; bit++) {
+			if (crc & 0x8000)
+				crc = (crc << 1) ^ 0x8005;
+			else
+				crc <<= 1;
+		}
+	}
+
+	return crc;
+}
+
+static void icnl9922c_pack_read_hdr(struct icnl9922c_tx_hdr *hdr,
+				    u16 cmd, u16 datlen)
+{
+	hdr->addr = ICNL9922C_TCS_RD_ADDR;
+	hdr->cmd = cpu_to_le16(cmd & ~ICNL9922C_TCS_WRITE_BIT);
+	hdr->datlen = cpu_to_le16(datlen);
+	hdr->crc16 = cpu_to_le16(icnl9922c_crc16((const u8 *)hdr,
+						 offsetof(struct icnl9922c_tx_hdr,
+							  crc16)));
+}
+
+static int icnl9922c_verify_tcs_rx(const u8 *rx, size_t rlen, u16 cmd)
+{
+	const struct icnl9922c_rx_tail *tail;
+	size_t rxlen = rlen + sizeof(*tail);
+	u16 crc_recv, crc_calc;
+
+	tail = (const struct icnl9922c_rx_tail *)(rx + rlen);
+	crc_recv = le16_to_cpu(tail->crc16);
+	crc_calc = icnl9922c_crc16(rx, rxlen - 2);
+	if (crc_recv != crc_calc)
+		return -EIO;
+
+	if (tail->ecode != 0)
+		return -EIO;
+
+	if (le16_to_cpu(tail->cmd) != (cmd & ~ICNL9922C_TCS_WRITE_BIT))
+		return -EIO;
+
+	return 0;
+}
+
+static int icnl9922c_tcs_read(struct icnl9922c_ts *ts, u16 cmd,
+			      u8 *rdata, size_t rlen)
+{
+	size_t rxlen = rlen + sizeof(struct icnl9922c_rx_tail);
+	int ret;
+
+	if (rxlen > ICNL9922C_XFER_BUF_SIZE)
+		return -EINVAL;
+
+	memset(ts->tx_buf, 0, sizeof(struct icnl9922c_tx_hdr));
+	icnl9922c_pack_read_hdr((struct icnl9922c_tx_hdr *)ts->tx_buf,
+				cmd, rlen);
+
+	ret = spi_write(ts->spi, ts->tx_buf, sizeof(struct icnl9922c_tx_hdr));
+	if (ret)
+		return ret;
+
+	usleep_range(100, 150);
+
+	ret = spi_read(ts->spi, ts->rx_buf, rxlen);
+	if (ret)
+		return ret;
+
+	ret = icnl9922c_verify_tcs_rx(ts->rx_buf, rlen, cmd);
+	if (ret)
+		return ret;
+
+	memcpy(rdata, ts->rx_buf, rlen);
+	usleep_range(100, 150);
+
+	return 0;
+}
+
+static int icnl9922c_tcs_read_1cs(struct icnl9922c_ts *ts, u16 cmd,
+				  u8 *rdata, size_t rlen)
+{
+	size_t rxlen = rlen + sizeof(struct icnl9922c_rx_tail);
+	struct spi_transfer xfer = {
+		.tx_buf = ts->tx_buf,
+		.rx_buf = ts->rx_buf,
+		.len = max(sizeof(struct icnl9922c_tx_hdr), rxlen),
+	};
+	int ret;
+
+	if (xfer.len > ICNL9922C_XFER_BUF_SIZE)
+		return -EINVAL;
+
+	memset(ts->tx_buf, 0, xfer.len);
+	icnl9922c_pack_read_hdr((struct icnl9922c_tx_hdr *)ts->tx_buf,
+				cmd, rlen);
+
+	ret = spi_sync_transfer(ts->spi, &xfer, 1);
+	if (ret)
+		return ret;
+
+	ret = icnl9922c_verify_tcs_rx(ts->rx_buf, rlen, cmd);
+	if (ret)
+		return ret;
+
+	memcpy(rdata, ts->rx_buf, rlen);
+
+	return 0;
+}
+
+static void icnl9922c_hw_reset(struct icnl9922c_ts *ts)
+{
+	if (!ts->reset_gpio)
+		return;
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	msleep(40);
+}
+
+static int icnl9922c_enter_prog_mode(struct icnl9922c_ts *ts)
+{
+	static const u8 magic[] = { 0xcc, 0x33, 0x55, 0x5a };
+	int ret;
+
+	memcpy(ts->tx_buf, magic, sizeof(magic));
+	ret = spi_write(ts->spi, ts->tx_buf, sizeof(magic));
+	if (ret)
+		return ret;
+
+	usleep_range(5000, 6000);
+	return 0;
+}
+
+static int icnl9922c_prog_read(struct icnl9922c_ts *ts, u32 addr,
+			       u8 *rbuf, size_t rlen)
+{
+	size_t xfer_len = rlen + ICNL9922C_DRW_OVERHEAD;
+	struct spi_transfer xfer = {
+		.tx_buf = ts->tx_buf,
+		.rx_buf = ts->rx_buf,
+		.len = xfer_len,
+	};
+	u16 crc_calc, crc_recv;
+	int ret;
+
+	if (xfer_len > ICNL9922C_XFER_BUF_SIZE)
+		return -EINVAL;
+
+	memset(ts->tx_buf, 0, xfer_len);
+	ts->tx_buf[0] = ICNL9922C_PROG_SPI_ADDR | 0x01;
+	put_unaligned_be24(addr, &ts->tx_buf[1]);
+	put_unaligned_be24(rlen, &ts->tx_buf[4]);
+	crc_calc = icnl9922c_crc16(ts->tx_buf, 7);
+	put_unaligned_be16(~crc_calc, &ts->tx_buf[7]);
+
+	ret = spi_sync_transfer(ts->spi, &xfer, 1);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 150);
+
+	crc_calc = icnl9922c_crc16(&ts->rx_buf[13], rlen);
+	crc_recv = get_unaligned_be16(&ts->rx_buf[13 + rlen]);
+	if (crc_recv != (u16)(~crc_calc))
+		return -EIO;
+
+	memcpy(rbuf, &ts->rx_buf[13], rlen);
+	return 0;
+}
+
+static int icnl9922c_prog_write(struct icnl9922c_ts *ts, u32 addr,
+				const u8 *wbuf, size_t wlen)
+{
+	size_t xfer_len = wlen + ICNL9922C_DRW_OVERHEAD;
+	u16 crc_calc;
+	int ret;
+
+	if (xfer_len > ICNL9922C_XFER_BUF_SIZE)
+		return -EINVAL;
+
+	ts->tx_buf[0] = ICNL9922C_PROG_SPI_ADDR;
+	put_unaligned_be24(addr, &ts->tx_buf[1]);
+	put_unaligned_be24(wlen, &ts->tx_buf[4]);
+	crc_calc = icnl9922c_crc16(ts->tx_buf, 7);
+	put_unaligned_be16(~crc_calc, &ts->tx_buf[7]);
+	memset(&ts->tx_buf[9], 0, 4);
+	memcpy(&ts->tx_buf[13], wbuf, wlen);
+	crc_calc = icnl9922c_crc16(wbuf, wlen);
+	put_unaligned_be16(~crc_calc, &ts->tx_buf[13 + wlen]);
+	memset(&ts->tx_buf[15 + wlen], 0, 3);
+
+	ret = spi_write(ts->spi, ts->tx_buf, xfer_len);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 150);
+	return 0;
+}
+
+static int icnl9922c_prog_writeb(struct icnl9922c_ts *ts, u32 addr, u8 val)
+{
+	return icnl9922c_prog_write(ts, addr, &val, sizeof(val));
+}
+
+static int icnl9922c_prog_writel(struct icnl9922c_ts *ts, u32 addr, u32 val)
+{
+	__le32 le = cpu_to_le32(val);
+
+	return icnl9922c_prog_write(ts, addr, (const u8 *)&le, sizeof(le));
+}
+
+static int icnl9922c_calc_sram_crc(struct icnl9922c_ts *ts, size_t size,
+				   u32 *crc)
+{
+	u8 busy = 1;
+	u8 buf[4];
+	int ret, retries;
+
+	ret = icnl9922c_prog_writel(ts, ICNL9922C_SFCTRL_SRAM_ADDR, 0);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1500);
+
+	ret = icnl9922c_prog_writel(ts, ICNL9922C_SFCTRL_DATA_LEN, size);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1500);
+
+	ret = icnl9922c_prog_writeb(ts, ICNL9922C_SFCTRL_SRAM_CRC_START, 1);
+	if (ret)
+		return ret;
+	usleep_range(10000, 11000);
+
+	for (retries = 0; retries < 50; retries++) {
+		ret = icnl9922c_prog_read(ts, ICNL9922C_SFCTRL_SF_BUSY,
+					  &busy, sizeof(busy));
+		if (!ret && !busy)
+			break;
+		usleep_range(10000, 11000);
+	}
+	if (ret || busy)
+		return ret ? ret : -ETIMEDOUT;
+
+	ret = icnl9922c_prog_read(ts, ICNL9922C_SFCTRL_CRC_RESULT,
+				  buf, sizeof(buf));
+	if (ret)
+		return ret;
+
+	*crc = get_unaligned_le32(buf);
+	return 0;
+}
+
+static irqreturn_t icnl9922c_irq_handler(int irq, void *dev_id)
+{
+	struct icnl9922c_ts *ts = dev_id;
+	struct icnl9922c_touch_info info;
+	int ret, i;
+
+	mutex_lock(&ts->lock);
+	if (!ts->running) {
+		mutex_unlock(&ts->lock);
+		return IRQ_HANDLED;
+	}
+	ret = icnl9922c_tcs_read_1cs(ts, ICNL9922C_CMD_TP_DATA_COORDINATES_RO,
+				     (u8 *)&info, sizeof(info));
+	mutex_unlock(&ts->lock);
+	if (ret)
+		return IRQ_HANDLED;
+
+	if (!info.num_msg || info.num_msg > ICNL9922C_MAX_TOUCH_POINTS)
+		return IRQ_HANDLED;
+
+	for (i = 0; i < info.num_msg; i++) {
+		const struct icnl9922c_touch_msg *msg = &info.msgs[i];
+		bool active;
+		u16 x, y;
+
+		if (msg->id >= ICNL9922C_MAX_TOUCH_POINTS)
+			continue;
+
+		active = msg->event == ICNL9922C_EVENT_DOWN ||
+			 msg->event == ICNL9922C_EVENT_MOVE ||
+			 msg->event == ICNL9922C_EVENT_STAY;
+
+		input_mt_slot(ts->input, msg->id);
+		if (!input_mt_report_slot_state(ts->input, MT_TOOL_FINGER,
+						active))
+			continue;
+
+		x = le16_to_cpu(msg->x);
+		y = le16_to_cpu(msg->y);
+		touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+		input_report_abs(ts->input, ABS_MT_PRESSURE, msg->pressure);
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+
+	return IRQ_HANDLED;
+}
+
+static int icnl9922c_ensure_input(struct icnl9922c_ts *ts, u16 fwid, u16 fwver,
+				  u16 res_x, u16 res_y)
+{
+	struct device *dev = &ts->spi->dev;
+	int ret;
+
+	if (ts->input)
+		return 0;
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+
+	ts->input->name = "Chipone ICNL9922C Touchscreen";
+	ts->input->id.bustype = BUS_SPI;
+
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0,
+			     res_x ? res_x : 1079, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0,
+			     res_y ? res_y : 2459, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_PRESSURE, 0, 255, 0, 0);
+
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+	if (!ts->prop.max_x)
+		ts->prop.max_x = res_x ? res_x : 1079;
+	if (!ts->prop.max_y)
+		ts->prop.max_y = res_y ? res_y : 2459;
+
+	ret = input_mt_init_slots(ts->input, ICNL9922C_MAX_TOUCH_POINTS,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret) {
+		dev_err(dev, "failed to init MT slots: %d\n", ret);
+		ts->input = NULL;
+		return ret;
+	}
+
+	ret = devm_request_threaded_irq(dev, ts->spi->irq, NULL,
+					icnl9922c_irq_handler,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					dev_name(dev), ts);
+	if (ret) {
+		dev_err(dev, "failed to request IRQ %d: %d\n",
+			ts->spi->irq, ret);
+		ts->input = NULL;
+		return ret;
+	}
+
+	ret = input_register_device(ts->input);
+	if (ret) {
+		dev_err(dev, "failed to register input device: %d\n", ret);
+		ts->input = NULL;
+		return ret;
+	}
+
+	dev_info(dev, "Chipone ICNL9922C fwid=0x%04x fwver=0x%04x (%ux%u)\n",
+		 fwid, fwver, ts->prop.max_x + 1, ts->prop.max_y + 1);
+
+	return 0;
+}
+
+static int icnl9922c_upload_sram(struct icnl9922c_ts *ts, const u8 *data,
+				 size_t size)
+{
+	struct device *dev = &ts->spi->dev;
+	u32 fw_crc = crc32_be(0, data, size);
+	u32 sram_crc = 0;
+	u8 buf[4];
+	u32 hwid = 0;
+	int attempt, ret;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		size_t offset = 0;
+
+		if (attempt > 0)
+			icnl9922c_hw_reset(ts);
+
+		ret = icnl9922c_enter_prog_mode(ts);
+		if (ret)
+			continue;
+
+		ret = icnl9922c_prog_read(ts, ICNL9922C_HW_REG_HWID,
+					  buf, sizeof(buf));
+		if (ret)
+			continue;
+
+		hwid = get_unaligned_le32(buf) & ICNL9922C_HWID_MASK;
+		if (hwid != ICNL9922C_HWID) {
+			ret = -ENODEV;
+			continue;
+		}
+
+		while (offset < size) {
+			size_t chunk = min_t(size_t, ICNL9922C_DRW_CHUNK_SIZE,
+					     size - offset);
+
+			ret = icnl9922c_prog_write(ts, offset, data + offset,
+						   chunk);
+			if (ret)
+				break;
+			offset += chunk;
+		}
+		if (ret) {
+			dev_err(dev, "SRAM write failed at 0x%zx: %d\n",
+				offset, ret);
+			continue;
+		}
+
+		ret = icnl9922c_calc_sram_crc(ts, size, &sram_crc);
+		if (ret) {
+			dev_err(dev, "HW SRAM CRC read failed: %d\n", ret);
+			continue;
+		}
+		if (sram_crc != fw_crc) {
+			dev_err(dev,
+				"SRAM CRC mismatch: hw=0x%08x != fw=0x%08x (try %d)\n",
+				sram_crc, fw_crc, attempt + 1);
+			ret = -EIO;
+			continue;
+		}
+
+		ret = icnl9922c_prog_writel(ts, ICNL9922C_SRAM_CRC_MAGIC_ADDR,
+					    ICNL9922C_SRAM_CRC_MAGIC);
+		if (!ret)
+			ret = icnl9922c_prog_writel(ts,
+						    ICNL9922C_SRAM_CRC_VAL_ADDR,
+						    fw_crc);
+		if (!ret)
+			ret = icnl9922c_prog_writel(ts,
+						    ICNL9922C_SRAM_CRC_LEN_ADDR,
+						    size);
+		if (!ret)
+			ret = icnl9922c_prog_writeb(ts,
+						    ICNL9922C_HW_REG_BOOT_MODE,
+						    ICNL9922C_BOOT_MODE_SRAM);
+		if (!ret)
+			return 0;
+	}
+
+	return ret ? ret : -EIO;
+}
+
+static void icnl9922c_fw_work(struct work_struct *work)
+{
+	struct icnl9922c_ts *ts = container_of(work, struct icnl9922c_ts,
+					       fw_work);
+	struct device *dev = &ts->spi->dev;
+	u8 buf[10];
+	u16 fwid = 0, fwver = 0, res_x = 0, res_y = 0;
+	int ret, retries;
+
+	mutex_lock(&ts->lock);
+
+	if (!ts->fw_data) {
+		const struct firmware *fw;
+
+		ret = request_firmware(&fw, ICNL9922C_FW_NAME, dev);
+		if (ret) {
+			dev_info(dev, "firmware %s not available (%d); idle\n",
+				 ICNL9922C_FW_NAME, ret);
+			mutex_unlock(&ts->lock);
+			return;
+		}
+
+		ts->fw_data = devm_kmemdup(dev, fw->data, fw->size, GFP_KERNEL);
+		ts->fw_size = fw->size;
+		release_firmware(fw);
+		if (!ts->fw_data) {
+			mutex_unlock(&ts->lock);
+			return;
+		}
+	}
+
+	ret = icnl9922c_upload_sram(ts, ts->fw_data, ts->fw_size);
+	if (ret) {
+		dev_err(dev, "failed to upload SRAM firmware: %d\n", ret);
+		mutex_unlock(&ts->lock);
+		return;
+	}
+
+	msleep(40);
+
+	for (retries = 0; retries < 5; retries++) {
+		if (!icnl9922c_tcs_read(ts, ICNL9922C_CMD_INFO_CHIP_FW_ID_RO,
+					buf, 4)) {
+			fwid = get_unaligned_le16(buf);
+			if (fwid && fwid != 0xffff)
+				break;
+		}
+		msleep(30);
+	}
+
+	if (!fwid || fwid == 0xffff) {
+		dev_err(dev, "SRAM firmware failed to boot into TCS mode\n");
+		mutex_unlock(&ts->lock);
+		return;
+	}
+
+	if (!icnl9922c_tcs_read(ts, ICNL9922C_CMD_INFO_FW_VER_RO, buf, 4))
+		fwver = get_unaligned_le16(buf);
+
+	if (!icnl9922c_tcs_read(ts, ICNL9922C_CMD_INFO_TOUCH_XY_INFO_RO,
+				buf, sizeof(buf))) {
+		res_x = get_unaligned_le16(buf);
+		res_y = get_unaligned_le16(buf + 2);
+	}
+
+	ts->running = true;
+	mutex_unlock(&ts->lock);
+
+	ret = icnl9922c_ensure_input(ts, fwid, fwver, res_x, res_y);
+	if (ret)
+		return;
+
+	mutex_lock(&ts->lock);
+	if (ts->running && !ts->irq_enabled) {
+		enable_irq(ts->spi->irq);
+		ts->irq_enabled = true;
+	}
+	mutex_unlock(&ts->lock);
+}
+
+static int icnl9922c_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct icnl9922c_ts *ts = container_of(follower, struct icnl9922c_ts,
+					       panel_follower);
+
+	schedule_work(&ts->fw_work);
+	return 0;
+}
+
+static int icnl9922c_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct icnl9922c_ts *ts = container_of(follower, struct icnl9922c_ts,
+					       panel_follower);
+
+	cancel_work_sync(&ts->fw_work);
+	mutex_lock(&ts->lock);
+	ts->running = false;
+	if (ts->irq_enabled) {
+		disable_irq(ts->spi->irq);
+		ts->irq_enabled = false;
+	}
+	mutex_unlock(&ts->lock);
+
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs icnl9922c_panel_follower_funcs = {
+	.panel_prepared = icnl9922c_panel_prepared,
+	.panel_unpreparing = icnl9922c_panel_unpreparing,
+};
+
+static void icnl9922c_cancel_work(void *data)
+{
+	struct icnl9922c_ts *ts = data;
+
+	cancel_work_sync(&ts->fw_work);
+}
+
+static int icnl9922c_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct icnl9922c_ts *ts;
+	u8 buf[4];
+	u32 hwid = 0;
+	int ret, retries;
+
+	if (spi->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "missing IRQ\n");
+
+	spi->bits_per_word = 8;
+	if (!spi->max_speed_hz)
+		spi->max_speed_hz = 3000000;
+
+	ret = spi_setup(spi);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to setup SPI\n");
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+
+	ts->tx_buf = devm_kzalloc(dev, ICNL9922C_XFER_BUF_SIZE, GFP_KERNEL);
+	ts->rx_buf = devm_kzalloc(dev, ICNL9922C_XFER_BUF_SIZE, GFP_KERNEL);
+	if (!ts->tx_buf || !ts->rx_buf)
+		return -ENOMEM;
+
+	mutex_init(&ts->lock);
+	INIT_WORK(&ts->fw_work, icnl9922c_fw_work);
+	ts->spi = spi;
+	spi_set_drvdata(spi, ts);
+
+	ret = devm_add_action_or_reset(dev, icnl9922c_cancel_work, ts);
+	if (ret)
+		return ret;
+
+	ts->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	if (drm_is_panel_follower(dev)) {
+		ts->panel_follower.funcs = &icnl9922c_panel_follower_funcs;
+		ret = devm_drm_panel_add_follower(dev, &ts->panel_follower);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to register panel follower\n");
+		return 0;
+	}
+
+	icnl9922c_hw_reset(ts);
+
+	for (retries = 0; retries < 3; retries++) {
+		ret = icnl9922c_enter_prog_mode(ts);
+		if (!ret)
+			ret = icnl9922c_prog_read(ts, ICNL9922C_HW_REG_HWID,
+						  buf, sizeof(buf));
+		if (!ret) {
+			hwid = get_unaligned_le32(buf) & ICNL9922C_HWID_MASK;
+			if (hwid == ICNL9922C_HWID)
+				break;
+			ret = -ENODEV;
+		}
+		msleep(20);
+	}
+
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to detect ICNL9922C (hwid=0x%06x)\n",
+				     hwid);
+
+	schedule_work(&ts->fw_work);
+	return 0;
+}
+
+static ssize_t fw_ver_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct icnl9922c_ts *ts = dev_get_drvdata(dev);
+	u8 raw[4];
+	int ret;
+
+	mutex_lock(&ts->lock);
+	if (!ts->running) {
+		mutex_unlock(&ts->lock);
+		return -ENODEV;
+	}
+	ret = icnl9922c_tcs_read(ts, ICNL9922C_CMD_INFO_FW_VER_RO,
+				 raw, sizeof(raw));
+	mutex_unlock(&ts->lock);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "0x%04x\n", get_unaligned_le16(raw));
+}
+static DEVICE_ATTR_RO(fw_ver);
+
+static struct attribute *icnl9922c_attrs[] = {
+	&dev_attr_fw_ver.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(icnl9922c);
+
+static const struct of_device_id icnl9922c_of_match[] = {
+	{ .compatible = "chipone,icnl9922c-ts" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, icnl9922c_of_match);
+
+static const struct spi_device_id icnl9922c_spi_id[] = {
+	{ "icnl9922c-ts" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, icnl9922c_spi_id);
+
+static struct spi_driver icnl9922c_driver = {
+	.driver = {
+		.name = "chipone-icnl9922c",
+		.of_match_table = icnl9922c_of_match,
+		.dev_groups = icnl9922c_groups,
+	},
+	.probe = icnl9922c_probe,
+	.id_table = icnl9922c_spi_id,
+};
+module_spi_driver(icnl9922c_driver);
