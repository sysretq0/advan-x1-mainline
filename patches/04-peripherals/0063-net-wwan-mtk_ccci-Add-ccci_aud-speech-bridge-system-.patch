+static void mtk_ccci_sys_rx(struct mtk_ccci_dev *ccci,
+			    const struct mtk_ccci_header *hdr)
+{
+	switch (hdr->data[1]) {
+	case CCCI_SYS_MD_WDT_MONITOR:
+	case CCCI_SYS_MD_SIM_TYPE:
+	case CCCI_SYS_MD_TX_POWER:
+	case CCCI_SYS_MD_SW_MD1_TX_POWER_REQ:
+	case CCCI_SYS_MD_RF_MAX_TEMP_SUB6:
+	case CCCI_SYS_MD_RF_ALL_TEMP_MMW:
+	case CCCI_SYS_MD_NR_BAND_ACTIVATE:
+		dev_dbg(ccci->dev, "CCCI SYS RX msg=0x%04x rsv=0x%08x\n",
+			hdr->data[1], hdr->reserved);
+		break;
+	default:
+		dev_dbg(ccci->dev, "CCCI SYS RX unknown msg=0x%08x rsv=0x%08x\n",
+			hdr->data[1], hdr->reserved);
+		break;
+	}
+}
+
 static void mtk_ccci_drain_queue(struct mtk_ccci_dev *ccci, u32 q)
 {
 	struct mtk_ccci_header hdr;
@@ -876,6 +897,12 @@ static void mtk_ccci_drain_queue(struct mtk_ccci_dev *ccci, u32 q)
 					       min_t(u32, ret, 64), true);
 			}
 			break;
+		case CCCI_CH_SYSTEM_RX:
+			mtk_ccci_sys_rx(ccci, &hdr);
+			break;
+		case CCCI_CH_PCM_RX:
+			mtk_ccci_aud_rx(ccci, ccci->rx_buf, ret);
+			break;
 		case CCCI_CH_RPC_RX:
 			mtk_ccci_rpc_handle(ccci, ccci->rx_buf, ret);
 			break;
@@ -888,6 +915,7 @@ static void mtk_ccci_drain_queue(struct mtk_ccci_dev *ccci, u32 q)
 		case CCCI_CH_IPC_RX:
 		case CCCI_CH_IPC_UART_RX:
 		case CCCI_CH_IMSA_DL:
+		case CCCI_CH_IMSDC_DL:
 		case CCCI_CH_IMSM_RX:
