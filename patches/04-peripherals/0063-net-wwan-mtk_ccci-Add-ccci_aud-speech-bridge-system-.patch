@@ -231,6 +231,7 @@ struct mtk_ccci_dpmaif {
 	bool irq_enabled;
 	bool started;
 	bool wwan_registered;
+	u32 dl_imr_bak;
 
 	/* DL PIT + BAT + FRG BAT DMA rings */
 	struct mtk_dpmaif_pit *pit_base;
@@ -1564,3 +1565,49 @@ void mtk_ccci_dpmaif_set_irq_wake(struct mtk_ccci_dev *ccci, bool on)
 
 	irq_set_irq_wake(dp->irq, on);
 }
+
+void mtk_ccci_dpmaif_suspend(struct mtk_ccci_dev *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp || !dp->started)
+		return;
+
+	dp->dl_imr_bak = readl(dp->pd_misc_base + DPMAIF_PD_AP_DL_L2TIMR0);
+}
+
+void mtk_ccci_dpmaif_resume(struct mtk_ccci_dev *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+	u32 unmasked;
+
+	if (!dp || !dp->started)
+		return;
+
+	/*
+	 * On MT6789, DPMAIF PD registers retain state across shallow s2idle;
+	 * if DPMAIF PD lost power (UL queue 0 base register cleared), restore
+	 * interrupt masks and HW UL ring configuration cleanly.
+	 */
+	if (readl(dp->pd_ul_base + DPMAIF_PD_UL_CHNL_CON0(0)) != 0)
+		return;
+
+	dev_warn(dp->dev, "DPMAIF PD lost power during suspend; restoring registers\n");
+
+	writel(0xffffffffU, dp->pd_misc_base + DPMAIF_PD_AP_DL_L2TISAR0);
+	writel(dp->dl_imr_bak, dp->pd_misc_base + DPMAIF_PD_AP_DL_L2TIMSR0);
+	unmasked = ~dp->dl_imr_bak & DPMAIF_DL_L2INTR_EN_MSK;
+	if (unmasked)
+		writel(unmasked, dp->pd_misc_base + DPMAIF_PD_AP_DL_L2TIMCR0);
+	dpmaif_set_ao_dl_isr_mask(dp, dp->dl_imr_bak);
+
+	writel(0xffffffffU, dp->pd_misc_base + DPMAIF_PD_AP_UL_L2TISAR0);
+	writel(DPMAIF_UL_L2INTR_EN_MSK,
+	       dp->pd_misc_base + DPMAIF_PD_AP_UL_L2TICR0);
+	writel(~(u32)DPMAIF_UL_L2INTR_EN_MSK,
+	       dp->pd_misc_base + DPMAIF_PD_AP_UL_L2TISR0);
+
+	writel(0xffffffffU, dp->pd_misc_base + DPMAIF_PD_AP_IP_BUSY);
+	writel(0, dp->pd_misc_base + DPMAIF_PD_AP_DLUL_IP_BUSY_MASK);
+	dpmaif_tx_hw_init(dp);
+}
