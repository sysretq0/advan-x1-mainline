 			dev_dbg(ccci->dev, "CCIF Q%u ch=%u RX len=%d\n",
@@ -1829,6 +1857,12 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 		goto err_fs;
 	}
 
+	ret = mtk_ccci_aud_register(ccci);
