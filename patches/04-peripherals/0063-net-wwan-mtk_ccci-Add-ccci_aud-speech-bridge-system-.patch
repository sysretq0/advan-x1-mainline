diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_aud.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_aud.c
new file mode 100644
index 000000000..b3bad4e52
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_aud.c
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 CCCI /dev/ccci_aud speech mailbox bridge
+ * (CCIF0 Q0 ch=4 RX <-> ch=5 TX).
+ *
+ * Implements PORT_F_USER_HEADER semantics matching Gen95 AudioHAL
+ * SpeechMessengerNormal: userspace reads and writes complete packets starting
+ * with the 16-byte mtk_ccci_header. On TX, hdr.data[0], hdr.data[1], and
+ * hdr.reserved are preserved verbatim so both 16-byte mailbox commands
+ * (data[0]=0xffffffff, data[1]=(msg_id << 16) | param16) and payload commands
+ * (data[0]=0, data[1]=payload_len, reserved=(msg_id << 16) | payload_len) are
+ * delivered unmodified while the kernel enforces channel=5 and sequence
+ * numbering.
+ *
+ * Copyright (c) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/poll.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "mtk_ccci.h"
+
+struct mtk_ccci_aud_pkt {
+	struct list_head node;
+	u32 len;
+	u8 data[] __counted_by(len);
+};
+
+static void mtk_ccci_aud_purge_rx(struct mtk_ccci_dev *ccci)
+{
+	struct mtk_ccci_aud_pkt *pkt, *tmp;
+	unsigned long flags;
+	LIST_HEAD(local);
+
+	spin_lock_irqsave(&ccci->aud_rx_lock, flags);
+	list_splice_init(&ccci->aud_rx_list, &local);
+	WRITE_ONCE(ccci->aud_rx_qlen, 0);
+	spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+
+	list_for_each_entry_safe(pkt, tmp, &local, node) {
+		list_del(&pkt->node);
+		kfree(pkt);
+	}
+}
+
+void mtk_ccci_aud_rx(struct mtk_ccci_dev *ccci, const u8 *data, u32 len)
+{
+	struct mtk_ccci_aud_pkt *pkt;
+	unsigned long flags;
+
+	if (!data || len < sizeof(struct mtk_ccci_header) ||
+	    len > MTK_CCCI_AUD_MAX_PKT)
+		return;
+
+	atomic_inc(&ccci->aud_rx_count);
+
+	/* Drop MD boot-time speech hello messages when no daemon is attached */
+	if (!atomic_read(&ccci->aud_open)) {
+		dev_dbg(ccci->dev, "ccci_aud RX %u B dropped (port closed)\n",
+			len);
+		return;
+	}
+
+	pkt = kmalloc(struct_size(pkt, data, len), GFP_KERNEL);
+	if (!pkt)
+		return;
+
+	pkt->len = len;
+	memcpy(pkt->data, data, len);
+
+	spin_lock_irqsave(&ccci->aud_rx_lock, flags);
+	if (ccci->aud_rx_qlen >= MTK_CCCI_AUD_RX_QUEUE_MAX) {
+		spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+		dev_warn_ratelimited(ccci->dev,
+				     "ccci_aud RX queue full (%u), dropping\n",
+				     MTK_CCCI_AUD_RX_QUEUE_MAX);
+		kfree(pkt);
+		return;
+	}
+	list_add_tail(&pkt->node, &ccci->aud_rx_list);
+	WRITE_ONCE(ccci->aud_rx_qlen, ccci->aud_rx_qlen + 1);
+	spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+
+	wake_up_interruptible(&ccci->aud_rx_wq);
+}
+
+static int mtk_ccci_aud_open(struct inode *inode, struct file *filp)
+{
+	struct miscdevice *mdev = filp->private_data;
+	struct mtk_ccci_dev *ccci = container_of(mdev, struct mtk_ccci_dev,
+						 aud_miscdev);
+
+	if (atomic_cmpxchg(&ccci->aud_open, 0, 1) != 0)
+		return -EBUSY;
+
+	filp->private_data = ccci;
+	nonseekable_open(inode, filp);
+	return 0;
+}
+
+static int mtk_ccci_aud_release(struct inode *inode, struct file *filp)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+
+	atomic_set(&ccci->aud_open, 0);
+	mtk_ccci_aud_purge_rx(ccci);
+	return 0;
+}
+
+static ssize_t mtk_ccci_aud_read(struct file *filp, char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+	struct mtk_ccci_aud_pkt *pkt;
+	unsigned long flags;
+	ssize_t ret;
+
+	for (;;) {
+		spin_lock_irqsave(&ccci->aud_rx_lock, flags);
+		pkt = list_first_entry_or_null(&ccci->aud_rx_list,
+					       struct mtk_ccci_aud_pkt, node);
+		if (pkt) {
+			if (count < pkt->len) {
+				spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+				return -EMSGSIZE;
+			}
+			list_del(&pkt->node);
+			WRITE_ONCE(ccci->aud_rx_qlen, ccci->aud_rx_qlen - 1);
+			spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+			break;
+		}
+		spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+
+		if (READ_ONCE(ccci->aud_closing))
+			return -ENODEV;
+
+		if (filp->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+
+		ret = wait_event_interruptible(ccci->aud_rx_wq,
+					       READ_ONCE(ccci->aud_rx_qlen) > 0 ||
+					       READ_ONCE(ccci->aud_closing));
+		if (ret)
+			return ret;
+	}
+
+	if (copy_to_user(buf, pkt->data, pkt->len))
+		ret = -EFAULT;
+	else
+		ret = pkt->len;
+
+	kfree(pkt);
+	return ret;
+}
+
+static ssize_t mtk_ccci_aud_write(struct file *filp, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+	struct mtk_ccci_header *hdr;
+	u8 *kbuf;
+	int ret, tries;
+
+	if (count < sizeof(*hdr) || count > MTK_CCCI_AUD_MAX_PKT)
+		return -EINVAL;
+
+	if (READ_ONCE(ccci->state) != MTK_CCCI_STATE_READY)
+		return -ENODEV;
+
+	kbuf = memdup_user(buf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	/*
+	 * PORT_F_USER_HEADER: preserve data[0], data[1], and reserved from
+	 * userspace verbatim so both 16-byte mailbox commands and variable-size
+	 * speech payload packets match Gen95 SpeechMessengerNormal.
+	 */
+	hdr = (struct mtk_ccci_header *)kbuf;
+	hdr->channel = CCCI_CH_PCM_TX;
+
+	for (tries = 0; tries < 200; tries++) {
+		ret = mtk_ccci_tx_send(ccci, MTK_CCIF_AUD_QUEUE, kbuf, count);
+		if (ret != -ENOSPC || (filp->f_flags & O_NONBLOCK))
+			break;
+		usleep_range(500, 1000);
+	}
+
+	kfree(kbuf);
+	if (ret)
+		return ret == -ENOSPC ? -EAGAIN : ret;
+
+	atomic_inc(&ccci->aud_tx_count);
+	return count;
+}
+
+static __poll_t mtk_ccci_aud_poll(struct file *filp, poll_table *wait)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+	__poll_t mask = EPOLLOUT | EPOLLWRNORM;
+	unsigned long flags;
+
+	poll_wait(filp, &ccci->aud_rx_wq, wait);
+
+	spin_lock_irqsave(&ccci->aud_rx_lock, flags);
+	if (ccci->aud_rx_qlen > 0)
+		mask |= EPOLLIN | EPOLLRDNORM;
+	spin_unlock_irqrestore(&ccci->aud_rx_lock, flags);
+
+	return mask;
+}
+
+static const struct file_operations mtk_ccci_aud_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_ccci_aud_open,
+	.release = mtk_ccci_aud_release,
+	.read = mtk_ccci_aud_read,
+	.write = mtk_ccci_aud_write,
+	.poll = mtk_ccci_aud_poll,
+};
+
+int mtk_ccci_aud_register(struct mtk_ccci_dev *ccci)
+{
+	spin_lock_init(&ccci->aud_rx_lock);
+	INIT_LIST_HEAD(&ccci->aud_rx_list);
+	init_waitqueue_head(&ccci->aud_rx_wq);
+	atomic_set(&ccci->aud_open, 0);
+
+	ccci->aud_miscdev.minor = MISC_DYNAMIC_MINOR;
+	ccci->aud_miscdev.name = "ccci_aud";
+	ccci->aud_miscdev.fops = &mtk_ccci_aud_fops;
+	ccci->aud_miscdev.parent = ccci->dev;
+
+	return misc_register(&ccci->aud_miscdev);
+}
+
+void mtk_ccci_aud_unregister(struct mtk_ccci_dev *ccci)
+{
+	WRITE_ONCE(ccci->aud_closing, true);
+	wake_up_interruptible_all(&ccci->aud_rx_wq);
+	misc_deregister(&ccci->aud_miscdev);
+	mtk_ccci_aud_purge_rx(ccci);
+}
