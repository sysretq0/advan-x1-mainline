 		dev_warn(&pdev->dev, "DPMAIF init failed (%d); continuing without IP data plane\n",
@@ -1842,6 +1876,8 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 		 mtk_ccci_state_names[READ_ONCE(ccci->state)]);
 	return 0;
 
+err_rpc:
+	mtk_ccci_rpc_unregister(ccci);
 err_fs:
 	mtk_ccci_fs_unregister(ccci);
 err_wq:
@@ -1851,22 +1887,31 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 	return ret;
 }
 
