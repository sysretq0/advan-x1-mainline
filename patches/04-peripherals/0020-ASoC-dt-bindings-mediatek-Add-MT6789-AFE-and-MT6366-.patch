From 00c572453187e468c4e12ab721173821e4f6ad1b Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:15:48 +0000
Subject: [PATCH] ASoC: dt-bindings: mediatek: Add MT6789 AFE and MT6366 sound
 card bindings

Extend the MT8186 AFE PCM binding with the compatible MediaTek MT6789
audio front-end (power-domains and optional reset) and add the MT6789
with MT6366 PMIC ASoC sound card binding.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 .../sound/mediatek,mt6789-mt6366-sound.yaml   | 67 +++++++++++++++++++
 .../bindings/sound/mt8186-afe-pcm.yaml        | 20 +++++-
 2 files changed, 84 insertions(+), 3 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/sound/mediatek,mt6789-mt6366-sound.yaml

diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6789-mt6366-sound.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6789-mt6366-sound.yaml
new file mode 100644
index 0000000..024f232
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6789-mt6366-sound.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6789-mt6366-sound.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6789 with MT6366 ASoC sound card
+
+maintainers:
+  - sysretq0 <324514544+sysretq0@users.noreply.github.com>
+
+description: |
+  This binding describes the ASoC sound card for MediaTek MT6789 boards
+  using the integrated MT6366 (MT6358) PMIC audio codec and optional I2S
+  codecs.
+
+allOf:
+  - $ref: sound-card-common.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6789-mt6366-sound
+
+  mediatek,platform:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The phandle of the MT6789 ASoC AFE platform node.
+
+  pinctrl-names: true
+
+patternProperties:
+  "^pinctrl-[0-9]+$": true
+  "^dai-link-[0-9]+$":
+    type: object
+    properties:
+      link-name:
+        enum:
+          - I2S0
+          - I2S3
+      codec:
+        type: object
+        properties:
+          sound-dai: true
+        required:
+          - sound-dai
+        additionalProperties: false
+    required:
+      - link-name
+    additionalProperties: false
+
+required:
+  - compatible
+  - model
+  - mediatek,platform
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "mediatek,mt6789-mt6366-sound";
+        model = "mt6789-mt6366";
+        mediatek,platform = <&afe>;
+        audio-routing =
+            "Headphone", "Headphone L",
+            "Headphone", "Headphone R",
+            "Earpiece", "Receiver";
+    };
diff --git a/Documentation/devicetree/bindings/sound/mt8186-afe-pcm.yaml b/Documentation/devicetree/bindings/sound/mt8186-afe-pcm.yaml
index f5af2cf..1c3d31f 100644
--- a/Documentation/devicetree/bindings/sound/mt8186-afe-pcm.yaml
+++ b/Documentation/devicetree/bindings/sound/mt8186-afe-pcm.yaml
@@ -11,7 +11,9 @@ maintainers:
 
 properties:
   compatible:
-    const: mediatek,mt8186-sound
+    enum:
+      - mediatek,mt8186-sound
+      - mediatek,mt6789-sound
 
   reg:
     maxItems: 1
@@ -19,6 +21,9 @@ properties:
   interrupts:
     maxItems: 1
 
+  power-domains:
+    maxItems: 1
+
   resets:
     maxItems: 1
 
@@ -100,14 +105,23 @@ properties:
 required:
   - compatible
   - interrupts
-  - resets
-  - reset-names
   - mediatek,apmixedsys
   - mediatek,infracfg
   - mediatek,topckgen
   - clocks
   - clock-names
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt8186-sound
+    then:
+      required:
+        - resets
+        - reset-names
+
 additionalProperties: false
 
 examples:
-- 
2.55.0

