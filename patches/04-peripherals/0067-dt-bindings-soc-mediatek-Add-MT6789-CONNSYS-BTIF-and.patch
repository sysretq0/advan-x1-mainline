From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Fri, 27 Nov 2026 14:36:00 +0700
Subject: [PATCH] dt-bindings: soc: mediatek: Add MT6789 CONNSYS, BTIF, and Wi-Fi bindings

Add devicetree binding schemas for the MediaTek MT6789 integrated
CONNSYS connectivity subsystem:
- mediatek,consys_emi_reserved (CONNSYS shared EMI reserved-memory region)
- mediatek,btif (AP-CONNSYS BTIF/APDMA transport)
- mediatek,mt6789-consys (CONNSYS top control, PMIC rails, SCPSYS domain)
- mediatek,wifi (CONNSYS HIF-AXI Wi-Fi controller)

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../reserved-memory/mediatek,consys-emi.yaml  | 34 ++++++++++
 .../soc/mediatek/mediatek,mt6789-btif.yaml    | 54 +++++++++++++++
 .../soc/mediatek/mediatek,mt6789-consys.yaml  | 67 +++++++++++++++++++
 .../soc/mediatek/mediatek,mt6789-wifi.yaml    | 54 +++++++++++++++
 4 files changed, 209 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/reserved-memory/mediatek,consys-emi.yaml
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-btif.yaml
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-consys.yaml
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-wifi.yaml

diff --git a/Documentation/devicetree/bindings/reserved-memory/mediatek,consys-emi.yaml b/Documentation/devicetree/bindings/reserved-memory/mediatek,consys-emi.yaml
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/Documentation/devicetree/bindings/reserved-memory/mediatek,consys-emi.yaml
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/reserved-memory/mediatek,consys-emi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek CONNSYS Shared EMI Reserved Memory
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+allOf:
+  - $ref: reserved-memory.yaml
+
+properties:
+  compatible:
+    const: mediatek,consys_emi_reserved
+
+  reg:
+    maxItems: 1
+
+  no-map: true
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    memory@7f000000 {
+        compatible = "mediatek,consys_emi_reserved";
+        reg = <0x00 0x7f000000 0x00 0x00500000>;
+        no-map;
+    };
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-btif.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-btif.yaml
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-btif.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6789-btif.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek CONNSYS BTIF Transport Controller
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+properties:
+  compatible:
+    const: mediatek,btif
+
+  reg:
+    minItems: 3
+    maxItems: 3
+
+  interrupts:
+    minItems: 3
+    maxItems: 3
+
+  clocks:
+    minItems: 2
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: btifc
+      - const: apdmac
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    btif@1100c000 {
+        compatible = "mediatek,btif";
+        reg = <0x1100c000 0x1000>,
+              <0x10217b00 0x80>,
+              <0x10217b80 0x80>;
+        interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&infracfg_ao 18>, <&infracfg_ao 61>;
+        clock-names = "btifc", "apdmac";
+    };
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-consys.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-consys.yaml
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-consys.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6789-consys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6789 Integrated CONNSYS Connectivity Subsystem
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+properties:
+  compatible:
+    const: mediatek,mt6789-consys
+
+  "#thermal-sensor-cells":
+    const: 0
+
+  reg:
+    minItems: 12
+    maxItems: 12
+
+  interrupts:
+    minItems: 3
+    maxItems: 3
+
+  power-domains:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: ccif
+
+  pmic:
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  vcn18-supply: true
+  vcn28-supply: true
+  vcn33_bt-supply: true
+  vcn33_wifi-supply: true
+
+  emi-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-size:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-alignment:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-max-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - power-domains
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    consys@18002000 {
+        compatible = "mediatek,mt6789-consys";
+        #thermal-sensor-cells = <0>;
+        reg = <0x18002000 0x1000>, <0x10007000 0x0100>,
+              <0x10001000 0x1000>, <0x10006000 0x1000>,
+              <0x18007000 0x1000>, <0x180b1000 0x1000>,
+              <0x180a3000 0x1000>, <0x180a5000 0x0800>,
+              <0x180c1000 0x1000>, <0x18004000 0x1000>,
+              <0x1024c000 0x0040>, <0x10003000 0x1000>;
+        interrupts = <GIC_SPI 410 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 411 IRQ_TYPE_LEVEL_HIGH>;
+        power-domains = <&spm 1>;
+        clocks = <&infracfg_ao 56>;
+        clock-names = "ccif";
+    };
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-wifi.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-wifi.yaml
new file mode 100644
index 0000000..4444444
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6789-wifi.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6789-wifi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6789 CONNSYS HIF-AXI Wi-Fi Controller
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+properties:
+  compatible:
+    const: mediatek,wifi
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  memory-region:
+    maxItems: 1
+
+  emi-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-size:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-alignment:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-max-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    wifi@18000000 {
+        compatible = "mediatek,wifi";
+        reg = <0x18000000 0x100000>;
+        interrupts = <GIC_SPI 409 IRQ_TYPE_LEVEL_HIGH>;
+        memory-region = <&wifi_dma_mem>;
+        emi-addr = <0x00>;
+        emi-size = <0x600000>;
+        emi-alignment = <0x1000000>;
+        emi-max-addr = <0xc0000000>;
+    };
-- 
