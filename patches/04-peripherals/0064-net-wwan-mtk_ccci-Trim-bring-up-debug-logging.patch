From ff79dbd8cc99e23abab3b8ea79302ee0d6d7fb1d Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Fri, 27 Nov 2026 03:16:09 +0700
Subject: [PATCH 64/65] net: wwan: mtk_ccci: Trim bring-up debug logging

Demote verbose per-packet, per-RPC, and bring-up handshake dev_info and
KERN_INFO hex dumps across mtk_ccci to dev_dbg and print_hex_dump_debug,
and remove the temporary dpmaif_dump_init_regs() register dumper. Keep
concise lifecycle messages (probe and MD READY) alongside all warning,
error, and MD exception crash-decoder logs.

Signed-off-by: sysretq0 <sysretq0@proton.me>

diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_at.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_at.c
index 328ec1a55..891477fa8 100644
--- a/drivers/net/wwan/mtk_ccci/mtk_ccci_at.c
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_at.c
@@ -152,8 +152,8 @@ static void mtk_ccci_at_log_urc(struct mtk_ccci_dev *ccci, const u8 *payload,
 		out--;
 	preview[out] = '\0';
 
-	dev_info(ccci->dev, "AT RX (%u B, port closed): %s\n",
-		 payload_len, preview);
+	dev_dbg(ccci->dev, "AT RX (%u B, port closed): %s\n",
+		payload_len, preview);
 }
 
 void mtk_ccci_at_rx(struct mtk_ccci_dev *ccci, const u8 *pkt, u32 len)
@@ -210,8 +210,8 @@ int mtk_ccci_at_register(struct mtk_ccci_dev *ccci)
 	ccci->at_port = port;
 	spin_unlock_irqrestore(&ccci->at_lock, flags);
 
-	dev_info(ccci->dev, "registered WWAN AT port (CCIF Q%u ch %u/%u)\n",
-		 MTK_CCIF_AT_QUEUE, CCCI_CH_UART2_RX, CCCI_CH_UART2_TX);
+	dev_dbg(ccci->dev, "registered WWAN AT port (CCIF Q%u ch %u/%u)\n",
+		MTK_CCIF_AT_QUEUE, CCCI_CH_UART2_RX, CCCI_CH_UART2_TX);
 	return 0;
 }
 
