From 48f20a6c390f655f61b89b85f1fa20e8609078c4 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Mon, 23 Nov 2026 18:00:00 +0000
Subject: [PATCH] dt-bindings: ufs/usb/phy: mediatek: Add MT6789 compatibles

Document MediaTek MT6789 compatible strings for UFS host controller
(including its 7 clocks, optional resets/reset-names, and optional
external M-PHY node), MUSB controller, and USB2 T-PHY v2.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../bindings/phy/mediatek,tphy.yaml           |  1 +
 .../devicetree/bindings/ufs/mediatek,ufs.yaml | 64 +++++++++++++++----
 .../bindings/usb/mediatek,musb.yaml           |  1 +
 3 files changed, 53 insertions(+), 13 deletions(-)

diff --git a/Documentation/devicetree/bindings/phy/mediatek,tphy.yaml b/Documentation/devicetree/bindings/phy/mediatek,tphy.yaml
index 8b240cf..d2894b8 100644
--- a/Documentation/devicetree/bindings/phy/mediatek,tphy.yaml
+++ b/Documentation/devicetree/bindings/phy/mediatek,tphy.yaml
@@ -78,6 +78,7 @@ properties:
       - items:
           - enum:
               - mediatek,mt2712-tphy
+              - mediatek,mt6789-tphy
               - mediatek,mt6893-tphy
               - mediatek,mt7629-tphy
               - mediatek,mt7981-tphy
diff --git a/Documentation/devicetree/bindings/ufs/mediatek,ufs.yaml b/Documentation/devicetree/bindings/ufs/mediatek,ufs.yaml
index 15c347f..b8677ab 100644
--- a/Documentation/devicetree/bindings/ufs/mediatek,ufs.yaml
+++ b/Documentation/devicetree/bindings/ufs/mediatek,ufs.yaml
@@ -12,10 +12,14 @@ maintainers:
 
 properties:
   compatible:
-    enum:
-      - mediatek,mt8183-ufshci
-      - mediatek,mt8192-ufshci
-      - mediatek,mt8195-ufshci
+    oneOf:
+      - enum:
+          - mediatek,mt8183-ufshci
+          - mediatek,mt8192-ufshci
+          - mediatek,mt8195-ufshci
+      - items:
+          - const: mediatek,mt6789-ufshci
+          - const: mediatek,mt8183-ufshci
 
   clocks:
     minItems: 1
@@ -31,6 +35,18 @@ properties:
   reg:
     maxItems: 1
 
+  resets:
+    minItems: 1
+    maxItems: 4
+
+  reset-names:
+    minItems: 1
+    items:
+      - const: hci_rst
+      - const: unipro_rst
+      - const: crypto_rst
+      - const: mphy_rst
+
   vcc-supply: true
 
   mediatek,ufs-disable-mcq:
@@ -41,7 +57,6 @@ required:
   - compatible
   - clocks
   - clock-names
-  - phys
   - reg
   - vcc-supply
 
@@ -54,8 +69,7 @@ allOf:
       properties:
         compatible:
           contains:
-            enum:
-              - mediatek,mt8195-ufshci
+            const: mediatek,mt8195-ufshci
     then:
       properties:
         clocks:
@@ -70,13 +84,37 @@ allOf:
             - const: unipro_mp_bclk
             - const: ufs_tx_symbol
             - const: ufs_mem_sub
+      required:
+        - phys
     else:
-      properties:
-        clocks:
-          maxItems: 1
-        clock-names:
-          items:
-            - const: ufs
+      if:
+        properties:
+          compatible:
+            contains:
+              const: mediatek,mt6789-ufshci
+      then:
+        properties:
+          clocks:
+            minItems: 7
+            maxItems: 7
+          clock-names:
+            items:
+              - const: ufs
+              - const: ufs_mp
+              - const: unipro_tick
+              - const: unipro_sys
+              - const: ufs_aes
+              - const: ufsfde_ck
+              - const: ufs_ck
+      else:
+        properties:
+          clocks:
+            maxItems: 1
+          clock-names:
+            items:
+              - const: ufs
+        required:
+          - phys
 
 examples:
   - |
diff --git a/Documentation/devicetree/bindings/usb/mediatek,musb.yaml b/Documentation/devicetree/bindings/usb/mediatek,musb.yaml
index a39d38d..8ac573f 100644
--- a/Documentation/devicetree/bindings/usb/mediatek,musb.yaml
+++ b/Documentation/devicetree/bindings/usb/mediatek,musb.yaml
@@ -19,6 +19,7 @@ properties:
       - enum:
           - mediatek,mt8516-musb
           - mediatek,mt2701-musb
+          - mediatek,mt6789-musb
           - mediatek,mt7623-musb
       - const: mediatek,mtk-musb
 
-- 
2.55.0

