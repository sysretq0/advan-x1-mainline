From f475d59fffaa86cec4815e9bc6cecb861cb2b304 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sun, 22 Nov 2026 04:29:43 +0000
Subject: [PATCH 07/11] dt-bindings: thermal: mediatek: lvts: Add MT6789
 support

Document the mediatek,mt6789-lvts compatible string and add MT6789
thermal sensor IDs to mediatek,lvts-thermal.h.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../bindings/thermal/mediatek,lvts-thermal.yaml    |  2 ++
 .../dt-bindings/thermal/mediatek,lvts-thermal.h    | 14 ++++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml b/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
index 29f431fcd..4bc04c55e 100644
--- a/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
+++ b/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
@@ -18,6 +18,7 @@ description: |
 properties:
   compatible:
     enum:
+      - mediatek,mt6789-lvts
       - mediatek,mt7987-lvts-ap
       - mediatek,mt7988-lvts-ap
       - mediatek,mt8186-lvts
@@ -65,6 +66,7 @@ allOf:
       properties:
         compatible:
           contains:
             enum:
+              - mediatek,mt6789-lvts
               - mediatek,mt8188-lvts-ap
               - mediatek,mt8188-lvts-mcu
               - mediatek,mt8192-lvts-ap
diff --git a/include/dt-bindings/thermal/mediatek,lvts-thermal.h b/include/dt-bindings/thermal/mediatek,lvts-thermal.h
index 350f98178..ff24d679e 100644
--- a/include/dt-bindings/thermal/mediatek,lvts-thermal.h
+++ b/include/dt-bindings/thermal/mediatek,lvts-thermal.h
@@ -109,4 +109,18 @@
 #define MT8196_AP_BOT2                  6
 #define MT8196_AP_BOT3                  7
 
+#define MT6789_LITTLE_CPU0	0
+#define MT6789_LITTLE_CPU1	1
+#define MT6789_LITTLE_CPU2	2
+#define MT6789_LITTLE_CPU3	3
+#define MT6789_BIG_CPU0		4
+#define MT6789_BIG_CPU1		5
+#define MT6789_BIG_CPU2		6
+#define MT6789_BIG_CPU3		7
+#define MT6789_GPU0		8
+#define MT6789_GPU1		9
+#define MT6789_SOC0		10
+#define MT6789_SOC1		11
+#define MT6789_MD		12
+
 #endif /* __MEDIATEK_LVTS_DT_H */
-- 
2.55.0

