+
+#include <linux/align.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/string.h>
+
+#include "mtk_ccci.h"
+
+/* Ringbuffer layout in non-cacheable SMEM:
+ *   +0x00: u32 header[2] = { 0xee0000ee, 0xee0000ee }
+ *   +0x08: rx_control { u32 read, write, length }
+ *   +0x14: tx_control { u32 read, write, length }
+ *   +0x20: rx_buffer[rx_len]
+ *   +0x20 + rx_len: tx_buffer[tx_len]
+ *   +0x20 + rx_len + tx_len: u32 footer[2] = { 0xff0000ff, 0xff0000ff }
+ */
+#define RBF_OFF_RX_READ		0x08
+#define RBF_OFF_RX_WRITE	0x0c
+#define RBF_OFF_RX_LEN		0x10
+#define RBF_OFF_TX_READ		0x14
+#define RBF_OFF_TX_WRITE	0x18
+#define RBF_OFF_TX_LEN		0x1c
+#define RBF_OFF_DATA		0x20
+
+#define PKG_HDR_LEN		8U
+#define PKG_FTR_LEN		8U
+
+static void rbf_read_wrap(void __iomem *buf, u32 buflen, u32 pos,
+			  void *dst, u32 len)
+{
+	u32 first;
+
+	if (pos + len <= buflen) {
+		memcpy_fromio(dst, buf + pos, len);
+		return;
+	}
+
+	first = buflen - pos;
+	memcpy_fromio(dst, buf + pos, first);
+	memcpy_fromio((u8 *)dst + first, buf, len - first);
+}
+
+static void rbf_write_wrap(void __iomem *buf, u32 buflen, u32 pos,
+			   const void *src, u32 len)
+{
+	u32 first;
+
+	if (pos + len <= buflen) {
+		memcpy_toio(buf + pos, src, len);
+		return;
+	}
+
+	first = buflen - pos;
+	memcpy_toio(buf + pos, src, first);
+	memcpy_toio(buf, (const u8 *)src + first, len - first);
+}
+
+int mtk_ccci_rb_create(struct mtk_ccci_ringbuf *rb, void __iomem *base,
+		       u32 rx_size, u32 tx_size)
+{
+	u32 total = CCCI_RBF_CTL_LEN + rx_size + tx_size;
+	u32 ftr_off = RBF_OFF_DATA + rx_size + tx_size;
+
+	if (!rb || !base)
+		return -EINVAL;
+
+	memset_io(base, 0, total);
+	writel(CCCI_RBF_HEADER_MAGIC, base + 0x00);
+	writel(CCCI_RBF_HEADER_MAGIC, base + 0x04);
+	writel(0, base + RBF_OFF_RX_READ);
+	writel(0, base + RBF_OFF_RX_WRITE);
+	writel(rx_size, base + RBF_OFF_RX_LEN);
+	writel(0, base + RBF_OFF_TX_READ);
+	writel(0, base + RBF_OFF_TX_WRITE);
+	writel(tx_size, base + RBF_OFF_TX_LEN);
+	writel(CCCI_RBF_FOOTER_MAGIC, base + ftr_off);
+	writel(CCCI_RBF_FOOTER_MAGIC, base + ftr_off + 4);
+	/* Ensure ringbuffer metadata is visible to MD before handshake */
+	mb();
+
+	rb->base = base;
+	rb->rx_len = rx_size;
+	rb->tx_len = tx_size;
+	return 0;
+}
+
+int mtk_ccci_rb_readable(struct mtk_ccci_ringbuf *rb)
+{
+	void __iomem *rx_buf;
+	u32 rd, wr, len, avail, pkt_len, total_len, ftr_pos;
+	u32 hdr[2], ftr[2];
+
+	if (!rb || !rb->base || !rb->rx_len)
+		return -EAGAIN;
+
+	/* Observe MD write pointer updates before reading ring payload */
+	rmb();
+	rd = readl(rb->base + RBF_OFF_RX_READ);
+	wr = readl(rb->base + RBF_OFF_RX_WRITE);
+	len = rb->rx_len;
+
+	if (rd >= len || wr >= len)
+		return -EPROTO;
+
+	avail = (wr >= rd) ? (wr - rd) : (len - rd + wr);
+	if (avail < PKG_HDR_LEN + sizeof(struct mtk_ccci_header) + PKG_FTR_LEN)
+		return -EAGAIN;
+
+	rx_buf = rb->base + RBF_OFF_DATA;
+	rbf_read_wrap(rx_buf, len, rd, hdr, sizeof(hdr));
+	if (hdr[0] != CCCI_PKG_HEADER_MAGIC)
+		return -EPROTO;
+
+	pkt_len = hdr[1];
+	total_len = ALIGN(PKG_HDR_LEN + pkt_len + PKG_FTR_LEN, 8);
+	if (pkt_len == 0 || total_len > avail || total_len > len)
+		return -EPROTO;
+
+	ftr_pos = (rd + total_len - PKG_FTR_LEN) % len;
+	rbf_read_wrap(rx_buf, len, ftr_pos, ftr, sizeof(ftr));
+	if (ftr[0] != CCCI_PKG_FOOTER_MAGIC || ftr[1] != CCCI_PKG_FOOTER_MAGIC)
+		return -EPROTO;
+
+	return pkt_len;
+}
+
+int mtk_ccci_rb_read(struct mtk_ccci_ringbuf *rb, void *dst, u32 max_len)
+{
+	void __iomem *rx_buf;
+	u32 rd, len, pkt_len, copy_len, total_len, data_pos, new_rd;
+	int ret;
+
+	ret = mtk_ccci_rb_readable(rb);
+	if (ret < 0)
+		return ret;
+
+	pkt_len = ret;
+	len = rb->rx_len;
+	rd = readl(rb->base + RBF_OFF_RX_READ);
+	rx_buf = rb->base + RBF_OFF_DATA;
+
+	copy_len = min(pkt_len, max_len);
+	data_pos = (rd + PKG_HDR_LEN) % len;
+	if (dst && copy_len)
+		rbf_read_wrap(rx_buf, len, data_pos, dst, copy_len);
+
+	total_len = ALIGN(PKG_HDR_LEN + pkt_len + PKG_FTR_LEN, 8);
+	new_rd = (rd + total_len) % len;
+	/* Complete payload reads before advancing the shared read pointer */
+	mb();
+	writel(new_rd, rb->base + RBF_OFF_RX_READ);
+	/* Flush updated read pointer to non-cacheable SMEM */
+	wmb();
+
+	return pkt_len;
+}
+
+int mtk_ccci_rb_write(struct mtk_ccci_ringbuf *rb, const void *src, u32 len)
+{
+	void __iomem *tx_buf;
+	u32 rd, wr, tx_len, free_sz, aligned_payload, total_len, pos;
+	u32 hdr[2] = { CCCI_PKG_HEADER_MAGIC, len };
+	u32 ftr[2] = { CCCI_PKG_FOOTER_MAGIC, CCCI_PKG_FOOTER_MAGIC };
+
+	if (!rb || !rb->base || !rb->tx_len || !src || !len)
+		return -EINVAL;
+
+	/* Observe MD read pointer updates before computing free space */
+	rmb();
+	rd = readl(rb->base + RBF_OFF_TX_READ);
+	wr = readl(rb->base + RBF_OFF_TX_WRITE);
+	tx_len = rb->tx_len;
+	if (rd >= tx_len || wr >= tx_len)
+		return -EPROTO;
+
+	aligned_payload = ALIGN(len, 8);
+	total_len = PKG_HDR_LEN + aligned_payload + PKG_FTR_LEN;
+	if (rd == wr)
+		free_sz = tx_len - 1;
+	else if (rd < wr)
+		free_sz = (tx_len - wr - 1) + rd;
+	else
+		free_sz = rd - wr - 1;
+
+	if (total_len >= free_sz)
+		return -ENOSPC;
+
+	tx_buf = rb->base + RBF_OFF_DATA + rb->rx_len;
+	pos = wr;
+
+	rbf_write_wrap(tx_buf, tx_len, pos, hdr, sizeof(hdr));
+	pos = (pos + PKG_HDR_LEN) % tx_len;
+
+	rbf_write_wrap(tx_buf, tx_len, pos, src, len);
+	pos = (pos + aligned_payload) % tx_len;
+
+	rbf_write_wrap(tx_buf, tx_len, pos, ftr, sizeof(ftr));
+	pos = (pos + PKG_FTR_LEN) % tx_len;
+
+	/* Ensure packet header, payload, and footer are visible before wr */
+	wmb();
+	writel(pos, rb->base + RBF_OFF_TX_WRITE);
+	/* Flush updated write pointer before CCIF doorbell */
+	wmb();
+
+	return len;
+}
