+static int mtk_ccci_parse_mem_region(struct device *dev, const char *name,
+				     phys_addr_t *phys, size_t *size)
+{
+	struct device_node *np;
+	struct resource res;
+	int idx, ret;
+
+	idx = of_property_match_string(dev->of_node, "memory-region-names", name);
+	if (idx < 0)
+		return idx;
+
+	np = of_parse_phandle(dev->of_node, "memory-region", idx);
+	if (!np)
+		return -ENODEV;
+
+	ret = of_address_to_resource(np, 0, &res);
+	of_node_put(np);
+	if (ret)
+		return ret;
+
+	*phys = res.start;
+	*size = resource_size(&res);
+	return 0;
+}
+
+static int mtk_ccci_parse_ccif(struct mtk_ccci_dev *ccci)
+{
+	struct device_node *ccif_np;
+	struct resource res;
+	int i, ret;
+
+	ccif_np = of_parse_phandle(ccci->dev->of_node, "mediatek,ccif", 0);
+	if (!ccif_np)
+		return -ENODEV;
+
+	ret = of_address_to_resource(ccif_np, 0, &res);
+	if (ret)
+		goto err_put;
+	ccci->ccif_ap_base = devm_ioremap_resource(ccci->dev, &res);
+	if (IS_ERR(ccci->ccif_ap_base)) {
+		ret = PTR_ERR(ccci->ccif_ap_base);
+		goto err_put;
+	}
+
+	ret = of_address_to_resource(ccif_np, 1, &res);
+	if (ret)
+		goto err_put;
+	ccci->ccif_md_base = devm_ioremap_resource(ccci->dev, &res);
+	if (IS_ERR(ccci->ccif_md_base)) {
+		ret = PTR_ERR(ccci->ccif_md_base);
+		goto err_put;
+	}
+
+	ccci->ccif_irq0 = of_irq_get(ccif_np, 0);
+	ccci->ccif_irq1 = of_irq_get(ccif_np, 1);
+	if (ccci->ccif_irq0 <= 0 || ccci->ccif_irq1 <= 0) {
+		ret = -EINVAL;
+		goto err_put;
+	}
+
+	ccci->num_ccif_clks = of_property_count_strings(ccif_np, "clock-names");
+	if (ccci->num_ccif_clks > 0) {
+		ccci->ccif_clks = devm_kcalloc(ccci->dev, ccci->num_ccif_clks,
+					       sizeof(*ccci->ccif_clks), GFP_KERNEL);
+		if (!ccci->ccif_clks) {
+			ret = -ENOMEM;
+			goto err_put;
+		}
+		for (i = 0; i < ccci->num_ccif_clks; i++) {
+			const char *cname;
+
+			ret = of_property_read_string_index(ccif_np, "clock-names", i, &cname);
+			if (ret)
+				goto err_put;
+			ccci->ccif_clks[i].id = cname;
+			ccci->ccif_clks[i].clk = of_clk_get_by_name(ccif_np, cname);
+			if (IS_ERR(ccci->ccif_clks[i].clk)) {
+				ret = PTR_ERR(ccci->ccif_clks[i].clk);
+				goto err_put_clks;
+			}
+		}
+	}
+
+	of_node_put(ccif_np);
+	return 0;
+
+err_put_clks:
+	while (--i >= 0)
+		clk_put(ccci->ccif_clks[i].clk);
+err_put:
+	of_node_put(ccif_np);
+	return ret;
+}
+
+static int mtk_ccci_probe(struct platform_device *pdev)
+{
+	struct mtk_ccci_dev *ccci;
+	size_t md_mem0_sz = 0;
+	int ret;
+
+	static_assert(sizeof(struct mtk_ccci_header) == 16);
+	static_assert(sizeof(struct mtk_ccci_md_query) == 224);
+	static_assert(sizeof(struct mtk_ccci_ap_query_v2_1) == 156);
+	static_assert(offsetof(struct mtk_ccci_sram_layout, up_header) == 240);
+	static_assert(sizeof(struct mtk_ccci_sram_layout) <= MTK_CCIF_SRAM_SIZE);
+
+	ccci = devm_kzalloc(&pdev->dev, sizeof(*ccci), GFP_KERNEL);
+	if (!ccci)
+		return -ENOMEM;
+
+	ccci->dev = &pdev->dev;
+	spin_lock_init(&ccci->ccif_lock);
+	init_completion(&ccci->hs1_comp);
+	init_completion(&ccci->hs2_comp);
+	INIT_WORK(&ccci->boot_work, mtk_ccci_boot_work);
+	INIT_WORK(&ccci->rx_work, mtk_ccci_rx_work);
+	platform_set_drvdata(pdev, ccci);
+
+	ccci->md_rgu_base = devm_platform_ioremap_resource_byname(pdev, "md-rgu");
+	if (IS_ERR(ccci->md_rgu_base))
+		return PTR_ERR(ccci->md_rgu_base);
+
+	ccci->wdt_irq = platform_get_irq_byname(pdev, "md-wdt");
+	if (ccci->wdt_irq < 0)
+		return ccci->wdt_irq;
+
+	ret = mtk_ccci_parse_ccif(ccci);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "failed to parse CCIF0\n");
+
+	ccci->scpsys = syscon_regmap_lookup_by_phandle_optional(pdev->dev.of_node,
+								"mediatek,scpsys");
+	of_property_read_u32(pdev->dev.of_node, "mediatek,srclken-o1", &ccci->srclken_o1);
+	of_property_read_u32(pdev->dev.of_node, "mediatek,power-flow-config",
+			     &ccci->power_flow_config);
+
+	ccci->vmodem = devm_regulator_get_optional(&pdev->dev, "vmodem");
+	if (IS_ERR(ccci->vmodem)) {
+		if (PTR_ERR(ccci->vmodem) == -ENODEV)
+			ccci->vmodem = NULL;
+		else
+			return dev_err_probe(&pdev->dev, PTR_ERR(ccci->vmodem),
+					     "failed to get vmodem supply\n");
+	}
+
+	ccci->vsram = devm_regulator_get_optional(&pdev->dev, "vsram");
+	if (IS_ERR(ccci->vsram)) {
+		if (PTR_ERR(ccci->vsram) == -ENODEV)
+			ccci->vsram = NULL;
+		else
+			return dev_err_probe(&pdev->dev, PTR_ERR(ccci->vsram),
+					     "failed to get vsram supply\n");
+	}
+
+	ret = mtk_ccci_parse_mem_region(&pdev->dev, "nc-smem",
+					&ccci->nc_smem_phys, &ccci->nc_smem_size);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "missing nc-smem region\n");
+
+	ret = mtk_ccci_parse_mem_region(&pdev->dev, "c-smem",
+					&ccci->c_smem_phys, &ccci->c_smem_size);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "missing c-smem region\n");
+
+	mtk_ccci_parse_mem_region(&pdev->dev, "ccci-tag",
+				  &ccci->tag_mem_phys, &ccci->tag_mem_size);
+	mtk_ccci_parse_mem_region(&pdev->dev, "md-mem0",
+				  &ccci->md_img_phys, &md_mem0_sz);
+	ccci->md_img_size = CCCI_MD_DEFAULT_IMG_SIZE;
+
+	mtk_ccci_verify_lk_tags(ccci);
+
+	ccci->nc_smem_virt = devm_ioremap_wc(&pdev->dev, ccci->nc_smem_phys,
+					     ccci->nc_smem_size);
+	if (!ccci->nc_smem_virt)
+		return -ENOMEM;
+
+	ret = mtk_ccci_init_smem_and_rings(ccci);
+	if (ret)
+		return ret;
+
+	ret = clk_bulk_prepare_enable(ccci->num_ccif_clks, ccci->ccif_clks);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "failed to enable CCIF clocks\n");
+
+	/* Reset CCIF0 pending flags, enable concurrent mode, clear 512B SRAM */
+	writel(0xffffffff, ccci->ccif_ap_base + APCCIF_ACK);
+	writel(0x01, ccci->ccif_ap_base + APCCIF_CON);
+	mtk_ccif_sram_clear(ccci);
+
+	ret = devm_request_irq(&pdev->dev, ccci->ccif_irq0, mtk_ccci_ccif_irq0,
+			       IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN,
+			       "mtk-ccif0-data0", ccci);
+	if (ret)
+		goto err_clks;
+
+	ret = devm_request_irq(&pdev->dev, ccci->ccif_irq1, mtk_ccci_ccif_irq1,
+			       IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN,
+			       "mtk-ccif0-data1", ccci);
+	if (ret)
+		goto err_clks;
+
+	ret = devm_request_irq(&pdev->dev, ccci->wdt_irq, mtk_ccci_wdt_irq,
+			       IRQF_TRIGGER_RISING | IRQF_NO_AUTOEN,
+			       "mtk-md-wdt", ccci);
+	if (ret)
+		goto err_clks;
+
+	pm_runtime_enable(&pdev->dev);
+	schedule_work(&ccci->boot_work);
+
+	dev_info(&pdev->dev, "MT6789 CCCI modem probed (nc=%pa c=%pa md=%pa)\n",
+		 &ccci->nc_smem_phys, &ccci->c_smem_phys, &ccci->md_img_phys);
+	return 0;
+
+err_clks:
+	clk_bulk_disable_unprepare(ccci->num_ccif_clks, ccci->ccif_clks);
+	return ret;
+}
+
+static void mtk_ccci_remove(struct platform_device *pdev)
+{
+	struct mtk_ccci_dev *ccci = platform_get_drvdata(pdev);
+	int i;
+
+	cancel_work_sync(&ccci->boot_work);
+	cancel_work_sync(&ccci->rx_work);
+
+	/*
+	 * Do not power off MT6789_POWER_DOMAIN_MD while MD is running: BL31
+	 * has no EL3 MD-stop SMC and asserting AXI protection would hang.
+	 */
+	pm_runtime_disable(&pdev->dev);
+	clk_bulk_disable_unprepare(ccci->num_ccif_clks, ccci->ccif_clks);
+	for (i = 0; i < ccci->num_ccif_clks; i++)
+		clk_put(ccci->ccif_clks[i].clk);
+}
+
+static const struct of_device_id mtk_ccci_of_match[] = {
+	{ .compatible = "mediatek,mt6789-ccci" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_ccci_of_match);
+
+static struct platform_driver mtk_ccci_driver = {
+	.probe = mtk_ccci_probe,
+	.remove = mtk_ccci_remove,
+	.driver = {
+		.name = "mtk-ccci",
+		.of_match_table = mtk_ccci_of_match,
+		.dev_groups = mtk_ccci_groups,
+	},
+};
+module_platform_driver(mtk_ccci_driver);
