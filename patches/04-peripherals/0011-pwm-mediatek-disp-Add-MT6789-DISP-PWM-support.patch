From 5966e2afb6fd2b298f9008f29e73e84997ccda88 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sun, 22 Nov 2026 04:29:49 +0000
Subject: [PATCH 11/11] pwm: mediatek-disp: Add MT6789 DISP PWM support

Add mediatek,mt6789-disp-pwm match entry to pwm-mtk-disp.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/pwm/pwm-mtk-disp.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/pwm/pwm-mtk-disp.c b/drivers/pwm/pwm-mtk-disp.c
index 56d10cde5..d44ce2fd8 100644
--- a/drivers/pwm/pwm-mtk-disp.c
+++ b/drivers/pwm/pwm-mtk-disp.c
@@ -284,6 +284,16 @@ static const struct mtk_pwm_data mt8173_pwm_data = {
 	.commit_mask = 0x1,
 };
 
+static const struct mtk_pwm_data mt6789_pwm_data = {
+	.enable_mask = BIT(0),
+	.con0 = 0x18,
+	.con0_sel = 0x0,
+	.con1 = 0x1c,
+	.has_commit = true,
+	.commit = 0x0c,
+	.commit_mask = 0x1,
+};
+
 static const struct mtk_pwm_data mt8183_pwm_data = {
 	.enable_mask = BIT(0),
 	.con0 = 0x18,
@@ -297,6 +307,7 @@ static const struct mtk_pwm_data mt8183_pwm_data = {
 static const struct of_device_id mtk_disp_pwm_of_match[] = {
 	{ .compatible = "mediatek,mt2701-disp-pwm", .data = &mt2701_pwm_data },
 	{ .compatible = "mediatek,mt6595-disp-pwm", .data = &mt8173_pwm_data },
+	{ .compatible = "mediatek,mt6789-disp-pwm", .data = &mt6789_pwm_data },
 	{ .compatible = "mediatek,mt8173-disp-pwm", .data = &mt8173_pwm_data },
 	{ .compatible = "mediatek,mt8183-disp-pwm", .data = &mt8183_pwm_data },
 	{ }
