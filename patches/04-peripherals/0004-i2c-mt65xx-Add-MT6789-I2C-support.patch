From c0f427b322b278845d6d948f2cf460ee0564f17e Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sun, 22 Nov 2026 04:29:40 +0000
Subject: [PATCH] i2c: mt65xx: Add MT6789 I2C support

Add mediatek,mt6789-i2c match entry with a dedicated mt6789_compat.

Tier A stock Advan DTB binds "mediatek,mt6983-i2c"; its mt6983_compat
has dma_sync=1 (confirmed from stock i2c-mt65xx.ko: compat @0x11b8,
word 0x10012401017c, bit5=1, and the `tst w8,#0x20` test in
mtk_i2c_do_transfer). Borrowing mt8188_compat (dma_sync=0) could
corrupt DMA transfers. Keep the hardware-verified regs_v3 layout
(equivalent to stock regs_v2 + slave_addr_ver=1) and set dma_sync=1.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/i2c/busses/i2c-mt65xx.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/i2c/busses/i2c-mt65xx.c b/drivers/i2c/busses/i2c-mt65xx.c
index 45d0d71..05731b6 100644
--- a/drivers/i2c/busses/i2c-mt65xx.c
+++ b/drivers/i2c/busses/i2c-mt65xx.c
@@ -523,10 +523,25 @@ static const struct mtk_i2c_compatible mt8192_compat = {
 	.max_dma_support = 36,
 };
 
+static const struct mtk_i2c_compatible mt6789_compat = {
+	.regs = mt_i2c_regs_v3,
+	.pmic_i2c = 0,
+	.dcm = 0,
+	.auto_restart = 1,
+	.aux_len_reg = 1,
+	.timing_adjust = 1,
+	/* MT6789 stock binds mt6983_compat (dma_sync=1), not mt8188's 0. */
+	.dma_sync = 1,
+	.ltiming_adjust = 1,
+	.apdma_sync = 1,
+	.max_dma_support = 36,
+};
+
 static const struct of_device_id mtk_i2c_of_match[] = {
 	{ .compatible = "mediatek,mt2712-i2c", .data = &mt2712_compat },
 	{ .compatible = "mediatek,mt6577-i2c", .data = &mt6577_compat },
 	{ .compatible = "mediatek,mt6589-i2c", .data = &mt6589_compat },
+	{ .compatible = "mediatek,mt6789-i2c", .data = &mt6789_compat },
 	{ .compatible = "mediatek,mt7622-i2c", .data = &mt7622_compat },
 	{ .compatible = "mediatek,mt7981-i2c", .data = &mt7981_compat },
 	{ .compatible = "mediatek,mt7986-i2c", .data = &mt7986_compat },
