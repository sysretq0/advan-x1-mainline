From bbafe5e10ca97eee2beea60e4e8a10df80500834 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sun, 22 Nov 2026 04:29:46 +0000
Subject: [PATCH] thermal/drivers/mediatek/lvts: Add MT6789 support

Add LVTS thermal controller data, V5 manual RCK calibration, and OF match
entry for the MediaTek MT6789 SoC (4 controllers, 13 sensors in filtered
mode).

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/thermal/mediatek/lvts_thermal.c      |  253 ++-
 1 file changed, 252 insertions(+), 1 deletion(-)

diff --git a/drivers/thermal/mediatek/lvts_thermal.c b/drivers/thermal/mediatek/lvts_thermal.c
index 81df7920f..376f0f082 100644
--- a/drivers/thermal/mediatek/lvts_thermal.c
+++ b/drivers/thermal/mediatek/lvts_thermal.c
@@ -57,6 +57,7 @@
 #define LVTS_IMMD1(__base)		(__base + 0x00A4)
 #define LVTS_IMMD2(__base)		(__base + 0x00A8)
 #define LVTS_IMMD3(__base)		(__base + 0x00AC)
+#define LVTS_RDATA0(__base)		(__base + 0x00B0)
 #define LVTS_PROTCTL(__base)	(__base + 0x00C0)
 #define LVTS_PROTTA(__base)		(__base + 0x00C4)
 #define LVTS_PROTTB(__base)		(__base + 0x00C8)
@@ -85,6 +86,12 @@
 #define LVTS_INT_SENSOR2			0x00247C00
 #define LVTS_INT_SENSOR3			0x1FC00000
 
+/* MT6789 hardware thermal reset (STAGE3), mirrored from stock soc_temp_lvts.c */
+#define LVTS_MONINT_STAGE3_INT_EN		BIT(31)
+#define LVTS_PROTCTL_PROTOFFSET_SET		GENMASK(13, 0)
+#define LVTS_PROTCTL_PROTOFFSET			GENMASK(15, 0)
+#define LVTS_PROTCTL_STRATEGY_MAX		(0x1 << 16)
+
 #define LVTS_SENSOR_MAX				4
 #define LVTS_GOLDEN_TEMP_MAX		62
 #define LVTS_GOLDEN_TEMP_DEFAULT	50
@@ -108,6 +115,20 @@
 #define LVTS_NUM_CAL_OFFSETS_MT7988	3
 #define LVTS_NUM_CAL_OFFSETS_MT8196	2
 
+#define LVTS_CONFIG_DEVICE_SENSING_STATUS	BIT(25)
+#define LVTS_CONFIG_DEVICE_ACCESS_STATUS	BIT(24)
+#define LVTS_DEVICE_READ_REG0			0xC1020000
+#define LVTS_CMD_MANUAL_RCK_V5			0xC1030E00
+#define LVTS_CMD_SELECT_SENSOR_RCK(id)		(0xC1030D00 | (id))
+#define LVTS_CMD_SENSOR_NO_RCK			0xC1030D10
+#define LVTS_CMD_SINGLE_MODE_V5			0xC10306F8
+#define LVTS_CMD_LOW_POWER_SINGLE_MODE		0xC10306B8
+#define LVTS_CMD_COUNT_WIN_20US_HI		0xC1030500
+#define LVTS_CMD_COUNT_WIN_20US_LO		0xC1030420
+#define LVTS_CMD_KICK_OFF_RCK			0xC1030302
+#define LVTS_DEF_COUNT_RC			2750
+#define LVTS_COUNT_RC_DELTA_MAX			1061
+
 static int golden_temp = LVTS_GOLDEN_TEMP_DEFAULT;
 static int golden_temp_offset;
 
@@ -125,6 +146,7 @@ struct lvts_sensor_data {
 struct lvts_ctrl_data {
 	struct lvts_sensor_data lvts_sensor[LVTS_SENSOR_MAX];
 	u8 valid_sensor_mask;
+	u8 count_rc_offset;
 	int offset;
 	enum lvts_msr_mode mode;
 };
@@ -162,6 +184,8 @@ struct lvts_data {
 	u16 msr_offset;
 	u16 start_settle_us;
 	bool skip_zero_msr;
+	/* Program LVTS STAGE3 hardware reboot (Advan X1 / MT6789) */
+	bool hw_reboot;
 };
 
 struct lvts_sensor {
@@ -179,6 +203,7 @@ struct lvts_ctrl {
 	struct lvts_sensor sensors[LVTS_SENSOR_MAX];
 	const struct lvts_data *lvts_data;
 	u32 calibration[LVTS_SENSOR_MAX];
+	u32 count_rc;
 	u8 valid_sensor_mask;
 	int mode;
 	void __iomem *base;
@@ -878,6 +903,21 @@ static int lvts_calibration_init(struct device *dev, struct lvts_ctrl *lvts_ctrl
 		}
 	}
 
+	if (lvts_ctrl_data->count_rc_offset) {
+		u8 off = lvts_ctrl_data->count_rc_offset;
+		u32 count_rc = 0;
+
+		if ((size_t)off + 2 >= calib_len)
+			return -EINVAL;
+
+		if (gt)
+			count_rc = efuse_calibration[off] |
+				   (efuse_calibration[off + 1] << 8) |
+				   (efuse_calibration[off + 2] << 16);
+
+		lvts_ctrl->count_rc = count_rc ? count_rc : LVTS_DEF_COUNT_RC;
+	}
+
 	return 0;
 }
 
@@ -1157,6 +1197,86 @@ static int lvts_ctrl_initialize(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 	return 0;
 }
 
+static void lvts_write_device(struct device *dev, struct lvts_ctrl *lvts_ctrl,
+			      u32 cmd)
+{
+	void __iomem *base = lvts_ctrl->base;
+	u32 val;
+	int ret;
+
+	writel(cmd, LVTS_CONFIG(base));
+	usleep_range(5, 10);
+
+	ret = readl_poll_timeout(LVTS_CONFIG(base), val,
+				 !(val & LVTS_CONFIG_DEVICE_ACCESS_STATUS),
+				 2, 200);
+	if (ret)
+		dev_warn(dev, "LVTS device write 0x%08x timeout\n", cmd);
+}
+
+static u32 lvts_read_device_reg0(struct device *dev, struct lvts_ctrl *lvts_ctrl)
+{
+	void __iomem *base = lvts_ctrl->base;
+	u32 val;
+	int ret;
+
+	writel(LVTS_DEVICE_READ_REG0, LVTS_CONFIG(base));
+
+	ret = readl_poll_timeout(LVTS_CONFIG(base), val,
+				 !(val & LVTS_CONFIG_DEVICE_ACCESS_STATUS),
+				 2, 200);
+	if (ret)
+		dev_warn(dev, "LVTS device read reg0 timeout\n");
+
+	return readl(LVTS_RDATA0(base));
+}
+
+static void lvts_ctrl_read_count_rc_n(struct device *dev,
+				      struct lvts_ctrl *lvts_ctrl)
+{
+	void __iomem *base = lvts_ctrl->base;
+	u32 val, rc_data, count_rc_now;
+	int i, ret;
+
+	lvts_write_device(dev, lvts_ctrl, LVTS_CMD_MANUAL_RCK_V5);
+
+	lvts_for_each_valid_sensor(i, lvts_ctrl) {
+		lvts_write_device(dev, lvts_ctrl, LVTS_CMD_SELECT_SENSOR_RCK(i));
+		lvts_write_device(dev, lvts_ctrl, LVTS_CMD_SINGLE_MODE_V5);
+		lvts_write_device(dev, lvts_ctrl, LVTS_CMD_COUNT_WIN_20US_HI);
+		lvts_write_device(dev, lvts_ctrl, LVTS_CMD_COUNT_WIN_20US_LO);
+		lvts_write_device(dev, lvts_ctrl, LVTS_CMD_KICK_OFF_RCK);
+		usleep_range(50, 60);
+
+		ret = readl_poll_timeout(LVTS_CONFIG(base), val,
+					 !(val & LVTS_CONFIG_DEVICE_SENSING_STATUS),
+					 2, 200);
+		if (ret)
+			dev_warn(dev, "LVTS sensor %d RCK sensing timeout\n", i);
+
+		rc_data = lvts_read_device_reg0(dev, lvts_ctrl) & GENMASK(23, 0);
+		usleep_range(5, 10);
+
+		if (!rc_data) {
+			count_rc_now = lvts_ctrl->count_rc;
+		} else {
+			u32 hi = max(rc_data, lvts_ctrl->count_rc);
+			u32 lo = min(rc_data, lvts_ctrl->count_rc);
+
+			if ((u64)hi * 1000 > (u64)lo * LVTS_COUNT_RC_DELTA_MAX)
+				count_rc_now = lvts_ctrl->count_rc;
+			else
+				count_rc_now = rc_data;
+		}
+
+		lvts_ctrl->calibration[i] =
+			((u64)count_rc_now * lvts_ctrl->calibration[i]) >> 14;
+	}
+
+	lvts_write_device(dev, lvts_ctrl, LVTS_CMD_SENSOR_NO_RCK);
+	lvts_write_device(dev, lvts_ctrl, LVTS_CMD_LOW_POWER_SINGLE_MODE);
+}
+
 static int lvts_ctrl_calibrate(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 {
 	int i;
@@ -1167,6 +1287,9 @@ static int lvts_ctrl_calibrate(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 		LVTS_EDATA03(lvts_ctrl->base)
 	};
 
+	if (lvts_ctrl->count_rc)
+		lvts_ctrl_read_count_rc_n(dev, lvts_ctrl);
+
 	/*
 	 * LVTS_EDATA0X : Efuse calibration reference value for sensor X
 	 *
@@ -1211,8 +1334,8 @@ static int lvts_ctrl_configure(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 	/*
 	 * LVTS_CALSCALE : ADC voltage round
 	 */
-	value = 0x300;
 	value = LVTS_CALSCALE_CONF;
+	writel(value, LVTS_CALSCALE(lvts_ctrl->base));
 
 	/*
 	 * LVTS_MSRCTL0 : Sensor filtering strategy
@@ -1296,11 +1419,44 @@ static int lvts_ctrl_configure(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 	return lvts_irq_init(lvts_ctrl);
 }
 
+/*
+ * Program the MT6789 LVTS STAGE3 hardware reboot threshold. Follows stock
+ * soc_temp_lvts.c:set_tc_hw_reboot_threshold(): force an extremely low
+ * reading (0x3FFF) and mask STAGE3 while latching the critical-trip raw
+ * threshold into PROTTC, then re-arm STAGE3 before clearing PROTOFFSET.
+ * Uses max-of-4 strategy (stricter than stock MT6789's per-TC dominator).
+ * The RGU reset is hardware-only, protecting the SoC even if the kernel hangs.
+ */
+static void lvts_ctrl_set_hw_reboot(struct lvts_ctrl *lvts_ctrl, int temp)
+{
+	void __iomem *base = lvts_ctrl->base;
+	u32 value, raw;
+
+	value = readl(LVTS_PROTCTL(base));
+	writel(value | LVTS_PROTCTL_PROTOFFSET_SET, LVTS_PROTCTL(base));
+	value = readl(LVTS_MONINT(base));
+	writel(value & ~LVTS_MONINT_STAGE3_INT_EN, LVTS_MONINT(base));
+
+	raw = lvts_temp_to_raw(temp, lvts_ctrl->lvts_data) & GENMASK(14, 0);
+
+	value = readl(LVTS_PROTCTL(base));
+	value &= ~GENMASK(17, 16);
+	value |= LVTS_PROTCTL_STRATEGY_MAX;
+	writel(value, LVTS_PROTCTL(base));
+	writel(raw, LVTS_PROTTC(base));
+
+	value = readl(LVTS_MONINT(base));
+	writel(value | LVTS_MONINT_STAGE3_INT_EN, LVTS_MONINT(base));
+	value = readl(LVTS_PROTCTL(base));
+	writel(value & ~LVTS_PROTCTL_PROTOFFSET, LVTS_PROTCTL(base));
+}
+
 static int lvts_ctrl_start(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 {
 	struct lvts_sensor *lvts_sensors = lvts_ctrl->sensors;
 	struct thermal_zone_device *tz;
 	u32 sensor_map = 0;
+	int crit_temp, hw_reboot_temp = 0;
 	int i;
 	/*
 	 * Bitmaps to enable each sensor on immediate and filtered modes, as
@@ -1342,6 +1498,11 @@ static int lvts_ctrl_start(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 		 */
 		lvts_sensors[i].tz = tz;
 
+		/* Use the DTS critical trip (113500 mC on Advan X1). */
+		crit_temp = 0;
+		if (!thermal_zone_get_crit_temp(tz, &crit_temp) && crit_temp > 0)
+			hw_reboot_temp = crit_temp;
+
 		/*
 		 * This sensor was correctly associated with a thermal
 		 * zone, let's set the corresponding bit in the sensor
@@ -1351,6 +1512,9 @@ static int lvts_ctrl_start(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 		sensor_map |= sensor_bitmap[i];
 	}
 
+	if (lvts_ctrl->lvts_data->hw_reboot && hw_reboot_temp > 0)
+		lvts_ctrl_set_hw_reboot(lvts_ctrl, hw_reboot_temp);
+
 	/*
 	 * The initialization of the thermal zones give us
 	 * which sensor point to enable. If any thermal zone
@@ -1662,6 +1826,72 @@ static const u32 mt7988_init_cmds[] = {
  *
  * Hence the rather confusing offsets provided below.
  */
+static const u32 mt6789_init_cmds[] = {
+	0xC1030300, 0xC1030420, 0xC1030500, 0xC10307A6, 0xC1030CFC,
+	0xC1030A8C, 0xC103098D, 0xC10308F1
+};
+
+static const struct lvts_ctrl_data mt6789_lvts_data_ctrl[] = {
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6789_LITTLE_CPU0,
+			  .cal_offsets = { 4, 5 } },
+			{ .dt_id = MT6789_LITTLE_CPU1,
+			  .cal_offsets = { 6, 7 } },
+			{ .dt_id = MT6789_LITTLE_CPU2,
+			  .cal_offsets = { 8, 9 } },
+			{ .dt_id = MT6789_LITTLE_CPU3,
+			  .cal_offsets = { 10, 11 } }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 1),
+		.count_rc_offset = 32,
+		.offset = 0x0,
+		.mode = LVTS_MSR_FILTERED_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6789_BIG_CPU0,
+			  .cal_offsets = { 12, 13 } },
+			{ .dt_id = MT6789_BIG_CPU1,
+			  .cal_offsets = { 14, 15 } },
+			{ .dt_id = MT6789_BIG_CPU2,
+			  .cal_offsets = { 16, 17 } },
+			{ .dt_id = MT6789_BIG_CPU3,
+			  .cal_offsets = { 18, 19 } }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 1),
+		.count_rc_offset = 36,
+		.offset = 0x100,
+		.mode = LVTS_MSR_FILTERED_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6789_GPU0,
+			  .cal_offsets = { 20, 21 } },
+			{ .dt_id = MT6789_GPU1,
+			  .cal_offsets = { 22, 23 } },
+			{ .dt_id = MT6789_SOC0,
+			  .cal_offsets = { 24, 25 } },
+			{ .dt_id = MT6789_SOC1,
+			  .cal_offsets = { 26, 27 } }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 1),
+		.count_rc_offset = 40,
+		.offset = 0x200,
+		.mode = LVTS_MSR_FILTERED_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6789_MD,
+			  .cal_offsets = { 28, 29 } }
+		},
+		VALID_SENSOR_MAP(1, 0, 0, 0),
+		.count_rc_offset = 44,
+		.offset = 0x300,
+		.mode = LVTS_MSR_FILTERED_MODE,
+	}
+};
+
 static const struct lvts_ctrl_data mt8186_lvts_data_ctrl[] = {
 	{
 		.lvts_sensor = {
@@ -2073,6 +2303,24 @@ static const struct lvts_data mt7988_lvts_ap_data = {
 	.ops = &lvts_platform_ops_mt7988,
 };
 
+static const struct lvts_data mt6789_lvts_data = {
+	.lvts_ctrl	= mt6789_lvts_data_ctrl,
+	.conn_cmd	= mt7988_conn_cmds,
+	.init_cmd	= mt6789_init_cmds,
+	.num_lvts_ctrl	= ARRAY_SIZE(mt6789_lvts_data_ctrl),
+	.num_conn_cmd	= ARRAY_SIZE(mt7988_conn_cmds),
+	.num_init_cmd	= ARRAY_SIZE(mt6789_init_cmds),
+	.temp_factor	= LVTS_COEFF_A_MT8195,
+	.temp_offset	= LVTS_COEFF_B_MT8195,
+	.gt_calib_bit_offset = 24,
+	.def_calibration = 35000,
+	.num_cal_offsets = LVTS_NUM_CAL_OFFSETS_MT8196,
+	.start_settle_us = 2000,
+	.skip_zero_msr = true,
+	.hw_reboot = true,
+	.ops = &lvts_platform_ops_mt7988,
+};
+
 static const struct lvts_data mt8186_lvts_data = {
 	.lvts_ctrl	= mt8186_lvts_data_ctrl,
 	.conn_cmd	= default_conn_cmds,
@@ -2203,6 +2451,7 @@ static const struct lvts_data mt8196_lvts_ap_data = {
 };
 
 static const struct of_device_id lvts_of_match[] = {
+	{ .compatible = "mediatek,mt6789-lvts", .data = &mt6789_lvts_data },
 	{ .compatible = "mediatek,mt7987-lvts-ap", .data = &mt7987_lvts_ap_data },
 	{ .compatible = "mediatek,mt7988-lvts-ap", .data = &mt7988_lvts_ap_data },
 	{ .compatible = "mediatek,mt8186-lvts", .data = &mt8186_lvts_data },
