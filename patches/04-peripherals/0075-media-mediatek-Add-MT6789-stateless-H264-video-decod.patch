+/* ---------------- V4L2 Formats & IOCTLs ---------------- */
+
+static void mtk_vdec_fill_out_fmt(struct v4l2_pix_format_mplane *pix_mp,
+				  u32 width, u32 height)
+{
+	u32 w = clamp_t(u32, ALIGN(width, 16), MTK_VDEC_MIN_W, MTK_VDEC_MAX_W);
+	u32 h = clamp_t(u32, ALIGN(height, 16), MTK_VDEC_MIN_H, MTK_VDEC_MAX_H);
+	u32 min_sz = max_t(u32, SZ_1M, PAGE_ALIGN(w * h));
+
+	pix_mp->pixelformat = V4L2_PIX_FMT_H264_SLICE;
+	pix_mp->width = w;
+	pix_mp->height = h;
+	pix_mp->field = V4L2_FIELD_NONE;
+	pix_mp->num_planes = 1;
+	pix_mp->plane_fmt[0].bytesperline = 0;
+	pix_mp->plane_fmt[0].sizeimage = max(pix_mp->plane_fmt[0].sizeimage,
+					     min_sz);
+}
+
+static void mtk_vdec_fill_cap_fmt(struct v4l2_pix_format_mplane *pix_mp,
+				  u32 width, u32 height)
+{
+	u32 w = clamp_t(u32, ALIGN(width, 16), MTK_VDEC_MIN_W, MTK_VDEC_MAX_W);
+	u32 h = clamp_t(u32, ALIGN(height, 32), MTK_VDEC_MIN_H, MTK_VDEC_MAX_H);
+
+	pix_mp->pixelformat = V4L2_PIX_FMT_MM21;
+	pix_mp->width = w;
+	pix_mp->height = h;
+	pix_mp->field = V4L2_FIELD_NONE;
+	pix_mp->num_planes = 2;
+	pix_mp->plane_fmt[0].bytesperline = w;
+	pix_mp->plane_fmt[0].sizeimage = w * h;
+	pix_mp->plane_fmt[1].bytesperline = w;
+	pix_mp->plane_fmt[1].sizeimage = (w * h) / 2;
+}
+
+static void mtk_vdec_reset_fmts(struct mtk_vdec_ctx *ctx)
+{
+	memset(&ctx->out_fmt, 0, sizeof(ctx->out_fmt));
+	ctx->out_fmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	ctx->out_fmt.fmt.pix_mp.colorspace = V4L2_COLORSPACE_REC709;
+	mtk_vdec_fill_out_fmt(&ctx->out_fmt.fmt.pix_mp,
+			      MTK_VDEC_DEFAULT_W, MTK_VDEC_DEFAULT_H);
+
+	memset(&ctx->cap_fmt, 0, sizeof(ctx->cap_fmt));
+	ctx->cap_fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	ctx->cap_fmt.fmt.pix_mp.colorspace = V4L2_COLORSPACE_REC709;
+	mtk_vdec_fill_cap_fmt(&ctx->cap_fmt.fmt.pix_mp,
+			      MTK_VDEC_DEFAULT_W, MTK_VDEC_DEFAULT_H);
+}
