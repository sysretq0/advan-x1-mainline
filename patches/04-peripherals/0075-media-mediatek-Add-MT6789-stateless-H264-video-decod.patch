+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MEDIATEK_MT6789_VDEC
+	tristate "MediaTek MT6789 stateless H.264 video decoder driver"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on VIDEO_DEV
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on MTK_IOMMU || COMPILE_TEST
+	depends on MTK_SMI || (COMPILE_TEST && MTK_SMI=n)
+	select MEDIA_CONTROLLER
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	select V4L2_H264
+	select MFD_SYSCON
+	help
+	  V4L2 stateless M2M hardware H.264 video decoder driver for the
+	  MediaTek MT6789 (Helio G99) VDEC block. Programs the VLD, MC,
+	  AVCVLD, AVCMV, PP, and MISC hardware registers directly without
+	  requiring proprietary VPU/VCU firmware.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mtk-vdec-mt6789.
