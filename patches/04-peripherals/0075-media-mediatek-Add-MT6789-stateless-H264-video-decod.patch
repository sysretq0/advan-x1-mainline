+/* ---------------- VB2 Queue Ops & Media Requests ---------------- */
+
+static int mtk_vdec_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
+				unsigned int *num_planes, unsigned int sizes[],
+				struct device *alloc_devs[])
+{
+	struct mtk_vdec_ctx *ctx = vb2_get_drv_priv(vq);
+	const struct v4l2_format *f =
+		V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->out_fmt : &ctx->cap_fmt;
+	unsigned int i;
+
+	if (*num_planes) {
+		if (*num_planes != f->fmt.pix_mp.num_planes)
+			return -EINVAL;
+		for (i = 0; i < *num_planes; i++) {
+			if (sizes[i] < f->fmt.pix_mp.plane_fmt[i].sizeimage)
+				return -EINVAL;
+		}
+		return 0;
+	}
+
+	*num_planes = f->fmt.pix_mp.num_planes;
+	for (i = 0; i < *num_planes; i++)
+		sizes[i] = f->fmt.pix_mp.plane_fmt[i].sizeimage;
+
+	return 0;
+}
+
+static int mtk_vdec_buf_prepare(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct mtk_vdec_ctx *ctx = vb2_get_drv_priv(vq);
+	const struct v4l2_format *f =
+		V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->out_fmt : &ctx->cap_fmt;
+	unsigned int i;
+
+	for (i = 0; i < f->fmt.pix_mp.num_planes; i++) {
+		u32 sizeimage = f->fmt.pix_mp.plane_fmt[i].sizeimage;
+
+		if (vb2_plane_size(vb, i) < sizeimage)
+			return -EINVAL;
+
+		if (V4L2_TYPE_IS_CAPTURE(vq->type))
+			vb2_set_plane_payload(vb, i, sizeimage);
+	}
+
+	return 0;
+}
+
+static void mtk_vdec_buf_queue(struct vb2_buffer *vb)
+{
+	struct mtk_vdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static int mtk_vdec_buf_out_validate(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+
+	vbuf->field = V4L2_FIELD_NONE;
+	return 0;
+}
+
+static void mtk_vdec_buf_request_complete(struct vb2_buffer *vb)
+{
+	struct mtk_vdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_ctrl_request_complete(vb->req_obj.req, &ctx->ctrl_hdl);
+}
+
+static int mtk_vdec_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct mtk_vdec_ctx *ctx = vb2_get_drv_priv(vq);
+
+	if (V4L2_TYPE_IS_CAPTURE(vq->type))
+		return 0;
+
+	return mtk_vdec_alloc_work_bufs(ctx);
+}
+
+static void mtk_vdec_stop_streaming(struct vb2_queue *vq)
+{
+	struct mtk_vdec_ctx *ctx = vb2_get_drv_priv(vq);
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		if (V4L2_TYPE_IS_OUTPUT(vq->type))
+			vbuf = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+		else
+			vbuf = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+
+		if (!vbuf)
+			break;
+
+		if (vbuf->vb2_buf.req_obj.req)
+			v4l2_ctrl_request_complete(vbuf->vb2_buf.req_obj.req,
+						   &ctx->ctrl_hdl);
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+	}
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		mtk_vdec_free_work_bufs(ctx);
+}
