diff --git a/drivers/media/platform/mediatek/vcodec/mt6789/mtk-vdec-mt6789.c b/drivers/media/platform/mediatek/vcodec/mt6789/mtk-vdec-mt6789.c
new file mode 100644
index 000000000000..7dfa99242913
--- /dev/null
+++ b/drivers/media/platform/mediatek/vcodec/mt6789/mtk-vdec-mt6789.c
@@ -0,0 +1,2033 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 (Helio G99) stateless V4L2 M2M H.264 video decoder driver.
+ *
+ * Drives the single-core MT6789 VDEC hardware (VLD, VLDTOP, MC, AVCVLD,
+ * AVCMV, PP, MISC) directly over CPU MMIO without proprietary VPU/VCU
+ * firmware. Outputs MediaTek 16x32 block-tiled NV12 (V4L2_PIX_FMT_MM21).
+ *
+ * Copyright (c) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <linux/videodev2.h>
+#include <linux/workqueue.h>
+
+#include <media/media-device.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-h264.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "mtk-vdec-mt6789-regs.h"
+
+#define MTK_VDEC_DRV_NAME		"mtk-vdec-mt6789"
+#define MTK_VDEC_MIN_W			64U
+#define MTK_VDEC_MAX_W			2560U
+#define MTK_VDEC_MIN_H			64U
+#define MTK_VDEC_MAX_H			2560U
+#define MTK_VDEC_DEFAULT_W		1280U
+#define MTK_VDEC_DEFAULT_H		720U
+#define MTK_VDEC_TIMEOUT_MS		1000U
+#define MTK_VDEC_POLL_US		10U
+#define MTK_VDEC_POLL_TIMEOUT_US	20000U
+#define MTK_VDEC_MAX_REFS		16U
+#define MTK_VDEC_MAX_NALU_SKIP		32U
+
+#define H264_NAL_SLICE			1
+#define H264_NAL_IDR_SLICE		5
+
+struct mtk_vdec_dma_buf {
+	void *va;
+	dma_addr_t dma;
+	size_t size;
+};
+
+struct mtk_vdec_slice_hdr {
+	u8 nal_ref_idc;
+	u8 nal_unit_type;
+	u32 first_mb_in_slice;
+	u32 slice_type;
+	u32 slice_type_mod;
+	bool field_pic_flag;
+	bool bottom_field_flag;
+	bool direct_spatial_mv_pred_flag;
+	bool num_ref_idx_override_flag;
+	u32 num_ref_idx_l0_active_minus1;
+	u32 num_ref_idx_l1_active_minus1;
+	u32 cabac_init_idc;
+	s32 slice_qp_delta;
+	u32 disable_deblocking_filter_idc;
+	s32 slice_alpha_c0_offset_div2;
+	s32 slice_beta_offset_div2;
+};
+
+struct mtk_vdec_dev {
+	struct device *dev;
+	void __iomem *gcon;
+	void __iomem *core;
+	struct regmap *vdecsys;
+	struct clk_bulk_data *clks;
+	int num_clks;
+	int irq;
+
+	struct mutex vdev_lock;
+	struct v4l2_device v4l2_dev;
+	struct media_device mdev;
+	struct video_device vdev;
+	struct v4l2_m2m_dev *m2m_dev;
+	struct delayed_work watchdog_work;
+};
+
+struct mtk_vdec_ctx {
+	struct mtk_vdec_dev *vdec;
+	struct v4l2_fh fh;
+	struct v4l2_ctrl_handler ctrl_hdl;
+
+	struct v4l2_format out_fmt;
+	struct v4l2_format cap_fmt;
+
+	struct mtk_vdec_dma_buf vld_wrap_buf;
+	struct mtk_vdec_dma_buf pp_wrap_buf;
+	struct mtk_vdec_dma_buf mv_bufs[VIDEO_MAX_FRAME];
+	size_t mv_buf_size;
+};
+
+static const char *const mtk_vdec_clk_names[] = {
+	"vdec-sel",
+	"vdec",
+	"larb",
+};
+
+static inline struct mtk_vdec_ctx *fh_to_ctx(struct v4l2_fh *fh)
+{
+	return container_of(fh, struct mtk_vdec_ctx, fh);
+}
+
+static inline struct mtk_vdec_ctx *file_to_ctx(struct file *file)
+{
+	return fh_to_ctx(file->private_data);
+}
+
+/*
+ * On MT6789, disp_iommu assigns SMI LARB4 (VDEC) to Region 1 (4 GiB..8 GiB).
+ * SMI LARB4 automatically prepends bank bit 32 to every 32-bit DMA address
+ * issued by VDEC. Always strip bit 32 before shifting so shifted hardware
+ * address fields (>> 4, >> 6, >> 8, >> 9) never fold bit 32 into lower bits.
+ */
+static inline u32 mtk_vdec_iova32(dma_addr_t addr)
+{
+	return lower_32_bits(addr);
+}
+
+static inline void __iomem *vdec_vld(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_VLD_BASE;
+}
+
+static inline void __iomem *vdec_vldtop(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_VLDTOP_BASE;
+}
+
+static inline void __iomem *vdec_mc(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_MC_BASE;
+}
+
+static inline void __iomem *vdec_avcvld(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_AVCVLD_BASE;
+}
+
+static inline void __iomem *vdec_avcmv(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_AVCMV_BASE;
+}
+
+static inline void __iomem *vdec_pp(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_PP_BASE;
+}
+
+static inline void __iomem *vdec_misc(struct mtk_vdec_dev *vdec)
+{
+	return vdec->core + VDEC_MISC_BASE;
+}
+
+static int mtk_vdec_dma_alloc(struct mtk_vdec_dev *vdec,
+			      struct mtk_vdec_dma_buf *buf, size_t size)
+{
+	buf->va = dma_alloc_coherent(vdec->dev, size, &buf->dma, GFP_KERNEL);
+	if (!buf->va)
+		return -ENOMEM;
+
+	buf->size = size;
+	return 0;
+}
+
+static void mtk_vdec_dma_free(struct mtk_vdec_dev *vdec,
+			      struct mtk_vdec_dma_buf *buf)
+{
+	if (!buf->va)
+		return;
+
+	dma_free_coherent(vdec->dev, buf->size, buf->va, buf->dma);
+	buf->va = NULL;
+	buf->dma = 0;
+	buf->size = 0;
+}
+
+static size_t mtk_vdec_calc_mv_buf_size(u32 width, u32 height)
+{
+	u32 mb_w = DIV_ROUND_UP(width, 16);
+	u32 mb_h = DIV_ROUND_UP(height, 16);
+	size_t sz = (size_t)mb_w * mb_h * 64 + 512;
+
+	sz = ALIGN(sz, PAGE_SIZE);
+	return min_t(size_t, sz, MTK_VDEC_MV_BUF_MAX_SIZE);
+}
+
+static int mtk_vdec_alloc_work_bufs(struct mtk_vdec_ctx *ctx)
+{
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	int ret;
+
+	ret = mtk_vdec_dma_alloc(vdec, &ctx->vld_wrap_buf,
+				 MTK_VDEC_VLD_WRAP_SIZE);
+	if (ret)
+		return ret;
+
+	ret = mtk_vdec_dma_alloc(vdec, &ctx->pp_wrap_buf,
+				 MTK_VDEC_PP_WRAP_SIZE);
+	if (ret)
+		goto err_vld_wrap;
+
+	ctx->mv_buf_size = mtk_vdec_calc_mv_buf_size(ctx->cap_fmt.fmt.pix_mp.width,
+						     ctx->cap_fmt.fmt.pix_mp.height);
+	return 0;
+
+err_vld_wrap:
+	mtk_vdec_dma_free(vdec, &ctx->vld_wrap_buf);
+	return ret;
+}
+
+static void mtk_vdec_free_work_bufs(struct mtk_vdec_ctx *ctx)
+{
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->mv_bufs); i++)
+		mtk_vdec_dma_free(vdec, &ctx->mv_bufs[i]);
+
+	mtk_vdec_dma_free(vdec, &ctx->pp_wrap_buf);
+	mtk_vdec_dma_free(vdec, &ctx->vld_wrap_buf);
+	ctx->mv_buf_size = 0;
+}
+
+static dma_addr_t mtk_vdec_get_mv_dma(struct mtk_vdec_ctx *ctx, u32 buf_index)
+{
+	struct mtk_vdec_dma_buf *mv;
+
+	if (buf_index >= ARRAY_SIZE(ctx->mv_bufs))
+		return 0;
+
+	mv = &ctx->mv_bufs[buf_index];
+	if (!mv->va) {
+		if (mtk_vdec_dma_alloc(ctx->vdec, mv, ctx->mv_buf_size))
+			return 0;
+	}
+
+	return mv->dma;
+}
+
+/* ---------------- Hardware Bitstream & Register Helpers ---------------- */
+
+static void mtk_vdec_clear_irq(struct mtk_vdec_dev *vdec)
+{
+	void __iomem *misc = vdec_misc(vdec);
+	u32 val;
+
+	val = readl(misc + MISC_IRQ_STATUS);
+	writel(val | MISC_IRQ_ENABLE | MISC_IRQ_CLEAR, misc + MISC_IRQ_STATUS);
+	writel((val | MISC_IRQ_ENABLE) & ~MISC_IRQ_CLEAR,
+	       misc + MISC_IRQ_STATUS);
+}
+
+static void mtk_vdec_hw_reset_and_init(struct mtk_vdec_dev *vdec)
+{
+	void __iomem *vld = vdec_vld(vdec);
+	void __iomem *mc = vdec_mc(vdec);
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	void __iomem *pp = vdec_pp(vdec);
+	void __iomem *misc = vdec_misc(vdec);
+	void __iomem *ufo = vdec->core + VDEC_UFO_BASE;
+	unsigned int dummy = 0;
+	u32 val;
+
+	regmap_write(vdec->vdecsys, VDECSYS_CKEN_SET, 1);
+	regmap_read(vdec->vdecsys, VDECSYS_CKEN_SET, &dummy);
+
+	writel(0, misc + MISC_IDLE_CTRL);
+	readl_poll_timeout_atomic(vld + VLD_FETCH_STATUS, val,
+				  (val & VLD_FETCH_OK) == 0,
+				  1, 1000);
+
+	writel(VLD_SW_RESET_ALL, vld + VLD_SW_RESET);
+	writel(0x2, misc + MISC_SW_RESET);
+	val = readl(misc + MISC_CLK_CG);
+	writel((val & MISC_CLK_CG_KEEP_MASK) | MISC_CLK_CG_VAL,
+	       misc + MISC_CLK_CG);
+	writel(MISC_GATING_1_VAL, misc + MISC_GATING_1);
+	writel(MISC_GATING_2_VAL, misc + MISC_GATING_2);
+	writel(MISC_GATING_3_VAL, misc + MISC_GATING_3);
+	writel(0x2, misc + MISC_SW_RESET);
+	writel(0x0, vld + VLD_SW_RESET);
+
+	regmap_write(vdec->vdecsys, VDECSYS_ACTIVE, 1);
+
+	writel(0x1, misc + MISC_CRC_CTRL);
+	writel(MISC_CODEC_SEL_H264, misc + MISC_CODEC_SEL);
+	writel(MISC_BW_CFG_1080P, misc + MISC_BW_CFG);
+
+	/* Ensure UFO / jump mode is disabled for 2-plane MM21 output */
+	writel(readl(ufo + UFO_CTRL) & ~UFO_CTRL_JUMP_MODE, ufo + UFO_CTRL);
+	writel(readl(pp + PP_CTRL) & ~PP_CTRL_JUMP_MODE, pp + PP_CTRL);
+
+	/* Reset reference picture list SRAM */
+	writel(0, mc + MC_REF_LIST_P0_CFG);
+	writel(0, mc + MC_REF_LIST_B0_CFG);
+	writel(0, mc + MC_REF_LIST_B1_CFG);
+	writel(1, avcvld + AVCVLD_REF_LIST_RST);
+	readl_poll_timeout_atomic(avcvld + AVCVLD_REF_LIST_RST, val,
+				  (val & BIT(0)) == 0, 1, 1000);
+
+	mtk_vdec_clear_irq(vdec);
+}
+
+static int mtk_vdec_init_barrel_shifter(struct mtk_vdec_dev *vdec,
+					dma_addr_t bs_dma, size_t bs_used,
+					size_t bs_buf_size, dma_addr_t dst_y)
+{
+	void __iomem *vld = vdec_vld(vdec);
+	void __iomem *vldtop = vdec_vldtop(vdec);
+	void __iomem *mc = vdec_mc(vdec);
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	u64 bs_start64 = mtk_vdec_iova32(bs_dma);
+	u64 bs_end64 = bs_start64 + bs_used;
+	u64 max_end64 = min_t(u64, bs_start64 + PAGE_ALIGN(bs_buf_size),
+			      0xffffffc0ULL);
+	u64 ring_end64 = min_t(u64, ALIGN(bs_end64 + MTK_VDEC_BS_RING_PAD, 64),
+			       max_end64);
+	u32 bs_start = (u32)bs_start64;
+	u32 bs_end = (u32)min_t(u64, bs_end64, ring_end64);
+	u32 ring_end = (u32)ring_end64;
+	u32 val;
+	int ret;
+
+	writel(VLD_BARREL_CFG_H264, vld + VLD_BARREL_CFG);
+	writel(AVCVLD_CTRL_INIT, avcvld + AVCVLD_CTRL);
+	writel(readl(vldtop + VLDTOP_CTRL) | VLDTOP_CTRL_EN,
+	       vldtop + VLDTOP_CTRL);
+	writel(MC_VLD_MODE_H264, mc + MC_VLD_MODE);
+
+	writel(bs_start >> 6, vld + VLD_BS_RING_START);
+	writel(ring_end >> 6, vld + VLD_BS_RING_END);
+	writel(readl(vld + VLD_DRAM_CTRL) | VLD_DRAM_CTRL_EN,
+	       vld + VLD_DRAM_CTRL);
+	writel(mtk_vdec_iova32(dst_y), vldtop + VLDTOP_FB_Y_ADDR);
+
+	writel(1, avcvld + AVCVLD_BARREL_RST);
+	writel(0, avcvld + AVCVLD_BARREL_RST);
+
+	writel(readl(vld + VLD_BS_END) | 1, vld + VLD_BS_END);
+	writel(bs_start, vld + VLD_BS_START);
+	writel(bs_start, vld + VLD_BS_START);
+	writel(bs_end, vld + VLD_BS_END);
+
+	writel(1, avcvld + AVCVLD_BARREL_RST);
+	writel(VLD_SW_RESET_BARREL, vld + VLD_SW_RESET);
+	writel(0, vld + VLD_SW_RESET);
+	writel(0, vld + VLD_BIT_OFFSET);
+	writel(VLD_SHIFT_FETCH_INIT, vld + VLD_SHIFT_CTRL);
+
+	ret = readl_poll_timeout_atomic(vld + VLD_FETCH_STATUS, val,
+					(val & VLD_FETCH_OK) != 0,
+					MTK_VDEC_POLL_US,
+					MTK_VDEC_POLL_TIMEOUT_US);
+	if (ret) {
+		dev_err(vdec->dev, "VLD barrel shifter fetch timeout (0x%08x)\n",
+			val);
+		return ret;
+	}
+
+	writel(VLD_SHIFT_FETCH_START, vld + VLD_SHIFT_CTRL);
+	writel(0, avcvld + AVCVLD_BARREL_RST);
+
+	return 0;
+}
+
+static inline u32 mtk_vdec_peek_bits(struct mtk_vdec_dev *vdec)
+{
+	return readl(vdec_avcvld(vdec) + AVCVLD_PEEK_BITS);
+}
+
+static inline u32 mtk_vdec_get_bits(struct mtk_vdec_dev *vdec, unsigned int n)
+{
+	u32 val;
+
+	if (!n || n > 32)
+		return 0;
+
+	/*
+	 * Reading AVCVLD_GET_BITS(n) advances the barrel shifter by n bits and
+	 * returns the post-shift 32-bit window, so extract the consumed bits
+	 * from the pre-shift peek window first.
+	 */
+	val = mtk_vdec_peek_bits(vdec) >> (32 - n);
+	readl(vdec_avcvld(vdec) + AVCVLD_GET_BITS(n));
+	return val;
+}
+
+static inline u32 mtk_vdec_get_ue(struct mtk_vdec_dev *vdec)
+{
+	return readl(vdec_avcvld(vdec) + AVCVLD_UE);
+}
+
+static inline s32 mtk_vdec_get_se(struct mtk_vdec_dev *vdec)
+{
+	return (s32)readl(vdec_avcvld(vdec) + AVCVLD_SE);
+}
+
+static int mtk_vdec_find_start_code(struct mtk_vdec_dev *vdec, u8 *nal_hdr)
+{
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	u32 peek = mtk_vdec_peek_bits(vdec);
+	s32 ctrl = (s32)readl(avcvld + AVCVLD_CTRL);
+	u32 val;
+	int ret;
+
+	if ((peek & ~0xffU) != 0x00000100U || ctrl < 0) {
+		writel(1, avcvld + AVCVLD_FIND_START_CODE);
+		ret = readl_poll_timeout_atomic(avcvld + AVCVLD_FIND_START_CODE,
+						val, (val & BIT(0)) == 0,
+						MTK_VDEC_POLL_US,
+						MTK_VDEC_POLL_TIMEOUT_US);
+		if (ret)
+			return ret;
+
+		peek = mtk_vdec_peek_bits(vdec);
+		if ((peek & ~0xffU) != 0x00000100U)
+			return -ENOENT;
+	}
+
+	/* Consume 00 00 01 <nal_header> (32 bits) */
+	val = mtk_vdec_get_bits(vdec, 32);
+	*nal_hdr = val & 0xff;
+	return 0;
+}
+
+static int mtk_vdec_find_slice_nalu(struct mtk_vdec_dev *vdec, u8 *nal_ref_idc,
+				    u8 *nal_unit_type)
+{
+	unsigned int i;
+	u8 hdr;
+	int ret;
+
+	for (i = 0; i < MTK_VDEC_MAX_NALU_SKIP; i++) {
+		ret = mtk_vdec_find_start_code(vdec, &hdr);
+		if (ret)
+			return ret;
+
+		*nal_ref_idc = (hdr >> 5) & 0x3;
+		*nal_unit_type = hdr & 0x1f;
+		if (*nal_unit_type == H264_NAL_SLICE ||
+		    *nal_unit_type == H264_NAL_IDR_SLICE)
+			return 0;
+	}
+
+	return -ENOENT;
+}
+
+static void mtk_vdec_write_scaling_list_one(struct mtk_vdec_dev *vdec,
+					    unsigned int idx, const u8 *list)
+{
+	void __iomem *vld = vdec_vld(vdec);
+	unsigned int base, len, off;
+
+	if (idx < 6) {
+		base = idx * 16;
+		len = 16;
+	} else if (idx == 6) {
+		base = 0x60;
+		len = 64;
+	} else {
+		base = 0xa0;
+		len = 64;
+	}
+
+	for (off = 0; off < len; off += 4) {
+		u32 word = get_unaligned_be32(list + off);
+
+		writel(VLD_SCALING_ADDR_LOAD + base + off,
+		       vld + VLD_SCALING_ADDR);
+		writel(word, vld + VLD_SCALING_DATA);
+		writel(VLD_SCALING_ADDR_COMMIT + base + off,
+		       vld + VLD_SCALING_ADDR);
+	}
+}
+
+static void
+mtk_vdec_program_sps_pps(struct mtk_vdec_dev *vdec,
+			 const struct v4l2_ctrl_h264_sps *sps,
+			 const struct v4l2_ctrl_h264_pps *pps,
+			 const struct v4l2_ctrl_h264_scaling_matrix *sm)
+{
+	void __iomem *vldtop = vdec_vldtop(vdec);
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	bool has_scaling =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_SCALING_MATRIX_PRESENT);
+	bool transform_8x8 =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE);
+	bool bot_poc = !!(pps->flags &
+		V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT);
+	bool deblock = !!(pps->flags &
+		V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT);
+	u32 reg;
+	unsigned int i;
+
+	reg = (sps->chroma_format_idc & 0x3) |
+	      ((sps->log2_max_frame_num_minus4 & 0xf) << 2) |
+	      ((sps->pic_order_cnt_type & 0x3) << 6) |
+	      ((sps->log2_max_pic_order_cnt_lsb_minus4 & 0xf) << 8) |
+	      (((sps->flags & V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO) ? 1 : 0) << 12) |
+	      ((sps->max_num_ref_frames & 0x1f) << 13) |
+	      (((sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) ? 1 : 0) << 18) |
+	      (((sps->flags & V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD) ? 1 : 0) << 19) |
+	      (((sps->flags & V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE) ? 1 : 0) << 20) |
+	      BIT(21);
+	writel(reg, avcvld + AVCVLD_SPS);
+
+	writel((sps->pic_width_in_mbs_minus1 & 0xffff) |
+	       ((sps->pic_height_in_map_units_minus1 & 0xffff) << 16),
+	       vldtop + VLDTOP_PIC_MB_SIZE);
+
+	writel((sps->bit_depth_luma_minus8 & 0xf) |
+	       ((sps->bit_depth_chroma_minus8 & 0xf) << 4),
+	       vldtop + VLDTOP_BIT_DEPTH);
+
+	reg = ((pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) ? 1 : 0) |
+	      ((bot_poc ? 1 : 0) << 1) |
+	      (((pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) ? 1 : 0) << 2) |
+	      ((pps->weighted_bipred_idc & 0x3) << 3) |
+	      (((u32)pps->pic_init_qp_minus26 & 0x3f) << 5) |
+	      (((u32)pps->chroma_qp_index_offset & 0x1f) << 11) |
+	      ((deblock ? 1 : 0) << 16) |
+	      (((pps->flags & V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED) ? 1 : 0) << 17) |
+	      ((transform_8x8 ? 1 : 0) << 18) |
+	      (((u32)pps->second_chroma_qp_index_offset & 0x1f) << 19);
+	writel(reg, avcvld + AVCVLD_PPS);
+
+	reg = (pps->num_ref_idx_l0_default_active_minus1 & 0x1f) |
+	      ((pps->num_ref_idx_l1_default_active_minus1 & 0x1f) << 5);
+	if (has_scaling) {
+		u32 sl_mask = transform_8x8 ? 0xffU : 0x3fU;
+
+		reg |= (sl_mask << 10) | BIT(18);
+		for (i = 0; i < 6; i++)
+			mtk_vdec_write_scaling_list_one(vdec, i,
+							sm->scaling_list_4x4[i]);
+		if (transform_8x8) {
+			mtk_vdec_write_scaling_list_one(vdec, 6,
+							sm->scaling_list_8x8[0]);
+			mtk_vdec_write_scaling_list_one(vdec, 7,
+							sm->scaling_list_8x8[1]);
+		}
+	}
+	writel(reg, avcvld + AVCVLD_PPS2);
+}
+
+static void mtk_vdec_program_poc(struct mtk_vdec_dev *vdec,
+				 const struct v4l2_ctrl_h264_decode_params *dec,
+				 const struct mtk_vdec_slice_hdr *sh)
+{
+	void __iomem *avcmv = vdec_avcmv(vdec);
+	s32 top_poc = dec->top_field_order_cnt;
+	s32 bot_poc = dec->bottom_field_order_cnt;
+	s32 cur_poc;
+
+	if (!sh->field_pic_flag) {
+		cur_poc = min(top_poc, bot_poc);
+		writel(top_poc & 0x3ffff, avcmv + AVCMV_TOP_POC);
+		writel(bot_poc & 0x3ffff, avcmv + AVCMV_BOT_POC);
+		writel(cur_poc & 0x3ffff, avcmv + AVCMV_CUR_POC);
+	} else {
+		cur_poc = sh->bottom_field_flag ? bot_poc : top_poc;
+		writel(cur_poc & 0x3ffff, avcmv + AVCMV_CUR_POC);
+	}
+}
+
+static u32 mtk_vdec_encode_ref_poc(s32 poc, s32 top_poc, s32 bot_poc,
+				   bool is_lt, bool is_bot, u8 dpb_idx)
+{
+	u32 val = (u32)poc & 0x3ffff;
+
+	val |= ((u32)(dpb_idx & 0x1f)) << 23;
+	if (is_bot)
+		val |= BIT(22);
+	if (is_lt)
+		val |= BIT(20);
+	if (top_poc <= bot_poc && top_poc != S32_MAX)
+		val |= BIT(21);
+
+	return val;
+}
+
+static void mtk_vdec_lookup_ref_addrs(struct mtk_vdec_ctx *ctx,
+				      const struct v4l2_h264_dpb_entry *dpb,
+				      dma_addr_t fallback_y,
+				      dma_addr_t fallback_c,
+				      dma_addr_t fallback_mv,
+				      dma_addr_t *ref_y, dma_addr_t *ref_c,
+				      dma_addr_t *ref_mv)
+{
+	struct vb2_queue *cap_vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+						   V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	struct vb2_buffer *vb = NULL;
+
+	if (dpb->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE)
+		vb = vb2_find_buffer(cap_vq, dpb->reference_ts);
+
+	if (vb) {
+		*ref_y = vb2_dma_contig_plane_dma_addr(vb, 0);
+		*ref_c = vb2_dma_contig_plane_dma_addr(vb, 1);
+		*ref_mv = (vb->index < ARRAY_SIZE(ctx->mv_bufs) &&
+			   ctx->mv_bufs[vb->index].dma) ?
+			  ctx->mv_bufs[vb->index].dma : fallback_mv;
+	} else {
+		*ref_y = fallback_y;
+		*ref_c = fallback_c;
+		*ref_mv = fallback_mv;
+	}
+}
+
+static void
+mtk_vdec_program_ref_lists(struct mtk_vdec_ctx *ctx,
+			   const struct v4l2_ctrl_h264_sps *sps,
+			   const struct v4l2_ctrl_h264_decode_params *dec,
+			   dma_addr_t fallback_y, dma_addr_t fallback_c,
+			   dma_addr_t fallback_mv)
+{
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	void __iomem *mc = vdec_mc(vdec);
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	void __iomem *avcmv = vdec_avcmv(vdec);
+	struct v4l2_h264_reflist_builder builder;
+	struct v4l2_h264_reference p0_list[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference b0_list[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference b1_list[V4L2_H264_REF_LIST_LEN];
+	unsigned int i, count;
+
+	v4l2_h264_init_reflist_builder(&builder, dec, sps, dec->dpb);
+	v4l2_h264_build_p_ref_list(&builder, p0_list);
+	v4l2_h264_build_b_ref_lists(&builder, b0_list, b1_list);
+
+	count = min_t(unsigned int, builder.num_valid, MTK_VDEC_MAX_REFS);
+
+	/* Initialize all 16 reference slots with safe fallback addresses */
+	for (i = 0; i < MTK_VDEC_MAX_REFS; i++) {
+		u32 fy = mtk_vdec_iova32(fallback_y);
+		u32 fc = mtk_vdec_iova32(fallback_c);
+		u32 fmv = mtk_vdec_iova32(fallback_mv) >> 4;
+
+		writel(fy, mc + MC_PREF_L0_Y(i));
+		writel(fc, mc + MC_PREF_L0_C(i));
+		writel(fy, mc + MC_BREF_L0_Y(i));
+		writel(fc, mc + MC_BREF_L0_C(i));
+		writel(fy, mc + MC_BREF_L1_Y(i));
+		writel(fc, mc + MC_BREF_L1_C(i));
+		writel(fmv, avcmv + AVCMV_BREF_L1_MV_TOP(i));
+		writel(fmv, avcmv + AVCMV_BREF_L1_MV_BOT(i));
+	}
+
+	/* P-slice L0 reference list */
+	for (i = 0; i < count; i++) {
+		u8 idx = p0_list[i].index;
+		const struct v4l2_h264_dpb_entry *dpb = &dec->dpb[idx];
+		bool is_lt = !!(dpb->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM);
+		u32 pic_num = is_lt ? dpb->pic_num : dpb->frame_num;
+		dma_addr_t ry, rc, rmv;
+
+		mtk_vdec_lookup_ref_addrs(ctx, dpb, fallback_y, fallback_c,
+					  fallback_mv, &ry, &rc, &rmv);
+
+		writel(mtk_vdec_iova32(ry), mc + MC_PREF_L0_Y(i));
+		writel(mtk_vdec_iova32(rc), mc + MC_PREF_L0_C(i));
+		writel((pic_num & 0x7ffff) | (is_lt ? BIT(19) : 0),
+		       avcvld + AVCVLD_PREF_L0_PICNUM(i));
+		writel(mtk_vdec_encode_ref_poc(dpb->top_field_order_cnt,
+					       dpb->top_field_order_cnt,
+					       dpb->bottom_field_order_cnt,
+					       is_lt, false, idx),
+		       avcmv + AVCMV_PREF_L0_TOP(i));
+		writel(mtk_vdec_encode_ref_poc(dpb->bottom_field_order_cnt,
+					       dpb->top_field_order_cnt,
+					       dpb->bottom_field_order_cnt,
+					       is_lt, true, idx),
+		       avcmv + AVCMV_PREF_L0_BOT(i));
+	}
+
+	/* B-slice L0 and L1 reference lists */
+	for (i = 0; i < count; i++) {
+		u8 idx0 = b0_list[i].index;
+		u8 idx1 = b1_list[i].index;
+		const struct v4l2_h264_dpb_entry *dpb0 = &dec->dpb[idx0];
+		const struct v4l2_h264_dpb_entry *dpb1 = &dec->dpb[idx1];
+		bool lt0 = !!(dpb0->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM);
+		bool lt1 = !!(dpb1->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM);
+		u32 pn0 = lt0 ? dpb0->pic_num : dpb0->frame_num;
+		u32 pn1 = lt1 ? dpb1->pic_num : dpb1->frame_num;
+		dma_addr_t ry, rc, rmv;
+
+		/* B-L0 */
+		mtk_vdec_lookup_ref_addrs(ctx, dpb0, fallback_y, fallback_c,
+					  fallback_mv, &ry, &rc, &rmv);
+		writel(mtk_vdec_iova32(ry), mc + MC_BREF_L0_Y(i));
+		writel(mtk_vdec_iova32(rc), mc + MC_BREF_L0_C(i));
+		writel((pn0 & 0x7ffff) | (lt0 ? BIT(19) : 0),
+		       avcvld + AVCVLD_BREF_L0_PICNUM(i));
+		writel(mtk_vdec_encode_ref_poc(dpb0->top_field_order_cnt,
+					       dpb0->top_field_order_cnt,
+					       dpb0->bottom_field_order_cnt,
+					       lt0, false, idx0),
+		       avcmv + AVCMV_BREF_L0_TOP(i));
+		writel(mtk_vdec_encode_ref_poc(dpb0->bottom_field_order_cnt,
+					       dpb0->top_field_order_cnt,
+					       dpb0->bottom_field_order_cnt,
+					       lt0, true, idx0),
+		       avcmv + AVCMV_BREF_L0_BOT(i));
+
+		/* B-L1 */
+		mtk_vdec_lookup_ref_addrs(ctx, dpb1, fallback_y, fallback_c,
+					  fallback_mv, &ry, &rc, &rmv);
+		writel(mtk_vdec_iova32(ry), mc + MC_BREF_L1_Y(i));
+		writel(mtk_vdec_iova32(rc), mc + MC_BREF_L1_C(i));
+		writel((pn1 & 0x7ffff) | (lt1 ? BIT(19) : 0),
+		       avcvld + AVCVLD_BREF_L1_PICNUM(i));
+		writel(mtk_vdec_encode_ref_poc(dpb1->top_field_order_cnt,
+					       dpb1->top_field_order_cnt,
+					       dpb1->bottom_field_order_cnt,
+					       lt1, false, idx1),
+		       avcmv + AVCMV_BREF_L1_TOP(i));
+		writel(mtk_vdec_encode_ref_poc(dpb1->bottom_field_order_cnt,
+					       dpb1->top_field_order_cnt,
+					       dpb1->bottom_field_order_cnt,
+					       lt1, true, idx1),
+		       avcmv + AVCMV_BREF_L1_BOT(i));
+		writel(mtk_vdec_iova32(rmv) >> 4,
+		       avcmv + AVCMV_BREF_L1_MV_TOP(i));
+		writel(mtk_vdec_iova32(rmv) >> 4,
+		       avcmv + AVCMV_BREF_L1_MV_BOT(i));
+	}
+}
+
+static void mtk_vdec_program_slice_hdr_regs(struct mtk_vdec_dev *vdec,
+					    const struct mtk_vdec_slice_hdr *sh)
+{
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	u32 reg;
+
+	reg = readl(avcvld + AVCVLD_SLICE_FIRST_MB);
+	reg &= ~GENMASK(16, 0);
+	reg |= sh->first_mb_in_slice & 0x1fff;
+	writel(reg, avcvld + AVCVLD_SLICE_FIRST_MB);
+
+	reg = readl(avcvld + AVCVLD_SLICE_HDR);
+	reg &= ~GENMASK(31, 13);
+	reg |= ((sh->slice_type_mod & 0xf) << 13) |
+	       ((sh->field_pic_flag ? 1 : 0) << 17) |
+	       ((sh->bottom_field_flag ? 1 : 0) << 18) |
+	       ((sh->num_ref_idx_override_flag ? 1 : 0) << 19) |
+	       ((sh->num_ref_idx_l0_active_minus1 & 0x1f) << 20) |
+	       ((sh->num_ref_idx_l1_active_minus1 & 0x1f) << 25);
+	writel(reg, avcvld + AVCVLD_SLICE_HDR);
+}
+
+static int mtk_vdec_hw_reorder_refs(struct mtk_vdec_dev *vdec)
+{
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	u32 val;
+
+	writel(1, avcvld + AVCVLD_REORDER_TRIG);
+	return readl_poll_timeout_atomic(avcvld + AVCVLD_REORDER_TRIG, val,
+					 val != 0, MTK_VDEC_POLL_US,
+					 MTK_VDEC_POLL_TIMEOUT_US);
+}
+
+static int mtk_vdec_hw_pred_weight_table(struct mtk_vdec_dev *vdec)
+{
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	u32 val;
+	int ret;
+
+	writel(1, avcvld + AVCVLD_WEIGHT_TRIG);
+	ret = readl_poll_timeout_atomic(avcvld + AVCVLD_WEIGHT_TRIG, val,
+					val != 0, MTK_VDEC_POLL_US,
+					MTK_VDEC_POLL_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	writel(readl(avcvld + AVCVLD_WEIGHT_CTRL) & ~BIT(0),
+	       avcvld + AVCVLD_WEIGHT_CTRL);
+	return 0;
+}
+
+static int mtk_vdec_skip_dec_ref_pic_marking(struct mtk_vdec_dev *vdec,
+					     bool is_idr)
+{
+	unsigned int guard;
+
+	if (is_idr) {
+		mtk_vdec_get_bits(vdec, 2);
+		return 0;
+	}
+
+	if (!mtk_vdec_get_bits(vdec, 1))
+		return 0;
+
+	for (guard = 0; guard < 32; guard++) {
+		u32 mmco = mtk_vdec_get_ue(vdec);
+
+		if (mmco == 0)
+			return 0;
+
+		if (mmco == 1 || mmco == 3)
+			mtk_vdec_get_ue(vdec);
+		if (mmco == 2)
+			mtk_vdec_get_ue(vdec);
+		if (mmco == 3 || mmco == 6)
+			mtk_vdec_get_ue(vdec);
+		if (mmco == 4)
+			mtk_vdec_get_ue(vdec);
+	}
+
+	return -EINVAL;
+}
+
+/*
+ * Parse the H.264 slice header directly on the AVCVLD hardware barrel shifter.
+ * This positions the barrel shifter at the exact start of slice data while
+ * letting hardware engines parse ref_pic_list_modification() and
+ * pred_weight_table() into their internal SRAMs.
+ */
+static int
+mtk_vdec_parse_slice_header_hw(struct mtk_vdec_ctx *ctx,
+			       const struct v4l2_ctrl_h264_sps *sps,
+			       const struct v4l2_ctrl_h264_pps *pps,
+			       const struct v4l2_ctrl_h264_decode_params *dec,
+			       dma_addr_t dst_y, dma_addr_t dst_c,
+			       dma_addr_t cur_mv,
+			       struct mtk_vdec_slice_hdr *sh)
+{
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	bool separate_colour_plane =
+		!!(sps->flags & V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE);
+	bool frame_mbs_only =
+		!!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY);
+	bool delta_poc_always_zero =
+		!!(sps->flags & V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO);
+	bool bot_poc_present =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT);
+	bool redundant_pic_cnt =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_REDUNDANT_PIC_CNT_PRESENT);
+	bool weighted_pred =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED);
+	bool entropy_cabac =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE);
+	bool deblock_ctrl =
+		!!(pps->flags & V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT);
+	int ret;
+
+	memset(sh, 0, sizeof(*sh));
+
+	ret = mtk_vdec_find_slice_nalu(vdec, &sh->nal_ref_idc,
+				       &sh->nal_unit_type);
+	if (ret)
+		return ret;
+
+	sh->first_mb_in_slice = mtk_vdec_get_ue(vdec);
+	sh->slice_type = mtk_vdec_get_ue(vdec);
+	if (sh->slice_type >= 10)
+		return -EINVAL;
+	sh->slice_type_mod = sh->slice_type % 5;
+
+	/* pic_parameter_set_id */
+	mtk_vdec_get_ue(vdec);
+
+	if (separate_colour_plane)
+		mtk_vdec_get_bits(vdec, 2);
+
+	/* frame_num */
+	mtk_vdec_get_bits(vdec, sps->log2_max_frame_num_minus4 + 4);
+
+	if (!frame_mbs_only) {
+		sh->field_pic_flag = !!mtk_vdec_get_bits(vdec, 1);
+		if (sh->field_pic_flag)
+			sh->bottom_field_flag = !!mtk_vdec_get_bits(vdec, 1);
+	}
+
+	if (sh->nal_unit_type == H264_NAL_IDR_SLICE)
+		mtk_vdec_get_ue(vdec);
+
+	if (sps->pic_order_cnt_type == 0) {
+		mtk_vdec_get_bits(vdec,
+				  sps->log2_max_pic_order_cnt_lsb_minus4 + 4);
+		if (bot_poc_present && !sh->field_pic_flag)
+			mtk_vdec_get_se(vdec);
+	} else if (sps->pic_order_cnt_type == 1 && !delta_poc_always_zero) {
+		mtk_vdec_get_se(vdec);
+		if (bot_poc_present && !sh->field_pic_flag)
+			mtk_vdec_get_se(vdec);
+	}
+
+	if (redundant_pic_cnt)
+		mtk_vdec_get_ue(vdec);
+
+	if (sh->slice_type_mod == 1) /* B slice */
+		sh->direct_spatial_mv_pred_flag = !!mtk_vdec_get_bits(vdec, 1);
+
+	sh->num_ref_idx_l0_active_minus1 =
+		pps->num_ref_idx_l0_default_active_minus1;
+	sh->num_ref_idx_l1_active_minus1 =
+		(sh->slice_type_mod == 1) ?
+		pps->num_ref_idx_l1_default_active_minus1 : 0;
+
+	if (sh->slice_type_mod == 0 || sh->slice_type_mod == 1 ||
+	    sh->slice_type_mod == 3) {
+		sh->num_ref_idx_override_flag = !!mtk_vdec_get_bits(vdec, 1);
+		if (sh->num_ref_idx_override_flag) {
+			sh->num_ref_idx_l0_active_minus1 =
+				min_t(u32, mtk_vdec_get_ue(vdec), 31);
+			if (sh->slice_type_mod == 1)
+				sh->num_ref_idx_l1_active_minus1 =
+					min_t(u32, mtk_vdec_get_ue(vdec), 31);
+		}
+	}
+
+	/*
+	 * Program slice header, POC, and initial reference picture lists before
+	 * triggering the hardware ref-list reordering and weight-table engines.
+	 */
+	mtk_vdec_program_slice_hdr_regs(vdec, sh);
+	mtk_vdec_program_poc(vdec, dec, sh);
+	mtk_vdec_program_ref_lists(ctx, sps, dec, dst_y, dst_c, cur_mv);
+
+	if (sh->slice_type_mod != 2 && sh->slice_type_mod != 4) {
+		ret = mtk_vdec_hw_reorder_refs(vdec);
+		if (ret) {
+			dev_err(vdec->dev, "HW ref list reorder timeout\n");
+			return ret;
+		}
+	}
+
+	if ((weighted_pred &&
+	     (sh->slice_type_mod == 0 || sh->slice_type_mod == 3)) ||
+	    (pps->weighted_bipred_idc == 1 && sh->slice_type_mod == 1)) {
+		ret = mtk_vdec_hw_pred_weight_table(vdec);
+		if (ret) {
+			dev_err(vdec->dev, "HW pred weight table timeout\n");
+			return ret;
+		}
+	}
+
+	if (sh->nal_ref_idc != 0) {
+		ret = mtk_vdec_skip_dec_ref_pic_marking(vdec,
+							sh->nal_unit_type == H264_NAL_IDR_SLICE);
+		if (ret)
+			return ret;
+	}
+
+	if (entropy_cabac && sh->slice_type_mod != 2 && sh->slice_type_mod != 4)
+		sh->cabac_init_idc = mtk_vdec_get_ue(vdec);
+
+	sh->slice_qp_delta = mtk_vdec_get_se(vdec);
+
+	if (sh->slice_type_mod == 3 || sh->slice_type_mod == 4) {
+		if (sh->slice_type_mod == 3)
+			mtk_vdec_get_bits(vdec, 1);
+		mtk_vdec_get_se(vdec);
+	}
+
+	if (deblock_ctrl) {
+		sh->disable_deblocking_filter_idc = mtk_vdec_get_ue(vdec);
+		if (sh->disable_deblocking_filter_idc != 1) {
+			sh->slice_alpha_c0_offset_div2 = mtk_vdec_get_se(vdec);
+			sh->slice_beta_offset_div2 = mtk_vdec_get_se(vdec);
+		}
+	}
+
+	return 0;
+}
+
+static int mtk_vdec_hw_dec_start(struct mtk_vdec_ctx *ctx,
+				 const struct v4l2_ctrl_h264_sps *sps,
+				 const struct v4l2_ctrl_h264_pps *pps,
+				 const struct mtk_vdec_slice_hdr *sh,
+				 dma_addr_t dst_y, dma_addr_t dst_c,
+				 dma_addr_t cur_mv)
+{
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	void __iomem *vldtop = vdec_vldtop(vdec);
+	void __iomem *mc = vdec_mc(vdec);
+	void __iomem *avcvld = vdec_avcvld(vdec);
+	void __iomem *avcmv = vdec_avcmv(vdec);
+	void __iomem *pp = vdec_pp(vdec);
+	void __iomem *misc = vdec_misc(vdec);
+	u32 aligned_w = ctx->cap_fmt.fmt.pix_mp.width;
+	u32 aligned_h = ctx->cap_fmt.fmt.pix_mp.height;
+	u32 y_size = ctx->cap_fmt.fmt.pix_mp.plane_fmt[0].sizeimage;
+	u32 c_size = ctx->cap_fmt.fmt.pix_mp.plane_fmt[1].sizeimage;
+	u32 dst_y32 = mtk_vdec_iova32(dst_y);
+	u32 dst_c32 = mtk_vdec_iova32(dst_c);
+	u32 fb_start = min(dst_y32, dst_c32);
+	u32 fb_end = max(dst_y32 + y_size, dst_c32 + c_size);
+	u32 mv32 = mtk_vdec_iova32(cur_mv);
+	u32 buf_mb_w = DIV_ROUND_UP(aligned_w, 16);
+	u32 mb_w = sps->pic_width_in_mbs_minus1 + 1;
+	u32 mb_h = sps->pic_height_in_map_units_minus1 + 1;
+	u32 reg, val;
+	int ret;
+
+	if (sh->slice_type_mod == 1)
+		writel(readl(avcmv + AVCMV_CTRL) | AVCMV_CTRL_BREF_EN,
+		       avcmv + AVCMV_CTRL);
+
+	writel(MISC_CODEC_SEL_PREP, misc + MISC_CODEC_SEL);
+	writel(sps->chroma_format_idc & 0x7, mc + MC_CHROMA_FMT);
+	writel(0xffffffff, vldtop + VLDTOP_ERR_MASK);
+
+	writel(aligned_w, mc + MC_PIC_WIDTH);
+	writel(aligned_h, mc + MC_PIC_HEIGHT);
+	writel(MISC_CODEC_SEL_H264, misc + MISC_CODEC_SEL);
+	writel(aligned_w | (aligned_h << 16), vldtop + VLDTOP_PIC_SIZE);
+
+	writel(AVCVLD_ERR_CFG_VAL, avcvld + AVCVLD_ERR_CFG1);
+	writel(AVCVLD_ERR_CFG_VAL, avcvld + AVCVLD_ERR_CFG2);
+
+	/* Non-UFO 2-plane MM21 output configuration */
+	writel(1, mc + MC_PP_ENABLE);
+	writel(dst_y32 >> 9, mc + MC_PP_Y_ADDR);
+	writel(dst_c32 >> 8, mc + MC_PP_C_ADDR);
+	writel(1, mc + MC_PP_WRITE_EN);
+	writel(3, mc + MC_PP_MB_MODE);
+	writel(buf_mb_w - 1, mc + MC_PP_MB_X_MAX);
+	writel((aligned_h >> 4) - 1, mc + MC_PP_MB_Y_MAX);
+	writel(buf_mb_w, mc + MC_PP_BUF_WIDTH);
+
+	/*
+	 * Disable single-contiguous-FB bound check since V4L2 MM21 allocates
+	 * Y and CbCr as two independent DMA-contig planes.
+	 */
+	writel(0, mc + MC_BOUND_EN);
+
+	writel(MC_DRAM_CFG_INIT, mc + MC_DRAM_CFG);
+	writel(dst_y32, mc + MC_Y_BASE);
+	writel(y_size, mc + MC_Y_SIZE);
+	writel(buf_mb_w, mc + MC_REF_BUF_WIDTH);
+
+	writel(AVCVLD_MISC_CFG1_VAL, avcvld + AVCVLD_MISC_CFG1);
+	writel(AVCVLD_MISC_CFG2_INIT, avcvld + AVCVLD_MISC_CFG2);
+	writel(0xffffffff, avcvld + AVCVLD_ERR_MASK1);
+	writel(0xffffffff, avcvld + AVCVLD_ERR_MASK2);
+
+	writel(mv32 >> 4, avcmv + AVCMV_CUR_MV_ADDR);
+
+	reg = ((u32)sh->slice_qp_delta & 0x7f) |
+	      ((sh->disable_deblocking_filter_idc & 0x3) << 7) |
+	      (((u32)sh->slice_alpha_c0_offset_div2 & 0xf) << 9) |
+	      (((u32)sh->slice_beta_offset_div2 & 0xf) << 13) |
+	      ((sh->nal_ref_idc & 0x3) << 17) |
+	      ((sh->direct_spatial_mv_pred_flag ? 1 : 0) << 19) |
+	      ((sh->cabac_init_idc & 0x3) << 20);
+	writel(reg, avcvld + AVCVLD_SLICE_CTRL);
+
+	if (pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) {
+		writel(1, avcvld + AVCVLD_CABAC_INIT);
+		ret = readl_poll_timeout_atomic(avcvld + AVCVLD_CABAC_STATUS,
+						val,
+						(val & AVCVLD_CABAC_BUSY) == 0,
+						MTK_VDEC_POLL_US,
+						MTK_VDEC_POLL_TIMEOUT_US);
+		if (ret) {
+			dev_err(vdec->dev, "CABAC init timeout (0x%08x)\n", val);
+			return ret;
+		}
+	}
+
+	writel(readl(mc + MC_DRAM_CFG) | MC_DRAM_CFG_START, mc + MC_DRAM_CFG);
+	writel(readl(mc + MC_DMA_CFG) | MC_DMA_CFG_EN, mc + MC_DMA_CFG);
+	writel((readl(mc + MC_CHROMA_CFG) & ~0x7) |
+	       (sps->chroma_format_idc & 0x7), mc + MC_CHROMA_CFG);
+
+	writel(mb_w * mb_h, vldtop + VLDTOP_TOTAL_MB);
+	writel(0xffffffff, vldtop + VLDTOP_TIMEOUT_CYCLE);
+
+	writel(mtk_vdec_iova32(ctx->vld_wrap_buf.dma), mc + MC_VLD_WRAP_ADDR);
+	writel(mtk_vdec_iova32(ctx->pp_wrap_buf.dma), mc + MC_PP_WRAP_ADDR);
+
+	writel(AVCVLD_MISC_CFG2_DEC, avcvld + AVCVLD_MISC_CFG2);
+	writel(AVCVLD_MISC_CFG3_VAL, avcvld + AVCVLD_MISC_CFG3);
+
+	reg = readl(vldtop + VLDTOP_FETCH_CFG);
+	reg &= ~VLDTOP_FETCH_CFG_MASK;
+	reg |= VLDTOP_FETCH_CFG_VAL;
+	writel(reg, vldtop + VLDTOP_FETCH_CFG);
+
+	if ((u64)aligned_w * aligned_h > 0x1fe000ULL) {
+		writel(MISC_BW_CFG_2K, misc + MISC_BW_CFG);
+		writel(readl(pp + PP_CTRL) | PP_CTRL_LARGE_RES, pp + PP_CTRL);
+	}
+
+	writel(readl(misc + MISC_DMA_EN) | 1, misc + MISC_DMA_EN);
+	writel(fb_start, misc + MISC_FB_BOUND_START);
+	writel(fb_end, misc + MISC_FB_BOUND_END);
+	writel(mv32, misc + MISC_MV_BOUND_START);
+	writel(mv32 + (u32)ctx->mv_buf_size, misc + MISC_MV_BOUND_END);
+
+	writel(AVCVLD_CTRL_DEC, avcvld + AVCVLD_CTRL);
+
+	/* Trigger hardware decode */
+	writel(1, avcvld + AVCVLD_DEC_START);
+
+	return 0;
+}
+
+/* ---------------- V4L2 M2M Job Execution & IRQ ---------------- */
+
+static void mtk_vdec_job_finish_no_pm(struct mtk_vdec_ctx *ctx,
+				      enum vb2_buffer_state state)
+{
+	v4l2_m2m_buf_done_and_job_finish(ctx->vdec->m2m_dev,
+					 ctx->fh.m2m_ctx, state);
+}
+
+static void mtk_vdec_job_finish(struct mtk_vdec_ctx *ctx,
+				enum vb2_buffer_state state)
+{
+	pm_runtime_mark_last_busy(ctx->vdec->dev);
+	pm_runtime_put_autosuspend(ctx->vdec->dev);
+	mtk_vdec_job_finish_no_pm(ctx, state);
+}
+
+static void *mtk_vdec_get_ctrl_ptr(struct mtk_vdec_ctx *ctx, u32 id)
+{
+	struct v4l2_ctrl *ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, id);
+
+	return ctrl ? ctrl->p_cur.p : NULL;
+}
+
+static void mtk_vdec_device_run(void *priv)
+{
+	struct mtk_vdec_ctx *ctx = priv;
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	struct vb2_v4l2_buffer *src_buf, *dst_buf;
+	struct media_request *src_req;
+	const struct v4l2_ctrl_h264_sps *sps;
+	const struct v4l2_ctrl_h264_pps *pps;
+	const struct v4l2_ctrl_h264_scaling_matrix *sm;
+	const struct v4l2_ctrl_h264_decode_params *dec;
+	struct mtk_vdec_slice_hdr sh;
+	dma_addr_t bs_dma, dst_y, dst_c, cur_mv;
+	size_t bs_used, bs_size;
+	int ret;
+
+	src_buf = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst_buf = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	if (!src_buf || !dst_buf) {
+		mtk_vdec_job_finish_no_pm(ctx, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	ret = pm_runtime_resume_and_get(vdec->dev);
+	if (ret < 0) {
+		dev_err(vdec->dev, "pm_runtime_resume_and_get failed: %d\n", ret);
+		mtk_vdec_job_finish_no_pm(ctx, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	src_req = src_buf->vb2_buf.req_obj.req;
+	if (src_req)
+		v4l2_ctrl_request_setup(src_req, &ctx->ctrl_hdl);
+
+	v4l2_m2m_buf_copy_metadata(src_buf, dst_buf);
+
+	sps = mtk_vdec_get_ctrl_ptr(ctx, V4L2_CID_STATELESS_H264_SPS);
+	pps = mtk_vdec_get_ctrl_ptr(ctx, V4L2_CID_STATELESS_H264_PPS);
+	sm = mtk_vdec_get_ctrl_ptr(ctx, V4L2_CID_STATELESS_H264_SCALING_MATRIX);
+	dec = mtk_vdec_get_ctrl_ptr(ctx, V4L2_CID_STATELESS_H264_DECODE_PARAMS);
+	if (!sps || !pps || !sm || !dec) {
+		ret = -EINVAL;
+		goto err_complete_req;
+	}
+
+	bs_dma = vb2_dma_contig_plane_dma_addr(&src_buf->vb2_buf, 0);
+	bs_used = vb2_get_plane_payload(&src_buf->vb2_buf, 0);
+	bs_size = vb2_plane_size(&src_buf->vb2_buf, 0);
+	dst_y = vb2_dma_contig_plane_dma_addr(&dst_buf->vb2_buf, 0);
+	dst_c = vb2_dma_contig_plane_dma_addr(&dst_buf->vb2_buf, 1);
+
+	if (!bs_used) {
+		ret = -EINVAL;
+		goto err_complete_req;
+	}
+
+	cur_mv = mtk_vdec_get_mv_dma(ctx, dst_buf->vb2_buf.index);
+	if (!cur_mv) {
+		ret = -ENOMEM;
+		goto err_complete_req;
+	}
+
+	mtk_vdec_hw_reset_and_init(vdec);
+
+	ret = mtk_vdec_init_barrel_shifter(vdec, bs_dma, bs_used, bs_size, dst_y);
+	if (ret)
+		goto err_complete_req;
+
+	mtk_vdec_program_sps_pps(vdec, sps, pps, sm);
+
+	ret = mtk_vdec_parse_slice_header_hw(ctx, sps, pps, dec,
+					     dst_y, dst_c, cur_mv, &sh);
+	if (ret) {
+		dev_err(vdec->dev, "Failed to parse slice header on HW: %d\n",
+			ret);
+		goto err_complete_req;
+	}
+
+	schedule_delayed_work(&vdec->watchdog_work,
+			      msecs_to_jiffies(MTK_VDEC_TIMEOUT_MS));
+
+	ret = mtk_vdec_hw_dec_start(ctx, sps, pps, &sh, dst_y, dst_c, cur_mv);
+	if (ret) {
+		cancel_delayed_work(&vdec->watchdog_work);
+		goto err_complete_req;
+	}
+
+	if (src_req)
+		v4l2_ctrl_request_complete(src_req, &ctx->ctrl_hdl);
+
+	return;
+
+err_complete_req:
+	if (src_req)
+		v4l2_ctrl_request_complete(src_req, &ctx->ctrl_hdl);
+	mtk_vdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
+}
+
+static const struct v4l2_m2m_ops mtk_vdec_m2m_ops = {
+	.device_run = mtk_vdec_device_run,
+};
+
+static irqreturn_t mtk_vdec_irq_thread(int irq, void *priv)
+{
+	struct mtk_vdec_dev *vdec = priv;
+	struct mtk_vdec_ctx *ctx;
+	u32 status, done_info, pic_done;
+	enum vb2_buffer_state state;
+
+	status = readl(vdec_misc(vdec) + MISC_IRQ_STATUS);
+	mtk_vdec_clear_irq(vdec);
+
+	ctx = v4l2_m2m_get_curr_priv(vdec->m2m_dev);
+	if (!ctx)
+		return IRQ_HANDLED;
+
+	done_info = readl(vdec_avcvld(vdec) + AVCVLD_DEC_DONE_INFO);
+	pic_done = readl(vdec_avcvld(vdec) + AVCVLD_PIC_COMPLETE);
+
+	if (status & MISC_IRQ_DEC_SUCCESS) {
+		state = VB2_BUF_STATE_DONE;
+	} else {
+		dev_warn(vdec->dev,
+			 "VDEC IRQ error: status=0x%08x done=0x%08x pic=0x%08x\n",
+			 status, done_info, pic_done);
+		state = VB2_BUF_STATE_ERROR;
+	}
+
+	if (cancel_delayed_work(&vdec->watchdog_work))
+		mtk_vdec_job_finish(ctx, state);
+
+	return IRQ_HANDLED;
+}
+
+static void mtk_vdec_watchdog_work(struct work_struct *work)
+{
+	struct mtk_vdec_dev *vdec =
+		container_of(to_delayed_work(work), struct mtk_vdec_dev,
+			     watchdog_work);
+	struct mtk_vdec_ctx *ctx = v4l2_m2m_get_curr_priv(vdec->m2m_dev);
+
+	if (!ctx)
+		return;
+
+	dev_err(vdec->dev,
+		"H.264 decode timeout (irq=0x%08x done=0x%08x pic=0x%08x)\n",
+		readl(vdec_misc(vdec) + MISC_IRQ_STATUS),
+		readl(vdec_avcvld(vdec) + AVCVLD_DEC_DONE_INFO),
+		readl(vdec_avcvld(vdec) + AVCVLD_PIC_COMPLETE));
+
+	mtk_vdec_hw_reset_and_init(vdec);
+	mtk_vdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
+}
