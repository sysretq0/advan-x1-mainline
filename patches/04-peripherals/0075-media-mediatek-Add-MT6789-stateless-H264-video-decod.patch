+static int mtk_vdec_querycap(struct file *file, void *priv,
+			     struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, MTK_VDEC_DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "MediaTek MT6789 H.264 Decoder", sizeof(cap->card));
+	snprintf(cap->bus_info, sizeof(cap->bus_info), "platform:%s",
+		 MTK_VDEC_DRV_NAME);
+	return 0;
+}
+
+static int mtk_vdec_enum_framesizes(struct file *file, void *priv,
+				    struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index != 0)
+		return -EINVAL;
+
+	if (fsize->pixel_format != V4L2_PIX_FMT_H264_SLICE)
+		return -ENOTTY;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = MTK_VDEC_MIN_W;
+	fsize->stepwise.max_width = MTK_VDEC_MAX_W;
+	fsize->stepwise.step_width = 16;
+	fsize->stepwise.min_height = MTK_VDEC_MIN_H;
+	fsize->stepwise.max_height = MTK_VDEC_MAX_H;
+	fsize->stepwise.step_height = 16;
+
+	return 0;
+}
+
+static int mtk_vdec_enum_fmt_out(struct file *file, void *priv,
+				 struct v4l2_fmtdesc *f)
+{
+	if (f->index != 0)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_H264_SLICE;
+	return 0;
+}
+
+static int mtk_vdec_enum_fmt_cap(struct file *file, void *priv,
+				 struct v4l2_fmtdesc *f)
+{
+	if (f->index != 0)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_MM21;
+	return 0;
+}
+
+static int mtk_vdec_g_fmt_out(struct file *file, void *priv,
+			      struct v4l2_format *f)
+{
+	struct mtk_vdec_ctx *ctx = file_to_ctx(file);
+
+	*f = ctx->out_fmt;
+	return 0;
+}
+
+static int mtk_vdec_g_fmt_cap(struct file *file, void *priv,
+			      struct v4l2_format *f)
+{
+	struct mtk_vdec_ctx *ctx = file_to_ctx(file);
+
+	*f = ctx->cap_fmt;
+	return 0;
+}
+
+static int mtk_vdec_try_fmt_out(struct file *file, void *priv,
+				struct v4l2_format *f)
+{
+	mtk_vdec_fill_out_fmt(&f->fmt.pix_mp,
+			      f->fmt.pix_mp.width, f->fmt.pix_mp.height);
+	return 0;
+}
+
+static int mtk_vdec_try_fmt_cap(struct file *file, void *priv,
+				struct v4l2_format *f)
+{
+	struct mtk_vdec_ctx *ctx = file_to_ctx(file);
+	u32 w = max(f->fmt.pix_mp.width, ctx->out_fmt.fmt.pix_mp.width);
+	u32 h = max(f->fmt.pix_mp.height, ctx->out_fmt.fmt.pix_mp.height);
+
+	mtk_vdec_fill_cap_fmt(&f->fmt.pix_mp, w, h);
+	return 0;
+}
+
+static int mtk_vdec_s_fmt_out(struct file *file, void *priv,
+			      struct v4l2_format *f)
+{
+	struct mtk_vdec_ctx *ctx = file_to_ctx(file);
+	struct vb2_queue *out_vq =
+		v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	struct vb2_queue *cap_vq =
+		v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+
+	if (vb2_is_streaming(out_vq) || vb2_is_busy(cap_vq))
+		return -EBUSY;
+
+	mtk_vdec_try_fmt_out(file, priv, f);
+	ctx->out_fmt = *f;
+
+	/* Propagate resolution and colorspace to CAPTURE format */
+	mtk_vdec_fill_cap_fmt(&ctx->cap_fmt.fmt.pix_mp,
+			      f->fmt.pix_mp.width, f->fmt.pix_mp.height);
+	ctx->cap_fmt.fmt.pix_mp.colorspace = f->fmt.pix_mp.colorspace;
+	ctx->cap_fmt.fmt.pix_mp.xfer_func = f->fmt.pix_mp.xfer_func;
+	ctx->cap_fmt.fmt.pix_mp.ycbcr_enc = f->fmt.pix_mp.ycbcr_enc;
+	ctx->cap_fmt.fmt.pix_mp.quantization = f->fmt.pix_mp.quantization;
+
+	return 0;
+}
+
+static int mtk_vdec_s_fmt_cap(struct file *file, void *priv,
+			      struct v4l2_format *f)
+{
+	struct mtk_vdec_ctx *ctx = file_to_ctx(file);
+	struct vb2_queue *cap_vq =
+		v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+
+	if (vb2_is_busy(cap_vq))
+		return -EBUSY;
+
+	mtk_vdec_try_fmt_cap(file, priv, f);
+	ctx->cap_fmt = *f;
+	return 0;
+}
