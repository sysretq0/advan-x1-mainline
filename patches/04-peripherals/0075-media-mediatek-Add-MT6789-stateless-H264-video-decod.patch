+static const struct media_device_ops mtk_vdec_media_ops = {
+	.req_validate = mtk_vdec_request_validate,
+	.req_queue = v4l2_m2m_request_queue,
+};
+
+static int mtk_vdec_queue_init(void *priv, struct vb2_queue *src_vq,
+			       struct vb2_queue *dst_vq)
+{
+	struct mtk_vdec_ctx *ctx = priv;
+	struct mtk_vdec_dev *vdec = ctx->vdec;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = ctx;
+	src_vq->ops = &mtk_vdec_vb2_ops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->dma_attrs = DMA_ATTR_NO_KERNEL_MAPPING;
+	src_vq->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &vdec->vdev_lock;
+	src_vq->dev = vdec->dev;
+	src_vq->supports_requests = true;
+	src_vq->requires_requests = true;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->bidirectional = true;
+	dst_vq->drv_priv = ctx;
+	dst_vq->ops = &mtk_vdec_vb2_ops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->dma_attrs = DMA_ATTR_NO_KERNEL_MAPPING;
+	dst_vq->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &vdec->vdev_lock;
+	dst_vq->dev = vdec->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* ---------------- Stateless H.264 Controls ---------------- */
+
+static int mtk_vdec_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	if (ctrl->id == V4L2_CID_STATELESS_H264_SPS) {
+		const struct v4l2_ctrl_h264_sps *sps = ctrl->p_new.p_h264_sps;
+
+		if (sps->bit_depth_luma_minus8 != 0 ||
+		    sps->bit_depth_chroma_minus8 != 0 ||
+		    sps->chroma_format_idc != 1)
+			return -EINVAL;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops mtk_vdec_ctrl_ops = {
+	.try_ctrl = mtk_vdec_try_ctrl,
+};
+
+static const struct v4l2_ctrl_config mtk_vdec_ctrls[] = {
+	{
+		.id = V4L2_CID_STATELESS_H264_SPS,
+		.ops = &mtk_vdec_ctrl_ops,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_PPS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_SCALING_MATRIX,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_DECODE_PARAMS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_DECODE_MODE,
+		.min = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.def = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.max = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_START_CODE,
+		.min = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.def = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.max = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+	},
+	{
+		.id = V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+		.min = V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE,
+		.def = V4L2_MPEG_VIDEO_H264_PROFILE_MAIN,
+		.max = V4L2_MPEG_VIDEO_H264_PROFILE_HIGH,
+		.menu_skip_mask = BIT(V4L2_MPEG_VIDEO_H264_PROFILE_EXTENDED),
+	},
+	{
+		.id = V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+		.min = V4L2_MPEG_VIDEO_H264_LEVEL_1_0,
+		.def = V4L2_MPEG_VIDEO_H264_LEVEL_4_1,
+		.max = V4L2_MPEG_VIDEO_H264_LEVEL_5_1,
+	},
+};
+
+static int mtk_vdec_init_ctrls(struct mtk_vdec_ctx *ctx)
+{
+	unsigned int i;
+	int ret;
+
+	v4l2_ctrl_handler_init(&ctx->ctrl_hdl, ARRAY_SIZE(mtk_vdec_ctrls));
+
+	for (i = 0; i < ARRAY_SIZE(mtk_vdec_ctrls); i++) {
+		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, &mtk_vdec_ctrls[i], ctx);
+		if (ctx->ctrl_hdl.error) {
+			ret = ctx->ctrl_hdl.error;
+			goto err_free;
+		}
+	}
+
+	ret = v4l2_ctrl_handler_setup(&ctx->ctrl_hdl);
+	if (ret)
+		goto err_free;
+
+	ctx->fh.ctrl_handler = &ctx->ctrl_hdl;
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+	return ret;
+}
+
+/* ---------------- File Ops ---------------- */
+
+static int mtk_vdec_open(struct file *filp)
+{
+	struct mtk_vdec_dev *vdec = video_drvdata(filp);
+	struct mtk_vdec_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->vdec = vdec;
+	mtk_vdec_reset_fmts(ctx);
+	v4l2_fh_init(&ctx->fh, video_devdata(filp));
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(vdec->m2m_dev, ctx,
+					    mtk_vdec_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_free_ctx;
+	}
+
+	ret = mtk_vdec_init_ctrls(ctx);
+	if (ret)
+		goto err_release_m2m;
+
+	v4l2_fh_add(&ctx->fh, filp);
+	return 0;
+
+err_release_m2m:
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+err_free_ctx:
+	kfree(ctx);
+	return ret;
+}
+
+static int mtk_vdec_release(struct file *filp)
+{
+	struct mtk_vdec_ctx *ctx = file_to_ctx(filp);
+
+	v4l2_fh_del(&ctx->fh, filp);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return 0;
+}
+
+static const struct v4l2_file_operations mtk_vdec_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_vdec_open,
+	.release = mtk_vdec_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+/* ---------------- Platform Driver & PM ---------------- */
+
+static int mtk_vdec_v4l2_init(struct mtk_vdec_dev *vdec)
+{
+	int ret;
+
+	ret = v4l2_device_register(vdec->dev, &vdec->v4l2_dev);
+	if (ret)
+		return ret;
+
+	vdec->m2m_dev = v4l2_m2m_init(&mtk_vdec_m2m_ops);
+	if (IS_ERR(vdec->m2m_dev)) {
+		ret = PTR_ERR(vdec->m2m_dev);
+		goto err_unreg_v4l2;
+	}
+
+	vdec->mdev.dev = vdec->dev;
+	strscpy(vdec->mdev.model, MTK_VDEC_DRV_NAME, sizeof(vdec->mdev.model));
+	strscpy(vdec->mdev.bus_info, "platform:" MTK_VDEC_DRV_NAME,
+		sizeof(vdec->mdev.bus_info));
+	media_device_init(&vdec->mdev);
+	vdec->mdev.ops = &mtk_vdec_media_ops;
+	vdec->v4l2_dev.mdev = &vdec->mdev;
+
+	vdec->vdev.lock = &vdec->vdev_lock;
+	vdec->vdev.v4l2_dev = &vdec->v4l2_dev;
+	vdec->vdev.fops = &mtk_vdec_fops;
+	vdec->vdev.release = video_device_release_empty;
+	vdec->vdev.vfl_dir = VFL_DIR_M2M;
+	vdec->vdev.device_caps = V4L2_CAP_STREAMING |
+				 V4L2_CAP_VIDEO_M2M_MPLANE;
+	vdec->vdev.ioctl_ops = &mtk_vdec_ioctl_ops;
+	video_set_drvdata(&vdec->vdev, vdec);
+	strscpy(vdec->vdev.name, MTK_VDEC_DRV_NAME, sizeof(vdec->vdev.name));
+
+	ret = video_register_device(&vdec->vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_cleanup_mc;
+
+	ret = v4l2_m2m_register_media_controller(vdec->m2m_dev, &vdec->vdev,
+						 MEDIA_ENT_F_PROC_VIDEO_DECODER);
+	if (ret)
+		goto err_unreg_vdev;
+
+	ret = media_device_register(&vdec->mdev);
+	if (ret)
+		goto err_unreg_mc;
+
+	return 0;
+
+err_unreg_mc:
+	v4l2_m2m_unregister_media_controller(vdec->m2m_dev);
+err_unreg_vdev:
+	video_unregister_device(&vdec->vdev);
+err_cleanup_mc:
+	media_device_cleanup(&vdec->mdev);
+	v4l2_m2m_release(vdec->m2m_dev);
+err_unreg_v4l2:
+	v4l2_device_unregister(&vdec->v4l2_dev);
+	return ret;
+}
+
+static void mtk_vdec_v4l2_cleanup(struct mtk_vdec_dev *vdec)
+{
+	media_device_unregister(&vdec->mdev);
+	v4l2_m2m_unregister_media_controller(vdec->m2m_dev);
+	video_unregister_device(&vdec->vdev);
+	media_device_cleanup(&vdec->mdev);
+	v4l2_m2m_release(vdec->m2m_dev);
+	v4l2_device_unregister(&vdec->v4l2_dev);
+}
+
+static int mtk_vdec_probe(struct platform_device *pdev)
+{
+	struct mtk_vdec_dev *vdec;
+	unsigned int i;
+	int ret;
+
+	vdec = devm_kzalloc_obj(&pdev->dev, *vdec);
+	if (!vdec)
+		return -ENOMEM;
+
+	vdec->dev = &pdev->dev;
+	platform_set_drvdata(pdev, vdec);
+	mutex_init(&vdec->vdev_lock);
+	INIT_DELAYED_WORK(&vdec->watchdog_work, mtk_vdec_watchdog_work);
+
+	vdec->gcon = devm_platform_ioremap_resource_byname(pdev, "gcon");
+	if (IS_ERR(vdec->gcon))
+		return PTR_ERR(vdec->gcon);
+
+	vdec->core = devm_platform_ioremap_resource_byname(pdev, "core");
+	if (IS_ERR(vdec->core))
+		return PTR_ERR(vdec->core);
+
+	vdec->vdecsys = syscon_regmap_lookup_by_phandle(pdev->dev.of_node,
+							"mediatek,vdecsys");
+	if (IS_ERR(vdec->vdecsys))
+		return dev_err_probe(&pdev->dev, PTR_ERR(vdec->vdecsys),
+				     "Failed to get mediatek,vdecsys syscon\n");
+
+	vdec->num_clks = ARRAY_SIZE(mtk_vdec_clk_names);
+	vdec->clks = devm_kcalloc(&pdev->dev, vdec->num_clks,
+				  sizeof(*vdec->clks), GFP_KERNEL);
+	if (!vdec->clks)
+		return -ENOMEM;
+
+	for (i = 0; i < vdec->num_clks; i++)
+		vdec->clks[i].id = mtk_vdec_clk_names[i];
+
+	ret = devm_clk_bulk_get(&pdev->dev, vdec->num_clks, vdec->clks);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "Failed to get clocks\n");
+
+	if (IS_ENABLED(CONFIG_ARCH_DMA_ADDR_T_64BIT) &&
+	    device_iommu_mapped(&pdev->dev))
+		ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(34));
+	else
+		ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to set DMA mask\n");
+
+	vb2_dma_contig_set_max_seg_size(&pdev->dev, DMA_BIT_MASK(32));
+
+	vdec->irq = platform_get_irq(pdev, 0);
+	if (vdec->irq < 0)
+		return vdec->irq;
+
+	ret = devm_request_threaded_irq(&pdev->dev, vdec->irq, NULL,
+					mtk_vdec_irq_thread, IRQF_ONESHOT,
+					dev_name(&pdev->dev), vdec);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to request VDEC IRQ\n");
+
+	pm_runtime_set_autosuspend_delay(&pdev->dev, 100);
+	pm_runtime_use_autosuspend(&pdev->dev);
+	pm_runtime_enable(&pdev->dev);
+
+	ret = mtk_vdec_v4l2_init(vdec);
+	if (ret)
+		goto err_pm_disable;
+
+	dev_info(&pdev->dev,
+		 "MT6789 stateless H.264 video decoder registered as /dev/%s\n",
+		 video_device_node_name(&vdec->vdev));
+	return 0;
+
+err_pm_disable:
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	return ret;
+}
+
+static void mtk_vdec_remove(struct platform_device *pdev)
+{
+	struct mtk_vdec_dev *vdec = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&vdec->watchdog_work);
+	mtk_vdec_v4l2_cleanup(vdec);
+	pm_runtime_disable(&pdev->dev);
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+}
+
+static int mtk_vdec_runtime_resume(struct device *dev)
+{
+	struct mtk_vdec_dev *vdec = dev_get_drvdata(dev);
+
+	return clk_bulk_prepare_enable(vdec->num_clks, vdec->clks);
+}
+
+static int mtk_vdec_runtime_suspend(struct device *dev)
+{
+	struct mtk_vdec_dev *vdec = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(vdec->num_clks, vdec->clks);
+	return 0;
+}
+
+static const struct dev_pm_ops mtk_vdec_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+	RUNTIME_PM_OPS(mtk_vdec_runtime_suspend, mtk_vdec_runtime_resume, NULL)
+};
+
+static const struct of_device_id mtk_vdec_of_match[] = {
+	{ .compatible = "mediatek,mt6789-vcodec-dec" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mtk_vdec_of_match);
+
+static struct platform_driver mtk_vdec_driver = {
+	.probe = mtk_vdec_probe,
+	.remove = mtk_vdec_remove,
+	.driver = {
+		.name = MTK_VDEC_DRV_NAME,
+		.of_match_table = mtk_vdec_of_match,
+		.pm = pm_ptr(&mtk_vdec_pm_ops),
+	},
+};
+module_platform_driver(mtk_vdec_driver);
+
