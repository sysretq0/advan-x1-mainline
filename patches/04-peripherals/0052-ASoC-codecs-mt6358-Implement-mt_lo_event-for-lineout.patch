From 8a16ee493c1399f6d948a288f42bb7d33a91e2d0 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Thu, 26 Nov 2026 23:31:42 +0700
Subject: [PATCH] ASoC: codecs: mt6358: Implement mt_lo_event for lineout
 playback

The upstream mt6358 codec driver registers "LOL Mux" as a plain DAPM
mux without a power-sequencing event handler, unlike "HPL Mux" and
"RCV Mux". As a result, playing audio through the standalone LINEOUT L
path (e.g. driving an external analog speaker amplifier such as FS1599)
never powers on the charge pump (NCP), 1.5V cap-less LDOs, -1.2V NV
regulator, IBIST, decoder clock (AUDDEC_ANA_CON13), Audio DAC R
(AUDDEC_ANA_CON0), or LO driver bias (AUDDEC_ANA_CON7 bit 1), leaving
LINEOUT completely silent.

Make lo_in_mux_map_enum a virtual SND_SOC_NOPM control (matching the HP
and RCV muxes), implement mt_lo_event() with the MT6358/MT6366 lineout
power-up/down sequence routing Audio DAC R to LOL (AUDDEC_ANA_CON7[3:2]
= 0x1), and attach it to the "LOL Mux" DAPM widget.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 sound/soc/codecs/mt6358.c | 150 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 146 insertions(+), 4 deletions(-)

diff --git a/sound/soc/codecs/mt6358.c b/sound/soc/codecs/mt6358.c
index 42b131d..a20899f 100644
--- a/sound/soc/codecs/mt6358.c
+++ b/sound/soc/codecs/mt6358.c
@@ -542,8 +542,8 @@ static int lo_in_mux_map_value[] = {
 };
 
 static SOC_VALUE_ENUM_SINGLE_DECL(lo_in_mux_map_enum,
-				  MT6358_AUDDEC_ANA_CON7,
-				  RG_AUDLOLMUXINPUTSEL_VAUDP15_SFT,
+				  SND_SOC_NOPM,
+				  0,
 				  RG_AUDLOLMUXINPUTSEL_VAUDP15_MASK,
 				  lo_in_mux_map,
 				  lo_in_mux_map_value);
@@ -1466,6 +1466,144 @@ static int mt_rcv_event(struct snd_soc_dapm_widget *w,
 	return 0;
 }
 
+static int mt_lo_event(struct snd_soc_dapm_widget *w,
+		       struct snd_kcontrol *kcontrol,
+		       int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6358_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	dev_dbg(priv->dev, "%s(), event 0x%x, mux %u\n",
+		__func__, event,
+		snd_soc_dapm_kcontrol_get_value(w->kcontrols[0]));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		/* Reduce ESD resistance of AU_REFN */
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON2, 0x4000);
+
+		/* Turn on DA_600K_NCP_VA18 */
+		regmap_write(priv->regmap, MT6358_AUDNCP_CLKDIV_CON1, 0x0001);
+		/* Set NCP clock as 604kHz (26MHz / 43) */
+		regmap_write(priv->regmap, MT6358_AUDNCP_CLKDIV_CON2, 0x002c);
+		/* Toggle RG_DIVCKS_CHG */
+		regmap_write(priv->regmap, MT6358_AUDNCP_CLKDIV_CON0, 0x0001);
+		/* Set NCP soft start mode as default mode: 100us */
+		regmap_write(priv->regmap, MT6358_AUDNCP_CLKDIV_CON4, 0x0003);
+		/* Enable NCP */
+		regmap_write(priv->regmap, MT6358_AUDNCP_CLKDIV_CON3, 0x0000);
+		usleep_range(250, 270);
+
+		/* Enable cap-less LDOs (1.5V) */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON14,
+				   0x1055, 0x1055);
+		/* Enable NV regulator (-1.2V) */
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON15, 0x0001);
+		usleep_range(100, 120);
+
+		/* Disable AUD_ZCD */
+		hp_zcd_disable(priv);
+
+		/* Disable lineout short-circuit protection */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLSCDISABLE_VAUDP15_MASK_SFT,
+				   RG_AUDLOLSCDISABLE_VAUDP15_MASK_SFT);
+
+		/* Set LO gain to -10dB */
+		regmap_write(priv->regmap, MT6358_ZCD_CON1, DL_GAIN_N_10DB_REG);
+
+		/* Enable IBIST and bias current optimization */
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON12, 0x0055);
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON11,
+				   0xff80, 0x4900);
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON12, 0x0055);
+
+		/* Set LO STB enhance circuits */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_LOOUTPUTSTBENH_VAUDP15_MASK_SFT,
+				   RG_LOOUTPUTSTBENH_VAUDP15_MASK_SFT);
+
+		/* Disable HP main CMFB loop and select default cap size */
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON9, 0x0000);
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON10, 0x0000);
+
+		/* Enable LO driver bias and core circuits */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLPWRUP_IBIAS_VAUDP15_MASK_SFT,
+				   RG_AUDLOLPWRUP_IBIAS_VAUDP15_MASK_SFT);
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLPWRUP_VAUDP15_MASK_SFT,
+				   RG_AUDLOLPWRUP_VAUDP15_MASK_SFT);
+
+		/* Apply configured lineout gain */
+		regmap_update_bits(priv->regmap, MT6358_ZCD_CON1,
+				   RG_AUDLOLGAIN_MASK_SFT,
+				   priv->ana_gain[AUDIO_ANALOG_VOLUME_LINEOUTL] <<
+				   RG_AUDLOLGAIN_SFT);
+		regmap_update_bits(priv->regmap, MT6358_ZCD_CON1,
+				   RG_AUDLORGAIN_MASK_SFT,
+				   priv->ana_gain[AUDIO_ANALOG_VOLUME_LINEOUTR] <<
+				   RG_AUDLORGAIN_SFT);
+
+		/* Enable AUD_CLK */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON13,
+				   0x1, 0x1);
+		/* Enable Audio DAC R */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON0,
+				   RG_AUDDACRPWRUP_VAUDP15_MASK_SFT |
+				   RG_AUD_DAC_PWR_UP_VA28_MASK_SFT,
+				   RG_AUDDACRPWRUP_VAUDP15_MASK_SFT |
+				   RG_AUD_DAC_PWR_UP_VA28_MASK_SFT);
+		/* Enable low-noise mode of DAC */
+		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON9, 0x0001);
+		/* Switch LOL MUX to audio DAC R */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLMUXINPUTSEL_VAUDP15_MASK_SFT,
+				   0x1 << RG_AUDLOLMUXINPUTSEL_VAUDP15_SFT);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		/* Switch LOL MUX to open */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLMUXINPUTSEL_VAUDP15_MASK_SFT, 0);
+		/* Disable Audio DAC R */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON0,
+				   RG_AUDDACRPWRUP_VAUDP15_MASK_SFT |
+				   RG_AUD_DAC_PWR_UP_VA28_MASK_SFT, 0);
+		/* Disable AUD_CLK */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON13,
+				   0x1, 0x0);
+		/* Reduce LO gain to minimum */
+		regmap_write(priv->regmap, MT6358_ZCD_CON1, DL_GAIN_N_40DB_REG);
+		/* Disable LO driver core and bias circuits */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLPWRUP_VAUDP15_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON7,
+				   RG_AUDLOLPWRUP_IBIAS_VAUDP15_MASK_SFT, 0);
+		/* Reset HP CMFB loop */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON9,
+				   0xff << 8, 0);
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON9,
+				   0xff << 8, 0x2 << 8);
+		/* Disable IBIST */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON12,
+				   0x1 << 8, 0x1 << 8);
+		/* Disable NV regulator (-1.2V) */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON15,
+				   0x1, 0x0);
+		/* Disable cap-less LDOs (1.5V) */
+		regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON14,
+				   0x1055, 0x0);
+		/* Disable NCP */
+		regmap_update_bits(priv->regmap, MT6358_AUDNCP_CLKDIV_CON3,
+				   0x1, 0x1);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
 static int mt_aif_out_event(struct snd_soc_dapm_widget *w,
 			    struct snd_kcontrol *kcontrol,
 			    int event)
@@ -2030,7 +2168,11 @@ static const struct snd_soc_dapm_widget mt6358_dapm_widgets[] = {
 	SND_SOC_DAPM_DAC("DACR", NULL, SND_SOC_NOPM, 0, 0),
 
 	/* LOL */
-	SND_SOC_DAPM_MUX("LOL Mux", SND_SOC_NOPM, 0, 0, &lo_in_mux_control),
+	SND_SOC_DAPM_MUX_E("LOL Mux", SND_SOC_NOPM, 0, 0,
+			   &lo_in_mux_control,
+			   mt_lo_event,
+			   SND_SOC_DAPM_PRE_PMU |
+			   SND_SOC_DAPM_PRE_PMD),
 
 	SND_SOC_DAPM_SUPPLY("LO Stability Enh", MT6358_AUDDEC_ANA_CON7,
 			    RG_LOOUTPUTSTBENH_VAUDP15_SFT, 0, NULL, 0),
@@ -2217,7 +2359,7 @@ static const struct snd_soc_dapm_route mt6358_dapm_routes[] = {
 	{"DACR", NULL, "DL Power Supply"},
 
 	/* Lineout Path */
-	{"LOL Mux", "Playback", "DACL"},
+	{"LOL Mux", "Playback", "DACR"},
 
 	{"LOL Buffer", NULL, "LOL Mux"},
 	{"LOL Buffer", NULL, "LO Stability Enh"},
-- 
2.55.0

