From 5186fe8e792a78ed007a3b90008913bb4150f945 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Fri, 27 Nov 2026 00:57:32 +0700
Subject: [PATCH] net: wwan: mtk_ccci: Quietly drain unsolicited IPC, IMSA, and
 WOA RX channels

During LTE boot and registration on MT6789, the Gen95 modem sends
unsolicited packets on logical channels 34 (CCCI_CH_IPC_RX, AP_MOD_WMT),
38 (CCCI_CH_IPC_UART_RX, AGPS), 57 (CCCI_CH_IMSA_DL, IMS), and 171
(CCCI_CH_WOA_RX, Wi-Fi offload). Without those Android vendor daemons
running, these fall through to the unhandled warning path and dump hex
into dmesg.

Define those channel IDs and drain them quietly at debug level
alongside CCCI_CH_IMSM_RX (169).

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/net/wwan/mtk_ccci/mtk_ccci.h      | 4 ++++
 drivers/net/wwan/mtk_ccci/mtk_ccci_core.c | 8 ++++++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci.h b/drivers/net/wwan/mtk_ccci/mtk_ccci.h
index aa57072..9b601e9 100644
--- a/drivers/net/wwan/mtk_ccci/mtk_ccci.h
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci.h
@@ -109,9 +109,13 @@
 #define CCCI_CH_FS_TX			15
 #define CCCI_CH_RPC_RX			32
 #define CCCI_CH_RPC_TX			33
+#define CCCI_CH_IPC_RX			34
+#define CCCI_CH_IPC_UART_RX		38
+#define CCCI_CH_IMSA_DL			57
 #define CCCI_CH_STATUS_RX		67
 #define CCCI_CH_STATUS_TX		68
 #define CCCI_CH_IMSM_RX			169
+#define CCCI_CH_WOA_RX			171
 
 /* Control channel message IDs */
 #define CCCI_MD_INIT_START_BOOT		0x0
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c
index 8ad116b..2b7cf44 100644
--- a/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c
@@ -885,9 +885,13 @@ static void mtk_ccci_drain_queue(struct mtk_ccci_dev *ccci, u32 q)
 		case CCCI_CH_UART2_RX:
 			mtk_ccci_at_rx(ccci, ccci->rx_buf, ret);
 			break;
+		case CCCI_CH_IPC_RX:
+		case CCCI_CH_IPC_UART_RX:
+		case CCCI_CH_IMSA_DL:
 		case CCCI_CH_IMSM_RX:
-			dev_dbg(ccci->dev, "CCIF Q%u IMSM RX len=%d\n",
-				q, ret);
+		case CCCI_CH_WOA_RX:
+			dev_dbg(ccci->dev, "CCIF Q%u ch=%u RX len=%d\n",
+				q, hdr.channel, ret);
 			break;
 		default:
 			if (__ratelimit(&ccci->unhandled_rs)) {
-- 
2.55.0

