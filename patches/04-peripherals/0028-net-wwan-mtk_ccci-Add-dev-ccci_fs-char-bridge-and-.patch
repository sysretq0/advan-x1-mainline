diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_fs.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_fs.c
new file mode 100644
index 000000000..9dd6d0ca2
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_fs.c
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 CCCI /dev/ccci_fs packet bridge (CCIF0 Q4 ch=14 <-> ch=15).
+ *
+ * Implements PORT_F_USER_HEADER semantics matching Gen95 ccci_fsd: userspace
+ * reads and writes complete packets starting with the 16-byte mtk_ccci_header.
+ * On TX, userspace hdr.data[0] (including bit 31 continuation flag) and
+ * hdr.reserved (concurrent request slot 0..4) are preserved verbatim; the
+ * kernel fills hdr.channel (15), hdr.data[1] (length), per-channel seq_num,
+ * and Gen95 assert_bit polarity.
+ *
+ * Copyright (c) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/poll.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "mtk_ccci.h"
+
+struct mtk_ccci_fs_pkt {
+	struct list_head node;
+	u32 len;
+	u8 data[] __counted_by(len);
+};
+
+static void mtk_ccci_fs_purge_rx(struct mtk_ccci_dev *ccci)
+{
+	struct mtk_ccci_fs_pkt *pkt, *tmp;
+	unsigned long flags;
+	LIST_HEAD(local);
+
+	spin_lock_irqsave(&ccci->fs_rx_lock, flags);
+	list_splice_init(&ccci->fs_rx_list, &local);
+	WRITE_ONCE(ccci->fs_rx_qlen, 0);
+	spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+
+	list_for_each_entry_safe(pkt, tmp, &local, node) {
+		list_del(&pkt->node);
+		kfree(pkt);
+	}
+}
+
+void mtk_ccci_fs_rx(struct mtk_ccci_dev *ccci, const u8 *data, u32 len)
+{
+	struct mtk_ccci_fs_pkt *pkt;
+	unsigned long flags;
+
+	if (!data || len < sizeof(struct mtk_ccci_header) ||
+	    len > MTK_CCCI_FS_MAX_PKT) {
+		dev_warn_ratelimited(ccci->dev,
+				     "ccci_fs RX bad packet len=%u\n", len);
+		return;
+	}
+
+	pkt = kmalloc(struct_size(pkt, data, len), GFP_KERNEL);
+	if (!pkt)
+		return;
+
+	pkt->len = len;
+	memcpy(pkt->data, data, len);
+
+	spin_lock_irqsave(&ccci->fs_rx_lock, flags);
+	if (ccci->fs_rx_qlen >= MTK_CCCI_FS_RX_QUEUE_MAX) {
+		spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+		dev_warn_ratelimited(ccci->dev,
+				     "ccci_fs RX queue full (%u), dropping\n",
+				     MTK_CCCI_FS_RX_QUEUE_MAX);
+		kfree(pkt);
+		return;
+	}
+	list_add_tail(&pkt->node, &ccci->fs_rx_list);
+	WRITE_ONCE(ccci->fs_rx_qlen, ccci->fs_rx_qlen + 1);
+	spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+
+	atomic_inc(&ccci->fs_rx_count);
+	wake_up_interruptible(&ccci->fs_rx_wq);
+}
+
+static int mtk_ccci_fs_open(struct inode *inode, struct file *filp)
+{
+	struct miscdevice *mdev = filp->private_data;
+	struct mtk_ccci_dev *ccci = container_of(mdev, struct mtk_ccci_dev,
+						 fs_miscdev);
+
+	if (atomic_cmpxchg(&ccci->fs_open, 0, 1) != 0)
+		return -EBUSY;
+
+	filp->private_data = ccci;
+	nonseekable_open(inode, filp);
+	return 0;
+}
+
+static int mtk_ccci_fs_release(struct inode *inode, struct file *filp)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+
+	mtk_ccci_fs_purge_rx(ccci);
+	atomic_set(&ccci->fs_open, 0);
+	return 0;
+}
+
+static ssize_t mtk_ccci_fs_read(struct file *filp, char __user *buf,
+				size_t count, loff_t *ppos)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+	struct mtk_ccci_fs_pkt *pkt;
+	unsigned long flags;
+	ssize_t ret;
+
+	for (;;) {
+		spin_lock_irqsave(&ccci->fs_rx_lock, flags);
+		pkt = list_first_entry_or_null(&ccci->fs_rx_list,
+					       struct mtk_ccci_fs_pkt, node);
+		if (pkt) {
+			if (count < pkt->len) {
+				spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+				return -EMSGSIZE;
+			}
+			list_del(&pkt->node);
+			WRITE_ONCE(ccci->fs_rx_qlen, ccci->fs_rx_qlen - 1);
+			spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+			break;
+		}
+		spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+
+		if (READ_ONCE(ccci->fs_closing))
+			return -ENODEV;
+
+		if (filp->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+
+		ret = wait_event_interruptible(ccci->fs_rx_wq,
+					       READ_ONCE(ccci->fs_rx_qlen) > 0 ||
+					       READ_ONCE(ccci->fs_closing));
+		if (ret)
+			return ret;
+	}
+
+	if (copy_to_user(buf, pkt->data, pkt->len))
+		ret = -EFAULT;
+	else
+		ret = pkt->len;
+
+	kfree(pkt);
+	return ret;
+}
+
+static ssize_t mtk_ccci_fs_write(struct file *filp, const char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+	struct mtk_ccci_header *hdr;
+	enum mtk_ccci_state st;
+	u8 *kbuf;
+	int ret, tries;
+
+	if (count < sizeof(*hdr) || count > MTK_CCCI_FS_MAX_PKT)
+		return -EINVAL;
+
+	st = READ_ONCE(ccci->state);
+	if (st != MTK_CCCI_STATE_HS1_DONE && st != MTK_CCCI_STATE_READY &&
+	    st != MTK_CCCI_STATE_EXCEPTION)
+		return -ENODEV;
+
+	kbuf = memdup_user(buf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	/*
+	 * PORT_F_USER_HEADER: preserve hdr->data[0] (bit 31 continuation flag)
+	 * and hdr->reserved (slot 0..4) from userspace verbatim; enforce
+	 * channel=15 and data[1]=count, while mtk_ccci_tx_send() fills ch=15's
+	 * monotonic seq_num and Gen95 assert_bit.
+	 */
+	hdr = (struct mtk_ccci_header *)kbuf;
+	hdr->channel = CCCI_CH_FS_TX;
+	hdr->data[1] = (u32)count;
+
+	for (tries = 0; tries < 200; tries++) {
+		ret = mtk_ccci_tx_send(ccci, MTK_CCIF_FS_QUEUE, kbuf, count);
+		if (ret != -ENOSPC || (filp->f_flags & O_NONBLOCK))
+			break;
+		usleep_range(500, 1000);
+	}
+
+	kfree(kbuf);
+	if (ret)
+		return ret == -ENOSPC ? -EAGAIN : ret;
+
+	atomic_inc(&ccci->fs_tx_count);
+	return count;
+}
+
+static __poll_t mtk_ccci_fs_poll(struct file *filp, poll_table *wait)
+{
+	struct mtk_ccci_dev *ccci = filp->private_data;
+	__poll_t mask = EPOLLOUT | EPOLLWRNORM;
+	unsigned long flags;
+
+	poll_wait(filp, &ccci->fs_rx_wq, wait);
+
+	spin_lock_irqsave(&ccci->fs_rx_lock, flags);
+	if (ccci->fs_rx_qlen > 0)
+		mask |= EPOLLIN | EPOLLRDNORM;
+	spin_unlock_irqrestore(&ccci->fs_rx_lock, flags);
+
+	return mask;
+}
+
+static const struct file_operations mtk_ccci_fs_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_ccci_fs_open,
+	.release = mtk_ccci_fs_release,
+	.read = mtk_ccci_fs_read,
+	.write = mtk_ccci_fs_write,
+	.poll = mtk_ccci_fs_poll,
+};
+
+int mtk_ccci_fs_register(struct mtk_ccci_dev *ccci)
+{
+	spin_lock_init(&ccci->fs_rx_lock);
+	INIT_LIST_HEAD(&ccci->fs_rx_list);
+	init_waitqueue_head(&ccci->fs_rx_wq);
+	atomic_set(&ccci->fs_open, 0);
+
+	ccci->fs_miscdev.minor = MISC_DYNAMIC_MINOR;
+	ccci->fs_miscdev.name = "ccci_fs";
+	ccci->fs_miscdev.fops = &mtk_ccci_fs_fops;
+	ccci->fs_miscdev.parent = ccci->dev;
+
+	return misc_register(&ccci->fs_miscdev);
+}
+
+void mtk_ccci_fs_unregister(struct mtk_ccci_dev *ccci)
+{
+	WRITE_ONCE(ccci->fs_closing, true);
+	wake_up_interruptible_all(&ccci->fs_rx_wq);
+	misc_deregister(&ccci->fs_miscdev);
+	mtk_ccci_fs_purge_rx(ccci);
+}
