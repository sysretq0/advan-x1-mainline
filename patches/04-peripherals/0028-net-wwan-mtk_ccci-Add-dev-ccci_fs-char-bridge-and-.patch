+
+static ssize_t boot_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct mtk_ccci_dev *ccci = dev_get_drvdata(dev);
+	bool val;
+	int ret;
+
+	ret = kstrtobool(buf, &val);
+	if (ret)
+		return ret;
+	if (!val)
+		return -EINVAL;
+
+	if (READ_ONCE(ccci->state) != MTK_CCCI_STATE_PARKED)
+		return -EBUSY;
+
+	if (atomic_cmpxchg(&ccci->boot_triggered, 0, 1) != 0)
+		return -EBUSY;
+
+	schedule_work(&ccci->boot_work);
+	return count;
+}
