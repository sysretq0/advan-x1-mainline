From a53167d38f1e7ac36d54c8de5d09b0a6151dbeb8 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:29:45 +0000
Subject: [PATCH] thermal/drivers/mediatek/lvts: Add per-SoC zero-MSR guard and
 start settle delay

Gate the raw-zero MSR -EAGAIN guard in lvts_get_temp() and the
post-enable settle sleep in lvts_ctrl_start() behind per-SoC fields
in struct lvts_data (skip_zero_msr and start_settle_us), leaving all
other MediaTek SoCs untouched.

Bound consecutive raw-zero retries per sensor so a permanently dead
sensor returns -EIO rather than masking thermal faults indefinitely.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/thermal/mediatek/lvts_thermal.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/thermal/mediatek/lvts_thermal.c b/drivers/thermal/mediatek/lvts_thermal.c
index 350fffd..81df792 100644
--- a/drivers/thermal/mediatek/lvts_thermal.c
+++ b/drivers/thermal/mediatek/lvts_thermal.c
@@ -160,6 +160,8 @@ struct lvts_data {
 	int gt_calib_bit_offset;
 	unsigned int def_calibration;
 	u16 msr_offset;
+	u16 start_settle_us;
+	bool skip_zero_msr;
 };
 
 struct lvts_sensor {
@@ -170,6 +172,7 @@ struct lvts_sensor {
 	int dt_id;
 	int low_thresh;
 	int high_thresh;
+	u8 zero_msr_count;
 };
 
 struct lvts_ctrl {
@@ -376,6 +379,17 @@ static int lvts_get_temp(struct thermal_zone_device *tz, int *temp)
 	if (rc)
 		return -EAGAIN;
 
+	if (lvts_data->skip_zero_msr) {
+		if (!(value & 0xFFFF)) {
+			if (lvts_sensor->zero_msr_count < 4) {
+				lvts_sensor->zero_msr_count++;
+				return -EAGAIN;
+			}
+			return -EIO;
+		}
+		lvts_sensor->zero_msr_count = 0;
+	}
+
 	*temp = lvts_raw_to_temp(value, lvts_data);
 
 	return 0;
@@ -1367,6 +1381,10 @@ static int lvts_ctrl_start(struct device *dev, struct lvts_ctrl *lvts_ctrl)
 		writel(sensor_map | BIT(9), LVTS_MONCTL0(lvts_ctrl->base));
 	}
 
+	if (sensor_map && lvts_ctrl->lvts_data->start_settle_us)
+		usleep_range(lvts_ctrl->lvts_data->start_settle_us,
+			     lvts_ctrl->lvts_data->start_settle_us + 1000);
+
 	return 0;
 }
 
