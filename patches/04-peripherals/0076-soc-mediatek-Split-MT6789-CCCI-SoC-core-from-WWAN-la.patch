+	}
 
 	enable_irq(ccci->ccif_irq0);
 	enable_irq(ccci->ccif_irq1);
@@ -1395,8 +1487,13 @@ static void mtk_ccci_boot_work(struct work_struct *work)
 	}
 
 	if (READ_ONCE(ccci->state) == MTK_CCCI_STATE_READY) {
