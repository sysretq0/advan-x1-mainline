 		}
 		if (exp) {
@@ -1347,10 +1430,19 @@ static void mtk_ccci_boot_work(struct work_struct *work)
 	 * Start DPMAIF v1 hardware and SMEM UL rings after MD MTCMOS is ON
 	 * (bus protection released) and before releasing MD boot slave.
 	 */
-	ret = mtk_ccci_dpmaif_start(ccci);
-	if (ret)
-		dev_warn(ccci->dev, "DPMAIF start failed (%d); continuing without IP data plane\n",
-			 ret);
+	scoped_guard(mutex, &ccci->wwan_lock) {
