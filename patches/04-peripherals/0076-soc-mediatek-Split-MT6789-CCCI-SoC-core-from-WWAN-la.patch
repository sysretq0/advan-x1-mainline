 /* Gen95 (MT6789 / MT6295M) CCIF0 normal and exception ringbuffer sizes */
 static const u32 mtk_ccif_rx_sz[MTK_CCIF_QUEUE_NUM] = {
@@ -296,6 +298,74 @@ int mtk_ccci_tx_send(struct mtk_ccci_dev *ccci, u32 q, void *buf, u32 len)
 
 	return 0;
 }
+EXPORT_SYMBOL_GPL(mtk_ccci_tx_send);
+
+void mtk_ccci_register_wwan_ops(struct mtk_ccci_dev *ccci,
+				const struct mtk_ccci_wwan_ops *ops)
+{
+	guard(mutex)(&ccci->wwan_lock);
+	rcu_assign_pointer(ccci->wwan_ops, ops);
+}
+EXPORT_SYMBOL_GPL(mtk_ccci_register_wwan_ops);
+
+void mtk_ccci_unregister_wwan_ops(struct mtk_ccci_dev *ccci)
+{
+	scoped_guard(mutex, &ccci->wwan_lock)
+		rcu_assign_pointer(ccci->wwan_ops, NULL);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL_GPL(mtk_ccci_unregister_wwan_ops);
+
+static void mtk_ccci_wwan_aux_release(struct device *dev)
+{
+	struct auxiliary_device *adev = to_auxiliary_dev(dev);
+	struct mtk_ccci_aux_dev *aux =
+		container_of(adev, struct mtk_ccci_aux_dev, adev);
+
+	kfree(aux);
+}
+
+static void mtk_ccci_wwan_aux_register(struct mtk_ccci_dev *ccci)
+{
+	struct mtk_ccci_aux_dev *aux;
+	int ret;
+
+	aux = kzalloc_obj(*aux);
+	if (!aux)
+		return;
+
+	aux->ccci = ccci;
+	aux->adev.name = MTK_CCCI_WWAN_AUX_NAME;
+	aux->adev.id = 0;
+	aux->adev.dev.parent = ccci->dev;
+	aux->adev.dev.release = mtk_ccci_wwan_aux_release;
+
+	ret = auxiliary_device_init(&aux->adev);
+	if (ret) {
+		kfree(aux);
+		dev_warn(ccci->dev, "WWAN auxiliary init failed (%d)\n", ret);
+		return;
+	}
+
+	ret = auxiliary_device_add(&aux->adev);
+	if (ret) {
+		auxiliary_device_uninit(&aux->adev);
+		dev_warn(ccci->dev, "WWAN auxiliary add failed (%d)\n", ret);
+		return;
+	}
+
+	ccci->wwan_aux = aux;
+}
+
+static void mtk_ccci_wwan_aux_unregister(struct mtk_ccci_dev *ccci)
+{
+	if (!ccci->wwan_aux)
+		return;
+
+	auxiliary_device_delete(&ccci->wwan_aux->adev);
+	auxiliary_device_uninit(&ccci->wwan_aux->adev);
+	ccci->wwan_aux = NULL;
+}
 
