--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_wwan_drv.c
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6789 CCCI WWAN auxiliary driver.
+ *
+ * Binds to the auxiliary device exposed by the MediaTek SoC CCCI core
+ * (drivers/soc/mediatek/mtk_ccci/) and attaches the Linux WWAN AT control
+ * port and DPMAIF v1 + SMEM UL network data plane.
+ *
+ * Copyright (c) 2026 sysretq0 <sysretq0@proton.me>
+ */
+
+#include <linux/auxiliary_bus.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/soc/mediatek/mtk_ccci.h>
+
+#include "mtk_ccci_wwan.h"
+
+static void mtk_ccci_wwan_register_ports(struct mtk_ccci_dev *ccci)
+{
+	mtk_ccci_at_register(ccci);
+	mtk_ccci_dpmaif_register_wwan(ccci);
+}
+
+static void mtk_ccci_wwan_quiesce(struct mtk_ccci_dev *ccci)
+{
+	mtk_ccci_dpmaif_uninit(ccci);
+	mtk_ccci_at_unregister(ccci);
+}
+
+static const struct mtk_ccci_wwan_ops mtk_ccci_wwan_ops = {
+	.at_rx = mtk_ccci_at_rx,
+	.smem_tx_irq = mtk_ccci_dpmaif_smem_tx_irq,
+	.dpmaif_start = mtk_ccci_dpmaif_start,
+	.register_ports = mtk_ccci_wwan_register_ports,
+	.quiesce = mtk_ccci_wwan_quiesce,
+	.get_default_if_id = mtk_ccci_dpmaif_get_default_if_id,
+	.set_default_if_id = mtk_ccci_dpmaif_set_default_if_id,
+	.set_irq_wake = mtk_ccci_dpmaif_set_irq_wake,
+	.suspend = mtk_ccci_dpmaif_suspend,
+	.resume = mtk_ccci_dpmaif_resume,
+};
+
+static int mtk_ccci_wwan_probe(struct auxiliary_device *adev,
+			       const struct auxiliary_device_id *id)
+{
+	struct mtk_ccci_aux_dev *aux =
+		container_of(adev, struct mtk_ccci_aux_dev, adev);
+	struct mtk_ccci_dev *ccci = aux->ccci;
+	int ret;
+
+	ret = mtk_ccci_dpmaif_init(ccci);
+	if (ret)
+		dev_warn(ccci->dev,
+			 "DPMAIF init failed (%d); continuing without IP data plane\n",
+			 ret);
+
+	mtk_ccci_register_wwan_ops(ccci, &mtk_ccci_wwan_ops);
+
+	if (READ_ONCE(ccci->state) == MTK_CCCI_STATE_READY) {
+		ret = mtk_ccci_dpmaif_start(ccci);
+		if (ret)
+			dev_warn(ccci->dev, "DPMAIF start failed (%d)\n", ret);
+		mtk_ccci_wwan_register_ports(ccci);
+	}
+
+	return 0;
+}
+
+static void mtk_ccci_wwan_remove(struct auxiliary_device *adev)
+{
+	struct mtk_ccci_aux_dev *aux =
+		container_of(adev, struct mtk_ccci_aux_dev, adev);
+	struct mtk_ccci_dev *ccci = aux->ccci;
+
+	mtk_ccci_unregister_wwan_ops(ccci);
+	mtk_ccci_wwan_quiesce(ccci);
+}
+
+static const struct auxiliary_device_id mtk_ccci_wwan_id_table[] = {
+	{ .name = MTK_CCCI_WWAN_AUX_ID },
+	{ }
+};
+MODULE_DEVICE_TABLE(auxiliary, mtk_ccci_wwan_id_table);
+
+static struct auxiliary_driver mtk_ccci_wwan_driver = {
+	.name = "wwan",
+	.probe = mtk_ccci_wwan_probe,
+	.remove = mtk_ccci_wwan_remove,
+	.id_table = mtk_ccci_wwan_id_table,
+};
+module_auxiliary_driver(mtk_ccci_wwan_driver);
+
+MODULE_AUTHOR("sysretq0 <sysretq0@proton.me>");
+MODULE_DESCRIPTION("MediaTek MT6789 CCCI WWAN AT port and DPMAIF data-plane driver");
+MODULE_LICENSE("GPL");
