From b0513a3f3a526236a667afde7af9ec67786d7457 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:15:47 +0000
Subject: [PATCH] dt-bindings: input: touchscreen: Add Chipone ICNL9922C SPI
 TDDI binding

Add the devicetree binding for the Chipone ICNL9922C SPI TDDI
touchscreen controller using the Chipone TCS protocol.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 .../touchscreen/chipone,icnl9922c-ts.yaml     | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/chipone,icnl9922c-ts.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/chipone,icnl9922c-ts.yaml b/Documentation/devicetree/bindings/input/touchscreen/chipone,icnl9922c-ts.yaml
new file mode 100644
index 0000000..da2baea
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/chipone,icnl9922c-ts.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/chipone,icnl9922c-ts.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Chipone ICNL9922C SPI TDDI Touchscreen Controller
+
+maintainers:
+  - Dmitry Torokhov <dmitry.torokhov@gmail.com>
+
+description: |
+  Chipone ICNL9922C Touch and Display Driver Integration (TDDI) capacitive
+  touchscreen controller connected over SPI using the Chipone TCS protocol.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+  - $ref: touchscreen.yaml#
+
+properties:
+  compatible:
+    const: chipone,icnl9922c-ts
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      Optional reset GPIO. Omit when the reset line is shared with and
+      controlled by the integrated MIPI-DSI TDDI display panel driver.
+
+  panel: true
+
+  spi-cpha: true
+  spi-cpol: true
+  spi-max-frequency: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "chipone,icnl9922c-ts";
+            reg = <0>;
+            spi-max-frequency = <3000000>;
+            interrupt-parent = <&pio>;
+            interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+            touchscreen-size-x = <1080>;
+            touchscreen-size-y = <2460>;
+        };
+    };
-- 
2.55.0

