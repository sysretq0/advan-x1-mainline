From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sat, 28 Nov 2026 14:12:00 +0700
Subject: [PATCH] dt-bindings: media: Add MediaTek MT6789 stateless video decoder

Document the MediaTek MT6789 (Helio G99) single-core hardware video
decoder (VDEC) block programmed via direct CPU MMIO without auxiliary
VPU/VCU firmware, using VDECSYS syscon, SMI LARB4 M4U ports, VDEC power
domain, and GIC SPI 458 interrupt.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../media/mediatek,mt6789-vcodec-dec.yaml     | 99 +++++++++++++++++++
 1 file changed, 99 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/mediatek,mt6789-vcodec-dec.yaml

diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6789-vcodec-dec.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6789-vcodec-dec.yaml
new file mode 100644
index 000000000000..a9a4676c817f
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6789-vcodec-dec.yaml
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6789-vcodec-dec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6789 Stateless Video Decoder
+
+maintainers:
+  - sysretq0 <sysretq0@proton.me>
+
+description:
+  MediaTek MT6789 (Helio G99) single-core hardware video decoder (VDEC)
+  programmed via direct MMIO registers without auxiliary VPU/SCP firmware.
+
+properties:
+  compatible:
+    const: mediatek,mt6789-vcodec-dec
+
+  reg:
+    items:
+      - description: VDEC_GCON global control register block
+      - description: VDEC core register blocks (VLD, VLDTOP, MC, AVCVLD, AVCMV, PP, MISC, UFO)
+
+  reg-names:
+    items:
+      - const: gcon
+      - const: core
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Top-level VDEC functional mux clock
+      - description: VDECSYS core clock gate
+      - description: VDECSYS SMI LARB clock gate
+
+  clock-names:
+    items:
+      - const: vdec-sel
+      - const: vdec
+      - const: larb
+
+  power-domains:
+    maxItems: 1
+
+  mediatek,vdecsys:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the VDECSYS syscon clock/reset register block.
+
+  iommus:
+    minItems: 1
+    maxItems: 12
+    description:
+      Phandles to the MediaTek M4U IOMMU ports on SMI LARB4 used by the VDEC
+      DMA engines.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+  - mediatek,vdecsys
+  - iommus
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6789-clk.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/memory/mediatek,mt6789-memory-port.h>
+    #include <dt-bindings/power/mt6789-power.h>
+
+    video-codec@16000000 {
+        compatible = "mediatek,mt6789-vcodec-dec";
+        reg = <0x16000000 0x1000>,
+              <0x16020000 0xa000>;
+        reg-names = "gcon", "core";
+        interrupts = <GIC_SPI 458 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&topckgen CLK_TOP_VDEC_SEL>,
+                 <&vdecsys CLK_VDE2_VDEC_CKEN>,
+                 <&vdecsys CLK_VDE2_LARB1_CKEN>;
+        clock-names = "vdec-sel", "vdec", "larb";
+        power-domains = <&spm MT6789_POWER_DOMAIN_VDEC>;
+        mediatek,vdecsys = <&vdecsys>;
+        iommus = <&disp_iommu M4U_PORT_L4_VDEC_MC_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_PP_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_PRED_RD_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_PRED_WR_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_PPWRAP_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_VLD_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_VLD2_EXT>,
+                 <&disp_iommu M4U_PORT_L4_VDEC_AVC_MV_EXT>;
+    };
-- 
2.47.2
