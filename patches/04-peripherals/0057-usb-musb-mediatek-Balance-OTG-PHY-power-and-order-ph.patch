From 5783ea63aa6692177147dcb096aeba4e815a5c6c Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Fri, 27 Nov 2026 01:19:06 +0700
Subject: [PATCH] usb: musb: mediatek: Cleanly tear down, settle, and start
 MUSB on OTG swaps

In dual-role OTG mode, drivers/usb/musb/mediatek.c has four bugs that
break live USB-C DR_SWAP and gadget/host operation:

1. mtk_musb_init() calls phy_power_on() even when glue->role starts as
   USB_ROLE_NONE, leaking phy->power_count (+1) so phy_power_off()
   never actually powers down the PHY or cycles VBUSVALID/SESSEND.
2. Direct DEVICE <-> HOST swaps call phy_power_off() and phy_power_on()
   back-to-back without settling, so the MUSB UTMI FSM never samples
   SESSEND=1 / IDDIG=0 before MUSB_DEVCTL_SESSION is asserted and stays
   latched in B-device mode (DevCtl=0x99).
3. In MUSB_OTG mode without a bound gadget, musb_start() is never called
   by the virtual root hub, leaving IntrTxE/IntrRxE/IntrUsbE masked off
   so host-mode connects never fire an IRQ.
4. Entering USB_ROLE_HOST leaves MUSB_POWER_SOFTCONN set, while returning
   to USB_ROLE_DEVICE never restores MUSB_POWER_SOFTCONN when
   musb->softconnect is active.

Balance phy_power_on()/phy_power_off() for USB_ROLE_NONE, tear down the
previous role cleanly, sleep 10 ms across direct PHY power-cycles and
2 ms after phy_set_mode(), call musb_start() when activating host or
device mode, and manage MUSB_POWER_SOFTCONN / MUSB_DEVCTL_SESSION
explicitly.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/usb/musb/mediatek.c | 111 ++++++++++++++++++++++++++++--------
 1 file changed, 86 insertions(+), 25 deletions(-)

diff --git a/drivers/usb/musb/mediatek.c b/drivers/usb/musb/mediatek.c
index 45eea9a..ab73737 100644
--- a/drivers/usb/musb/mediatek.c
+++ b/drivers/usb/musb/mediatek.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -66,51 +67,108 @@ static int mtk_musb_clks_get(struct mtk_glue *glue)
 static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 {
 	struct musb *musb = glue->musb;
-	u8 devctl = readb(musb->mregs + MUSB_DEVCTL);
-	enum usb_role new_role;
+	enum usb_role old_role = glue->role;
+	unsigned long flags;
+	u8 devctl, power;
 
-	if (role == glue->role)
+	if (role == old_role)
 		return 0;
 
+	if (role != USB_ROLE_HOST && role != USB_ROLE_DEVICE &&
+	    role != USB_ROLE_NONE) {
+		dev_err(glue->dev, "Invalid State\n");
+		return -EINVAL;
+	}
+
+	/* Cleanly tear down the previous role before changing PHY state. */
+	spin_lock_irqsave(&musb->lock, flags);
+	if (old_role == USB_ROLE_DEVICE) {
+		power = musb_readb(musb->mregs, MUSB_POWER);
+		power &= ~MUSB_POWER_SOFTCONN;
+		musb_writeb(musb->mregs, MUSB_POWER, power);
+		musb_g_disconnect(musb);
+	} else if (old_role == USB_ROLE_HOST) {
+		devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
+		devctl &= ~MUSB_DEVCTL_SESSION;
+		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
+		musb_root_disconnect(musb);
+	}
+	spin_unlock_irqrestore(&musb->lock, flags);
+
 	switch (role) {
 	case USB_ROLE_HOST:
-		musb->xceiv->otg->state = OTG_STATE_A_WAIT_VRISE;
 		glue->phy_mode = PHY_MODE_USB_HOST;
-		new_role = USB_ROLE_HOST;
-		if (glue->role == USB_ROLE_NONE)
+		if (old_role == USB_ROLE_DEVICE) {
+			phy_power_off(glue->phy);
+			usleep_range(10000, 12000);
 			phy_power_on(glue->phy);
+		} else if (old_role == USB_ROLE_NONE) {
+			phy_power_on(glue->phy);
+		}
+		phy_set_mode(glue->phy, glue->phy_mode);
+		usleep_range(2000, 3000);
 
+		spin_lock_irqsave(&musb->lock, flags);
+		musb->xceiv->otg->state = OTG_STATE_A_WAIT_VRISE;
+		MUSB_HST_MODE(musb);
+		spin_unlock_irqrestore(&musb->lock, flags);
+
+		musb_start(musb);
+
+		spin_lock_irqsave(&musb->lock, flags);
+		power = musb_readb(musb->mregs, MUSB_POWER);
+		power &= ~MUSB_POWER_SOFTCONN;
+		musb_writeb(musb->mregs, MUSB_POWER, power);
+		devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
 		devctl |= MUSB_DEVCTL_SESSION;
 		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
-		MUSB_HST_MODE(musb);
+		spin_unlock_irqrestore(&musb->lock, flags);
 		break;
 	case USB_ROLE_DEVICE:
-		musb->xceiv->otg->state = OTG_STATE_B_IDLE;
 		glue->phy_mode = PHY_MODE_USB_DEVICE;
-		new_role = USB_ROLE_DEVICE;
-		devctl &= ~MUSB_DEVCTL_SESSION;
-		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
-		if (glue->role == USB_ROLE_NONE)
+		if (old_role == USB_ROLE_HOST) {
+			phy_power_off(glue->phy);
+			usleep_range(10000, 12000);
 			phy_power_on(glue->phy);
+		} else if (old_role == USB_ROLE_NONE) {
+			phy_power_on(glue->phy);
+		}
+		phy_set_mode(glue->phy, glue->phy_mode);
+		usleep_range(2000, 3000);
 
+		spin_lock_irqsave(&musb->lock, flags);
+		musb->xceiv->otg->state = OTG_STATE_B_IDLE;
 		MUSB_DEV_MODE(musb);
+		spin_unlock_irqrestore(&musb->lock, flags);
+
+		musb_start(musb);
+
+		spin_lock_irqsave(&musb->lock, flags);
+		devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
+		devctl &= ~MUSB_DEVCTL_SESSION;
+		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
+		if (musb->softconnect) {
+			power = musb_readb(musb->mregs, MUSB_POWER);
+			power |= MUSB_POWER_SOFTCONN | MUSB_POWER_HSENAB;
+			musb_writeb(musb->mregs, MUSB_POWER, power);
+		}
+		spin_unlock_irqrestore(&musb->lock, flags);
 		break;
 	case USB_ROLE_NONE:
 		glue->phy_mode = PHY_MODE_USB_OTG;
-		new_role = USB_ROLE_NONE;
-		devctl &= ~MUSB_DEVCTL_SESSION;
-		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
-		if (glue->role != USB_ROLE_NONE)
+		spin_lock_irqsave(&musb->lock, flags);
+		musb->xceiv->otg->state = OTG_STATE_B_IDLE;
+		MUSB_DEV_MODE(musb);
+		spin_unlock_irqrestore(&musb->lock, flags);
+		if (old_role != USB_ROLE_NONE)
 			phy_power_off(glue->phy);
-
+		phy_set_mode(glue->phy, glue->phy_mode);
 		break;
 	default:
-		dev_err(glue->dev, "Invalid State\n");
-		return -EINVAL;
+		break;
 	}
 
-	glue->role = new_role;
-	phy_set_mode(glue->phy, glue->phy_mode);
+	glue->role = role;
 
 	return 0;
 }
@@ -278,9 +336,11 @@ static int mtk_musb_init(struct musb *musb)
 	if (ret)
 		goto err_phy_init;
 
-	ret = phy_power_on(glue->phy);
-	if (ret)
-		goto err_phy_power_on;
+	if (glue->role != USB_ROLE_NONE) {
+		ret = phy_power_on(glue->phy);
+		if (ret)
+			goto err_phy_power_on;
+	}
 
 	phy_set_mode(glue->phy, glue->phy_mode);
 
@@ -337,7 +397,8 @@ static int mtk_musb_exit(struct musb *musb)
 	struct mtk_glue *glue = dev_get_drvdata(dev->parent);
 
 	mtk_otg_switch_exit(glue);
-	phy_power_off(glue->phy);
+	if (glue->role != USB_ROLE_NONE)
+		phy_power_off(glue->phy);
 	phy_exit(glue->phy);
 	clk_bulk_disable_unprepare(MTK_MUSB_CLKS_NUM, glue->clks);
 
-- 
2.55.0

