From 7dc875d09e9c391683a21976bc06dc542d7edc26 Mon Sep 17 00:00:00 2001
From: sysretq0 <324514544+sysretq0@users.noreply.github.com>
Date: Fri, 27 Nov 2026 00:38:48 +0700
Subject: [PATCH] usb: musb: mediatek: Balance OTG PHY power and order
 phy_set_mode

In dual-role OTG mode, mtk_musb_probe() initializes glue->role to
USB_ROLE_NONE, yet mtk_musb_init() unconditionally calls
phy_power_on(). Subsequent transitions to HOST/DEVICE call
phy_power_on() again (power_count = 2), so phy_power_off() on
USB_ROLE_NONE never reaches 0 and never cycles VBUSVALID/SESSEND.

Additionally, mtk_otg_switch_set() asserts MUSB_DEVCTL_SESSION before
calling phy_set_mode(PHY_MODE_USB_HOST), so IDDIG is still high
(B-device) when SESSION is set, causing Babble and a_wait_vrise
disconnect errors on role switches. On a direct HOST -> DEVICE DR_SWAP
(where external VBUS never drops), clearing MUSB_DEVCTL_SESSION without
power-cycling the PHY leaves DevCtl stuck at 0x98 (SESSION=0) and deaf
to host resets.

Only call phy_power_on()/phy_power_off() at init/exit when glue->role
is not USB_ROLE_NONE, call phy_set_mode() before asserting
MUSB_DEVCTL_SESSION in host mode, and power-cycle the PHY on direct
HOST -> DEVICE swaps so MUSB latches a fresh B-device session.

Signed-off-by: sysretq0 <324514544+sysretq0@users.noreply.github.com>
---
 drivers/usb/musb/mediatek.c | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/drivers/usb/musb/mediatek.c b/drivers/usb/musb/mediatek.c
index 45eea9a..571768f 100644
--- a/drivers/usb/musb/mediatek.c
+++ b/drivers/usb/musb/mediatek.c
@@ -80,6 +80,7 @@ static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 		if (glue->role == USB_ROLE_NONE)
 			phy_power_on(glue->phy);
 
+		phy_set_mode(glue->phy, glue->phy_mode);
 		devctl |= MUSB_DEVCTL_SESSION;
 		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
 		MUSB_HST_MODE(musb);
@@ -90,9 +91,19 @@ static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 		new_role = USB_ROLE_DEVICE;
 		devctl &= ~MUSB_DEVCTL_SESSION;
 		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
-		if (glue->role == USB_ROLE_NONE)
+		if (glue->role == USB_ROLE_HOST) {
+			/*
+			 * Power-cycle the PHY when leaving host mode via
+			 * DR_SWAP so VBUSVALID/SESSEND cleanly edge-triggers
+			 * a fresh B-device session in MUSB.
+			 */
+			phy_power_off(glue->phy);
 			phy_power_on(glue->phy);
+		} else if (glue->role == USB_ROLE_NONE) {
+			phy_power_on(glue->phy);
+		}
 
+		phy_set_mode(glue->phy, glue->phy_mode);
 		MUSB_DEV_MODE(musb);
 		break;
 	case USB_ROLE_NONE:
@@ -103,6 +114,7 @@ static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 		if (glue->role != USB_ROLE_NONE)
 			phy_power_off(glue->phy);
 
+		phy_set_mode(glue->phy, glue->phy_mode);
 		break;
 	default:
 		dev_err(glue->dev, "Invalid State\n");
@@ -110,7 +122,6 @@ static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 	}
 
 	glue->role = new_role;
-	phy_set_mode(glue->phy, glue->phy_mode);
 
 	return 0;
 }
@@ -278,9 +289,11 @@ static int mtk_musb_init(struct musb *musb)
 	if (ret)
 		goto err_phy_init;
 
-	ret = phy_power_on(glue->phy);
-	if (ret)
-		goto err_phy_power_on;
+	if (glue->role != USB_ROLE_NONE) {
+		ret = phy_power_on(glue->phy);
+		if (ret)
+			goto err_phy_power_on;
+	}
 
 	phy_set_mode(glue->phy, glue->phy_mode);
 
@@ -337,7 +350,8 @@ static int mtk_musb_exit(struct musb *musb)
 	struct mtk_glue *glue = dev_get_drvdata(dev->parent);
 
 	mtk_otg_switch_exit(glue);
-	phy_power_off(glue->phy);
+	if (glue->role != USB_ROLE_NONE)
+		phy_power_off(glue->phy);
 	phy_exit(glue->phy);
 	clk_bulk_disable_unprepare(MTK_MUSB_CLKS_NUM, glue->clks);
 
-- 
