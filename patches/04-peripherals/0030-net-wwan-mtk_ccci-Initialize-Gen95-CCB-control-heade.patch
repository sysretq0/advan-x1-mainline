From aa3d7c4a688646599b476a0450f40fef170e30a4 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Tue, 24 Nov 2026 19:17:19 +0000
Subject: [PATCH] net: wwan: mtk_ccci: Initialize Gen95 CCB control headers in
 SMEM

Populate the 20-entry Gen95 CCB control header table (18 DHL +
1 MD_MONITOR + 1 META, totaling 0x17c000 B in SMEM_USER_CCB_DATA) at
NC_OFF_CCB_CTRL (0x00818000) with DL/UL page sizes, buffer sizes, and
the 0xeeff0011 init guard band before releasing modem boot.

Without these headers, md1rom's ccci_shm_bm (RT_FEAT_CCB_SHM) polls
NC_OFF_CCB_CTRL for 3s on CCCI_SHM_BM_TIMER and asserts at
mcu/service/hif/cccisrv/ccci_shm_bm/src/ccci_shm_bm.c:594.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 drivers/net/wwan/mtk_ccci/mtk_ccci.h      | 20 +++++++++
 drivers/net/wwan/mtk_ccci/mtk_ccci_core.c | 52 +++++++++++++++++++++++
 2 files changed, 72 insertions(+)

diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci.h b/drivers/net/wwan/mtk_ccci/mtk_ccci.h
index 3ccf21052..f3a1a752f 100644
--- a/drivers/net/wwan/mtk_ccci/mtk_ccci.h
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci.h
@@ -213,6 +213,26 @@ enum mtk_ccci_rt_feat_id {
 #define C_SZ_USIP			0x00060000U
 
 #define MTK_CCCI_DBM_GUARD		0x44444444U
+#define MTK_CCCI_CCB_GUARD_INIT		0xeeff0011U
+
+struct mtk_ccci_ccb_hdr {
+	u32 dl_guard_band;
+	u32 dl_alloc_index;
+	u32 dl_free_index;
+	u32 dl_read_index;
+	u32 dl_write_index;
+	u32 dl_page_size;
+	u32 dl_data_buffer_size;
+	u32 dl_guard_band_e;
+	u32 ul_guard_band;
+	u32 ul_alloc_index;
+	u32 ul_free_index;
+	u32 ul_read_index;
+	u32 ul_write_index;
+	u32 ul_page_size;
+	u32 ul_data_buffer_size;
+	u32 ul_guard_band_e;
+} __packed;
 
 /* Ringbuf framing constants */
 #define CCCI_RBF_HEADER_MAGIC		0xee0000eeU
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c
index 166dee4cc..acc3b5251 100644
--- a/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_core.c
@@ -52,6 +52,40 @@ static const u32 mtk_ccif_exp_sz[MTK_CCIF_QUEUE_NUM] = {
 	 0,         0,        0,        0,
 };
 
+struct mtk_ccb_cfg {
+	u32 dl_page_size;
+	u32 ul_page_size;
+	u32 dl_buff_size;
+	u32 ul_buff_size;
+};
+
+/*
+ * Gen95 (MT6789) CCB channel table: 20 entries (18 DHL + 1 MD_MONITOR +
+ * 1 META) totaling 0x17c000 B in SMEM_USER_CCB_DATA.
+ */
+static const struct mtk_ccb_cfg mtk_ccb_configs[] = {
+	{  1024,  1024,  32768,  32768 }, /* [ 0] DHL Ctrl */
+	{ 20480,   128, 122880,    128 }, /* [ 1] DHL Exception */
+	{   512,  1024,  36864,  32768 }, /* [ 2] DHL PS */
+	{   512,   128,  32768,    128 }, /* [ 3] DHL HWLOGGER1 */
+	{   512,   128,  32768,    128 }, /* [ 4] DHL HWLOGGER2 */
+	{   512,   128, 131072,    128 }, /* [ 5] DHL HWLOGGER3 */
+	{   128,   128,    128,    128 }, /* [ 6] DHL dummy */
+	{   128,   128,    128,    128 }, /* [ 7] DHL dummy */
+	{   128,   128,    128,    128 }, /* [ 8] DHL dummy */
+	{   128,   128,    128,    128 }, /* [ 9] DHL dummy */
+	{   128,   128,    128,    128 }, /* [10] DHL dummy */
+	{   128,   128,    128,    128 }, /* [11] DHL dummy */
+	{   128,   128,    128,    128 }, /* [12] DHL dummy */
+	{   128,   128,    128,    128 }, /* [13] DHL dummy */
+	{   128,   128,    128,    128 }, /* [14] DHL dummy */
+	{   128,   128,    128,    128 }, /* [15] DHL dummy */
+	{   128,   128,    128,    128 }, /* [16] DHL dummy */
+	{   128,   128,    640,    128 }, /* [17] DHL dummy padding */
+	{   512,  1024,  16384,  16384 }, /* [18] MD_MONITOR */
+	{ 66560, 66560, 532480, 532480 }, /* [19] META */
+};
+
 static const char *const mtk_ccci_state_names[] = {
 	[MTK_CCCI_STATE_INIT]		= "init",
 	[MTK_CCCI_STATE_PARKED]		= "parked",
@@ -387,6 +421,21 @@ static int mtk_ccci_init_smem_and_rings(struct mtk_ccci_dev *ccci)
 	writel(MTK_CCCI_DBM_GUARD, base + 8 + NC_SZ_DBM_BODY);
 	writel(MTK_CCCI_DBM_GUARD, base + 12 + NC_SZ_DBM_BODY);
 
+	/* Initialize Gen95 CCB control headers (guard band 0xeeff0011) */
+	base = ccci->nc_smem_virt + NC_OFF_CCB_CTRL;
+	for (i = 0; i < ARRAY_SIZE(mtk_ccb_configs); i++) {
+		struct mtk_ccci_ccb_hdr hdr = {
+			.dl_page_size		= mtk_ccb_configs[i].dl_page_size,
+			.dl_data_buffer_size	= mtk_ccb_configs[i].dl_buff_size,
+			.dl_guard_band_e	= MTK_CCCI_CCB_GUARD_INIT,
+			.ul_page_size		= mtk_ccb_configs[i].ul_page_size,
+			.ul_data_buffer_size	= mtk_ccb_configs[i].ul_buff_size,
+			.ul_guard_band_e	= MTK_CCCI_CCB_GUARD_INIT,
+		};
+
+		memcpy_toio(base + i * sizeof(hdr), &hdr, sizeof(hdr));
+	}
+
 	/* Normal CCIF0 ringbuffers in SMEM_USER_CCISM_MCU (0x8e829000) */
 	off = 0;
 	for (i = 0; i < MTK_CCIF_QUEUE_NUM; i++) {
@@ -1472,6 +1521,9 @@ static int mtk_ccci_probe(struct platform_device *pdev)
 	static_assert(sizeof(struct mtk_ccci_sram_layout) <= MTK_CCIF_SRAM_SIZE);
 	static_assert(sizeof(union mtk_ccci_ex_content_v3) == 276);
 	static_assert(sizeof(struct mtk_ccci_ex_overview_v3) <= 512);
+	static_assert(sizeof(struct mtk_ccci_ccb_hdr) == 64);
+	static_assert(ARRAY_SIZE(mtk_ccb_configs) * sizeof(struct mtk_ccci_ccb_hdr) <=
+		      NC_SZ_CCB_CTRL);
 
 	ccci = devm_kzalloc(&pdev->dev, sizeof(*ccci), GFP_KERNEL);
 	if (!ccci)
-- 
2.55.0

