From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sat, 28 Nov 2026 00:15:00 +0700
Subject: [PATCH] dt-bindings: iio: Add MediaTek MT6789 SCP RV55 sensorhub

Add devicetree schema for the MediaTek MT6789 System Control Processor
(SCP RV55) hardware mailbox and DRAM ring-buffer sensorhub interface.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 .../iio/mediatek,mt6789-scp-sensorhub.yaml    | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iio/mediatek,mt6789-scp-sensorhub.yaml

diff --git a/Documentation/devicetree/bindings/iio/mediatek,mt6789-scp-sensorhub.yaml b/Documentation/devicetree/bindings/iio/mediatek,mt6789-scp-sensorhub.yaml
new file mode 100644
index 0000000..c1e9a42
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/mediatek,mt6789-scp-sensorhub.yaml
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/mediatek,mt6789-scp-sensorhub.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6789 SCP RV55 Sensor Hub
+
+maintainers:
+  - sysretq0 <sysretq0@proton.me>
+
+description:
+  The MediaTek MT6789 System Control Processor (SCP RV55) hosts the on-SoC
+  sensor hub firmware communicating with the application processor via
+  hardware mailboxes and a reserved DRAM shared-memory region.
+
+properties:
+  compatible:
+    const: mediatek,mt6789-scp-sensorhub
+
+  reg:
+    items:
+      - description: SCP configuration registers (SCP_TO_SPM IPC clear)
+      - description: SCP hardware mailbox 1 (boot ready / core0 status)
+      - description: SCP hardware mailbox 2 (sensorhub ctrl & notify IPI)
+      - description: SCP hardware mailbox 3 (hart1 status / logger ack)
+
+  reg-names:
+    items:
+      - const: cfg
+      - const: mbox1
+      - const: mbox2
+      - const: mbox3
+
+  interrupts:
+    items:
+      - description: Mailbox 1 interrupt
+      - description: Mailbox 2 interrupt
+      - description: Mailbox 3 interrupt
+
+  interrupt-names:
+    items:
+      - const: mbox1
+      - const: mbox2
+      - const: mbox3
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: scp
+
+  memory-region:
+    maxItems: 1
+    description: Phandle to the reserved SCP shared-memory DRAM region.
+
+  mediatek,infracfg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the infracfg_ao syscon for SCP awake-lock IPC.
+
+  mount-matrix: true
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - memory-region
+  - mediatek,infracfg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6789-clk.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    sensorhub@10724000 {
+        compatible = "mediatek,mt6789-scp-sensorhub";
+        reg = <0x10724000 0x1000>,
+              <0x107fc000 0x1000>,
+              <0x107fd000 0x1000>,
+              <0x107fe000 0x1000>;
+        reg-names = "cfg", "mbox1", "mbox2", "mbox3";
+        interrupts = <GIC_SPI 469 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 470 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 471 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "mbox1", "mbox2", "mbox3";
+        clocks = <&topckgen CLK_TOP_SCP_SEL>;
+        clock-names = "scp";
+        memory-region = <&scp_share_mem>;
+        mediatek,infracfg = <&infracfg_ao>;
+    };
-- 
2.47.2
