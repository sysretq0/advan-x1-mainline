# Advan X1 (MT6789) U-Boot runtime overrides (plain text, imported by boot.scr)
# Edit this file on Space 1 (e.g. `esp`) without recompiling boot.scr.
#
# Layout mode: @LAYOUT_MODE@
# FIT filename on Space 1 (single mode) or Space 2 (split mode):
fit_file=@FIT_FILE@
fit_conf=@FIT_CONF@

# Primary Space 2 GPT partition label when FIT is placed on a second partition:
payload_part_label=@PAYLOAD_PART_LABEL@
force_split=@FORCE_SPLIT@

# Extra kernel cmdline flags appended to default bootargs.
# Examples:
#   extra_bootargs=noswitch
#   extra_bootargs=root=PARTLABEL=linux rootfstype=ext4
#   extra_bootargs=root=UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
extra_bootargs=
