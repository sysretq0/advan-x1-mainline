[Unit]
Description=MediaTek MT6789 CCCI Read-Only NVRAM Filesystem Daemon
After=systemd-udev-trigger.service local-fs.target
ConditionPathExists=/dev/ccci_fs

[Service]
Type=simple
ExecStart=/usr/local/sbin/ccci-fsd-launch.sh
Restart=no
StandardOutput=kmsg+console
StandardError=kmsg+console

[Install]
WantedBy=multi-user.target
