[Unit]
Description=MediaTek MT6789 Mainline WWAN 4G LTE Standalone Connect Helper
After=ccci-fsd.service systemd-resolved.service
ConditionPathExists=!/usr/sbin/ModemManager

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/mtk-wwan-connect
ExecStop=/usr/local/sbin/mtk-wwan-connect --disconnect

[Install]
WantedBy=multi-user.target
