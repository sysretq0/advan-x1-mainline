# Advan X1 mainline P1 config fragment — real clock bringup
# Base: arm64 defconfig. Merged via scripts/kconfig/merge_config.sh.
# Goal: boot with the MT6789 clock drivers active (no clk_ignore_unused),
# UART0 baud clock resolved from topckgen uart mux, gate from infra_ao.
# Loadable module policy: boot-critical drivers (clocks, pinctrl, serial, UFS/SD,
# display/panel/backlight, loop, ext4, configfs, USB gadget, PMIC/regulators,
# thermal safety, charger/Type-C, modem, core crypto/zstd) stay built-in (=y).
# Non-essential peripheral and runtime drivers (GPU, touch, audio, NFC,
# uinput/uhid, spidev, i2c-dev, haptic, overlay/fuse, DMA-BUF heaps, optional
# CPUFreq governors, bridge/VLAN/netfilter/dm, USB-C OTG peripherals, Wi-Fi/BT
# core) are built as curated =m modules (see config/initramfs-modules.txt) and
# loaded by static C /init via SYS_finit_module without pulling 750+ unrelated
# defconfig modules.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Core rootfs / Option A nested-GPT loop / ConfigFS support (explicitly pinned)
CONFIG_BLK_DEV_LOOP=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=y
CONFIG_CONFIGFS_FS=y

# Core crypto algorithms and zstd compression (arm64 defconfig leaves these =m;
# keep built-in so Wi-Fi/BT/dm-crypt/TLS/zstd never hit missing crypto-* modules)
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y

# Trim build: no debug info
CONFIG_DEBUG_INFO_NONE=y

# Work around upstream Linux blk_holder_ops __releases(&bdev->bd_holder_lock)
# compile error under Clang >= 23 (e.g. AOSP clang-r614150), where
# WARN_CONTEXT_ANALYSIS defaults to y and rejects __releases() on fn pointers.
CONFIG_WARN_CONTEXT_ANALYSIS=n

# Restrict to MediaTek architecture to trim build footprint and prevent OOM
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_GOOGLE=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MICROCHIP=n
CONFIG_ARCH_LAN969X=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_PENSANDO=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# MT6789 clock controllers (topckgen + apmixedsys + infracfg_ao), built-in
CONFIG_COMMON_CLK_MT6789=y

# MT6789 pinctrl and GPIO driver, built-in
CONFIG_PINCTRL_MT6789=y

# MediaTek SPI host controller and spidev (non-essential chardev =m)
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=m

# MediaTek I2C bus controller and chardev (non-essential chardev =m)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_MT65XX=y

# Console on mtk-drm
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_MTK_CMDQ=y
CONFIG_DRM_MEDIATEK=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_REGULATOR_TPS65132=y
CONFIG_DRM_PANEL_CHIPONE_ICNL9922C=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# UART0: mediatek,mt6577-uart via 8250_mtk + generic earlycon
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_CORE_CONSOLE=y

# Watchdog (mt6789-wdt/mt6589-wdt compat)
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y

# Base userspace visibility without a rootfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# evidence: console output into stock ramoops carveout (hang diagnosis)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=65536
CONFIG_PRINTK_TIME=y

# USB MUSB and T-PHY for USB gadget
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_INVENTRA_DMA=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# Explicitly disable monolithic legacy gadgets (prevent auto-binding to musb-hdrc UDC)
CONFIG_USB_ETH=n
CONFIG_USB_G_NCM=n
CONFIG_USB_GADGETFS=n
CONFIG_USB_FUNCTIONFS=n
CONFIG_USB_MASS_STORAGE=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_MIDI_GADGET=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_CDC_COMPOSITE=n
CONFIG_USB_G_NOKIA=n
CONFIG_USB_G_ACM_MS=n
CONFIG_USB_G_MULTI=n
CONFIG_USB_G_HID=n
CONFIG_USB_G_DBGP=n
CONFIG_USB_RAW_GADGET=n

# Keep /dev/mem hardened by default (override via EXTRA_CONFIGFRAGS=config/extra/devmem-debug.configfrag)
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# MediaTek PMIC Wrapper and MT6358/MT6366 PMIC
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_MEDIATEK_MT6359_AUXADC=y
CONFIG_MTK_MT6366_CLKBUF=y
CONFIG_NVMEM_MT6358_EFUSE=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_MT6779=y
CONFIG_INPUT_REGULATOR_HAPTIC=m

# CPU frequency scaling (hardware DVFS)
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

# Touchscreen and userspace input (non-essential =m)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_CHIPONE_ICNL9922C=m
CONFIG_INPUT_UINPUT=m
CONFIG_UHID=m

# NFC (STMicroelectronics ST21NFC / ST-NCI on i2c3; core built-in, transport =m)
CONFIG_RFKILL=y
CONFIG_NFC=y
CONFIG_NFC_NCI=m
CONFIG_NFC_ST_NCI=m
CONFIG_NFC_ST_NCI_I2C=m

# Audio (MT6789 AFE + MT6366/MT6358 PMIC codec + FS1599 speaker amp + ACCDET)
# Core ALSA/ASoC built-in; platform/machine/codec drivers built as curated =m.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT8186=m
CONFIG_SND_SOC_MT6358=m
CONFIG_SND_SOC_MT6789_MT6366=m
CONFIG_SND_SOC_FS1599=m
CONFIG_SND_SOC_MT6358_ACCDET=m

# Thermal: MediaTek eFuse, socinfo and LVTS thermal sensor
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_MTK_SOCINFO=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_MTK_MT6366_THERMAL=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_MEDIATEK_MT6577_AUXADC=y

# Storage: MediaTek MSDC (MicroSD)
CONFIG_MMC_MTK=y

# Battery, charger and USB Type-C PD (CW2217, SC89601A/BQ25890, RT1711H)
CONFIG_BATTERY_CW2217=y
CONFIG_CHARGER_BQ25890=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_RT1711H=y

# Power Domains & GPU (Mali-G57 MC2 Panfrost, non-essential =m)
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_DRM_PANFROST=m

# MediaTek SMI and MMSYS
CONFIG_MTK_SMI=y
CONFIG_MTK_MMSYS=y

# MediaTek MT6789 CCCI cellular modem (WWAN)
CONFIG_GNSS=y
CONFIG_WWAN=y
CONFIG_MTK_CCCI=y

# MediaTek MT6789 SCP RV55 sensorhub (accelerometer, gyro, mag, ALS, proximity)
CONFIG_IIO_MTK_SCP_SENSORHUB=y

# Rear camera LED torch / flash (Awinic AW3641E via GPIO LED flash class)
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_SGM3140=y

# MediaTek hardware JPEG encoder & MT6789 stateless H.264 VDEC (V4L2 M2M over LARB4/7 + M4U)
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_MEDIATEK_JPEG=m
CONFIG_V4L2_H264=m
CONFIG_VIDEO_MEDIATEK_MT6789_VDEC=m

# IPsec / XFRM and policy routing for 3GPP IMS / VoLTE (RFC 3329 / TS 33.203)
CONFIG_XFRM_USER=y
CONFIG_INET_AH=y
CONFIG_INET_ESP=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# WireGuard VPN (NetworkManager native WireGuard client).
# Hidden tristate helpers are selected to =m by CONFIG_WIREGUARD=m and are
# staged in config/initramfs-modules.txt (udp_tunnel, libpoly1305,
# libchacha20poly1305, libcurve25519) in dependency order. CRYPTO_LIB_CHACHA
# stays built-in via CONFIG_CRYPTO_CHACHA20=y.
CONFIG_WIREGUARD=m

# NAT / nftables: iptables-nft (NetworkManager hotspot masquerade, containers).
# Without NF_TABLES + NAT, `iptables -t nat -L` dies with
# "Failed to initialize nft: Protocol not supported" on the running build.
# NF_TABLES_IPV4 is a hidden bool (defaults n) and must be pinned for NFT_*.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_NAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
# nftables reject verdict + xtables REJECT targets (required by NetworkManager
# hotspot iptables-nft `-j REJECT` rules), plus legacy iptables tables.
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_IPV4=m
CONFIG_NFT_REJECT_IPV6=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_NAT=m

# Desktop/user convenience. All non-boot-critical items are =m and staged in
# config/initramfs-modules.txt (PROC_KCORE is bool so it stays built-in).
CONFIG_DM_CRYPT=m
# CIFS is built-in: CONFIG_SMBFS is a hidden tristate that defaults to =m when
# CIFS=m, and its composite smbfs.ko (cifs_md4.o + smb_compress.o) cannot be
# built as a single .ko target by the curated initramfs kmod builder.
CONFIG_CIFS=y
CONFIG_NFSD=m
CONFIG_F2FS_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NTFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_NETLINK_DIAG=m
CONFIG_PROC_KCORE=y
CONFIG_BLK_DEV_RAM=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NF_TABLES_IPV6=y
CONFIG_BINFMT_MISC=m
# Common USB-serial adapters (debug cables / external modems); OPTION already =m.
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_QCAUX=m

# Compressed RAM swap (zsmalloc built-in for ZSWAP+ZRAM; zram multi-comp LZ4/ZSTD module)
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y
CONFIG_ZRAM_MEMORY_TRACKING=y

# === Release-grade Linux / mobile distro baseline (Debian/Mobian/Fedora/Ubuntu/pmOS) ===

# Scheduler, cgroup v2 & mobile UI responsiveness
# UCLAMP_TASK enables scheduler utilization clamping (fixes gnome-shell sched_setattr EINVAL).
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_PSI=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CHECKPOINT_RESTORE=y

# Memory management: Multi-Gen LRU (MGLRU), zswap, and userfaultfd
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZSWAP=y
CONFIG_USERFAULTFD=y

# Security LSMs & hardening (Debian/Mobian/Ubuntu/Fedora standard)
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,apparmor,bpf"
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# Compressed firmware (/lib/firmware/*.zst, *.xz) & userspace AF_ALG crypto
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y

# Networking: BBR congestion control, FQ/FQ_CODEL/CAKE/HTB qdiscs, inet nftables,
# container/firewall xtables matches, IPVLAN/dummy/IFB, and PPP/PPPoE.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_HTB=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_HASH=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_CGROUP=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_IPVLAN=m
CONFIG_DUMMY=m
CONFIG_IFB=m
CONFIG_PPP=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m

# Filesystems & storage (Flatpak/AppImage SquashFS compression, UTF-8 NLS, DM snapshot/verity)
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_NLS_UTF8=y
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_VERITY=m

# Bluetooth LE & profiles (RFCOMM/BNEP), USB tethering/WWAN, HID peripherals & LED triggers
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_BACKLIGHT=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y



