# Advan X1 mainline P1 config fragment — real clock bringup
# Base: arm64 defconfig. Merged via scripts/kconfig/merge_config.sh.
# Goal: boot with the MT6789 clock drivers active (no clk_ignore_unused),
# UART0 baud clock resolved from topckgen uart mux, gate from infra_ao.
# No modules.

# Trim build: no modules, no debug info
CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y

# Restrict to MediaTek architecture to trim build footprint and prevent OOM
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_GOOGLE=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MICROCHIP=n
CONFIG_ARCH_LAN969X=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_PENSANDO=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n

# MT6789 clock controllers (topckgen + apmixedsys + infracfg_ao), built-in
CONFIG_COMMON_CLK_MT6789=y

# MT6789 pinctrl and GPIO driver, built-in
CONFIG_PINCTRL_MT6789=y

# MediaTek SPI host controller and spidev
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=y

# MediaTek I2C bus controller and chardev
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y

# Console on simpledrm
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# UART0: mediatek,mt6577-uart via 8250_mtk + generic earlycon
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_CORE_CONSOLE=y

# Watchdog (mt6789-wdt/mt6589-wdt compat)
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y

# Base userspace visibility without a rootfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# evidence: console output into stock ramoops carveout (hang diagnosis)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=65536
CONFIG_PRINTK_TIME=y

# USB MUSB and T-PHY for USB gadget
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_INVENTRA_DMA=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# Explicitly disable monolithic legacy gadgets (prevent auto-binding to musb-hdrc UDC)
CONFIG_USB_ETH=n
CONFIG_USB_G_NCM=n
CONFIG_USB_GADGETFS=n
CONFIG_USB_FUNCTIONFS=n
CONFIG_USB_MASS_STORAGE=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_MIDI_GADGET=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_CDC_COMPOSITE=n
CONFIG_USB_G_NOKIA=n
CONFIG_USB_G_ACM_MS=n
CONFIG_USB_G_MULTI=n
CONFIG_USB_G_HID=n
CONFIG_USB_G_DBGP=n
CONFIG_USB_RAW_GADGET=n

# Testing: allow /dev/mem access without restrictions
CONFIG_STRICT_DEVMEM=n
CONFIG_IO_STRICT_DEVMEM=n

# MediaTek PMIC Wrapper and MT6358/MT6366 PMIC
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_KEYBOARD_MTK_PMIC=y

# Chipone TDDI Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_CHIPONE_TDDI=y
