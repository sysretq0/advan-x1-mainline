// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Advan X1 (MT6789) board device tree — clean redo.
 *
 * Board values from Advan X1 stock artifacts (extracted/v5/dtb/main_dtb_0.dts
 * and live /proc/iomem audits 2026-11-11). Structure: upstream board-dts
 * conventions. Loader interaction notes are evidence, not decoration — the
 * loki-loader LNXB chain rewrites the chosen/bootargs bytes in place and
 * publishes initrd coordinates only when the stub properties exist.
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/regulator/mediatek,mt6397-regulator.h>

#include "mt6789.dtsi"

/ {
	model = "Advan X1";
	compatible = "advan,x1", "mediatek,mt6789";

	chosen {
		/*
		 * Bootargs stub: loader (loki-loader/src/boot.c) rewrites these
		 * exact value bytes in place, so this string IS the published
		 * cmdline. Do not shrink below current capacity.
		 */
		bootargs = "earlycon=uart8250,mmio32,0x11002000 console=ttyGS0,115200 console=tty0 nokaslr loglevel=7 initcall_debug=1 rdinit=/init                  ";

		/*
		 * Loader publishes initrd coordinates ONLY when the DTB carries
		 * these stubs (boot.c/fdt.c FDT_NO_PROP). Boot 18 lost the
		 * initramfs entirely because these two properties went missing.
		 */
		linux,initrd-start = <0x00 0x00>;
		linux,initrd-end = <0x00 0x00>;
		stdout-path = "framebuffer0";

		#address-cells = <2>;
		#size-cells = <2>;

		framebuffer0: framebuffer@fe007000 {
			compatible = "simple-framebuffer";
			/* memory-region overrides reg; both kept for loader
			 * compat (older staging code reads reg; kernel uses
			 * memory-region). */
			reg = <0x00 0xfe007000 0x00 0x00a80000>;
			memory-region = <&fb_reserved>;
			width = <1080>;
			height = <2460>;
			stride = <4352>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* 4352 B * 2460 rows = 10,705,920 B; padded to 0x00A80000.
		 * no-map: page allocator would otherwise clobber the LK
		 * scanout buffer (boot 1-3 finding: kernel never reserves
		 * bare-reg simplefb DRAM). */
		fb_reserved: framebuffer@fe007000 {
			reg = <0x00 0xfe007000 0x00 0x00a80000>;
			no-map;
		};

		/* Stock ramoops carveout (matching Android cmdline geometry):
		 * 896 KiB (0xe0000) window at 0x48090000:
		 * dmesg: 143 * 4 KiB (0x8f000), console: 256 KiB (0x40000),
		 * ftrace: 4 KiB (0x1000), pmsg: 64 KiB (0x10000).
		 * Matching Android's exact layout ensures console-ramoops-0
		 * aligns at 0x4811f000 without 4 KiB offset or interleaving. */
		ramoops@48090000 {
			compatible = "ramoops";
			reg = <0x00 0x48090000 0x00 0x000e0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x10000>;
			ecc-size = <0>;
			no-map;
		};
	};

	/* Memory: ONE verifiably clean window from live stock /proc/iomem
	 * (2026-11-11): 0x140000000-0x2296fffff has zero reserved children.
	 * Above it sit TZ/pKVM-class reservations to 0x23fffefff; device is
	 * 8 GB total, stock MemTotal 7.49 GiB. Do NOT widen without a fresh
	 * iomem audit. The stock ramoops hole is declared as memory + reserved
	 * above. */
	memory@48090000 {
		device_type = "memory";
		reg = <0x00 0x48090000 0x00 0x000e0000>; /* 896 KiB stock ramoops hole */
	};

	/* Kernel staging region: loader drops the Image at 0x61000000 (2 MiB
	 * aligned); the arm64 kernel needs its load address inside a declared
	 * memory region or the linear map never covers its own image (first
	 * boot silence, 2026-11-11: silent hang + 30 s WDT). image_size
	 * 0x54a0000 (84.6 MiB) fits with margin; top 0x69000000 stays below
	 * the stock hole at 0x70000000-0x76bfffff. Loader image/stack/DTB
	 * staging (0x60000000-0x61000000) stay outside on purpose. */
	memory@61000000 {
		device_type = "memory";
		reg = <0x00 0x61000000 0x00 0x08000000>; /* 128 MiB */
	};

	memory@140000000 {
		device_type = "memory";
		reg = <0x01 0x40000000 0x00 0xe9700000>; /* 3.64 GiB clean window */
	};
};

&uart0 {
	status = "okay";
};

&ufshci {
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;
	mediatek,pad-select = <0>;
	status = "okay";

	touchscreen@0 {
		compatible = "chipone-tddi";
		reg = <0>;
		spi-max-frequency = <3000000>;
		spi-cpha;
		spi-cpol;
		interrupt-parent = <&pio>;
		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
		chipone,x-res = <1080>;
		chipone,y-res = <2460>;
		status = "okay";
	};
};

&spi5 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi5_pins>;
	mediatek,pad-select = <0>;
	status = "okay";

	spidev5: spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&pwrap {
	status = "okay";

	pmic: pmic {
		compatible = "mediatek,mt6366", "mediatek,mt6358";
		interrupt-parent = <&pio>;
		interrupts = <137 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;

		mt6366regulator: regulators {
			compatible = "mediatek,mt6366-regulator", "mediatek,mt6358-regulator";

			vcore {
				regulator-name = "vcore";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <200>;
				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
							   MT6397_BUCK_MODE_FORCE_PWM>;
				regulator-always-on;
			};

			mt6366_vdram1_reg: vdram1 {
				regulator-name = "vdram1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <2087500>;
				regulator-ramp-delay = <12500>;
				regulator-enable-ramp-delay = <0>;
				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
							   MT6397_BUCK_MODE_FORCE_PWM>;
				regulator-always-on;
			};

			mt6366_vgpu_reg: vgpu {
				regulator-name = "vgpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <200>;
				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
							   MT6397_BUCK_MODE_FORCE_PWM>;
				regulator-boot-on;
			};

			mt6366_vproc11_reg: vproc11 {
				regulator-name = "vproc11";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <200>;
				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
							   MT6397_BUCK_MODE_FORCE_PWM>;
				regulator-always-on;
			};

			mt6366_vproc12_reg: vproc12 {
				regulator-name = "vproc12";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <200>;
				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
							   MT6397_BUCK_MODE_FORCE_PWM>;
				regulator-always-on;
			};

			mt6366_vs1_reg: vs1 {
				regulator-name = "vs1";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <2587500>;
				regulator-ramp-delay = <12500>;
				regulator-enable-ramp-delay = <0>;
				regulator-always-on;
			};

			mt6366_vs2_reg: vs2 {
				regulator-name = "vs2";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <2087500>;
				regulator-ramp-delay = <12500>;
				regulator-enable-ramp-delay = <0>;
				regulator-always-on;
			};

			mt6366_vmodem_reg: vmodem {
				regulator-name = "vmodem";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <900>;
				regulator-always-on;
			};

			mt6366_vpa_reg: vpa {
				regulator-name = "vpa";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3650000>;
				regulator-ramp-delay = <50000>;
				regulator-enable-ramp-delay = <250>;
			};

			mt6366_va12_reg: va12 {
				regulator-name = "va12";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-enable-ramp-delay = <270>;
				regulator-always-on;
			};

			mt6366_vaud28_reg: vaud28 {
				regulator-name = "vaud28";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <270>;
			};

			mt6366_vaux18_reg: vaux18 {
				regulator-name = "vaux18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <270>;
				regulator-always-on;
			};

			mt6366_vbif28_reg: vbif28 {
				regulator-name = "vbif28";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <270>;
				regulator-always-on;
			};

			mt6366_vcn18_reg: vcn18 {
				regulator-name = "vcn18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <270>;
			};

			mt6366_vcn28_reg: vcn28 {
				regulator-name = "vcn28";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <270>;
				regulator-always-on;
			};

			mt6366_vefuse_reg: vefuse {
				regulator-name = "vefuse";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <1900000>;
				regulator-enable-ramp-delay = <270>;
			};

			mt6366_vfe28_reg: vfe28 {
				regulator-name = "vfe28";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <270>;
			};

			mt6366_vemc_reg: vemc {
				regulator-name = "vemc";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <60>;
			};

			mt6366_vibr_reg: vibr {
				regulator-name = "vibr";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <60>;
			};

			mt6366_vio18_reg: vio18 {
				regulator-name = "vio18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <2700>;
				regulator-always-on;
			};

			mt6366_vio28_reg: vio28 {
				regulator-name = "vio28";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <270>;
				regulator-always-on;
			};

			mt6366_vm18_reg: vm18 {
				regulator-name = "vm18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <325>;
				regulator-always-on;
			};

			mt6366_vmc_reg: vmc {
				regulator-name = "vmc";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <60>;
			};

			mt6366_vmddr_reg: vmddr {
				regulator-name = "vmddr";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <750000>;
				regulator-enable-ramp-delay = <325>;
				regulator-always-on;
			};

			mt6366_vmch_reg: vmch {
				regulator-name = "vmch";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <60>;
			};

			mt6366_vcn33_reg: vcn33 {
				regulator-name = "vcn33";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3500000>;
				regulator-enable-ramp-delay = <270>;
			};

			mt6366_vdram2_reg: vdram2 {
				regulator-name = "vdram2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <3300>;
				regulator-always-on;
			};

			mt6366_vrf12_reg: vrf12 {
				regulator-name = "vrf12";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-enable-ramp-delay = <120>;
			};

			mt6366_vrf18_reg: vrf18 {
				regulator-name = "vrf18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <120>;
			};

			mt6366_vsim1_reg: vsim1 {
				regulator-name = "vsim1";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <3100000>;
				regulator-enable-ramp-delay = <540>;
			};

			mt6366_vsim2_reg: vsim2 {
				regulator-name = "vsim2";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <3100000>;
				regulator-enable-ramp-delay = <540>;
			};

			mt6366_vsram_gpu_reg: vsram-gpu {
				regulator-name = "vsram-gpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <240>;
				regulator-boot-on;
			};

			mt6366_vsram_others_reg: vsram-others {
				regulator-name = "vsram-others";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <240>;
				regulator-always-on;
			};

			mt6366_vsram_proc11_reg: vsram-proc11 {
				regulator-name = "vsram-proc11";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <240>;
				regulator-always-on;
			};

			mt6366_vsram_proc12_reg: vsram-proc12 {
				regulator-name = "vsram-proc12";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <240>;
				regulator-always-on;
			};

			mt6366_vsram_core_reg: vsram-core {
				regulator-name = "vsram-core";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1293750>;
				regulator-ramp-delay = <6250>;
				regulator-enable-ramp-delay = <240>;
				regulator-always-on;
			};
		};

		mt6358keys: keys {
			compatible = "mediatek,mt6358-keys";
			power-off-time-sec = <0>;

			powerkey {
				linux,keycodes = <KEY_POWER>;
				wakeup-source;
			};

			homekey {
				linux,keycodes = <KEY_HOME>;
				wakeup-source;
			};
		};
	};
};

&gpu {
	mali-supply = <&mt6366_vgpu_reg>;
	status = "okay";
};

&mfg0 {
	domain-supply = <&mt6366_vsram_gpu_reg>;
};

&mfg1 {
	domain-supply = <&mt6366_vgpu_reg>;
};
