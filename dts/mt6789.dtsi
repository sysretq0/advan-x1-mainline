// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * MediaTek MT6789 (Helio G99) SoC base device tree — mainline shape.
 *
 * Board authority: Advan X1 stock artifacts (extracted/v5/dtb/main_dtb_0.dts,
 * dtbo_unpacked.dts). Every address/IRQ here is copied from those files; the
 * structure follows upstream mediatek dtsi conventions (mt8186 generation).
 *
 * P1 scope: CPU topology, GICv3, arch timer, PSCI, watchdog, UART0, and the
 * three clock controllers (topckgen, apmixedsys, infracfg_ao). UFS/USB/mphy/
 * scpsys nodes land in P2-P4 with their drivers.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/mt6789-clk.h>
#include <dt-bindings/memory/mediatek,mt6789-memory-port.h>
#include <dt-bindings/reset/mt6789-resets.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/mt65xx.h>
#include <dt-bindings/pinctrl/mt6789-pinfunc.h>
#include <dt-bindings/power/mt6789-power.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>

/ {
	compatible = "mediatek,mt6789";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &spi2;
		spi3 = &spi3;
		spi4 = &spi4;
		spi5 = &spi5;
		ovl0 = &ovl0;
		rdma0 = &rdma0;
		color0 = &color0;
		ccorr0 = &ccorr0;
		aal0 = &aal0;
		gamma0 = &gamma0;
		postmask0 = &postmask0;
		dither0 = &dither0;
		dsi0 = &dsi0;
		mutex0 = &disp_mutex;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * 6x Cortex-A55 (MPIDR 0x0-0x5, cluster 0) and
		 * 2x Cortex-A76 (MPIDR 0x6-0x7, cluster 1).
		 */
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x000>;
			enable-method = "psci";
			capacity-dmips-mhz = <383>;
			performance-domains = <&performance 0>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <383>;
			performance-domains = <&performance 0>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <383>;
			performance-domains = <&performance 0>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <383>;
			performance-domains = <&performance 0>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <383>;
			performance-domains = <&performance 0>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <383>;
			performance-domains = <&performance 0>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			performance-domains = <&performance 1>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			performance-domains = <&performance 1>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b &mcusysoff
					   &system_mem &system_pll &system_bus
					   &s2idle>;
			#cooling-cells = <2>;
		};

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
				core4 { cpu = <&cpu4>; };
				core5 { cpu = <&cpu5>; };
			};

			cluster1 {
				core0 { cpu = <&cpu6>; };
				core1 { cpu = <&cpu7>; };
			};
		};

		idle-states {
			entry-method = "psci";

			cpuoff_l: cpu-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010001>;
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1600>;
			};

			cpuoff_b: cpu-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010002>;
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1400>;
			};

			clusteroff_l: cluster-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010101>;
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <2100>;
			};

			clusteroff_b: cluster-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010102>;
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <1900>;
			};

			mcusysoff: cluster-mcusys-off {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010701>;
				local-timer-stop;
				entry-latency-us = <450>;
				exit-latency-us = <600>;
				min-residency-us = <4000>;
			};

			system_mem: cluster-system-mem {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010f01>;
				local-timer-stop;
				entry-latency-us = <700>;
				exit-latency-us = <850>;
				min-residency-us = <4000>;
			};

			system_pll: cluster-system-pll {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010f02>;
				local-timer-stop;
				entry-latency-us = <800>;
				exit-latency-us = <950>;
				min-residency-us = <4000>;
			};

			system_bus: cluster-system-bus {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010f03>;
				local-timer-stop;
				entry-latency-us = <1300>;
				exit-latency-us = <2800>;
				min-residency-us = <4000>;
			};

			s2idle: cluster-s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01011f01>;
				local-timer-stop;
				entry-latency-us = <10000>;
				exit-latency-us = <10000>;
				min-residency-us = <0xffffffff>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
		/* LK leaves the counter at 13 MHz (verified 2026-11-11). */
		clock-frequency = <13000000>;
	};

	clk13m: fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&clk26m>;
		clock-div = <2>;
		clock-mult = <1>;
		clock-output-names = "clk13m";
	};

	clk26m: oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	clk32k: oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "clk32k";
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-390000000 {
			opp-hz = /bits/ 64 <390000000>;
			opp-microvolt = <675000>;
		};

		opp-493000000 {
			opp-hz = /bits/ 64 <493000000>;
			opp-microvolt = <687500>;
		};

		opp-596000000 {
			opp-hz = /bits/ 64 <596000000>;
			opp-microvolt = <693750>;
		};

		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <700000>;
		};

		opp-801000000 {
			opp-hz = /bits/ 64 <801000000>;
			opp-microvolt = <756250>;
		};

		opp-907000000 {
			opp-hz = /bits/ 64 <907000000>;
			opp-microvolt = <806250>;
		};

		opp-1003000000 {
			opp-hz = /bits/ 64 <1003000000>;
			opp-microvolt = <856250>;
		};

		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <900000>;
		};
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		performance: performance-controller@11bc10 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x00 0x0011bc10 0x00 0x120>,
			      <0x00 0x0011bd30 0x00 0x120>;
			#performance-domain-cells = <1>;
		};

		gic: interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			#address-cells = <2>;
			#size-cells = <2>;
			interrupt-controller;
			reg = <0x00 0x0c000000 0x00 0x00040000>, /* GICD */
			      <0x00 0x0c040000 0x00 0x00200000>; /* GICR */
			interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;
		};

		modem: modem@d0cf000 {
			compatible = "mediatek,mt6789-ccci";
			reg = <0x00 0x0d0cf000 0x00 0x1000>;
			reg-names = "md-rgu";
			interrupts = <GIC_SPI 110 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "md-wdt";
			power-domains = <&spm MT6789_POWER_DOMAIN_MD>;
			mediatek,ccif = <&ccif0>;
			mediatek,ccif-scp = <&ccif2>;
			mediatek,dpmaif = <&dpmaif>;
			mediatek,scpsys = <&scpsys>;
			mediatek,infracfg = <&infracfg_ao>;
			mediatek,srclken-o1 = <0x200000>;
			mediatek,power-flow-config = <0x12>;
			status = "disabled";
		};

		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt6789-topckgen", "syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <1>;
		};

		infracfg_ao: clock-controller@10001000 {
			compatible = "mediatek,mt6789-infracfg_ao", "syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		scpsys: syscon@10006000 {
			compatible = "mediatek,mt6789-scpsys", "syscon", "simple-mfd";
			reg = <0x00 0x10006000 0x00 0x1000>;

			/* System Power Manager */
			spm: power-controller {
				compatible = "mediatek,mt6789-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				/* power domain of the SoC */
				md: power-domain@0 {
					reg = <MT6789_POWER_DOMAIN_MD>;
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};

				mfg0: power-domain@2 {
					reg = <MT6789_POWER_DOMAIN_MFG0>;
					clocks = <&topckgen CLK_TOP_MFG_PLL_SEL>,
						 <&topckgen CLK_TOP_MFG_REF_SEL>;
					clock-names = "mfg", "alt";
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					mfg1: power-domain@3 {
						reg = <MT6789_POWER_DOMAIN_MFG1>;
						mediatek,infracfg = <&infracfg_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						mfg2: power-domain@4 {
							reg = <MT6789_POWER_DOMAIN_MFG2>;
							#power-domain-cells = <0>;
						};

						mfg3: power-domain@5 {
							reg = <MT6789_POWER_DOMAIN_MFG3>;
							#power-domain-cells = <0>;
						};
					};
				};

				power-domain@10 {
					reg = <MT6789_POWER_DOMAIN_DISP>;
					clocks = <&topckgen CLK_TOP_DISP_SEL>,
						 <&mmsys CLK_MM_SMI_INFRA>,
						 <&mmsys CLK_MM_SMI_COMMON>,
						 <&mmsys CLK_MM_SMI_GALS>,
						 <&mmsys CLK_MM_SMI_IOMMU>,
						 <&mmsys CLK_MM_APB_BUS>,
						 <&mmsys CLK_MM_DISP_26M>;
					clock-names = "disp",
						      "subsys-smi-infra",
						      "subsys-smi-common",
						      "subsys-smi-gals",
						      "subsys-smi-iommu",
						      "subsys-apb-bus",
						      "subsys-disp-26m";
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};

				power-domain@11 {
					reg = <MT6789_POWER_DOMAIN_AUDIO>;
					clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
						 <&infracfg_ao CLK_IFRAO_AUDIO_26M_BCLK>,
						 <&infracfg_ao CLK_IFRAO_AUDIO>;
					clock-names = "audio",
						      "subsys-audio-0",
						      "subsys-audio-1";
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};
			};
		};

		apmixedsys: clock-controller@1000c000 {
			compatible = "mediatek,mt6789-apmixedsys", "syscon";
			reg = <0x00 0x1000c000 0x00 0x1000>;
			#clock-cells = <1>;
		};

		pio: pinctrl@10005000 {
			compatible = "mediatek,mt6789-pinctrl";
			reg = <0x00 0x10005000 0x00 0x1000>,
			      <0x00 0x11c30000 0x00 0x1000>,
			      <0x00 0x11d10000 0x00 0x1000>,
			      <0x00 0x11d40000 0x00 0x1000>,
			      <0x00 0x11e20000 0x00 0x1000>,
			      <0x00 0x11e60000 0x00 0x1000>,
			      <0x00 0x11ea0000 0x00 0x1000>,
			      <0x00 0x1000b000 0x00 0x1000>;
			reg-names = "gpio",
				    "iocfg_rb",
				    "iocfg_bm",
				    "iocfg_br",
				    "iocfg_lm",
				    "iocfg_bl",
				    "iocfg_rt",
				    "eint";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 188>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>;

			spi0_pins: spi0-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO30__FUNC_SPI0_CLK>,
						 <PINMUX_GPIO31__FUNC_SPI0_CSB>,
						 <PINMUX_GPIO32__FUNC_SPI0_MO>,
						 <PINMUX_GPIO33__FUNC_SPI0_MI>;
					drive-strength = <2>;
					bias-disable;
				};
			};

			spi1_pins: spi1-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO34__FUNC_SPI1_CLK>,
						 <PINMUX_GPIO35__FUNC_SPI1_CSB>,
						 <PINMUX_GPIO36__FUNC_SPI1_MO>,
						 <PINMUX_GPIO37__FUNC_SPI1_MI>;
					bias-disable;
				};
			};

			spi2_pins: spi2-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO38__FUNC_SPI2_CLK>,
						 <PINMUX_GPIO39__FUNC_SPI2_CSB>,
						 <PINMUX_GPIO40__FUNC_SPI2_MO>,
						 <PINMUX_GPIO41__FUNC_SPI2_MI>;
					bias-disable;
				};
			};

			spi3_pins: spi3-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO42__FUNC_SPI3_CLK>,
						 <PINMUX_GPIO43__FUNC_SPI3_CSB>,
						 <PINMUX_GPIO44__FUNC_SPI3_MO>,
						 <PINMUX_GPIO45__FUNC_SPI3_MI>;
					bias-disable;
				};
			};

			spi4_pins: spi4-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO9__FUNC_SPI4_CLK>,
						 <PINMUX_GPIO10__FUNC_SPI4_CSB>,
						 <PINMUX_GPIO11__FUNC_SPI4_MO>,
						 <PINMUX_GPIO12__FUNC_SPI4_MI>;
					bias-disable;
				};
			};

			spi5_pins: spi5-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO46__FUNC_SPI5_CLK>,
						 <PINMUX_GPIO47__FUNC_SPI5_CSB>,
						 <PINMUX_GPIO48__FUNC_SPI5_MO>,
						 <PINMUX_GPIO49__FUNC_SPI5_MI>;
					bias-disable;
				};
			};

			i2c0_pins: i2c0-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO130__FUNC_SCL0>,
						 <PINMUX_GPIO131__FUNC_SDA0>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c1_pins: i2c1-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO132__FUNC_SCL1>,
						 <PINMUX_GPIO133__FUNC_SDA1>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c2_pins: i2c2-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO134__FUNC_SCL2>,
						 <PINMUX_GPIO135__FUNC_SDA2>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c3_pins: i2c3-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO136__FUNC_SCL3>,
						 <PINMUX_GPIO137__FUNC_SDA3>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c4_pins: i2c4-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO138__FUNC_SCL4>,
						 <PINMUX_GPIO139__FUNC_SDA4>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c5_pins: i2c5-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO140__FUNC_SCL5>,
						 <PINMUX_GPIO141__FUNC_SDA5>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c6_pins: i2c6-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO142__FUNC_SCL6>,
						 <PINMUX_GPIO143__FUNC_SDA6>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c7_pins: i2c7-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO144__FUNC_SCL7>,
						 <PINMUX_GPIO145__FUNC_SDA7>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c8_pins: i2c8-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO146__FUNC_SCL8>,
						 <PINMUX_GPIO147__FUNC_SDA8>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			i2c9_pins: i2c9-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO148__FUNC_SCL9>,
						 <PINMUX_GPIO149__FUNC_SDA9>;
					bias-pull-up = <MTK_PULL_SET_RSEL_011>;
					input-enable;
				};
			};

			disp_pwm0_pins: disp-pwm0-default-pins {
				pins-bus {
					pinmux = <PINMUX_GPIO84__FUNC_DISP_PWM>;
				};
			};
		};

		watchdog: watchdog@10007000 {
			compatible = "mediatek,mt6789-wdt", "mediatek,mt6589-wdt",
				     "syscon", "simple-mfd";
			reg = <0x00 0x10007000 0x00 0x100>;
			#reset-cells = <1>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x24>;
				mask = <0x0f>;
				mode-charger = <0x01>;
				mode-recovery = <0x02>;
				mode-bootloader = <0x03>;
				mode-dm-verity-dev-corrupt = <0x04>;
				mode-kpoc = <0x05>;
				mode-ddr-reserve = <0x06>;
				mode-meta = <0x07>;
				mode-rpmbpk = <0x08>;
			};
		};

		keyboard: keyboard@10010000 {
			compatible = "mediatek,mt6779-keypad";
			reg = <0x00 0x10010000 0x00 0x1000>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_EDGE_RISING>;
			clocks = <&clk26m>;
			clock-names = "kpd";
			status = "disabled";
		};

		dpmaif: dpmaif@10014000 {
