				 <&infracfg_ao CLK_IFRAO_AP_DMA>;
			clock-names = "main", "dma";
			clock-div = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c8: i2c@11eb2000 {
			compatible = "mediatek,mt6789-i2c";
			reg = <0x00 0x11eb2000 0x00 0x1000>,
			      <0x00 0x10217600 0x00 0x80>;
			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&imp_iic_wrap_en CLK_IMPEN_AP_CLOCK_I2C8>,
				 <&infracfg_ao CLK_IFRAO_AP_DMA>;
			clock-names = "main", "dma";
			clock-div = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c9: i2c@11eb3000 {
			compatible = "mediatek,mt6789-i2c";
			reg = <0x00 0x11eb3000 0x00 0x1000>,
			      <0x00 0x10217700 0x00 0x80>;
