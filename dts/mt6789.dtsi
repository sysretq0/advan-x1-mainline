		dither0: dither@1400f000 {
			compatible = "mediatek,mt6789-disp-dither", "mediatek,mt8183-disp-dither";
			reg = <0x00 0x1400f000 0x00 0x1000>;
			clocks = <&mmsys CLK_MM_DISP_DITHER0>;
			interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
		};

		dsc0: dsc@14012000 {
			compatible = "mediatek,mt6789-disp-dsc", "mediatek,mt8195-disp-dsc";
			reg = <0x00 0x14012000 0x00 0x1000>;
			clocks = <&mmsys CLK_MM_DISP_DSC_WRAP0>;
			interrupts = <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
		};

		dsi0: dsi@14013000 {
			compatible = "mediatek,mt6789-dsi";
			reg = <0x00 0x14013000 0x00 0x1000>;
			clocks = <&mmsys CLK_MM_DSI0>,
				 <&mmsys CLK_MM_DSI0_DSI_CK_DOMAIN>,
				 <&mipi_tx0>;
			clock-names = "engine", "digital", "hs";
			interrupts = <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			phys = <&mipi_tx0>;
			phy-names = "dphy";
			status = "disabled";

			port {
				dsi0_out: endpoint {
				};
			};
		};

		disp_iommu: iommu@14016000 {
			compatible = "mediatek,mt6789-iommu-mm";
			reg = <0x00 0x14016000 0x00 0x1000>;
			interrupts = <GIC_SPI 303 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mmsys CLK_MM_SMI_IOMMU>;
			clock-names = "bclk";
			power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
			mediatek,larbs = <&larb0>, <&larb1>;
			#iommu-cells = <1>;
		};
	};

