# /init uses modprobe_dep() from /lib/modules/<uname -r>/modules.dep when
# available (automatic dependency order), and falls back to /lib/modules/extra/<name>.ko
# in this exact dependency order when depmod was not run at build time.
#
# Modules not staged in the current build are skipped silently. Any extra
