#!/bin/sh
# ADVAN X1 Mainline Linux Initramfs
# Boots BusyBox into RAM, brings up USB ACM gadget, and runs interactive shell.

# Essential mountpoints
mkdir -p /proc /sys /dev /mnt /tmp /run /etc /sys/kernel/config
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t configfs none /sys/kernel/config 2>/dev/null || true

log() {
    [ -w /dev/kmsg ] && echo "<6>[INIT] $@" > /dev/kmsg 2>/dev/null || true
    [ -c /dev/tty0 ] && echo "$@" > /dev/tty0 2>/dev/null || true
}

# Display banner on screen and console
BANNER="
=============================================================
         ADVAN X1 (Helio G99 / MT6789) Mainline Linux        
             Minimal Standalone BusyBox Initramfs            
============================================================="

[ -w /dev/kmsg ] && echo "$BANNER" > /dev/kmsg 2>/dev/null || true
[ -c /dev/tty0 ] && echo "$BANNER" > /dev/tty0 2>/dev/null || true
log "=== ADVAN X1 Mainline Linux BusyBox Initramfs ==="

log "Kernel $(uname -r) on $(uname -m)"
log "System uptime: $(cut -d' ' -f1 /proc/uptime) seconds"

# Setup USB gadget (ACM serial on /dev/ttyGS0)
if [ -d /sys/kernel/config/usb_gadget ]; then
    log "Initializing USB ConfigFS gadget..."
    cd /sys/kernel/config/usb_gadget
    mkdir -p g1
    cd g1
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0100 > bcdDevice
    mkdir -p strings/0x409
    echo "Advan" > strings/0x409/manufacturer
    echo "Advan X1 Mainline" > strings/0x409/product
    mkdir -p configs/c.1/strings/0x409
    echo "ACM" > configs/c.1/strings/0x409/configuration
    echo 500 > configs/c.1/MaxPower
    mkdir -p functions/acm.usb0
    ln -sf functions/acm.usb0 configs/c.1/

    # Wait up to 3 seconds for UDC registration
    UDC=""
    for i in 1 2 3; do
        UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        [ -n "$UDC" ] && break
        sleep 1
    done

    if [ -n "$UDC" ]; then
        if echo "$UDC" > UDC 2>/dev/null; then
            log "USB gadget bound to $UDC (/dev/ttyGS0 active)"
        else
            log "Failed to bind USB gadget to $UDC"
        fi
    else
        log "No UDC device found in /sys/class/udc"
    fi
fi

# Print block device partitions for diagnostic confirmation
log "Detected block devices: $(cat /proc/partitions 2>/dev/null | tr '\n' '; ')"

# Mount debugfs for hardware introspection
mount -t debugfs none /sys/kernel/debug 2>/dev/null || true

log "=== Pinctrl & GPIO Diagnostics ==="
log "GPIO chips: $(ls -d /sys/class/gpio/gpiochip* 2>/dev/null || echo 'None')"
for chip in /sys/class/gpio/gpiochip*; do
    if [ -d "$chip" ]; then
        log "$chip: label=$(cat $chip/label 2>/dev/null), base=$(cat $chip/base 2>/dev/null), ngpio=$(cat $chip/ngpio 2>/dev/null)"
    fi
done

if [ -d /sys/kernel/debug/pinctrl ]; then
    log "Registered pinctrl devices: $(ls /sys/kernel/debug/pinctrl 2>/dev/null)"
    for pctrl in /sys/kernel/debug/pinctrl/*; do
        if [ -d "$pctrl" ]; then
            log "Pinctrl $pctrl pin count: $(wc -l < $pctrl/pins 2>/dev/null || echo 'N/A') lines"
            head -n 25 "$pctrl/pins" 2>/dev/null | while read -r line; do log "  PIN: $line"; done
            tail -n 40 "$pctrl/pins" 2>/dev/null | while read -r line; do log "  PIN: $line"; done
        fi
    done
fi

if [ -f /sys/kernel/debug/gpio ]; then
    log "=== /sys/kernel/debug/gpio ==="
    cat /sys/kernel/debug/gpio 2>/dev/null | while read -r line; do log "  GPIO: $line"; done
fi

log "=== SPI Controller Diagnostics ==="
log "SPI masters: $(ls -d /sys/class/spi_master/* 2>/dev/null || echo 'None')"
for sm in /sys/class/spi_master/*; do
    if [ -d "$sm" ]; then
        log "SPI master $(basename $sm): of_node=$(readlink $sm/device/of_node 2>/dev/null || echo 'N/A')"
    fi
done
log "SPI devices: $(ls -d /sys/bus/spi/devices/* 2>/dev/null || echo 'None')"
log "SPI devnodes: $(ls -l /dev/spidev* 2>/dev/null || echo 'None')"

log "=== I2C Controller Diagnostics ==="
log "I2C adapters: $(ls -d /sys/class/i2c-adapter/* 2>/dev/null || echo 'None')"
for i2c in /sys/class/i2c-adapter/*; do
    if [ -d "$i2c" ]; then
        log "I2C adapter $(basename $i2c): name=$(cat $i2c/name 2>/dev/null || echo 'N/A')"
    fi
done
log "I2C devnodes: $(ls -l /dev/i2c-* 2>/dev/null || echo 'None')"

# Register peek utility via devmem (with /dev/mem fallback)
peek() {
    addr="$1"
    val=""
    if command -v devmem >/dev/null 2>&1; then
        val=$(devmem "$addr" 32 2>/dev/null || devmem "$addr" 2>/dev/null)
    fi
    if [ -z "$val" ] && [ -r /dev/mem ]; then
        val=$(dd if=/dev/mem bs=4 count=1 skip=$(( $addr / 4 )) 2>/dev/null | hexdump -e '1/4 "0x%08x\n"' 2>/dev/null)
    fi
    echo "${val:-N/A}"
}

log "=== MMIO Hardware Register Peeks (devmem) ==="
log "  INFRACFG_AO CG1 (0x10001090, SPI0 bit19): $(peek 0x10001090)"
log "  INFRACFG_AO CG2 (0x10001094, SPI1..5 bits): $(peek 0x10001094)"
log "  TOPCKGEN SPI MUX (0x100000a0): $(peek 0x100000a0)"
log "  TOPCKGEN I2C MUX (0x100000b0): $(peek 0x100000b0)"
log "  SPI0 base (0x1100a000): $(peek 0x1100a000)"
log "  SPI0 CMD  (0x1100a00c): $(peek 0x1100a00c)"
log "  SPI5 base (0x11019000): $(peek 0x11019000)"
log "  SPI5 CMD  (0x1101900c): $(peek 0x1101900c)"
log "  I2C0 base (0x11e00000): $(peek 0x11e00000)"
log "  I2C5 base (0x11017000): $(peek 0x11017000)"
log "  I2C_WRAP_C (0x1101b000): $(peek 0x1101b000)"
log "  MUSB DEVCTL (0x11200060): $(peek 0x11200060)"
log "  TPHY DTM1 (0x11f4036c): $(peek 0x11f4036c)"

# Nested GPT rootfs detection and loopback mounting
log "=== Nested GPT Rootfs Detection ==="
mkdir -p /sysroot
ROOT_MOUNTED=0

# Ensure loop control nodes exist
[ -e /dev/loop-control ] || mknod /dev/loop-control c 10 237 2>/dev/null || true
for l in 0 1 2 3 4 5 6 7; do
    [ -e /dev/loop$l ] || mknod /dev/loop$l b 7 $l 2>/dev/null || true
done

# Try /dev/sdc64 (48GB rootfs partition, nested GPT part 1 offset 256*4096 = 1048576)
if [ -b /dev/sdc64 ]; then
    log "Checking /dev/sdc64 nested GPT (offset 1048576)..."
    losetup -r -o 1048576 /dev/loop0 /dev/sdc64 2>/dev/null || true
    if mount -t ext4 -o ro /dev/loop0 /sysroot 2>/dev/null; then
        ROOT_MOUNTED=1
        log "SUCCESS: Mounted /dev/sdc64 nested ext4 rootfs on /sysroot"
        if [ -f /sysroot/etc/os-release ]; then
            log "Rootfs OS: $(grep -E '^(NAME|VERSION)=' /sysroot/etc/os-release 2>/dev/null | tr '\n' '; ')"
        fi
    else
        losetup -d /dev/loop0 2>/dev/null || true
    fi
fi

# Try /dev/sdc72 (xnu_data partition, nested GPT part 1 offset 34560*4096 = 141557760)
if [ "$ROOT_MOUNTED" -eq 0 ] && [ -b /dev/sdc72 ]; then
    log "Checking /dev/sdc72 nested GPT (offset 141557760)..."
    losetup -r -o 141557760 /dev/loop1 /dev/sdc72 2>/dev/null || true
    if mount -t ext4 -o ro /dev/loop1 /sysroot 2>/dev/null; then
        ROOT_MOUNTED=1
        log "SUCCESS: Mounted /dev/sdc72 nested ext4 rootfs on /sysroot"
        if [ -f /sysroot/etc/os-release ]; then
            log "Rootfs OS: $(grep -E '^(NAME|VERSION)=' /sysroot/etc/os-release 2>/dev/null | tr '\n' '; ')"
        fi
    else
        losetup -d /dev/loop1 2>/dev/null || true
    fi
fi

if [ "$ROOT_MOUNTED" -eq 1 ]; then
    log "Rootfs is ready at /sysroot."
    log "To boot into systemd/distribution: switch_root /sysroot /sbin/init"
    # Auto-switch if switch_root requested on cmdline
    if grep -q "switch_root" /proc/cmdline 2>/dev/null; then
        log "Executing switch_root to /sysroot /sbin/init..."
        mkdir -p /sysroot/proc /sysroot/sys /sysroot/dev
        mount --move /proc /sysroot/proc
        mount --move /sys /sysroot/sys
        mount --move /dev /sysroot/dev
        exec switch_root /sysroot /sbin/init
    fi
else
    log "No nested ext4 rootfs automatically mounted; continuing in standalone initramfs."
fi

# Issue banner for getty logins
cat << 'EOF' > /etc/issue

=============================================================
         ADVAN X1 (Helio G99 / MT6789) Mainline Linux        
         Interactive BusyBox Shell on /dev/ttyGS0            
=============================================================

EOF

# Profile for ash shells
cat << 'EOF' > /etc/profile
export PS1='advan-x1:\w# '
export PATH='/bin:/sbin:/usr/bin:/usr/sbin'
peek() {
    devmem "$1" 32 2>/dev/null || devmem "$1" 2>/dev/null || echo "EFAULT"
}
poke() {
    devmem "$1" 32 "$2"
}
boot_systemd() {
    if [ -f /sysroot/sbin/init ] || [ -f /sysroot/lib/systemd/systemd ]; then
        echo "Switching root to /sysroot..."
        mkdir -p /sysroot/proc /sysroot/sys /sysroot/dev
        mount --move /proc /sysroot/proc
        mount --move /sys /sysroot/sys
        mount --move /dev /sysroot/dev
        exec switch_root /sysroot /sbin/init
    else
        echo "Error: /sysroot is not mounted or has no /sbin/init"
    fi
}
echo "Welcome to ADVAN X1 Mainline Linux (Helio G99 / MT6789)!"
echo "Commands available: peek <addr>, poke <addr> <val>, boot_systemd"
EOF

# Ensure /dev/ttyGS0 is available before launching getty
for i in 1 2 3 4 5; do
    [ -c /dev/ttyGS0 ] && break
    sleep 0.5
done

# Spawn getty on USB serial ttyGS0 with CLOCAL (no carrier detect wait, direct login to /bin/sh)
if [ -c /dev/ttyGS0 ]; then
    log "Starting getty on /dev/ttyGS0 (115200 baud)..."
else
    log "WARNING: /dev/ttyGS0 not found yet, loop will wait for it..."
fi

(
    while true; do
        if [ -c /dev/ttyGS0 ]; then
            getty -L -n -l /bin/sh 115200 ttyGS0 vt100
        fi
        sleep 1
    done
) &

# Spawn getty on screen /dev/tty0
if [ -c /dev/tty0 ]; then
    log "Starting getty on /dev/tty0..."
    (
        while true; do
            getty -n -l /bin/sh 0 tty0 linux
            sleep 1
        done
    ) &
fi

log "=== Init complete, system ready for interactive shell access ==="

# PID 1 wait loop: reaps zombie processes and sleeps
while true; do
    wait
    sleep 1
done
