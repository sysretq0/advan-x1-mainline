#!/bin/sh
# ADVAN X1 Mainline Linux Initramfs
# Boots BusyBox into RAM, brings up USB ACM gadget, and runs interactive shell.

# Essential mountpoints
mkdir -p /proc /sys /dev /mnt /tmp /run /etc /sys/kernel/config
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t configfs none /sys/kernel/config 2>/dev/null || true

log() {
    [ -w /dev/kmsg ] && echo "<6>[INIT] $@" > /dev/kmsg 2>/dev/null || true
    [ -c /dev/tty0 ] && echo "$@" > /dev/tty0 2>/dev/null || true
}

# Display banner on screen and console
BANNER="
=============================================================
         ADVAN X1 (Helio G99 / MT6789) Mainline Linux        
             Minimal Standalone BusyBox Initramfs            
============================================================="

[ -w /dev/kmsg ] && echo "$BANNER" > /dev/kmsg 2>/dev/null || true
[ -c /dev/tty0 ] && echo "$BANNER" > /dev/tty0 2>/dev/null || true
log "=== ADVAN X1 Mainline Linux BusyBox Initramfs ==="

log "Kernel $(uname -r) on $(uname -m)"
log "System uptime: $(cut -d' ' -f1 /proc/uptime) seconds"

# Setup USB gadget (ACM serial on /dev/ttyGS0)
if [ -d /sys/kernel/config/usb_gadget ]; then
    log "Initializing USB ConfigFS gadget..."
    cd /sys/kernel/config/usb_gadget
    mkdir -p g1
    cd g1
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0100 > bcdDevice
    mkdir -p strings/0x409
    echo "Advan" > strings/0x409/manufacturer
    echo "Advan X1 Mainline" > strings/0x409/product
    mkdir -p configs/c.1/strings/0x409
    echo "ACM" > configs/c.1/strings/0x409/configuration
    echo 500 > configs/c.1/MaxPower
    mkdir -p functions/acm.usb0
    ln -sf functions/acm.usb0 configs/c.1/

    # Wait up to 3 seconds for UDC registration
    UDC=""
    for i in 1 2 3; do
        UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        [ -n "$UDC" ] && break
        sleep 1
    done

    if [ -n "$UDC" ]; then
        if echo "$UDC" > UDC 2>/dev/null; then
            log "USB gadget bound to $UDC (/dev/ttyGS0 active)"
        else
            log "Failed to bind USB gadget to $UDC"
        fi
    else
        log "No UDC device found in /sys/class/udc"
    fi
fi

# Print block device partitions for diagnostic confirmation
log "Detected block devices: $(cat /proc/partitions 2>/dev/null | tr '\n' '; ')"

# Mount debugfs for hardware introspection
mount -t debugfs none /sys/kernel/debug 2>/dev/null || true

# Summary of probed hardware
[ -d /sys/class/gpio ] && log "GPIO chips: $(ls -d /sys/class/gpio/gpiochip* 2>/dev/null | tr '\n' ' ')"
[ -d /sys/class/i2c-adapter ] && log "I2C adapters: $(ls -d /sys/class/i2c-adapter/* 2>/dev/null | tr '\n' ' ')"
[ -d /sys/class/spi_master ] && log "SPI masters: $(ls -d /sys/class/spi_master/* 2>/dev/null | tr '\n' ' ')"
[ -d /sys/bus/platform/drivers/panfrost ] && log "GPU driver: Panfrost active"
if [ -d /sys/class/thermal ]; then
    TZ_SUMMARY=""
    for tz in /sys/class/thermal/thermal_zone*; do
        [ -d "$tz" ] || continue
        TZ_TYPE=$(cat "$tz/type" 2>/dev/null || echo "?")
        TZ_TEMP=$(cat "$tz/temp" 2>/dev/null || echo "err")
        TZ_SUMMARY="$TZ_SUMMARY ${TZ_TYPE}=${TZ_TEMP}"
    done
    [ -n "$TZ_SUMMARY" ] && log "Thermal zones:$TZ_SUMMARY"
fi

# Display pipeline & IRQ telemetry (read-only, strictly clock-gated)
if [ -r /proc/interrupts ]; then
    DISP_IRQS=$(grep -E 'ovl|rdma|dsi|mutex|lvts|ufshci|pmic' /proc/interrupts 2>/dev/null | tr '\n' '; ')
    [ -n "$DISP_IRQS" ] && log "Key IRQs: $DISP_IRQS"
fi
if [ -d /sys/class/backlight/backlight ]; then
    BL_B=$(cat /sys/class/backlight/backlight/brightness 2>/dev/null || echo "?")
    BL_A=$(cat /sys/class/backlight/backlight/actual_brightness 2>/dev/null || echo "?")
    BL_P=$(cat /sys/class/backlight/backlight/bl_power 2>/dev/null || echo "?")
    log "Backlight: brightness=$BL_B actual=$BL_A power=$BL_P"
fi
if command -v devmem >/dev/null 2>&1; then
    clk_on() {
        local c="/sys/kernel/debug/clk/$1/clk_enable_count"
        [ -r "$c" ] && [ "$(cat "$c" 2>/dev/null)" -gt 0 ] 2>/dev/null
    }
    if clk_on mm_apb_bus && clk_on mm_disp_mutex0; then
        log "MMSYS/MUTEX: cg0=$(devmem 0x14000100 32) cg1=$(devmem 0x140001a0 32) dl_v0=$(devmem 0x14000e9c 32) dl_v1=$(devmem 0x14000ea0 32) dl_r0=$(devmem 0x14000ea8 32) dl_r1=$(devmem 0x14000eac 32) mtx_en=$(devmem 0x14001020 32) mtx_sof=$(devmem 0x1400102c 32) mtx_mod0=$(devmem 0x14001030 32)"
    fi
    if clk_on mm_disp_ovl0 && clk_on mm_disp_rdma0; then
        log "OVL0: sta=$(devmem 0x14005000 32) inten=$(devmem 0x14005004 32) intsta=$(devmem 0x14005008 32) en=$(devmem 0x1400500c 32) dp=$(devmem 0x14005024 32) src=$(devmem 0x1400502c 32) l0addr=$(devmem 0x14005f40 32) flow=$(devmem 0x14005240 32)"
        log "RDMA0: inten=$(devmem 0x14007000 32) ints=$(devmem 0x14007004 32) con=$(devmem 0x14007010 32) fifo=$(devmem 0x14007040 32) shd=$(devmem 0x140070bc 32) in_l=$(devmem 0x140070f4 32) out_l=$(devmem 0x140070fc 32) dbg=$(devmem 0x14007100 32)"
    fi
    if clk_on mm_disp_dsc_wrap0 && clk_on mm_dsi0; then
        log "DSC0/DSI0: dsc_con=$(devmem 0x14012000 32) dsc_mode=$(devmem 0x14012030 32) dsc_shd=$(devmem 0x14012200 32) dsi_st=$(devmem 0x14013000 32) dsi_is=$(devmem 0x1401300c 32) dsi_con=$(devmem 0x14013010 32) dsi_md=$(devmem 0x14013014 32) dsi_tx=$(devmem 0x14013018 32) dsi_ps=$(devmem 0x1401301c 32) dsi_lc=$(devmem 0x14013104 32) dbg6=$(devmem 0x14013160 32) dbg7=$(devmem 0x14013164 32)"
    fi
    if clk_on mipi_tx0_pll; then
        log "MIPITX: lane=$(devmem 0x11f6000c 32) con0=$(devmem 0x11f6002c 32) con1=$(devmem 0x11f60030 32) sw0=$(devmem 0x11f60110 32) ckmode=$(devmem 0x11f60210 32)"
    fi
fi

# Keep UFS host controller active during early boot
for ufs_pwr in /sys/bus/platform/devices/*.ufshci/power/control; do
    [ -e "$ufs_pwr" ] && echo on > "$ufs_pwr" 2>/dev/null || true
done

# Rootfs discovery:
#   1. Explicit kernel cmdline `root=PARTLABEL=<name>` / `root=UUID=<uuid>` / `root=/dev/<node>`
#      (standard flat GPT Linux rootfs partition)
#   2. Legacy fallback: nested GPT ext4 rootfs inside /dev/sdc72 (xnu_data, offset 141557760)
mkdir -p /sysroot
ROOT_MOUNTED=0
ROOT_LEGACY_LOOP=0

# Ensure loop control nodes exist
[ -e /dev/loop-control ] || mknod /dev/loop-control c 10 237 2>/dev/null || true
for l in 0 1 2 3 4 5 6 7; do
    [ -e /dev/loop$l ] || mknod /dev/loop$l b 7 $l 2>/dev/null || true
done

resolve_partlabel() {
    local want="$1"
    for uev in /sys/block/*/*/uevent /sys/block/*/uevent; do
        [ -r "$uev" ] || continue
        if grep -qx "PARTNAME=$want" "$uev" 2>/dev/null; then
            local dname
            dname=$(sed -n 's/^DEVNAME=//p' "$uev" | head -n 1)
            [ -n "$dname" ] && [ -b "/dev/$dname" ] && echo "/dev/$dname" && return 0
        fi
    done
    return 1
}

CMD_ROOT=""
CMD_ROOTFSTYPE=""
for tok in $(cat /proc/cmdline 2>/dev/null); do
    case "$tok" in
        root=*) CMD_ROOT="${tok#root=}" ;;
        rootfstype=*) CMD_ROOTFSTYPE="${tok#rootfstype=}" ;;
    esac
done

if [ -n "$CMD_ROOT" ]; then
    log "=== Explicit Rootfs Discovery (root=$CMD_ROOT) ==="
    ROOT_DEV=""
    for i in 1 2 3 4 5 6; do
        case "$CMD_ROOT" in
            PARTLABEL=*)
                ROOT_DEV=$(resolve_partlabel "${CMD_ROOT#PARTLABEL=}" || true)
                ;;
            UUID=*)
                ROOT_DEV=$(blkid -t "$CMD_ROOT" -o device 2>/dev/null | head -n 1 || true)
                if [ -z "$ROOT_DEV" ] && command -v findfs >/dev/null 2>&1; then
                    ROOT_DEV=$(findfs "$CMD_ROOT" 2>/dev/null || true)
                fi
                ;;
            /dev/*)
                [ -b "$CMD_ROOT" ] && ROOT_DEV="$CMD_ROOT"
                ;;
        esac
        [ -n "$ROOT_DEV" ] && [ -b "$ROOT_DEV" ] && break
        sleep 0.5
    done

    if [ -n "$ROOT_DEV" ] && [ -b "$ROOT_DEV" ]; then
        FSTYPE_OPT=""
        [ -n "$CMD_ROOTFSTYPE" ] && FSTYPE_OPT="-t $CMD_ROOTFSTYPE"
        if mount $FSTYPE_OPT -o rw "$ROOT_DEV" /sysroot 2>/dev/null || \
           mount -t ext4 -o rw "$ROOT_DEV" /sysroot 2>/dev/null; then
            ROOT_MOUNTED=1
            log "SUCCESS: Mounted $CMD_ROOT ($ROOT_DEV) on /sysroot (rw)"
        else
            log "WARNING: Found $ROOT_DEV for $CMD_ROOT but mount failed"
        fi
    else
        log "WARNING: Timed out waiting for $CMD_ROOT"
    fi
fi

# Fallback: locate `xnu_data` by GPT PARTNAME (works across repartitions, falls back to /dev/sdc72)
# and mount its nested GPT part 1 ext4 rootfs (offset 34560*4096 = 141557760).
if [ "$ROOT_MOUNTED" -eq 0 ]; then
    XNU_DEV=""
    for i in 1 2 3 4 5 6; do
        XNU_DEV=$(resolve_partlabel "xnu_data" || true)
        [ -z "$XNU_DEV" ] && [ -b /dev/sdc72 ] && XNU_DEV="/dev/sdc72"
        [ -n "$XNU_DEV" ] && [ -b "$XNU_DEV" ] && break
        sleep 0.5
    done

    if [ -n "$XNU_DEV" ] && [ -b "$XNU_DEV" ]; then
        log "=== Nested GPT Rootfs Fallback on $XNU_DEV (xnu_data, offset 141557760) ==="
        losetup -o 141557760 /dev/loop0 "$XNU_DEV" 2>/dev/null || true
        if mount -t ext4 -o rw /dev/loop0 /sysroot 2>/dev/null; then
            ROOT_MOUNTED=1
            ROOT_LEGACY_LOOP=1
            log "SUCCESS: Mounted $XNU_DEV (xnu_data) nested ext4 rootfs on /sysroot (rw)"
        else
            losetup -d /dev/loop0 2>/dev/null || true
        fi
    fi
fi

if [ "$ROOT_MOUNTED" -eq 1 ]; then
    if [ -f /sysroot/etc/os-release ]; then
        log "Rootfs OS: $(grep -E '^(NAME|VERSION)=' /sysroot/etc/os-release 2>/dev/null | tr '\n' '; ')"
    fi
    if [ -d /sysroot/etc/systemd/system/getty.target.wants ]; then
        log "getty.target.wants: $(ls /sysroot/etc/systemd/system/getty.target.wants/ 2>/dev/null)"
        if [ -L /sysroot/etc/systemd/system/getty.target.wants/serial-getty@ttyGS0.service ] || [ -e /sysroot/etc/systemd/system/getty.target.wants/serial-getty@ttyGS0.service ]; then
            log "SUCCESS: serial-getty@ttyGS0.service is present in getty.target.wants"
        else
            log "WARNING: serial-getty@ttyGS0.service is MISSING from getty.target.wants"
        fi
    fi

    log "Rootfs is ready at /sysroot."
    if grep -q "noswitch" /proc/cmdline 2>/dev/null; then
        log "noswitch detected on cmdline; staying in standalone initramfs rescue shell."
    elif [ -x /sysroot/sbin/init ] || [ -f /sysroot/lib/systemd/systemd ]; then
        if [ "$ROOT_LEGACY_LOOP" -eq 1 ] && [ -f /sysroot/etc/fstab ] && ! grep -q "UUID=e8f59895-03e3-4f1c-a25a-2d7a8cd3b050" /sysroot/etc/fstab 2>/dev/null; then
            sed -i -E 's|^PARTUUID=[^ ]+ +/ +ext4|UUID=e8f59895-03e3-4f1c-a25a-2d7a8cd3b050 / ext4|g' /sysroot/etc/fstab
            sed -i 's|PARTUUID=1cd1f6a4-689e-4ce4-922c-749d9691cd48|UUID=e8f59895-03e3-4f1c-a25a-2d7a8cd3b050|g' /sysroot/etc/fstab
            sed -i 's|PARTUUID=39a7004f-9b43-4ba1-a46b-91cb78a4b1dd|UUID=e8f59895-03e3-4f1c-a25a-2d7a8cd3b050|g' /sysroot/etc/fstab
            sed -i 's|,x-systemd.growfs||g' /sysroot/etc/fstab
            sed -i 's|.*[[:space:]]/boot/efi[[:space:]].*|# &|' /sysroot/etc/fstab
            log "Sanitized /sysroot/etc/fstab for loop rootfs"
        fi
        mkdir -p /sysroot/var/log/boot-diag
        if [ -f /sysroot/var/log/boot-diag/early-init-dmesg.log ]; then
            mv /sysroot/var/log/boot-diag/early-init-dmesg.log /sysroot/var/log/boot-diag/early-init-dmesg.log.prev
        fi
        dmesg > /sysroot/var/log/boot-diag/early-init-dmesg.log
        sync

        mkdir -p /sysroot/etc/systemd/journald.conf.d
        printf '[Journal]\nForwardToKMsg=no\n' > /sysroot/etc/systemd/journald.conf.d/kmsg.conf
        mkdir -p /sysroot/etc/systemd/pstore.conf.d
        printf '[PStore]\nStorage=none\nUnlink=no\n' > /sysroot/etc/systemd/pstore.conf.d/keep-ramoops.conf
        mkdir -p /sysroot/etc/systemd/logind.conf.d
        printf '[Login]\nHandlePowerKey=reboot\nHandlePowerKeyLongPress=reboot\n' > /sysroot/etc/systemd/logind.conf.d/powerkey.conf
        mkdir -p /sysroot/etc/systemd/system/getty.target.wants
        [ -e /sysroot/usr/lib/systemd/system/serial-getty@.service ] && \
            ln -sf /usr/lib/systemd/system/serial-getty@.service /sysroot/etc/systemd/system/getty.target.wants/serial-getty@ttyGS0.service 2>/dev/null || true
        log "Executing switch_root to /sysroot /sbin/init (USB gadget active on /dev/ttyGS0)..."
        mkdir -p /sysroot/proc /sysroot/sys /sysroot/dev /sysroot/sys/kernel/config
        mount --move /sys/kernel/config /sysroot/sys/kernel/config 2>/dev/null || true
        mount --move /dev /sysroot/dev
        mount --move /sys /sysroot/sys
        mount --move /proc /sysroot/proc
        exec switch_root /sysroot /sbin/init --log-target=kmsg --show-status=1
    else
        log "WARNING: /sysroot mounted but /sbin/init not found; falling back to rescue shell."
    fi
else
    log "No nested ext4 rootfs automatically mounted; continuing in standalone initramfs."
fi

# Issue banner for getty logins
cat << 'EOF' > /etc/issue

=============================================================
         ADVAN X1 (Helio G99 / MT6789) Mainline Linux        
         Interactive BusyBox Shell on /dev/ttyGS0            
=============================================================

EOF

# Profile for ash shells
cat << 'EOF' > /etc/profile
export PS1='advan-x1:\w# '
export PATH='/bin:/sbin:/usr/bin:/usr/sbin'
peek() {
    devmem "$1" 32 2>/dev/null || devmem "$1" 2>/dev/null || echo "EFAULT"
}
poke() {
    devmem "$1" 32 "$2"
}
boot_systemd() {
    if [ -f /sysroot/sbin/init ] || [ -f /sysroot/lib/systemd/systemd ]; then
        echo "Switching root to /sysroot..."
        mkdir -p /sysroot/proc /sysroot/sys /sysroot/dev
        mount --move /proc /sysroot/proc
        mount --move /sys /sysroot/sys
        mount --move /dev /sysroot/dev
        exec switch_root /sysroot /sbin/init --log-target=kmsg --show-status=1
    else
        echo "Error: /sysroot is not mounted or has no /sbin/init"
    fi
}
echo "Welcome to ADVAN X1 Mainline Linux (Helio G99 / MT6789)!"
echo "Commands available: peek <addr>, poke <addr> <val>, boot_systemd"
EOF

# Ensure /dev/ttyGS0 is available before launching getty
for i in 1 2 3 4 5; do
    [ -c /dev/ttyGS0 ] && break
    sleep 0.5
done

# Spawn getty on USB serial ttyGS0 with CLOCAL (no carrier detect wait, direct login to /bin/sh)
if [ -c /dev/ttyGS0 ]; then
    log "Starting getty on /dev/ttyGS0 (115200 baud)..."
else
    log "WARNING: /dev/ttyGS0 not found yet, loop will wait for it..."
fi

(
    while true; do
        if [ -c /dev/ttyGS0 ]; then
            getty -L -n -l /bin/sh 115200 ttyGS0 vt100
        fi
        sleep 1
    done
) &

# Spawn getty on screen /dev/tty0
if [ -c /dev/tty0 ]; then
    log "Starting getty on /dev/tty0..."
    (
        while true; do
            getty -n -l /bin/sh 0 tty0 linux
            sleep 1
        done
    ) &
fi

log "=== Init complete, system ready for interactive shell access ==="

# PID 1 wait loop: reaps zombie processes and sleeps
while true; do
    wait
    sleep 1
done
