From 40b985be597d33efd9a2bf35ea2c7ebee4f82a99 Mon Sep 17 00:00:00 2001
From: sysretq0 <sysretq0@proton.me>
Date: Sun, 22 Nov 2026 04:30:01 +0000
Subject: [PATCH] arm64: dts: mediatek: advan-x1: Enable out-of-tree Chipone
 TDDI touch

Add the out-of-tree chipone-tddi SPI touchscreen child node on spi0
for optional local builds with patches-extra/.

Signed-off-by: sysretq0 <sysretq0@proton.me>
---
 arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts b/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts
index 5d19a7c0c..5a96aec6b 100644
--- a/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6789-advan-x1.dts
@@ -100,6 +100,19 @@ &spi0 {
 	pinctrl-0 = <&spi0_pins>;
 	mediatek,pad-select = <0>;
 	status = "okay";
+
+	touchscreen@0 {
+		compatible = "chipone-tddi";
+		reg = <0>;
+		spi-max-frequency = <3000000>;
+		spi-cpha;
+		spi-cpol;
+		interrupt-parent = <&pio>;
+		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+		chipone,x-res = <1080>;
+		chipone,y-res = <2460>;
+		status = "okay";
+	};
 };
 
 &i2c0 {
-- 
2.55.0

